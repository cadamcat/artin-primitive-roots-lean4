import Mathlib.Topology.Algebra.FilterBasis

set_option autoImplicit false

open Filter

namespace ArtinPrimitiveRoots.Theta.LocalTopology

universe u

variable {G : Type u} [Group G]

/-- A decreasing family of subgroups, from some starting level onward, with enough
conjugation control to define a group topology. This is the abstract input for congruence
subgroups in a local central extension. -/
structure SubgroupNeighborhoodBasis where
  /-- First level used for the neighborhood basis. -/
  first : ℕ
  /-- The subgroup at each level. Values below `first` are ignored. -/
  level : ℕ → Subgroup G
  /-- Higher levels give smaller subgroups. -/
  antitone : ∀ ⦃m n : ℕ⦄, first ≤ m → m ≤ n → level n ≤ level m
  /-- Conjugation by each group element preserves sufficiently small neighborhoods. -/
  conjugate : ∀ (g : G) (n : ℕ), first ≤ n →
    ∃ m, first ≤ m ∧ (level m : Set G) ⊆ (fun x : G => g * x * g⁻¹) ⁻¹' (level n : Set G)

namespace SubgroupNeighborhoodBasis

variable (B : SubgroupNeighborhoodBasis (G := G))

/-- The group filter basis generated by the levels `level n`, for `n ≥ first`. -/
@[instance_reducible]
noncomputable def toGroupFilterBasis : GroupFilterBasis G where
  toFilterBasis :=
    { sets := {s | ∃ n, B.first ≤ n ∧ (B.level n : Set G) = s}
      nonempty := ⟨(B.level B.first : Set G), B.first, le_rfl, rfl⟩
      inter_sets := by
        intro s t hs ht
        rcases hs with ⟨m, hm, rfl⟩
        rcases ht with ⟨n, hn, rfl⟩
        refine ⟨(B.level (max m n) : Set G), ⟨max m n, ?_, rfl⟩, ?_⟩
        · exact le_trans hm (Nat.le_max_left m n)
        · intro x hx
          constructor
          · exact B.antitone hm (Nat.le_max_left m n) hx
          · exact B.antitone hn (Nat.le_max_right m n) hx }
  one' := by
    intro s hs
    rcases hs with ⟨n, hn, rfl⟩
    exact (B.level n).one_mem
  mul' := by
    intro s hs
    rcases hs with ⟨n, hn, rfl⟩
    refine ⟨(B.level n : Set G), ⟨n, hn, rfl⟩, ?_⟩
    intro x hx
    rcases Set.mem_mul.mp hx with ⟨a, ha, b, hb, rfl⟩
    exact (B.level n).mul_mem ha hb
  inv' := by
    intro s hs
    rcases hs with ⟨n, hn, rfl⟩
    refine ⟨(B.level n : Set G), ⟨n, hn, rfl⟩, ?_⟩
    intro x hx
    exact (B.level n).inv_mem hx
  conj' := by
    intro g s hs
    rcases hs with ⟨n, hn, rfl⟩
    rcases B.conjugate g n hn with ⟨m, hm, hsub⟩
    exact ⟨(B.level m : Set G), ⟨m, hm, rfl⟩, hsub⟩

/-- The group topology whose identity neighborhoods are generated by this basis. -/
noncomputable abbrev topology : TopologicalSpace G := B.toGroupFilterBasis.topology

/-- The topology generated from a subgroup neighborhood basis is a group topology. -/
theorem isTopologicalGroup : @IsTopologicalGroup G B.topology inferInstance :=
  B.toGroupFilterBasis.isTopologicalGroup

/-- The identity neighborhoods have the expected indexed subgroup basis. -/
theorem nhds_one_hasBasis :
    @Filter.HasBasis G ℕ (@nhds G B.topology 1) (fun n => B.first ≤ n)
      (fun n => (B.level n : Set G)) := by
  exact B.toGroupFilterBasis.nhds_one_hasBasis.to_hasBasis'
    (by
      intro s hs
      rcases hs with ⟨n, hn, rfl⟩
      exact ⟨n, hn, fun x hx => hx⟩)
    (by
      intro n hn
      exact B.toGroupFilterBasis.mem_nhds_one ⟨n, hn, rfl⟩)

/-- Left translates of the indexed subgroups give neighborhood charts at every point. -/
theorem nhds_hasBasis (g : G) :
    @Filter.HasBasis G ℕ (@nhds G B.topology g) (fun n => B.first ≤ n)
      (fun n => (fun x : G => g * x) '' (B.level n : Set G)) := by
  exact B.toGroupFilterBasis.nhds_hasBasis g |>.to_hasBasis'
    (by
      intro s hs
      rcases hs with ⟨n, hn, rfl⟩
      exact ⟨n, hn, fun x hx => hx⟩)
    (by
      intro n hn
      exact (B.toGroupFilterBasis.nhds_hasBasis g).mem_of_mem ⟨n, hn, rfl⟩)

/-- Every neighborhood of `g` contains one of the left-translate charts. -/
theorem exists_chart_subset {g : G} {s : Set G} (hs : s ∈ @nhds G B.topology g) :
    ∃ n, B.first ≤ n ∧ (fun x : G => g * x) '' (B.level n : Set G) ⊆ s :=
  (B.nhds_hasBasis g).mem_iff.mp hs

/-- Each subgroup in the neighborhood basis is open. -/
theorem isOpen_level (n : ℕ) (hn : B.first ≤ n) :
    @IsOpen G B.topology (B.level n : Set G) := by
  letI : TopologicalSpace G := B.topology
  rw [isOpen_iff_mem_nhds]
  intro g hg
  apply Filter.mem_of_superset ((B.nhds_hasBasis g).mem_of_mem hn)
  rintro x ⟨y, hy, rfl⟩
  exact (B.level n).mul_mem hg hy

/-- A homomorphism is continuous when it sends some sufficiently small source subgroup into
each prescribed target neighborhood subgroup. -/
theorem continuous_of_levels {H : Type u} [Group H]
    (C : SubgroupNeighborhoodBasis (G := H)) (f : G →* H)
    (hf : ∀ n, C.first ≤ n → ∃ m, B.first ≤ m ∧
      ∀ x ∈ (B.level m : Set G), f x ∈ (C.level n : Set H)) :
    @Continuous G H B.topology C.topology f := by
  letI : TopologicalSpace G := B.topology
  letI : IsTopologicalGroup G := B.isTopologicalGroup
  letI : TopologicalSpace H := C.topology
  letI : IsTopologicalGroup H := C.isTopologicalGroup
  apply continuous_of_tendsto_nhds_one f
  rw [B.nhds_one_hasBasis.tendsto_iff C.nhds_one_hasBasis]
  intro n hn
  obtain ⟨m, hm, hmap⟩ := hf n hn
  exact ⟨m, hm, hmap⟩

/-- A homomorphism is open when the image of each source neighborhood subgroup contains a
target neighborhood subgroup. -/
theorem isOpenMap_of_levels {H : Type u} [Group H]
    (C : SubgroupNeighborhoodBasis (G := H)) (f : G →* H)
    (hf : ∀ n, B.first ≤ n → ∃ m, C.first ≤ m ∧
      (C.level m : Set H) ⊆ f '' (B.level n : Set G)) :
    @IsOpenMap G H B.topology C.topology f := by
  letI : TopologicalSpace G := B.topology
  letI : IsTopologicalGroup G := B.isTopologicalGroup
  letI : TopologicalSpace H := C.topology
  letI : IsTopologicalGroup H := C.isTopologicalGroup
  intro s hs
  rw [isOpen_iff_mem_nhds]
  intro y hy
  rcases hy with ⟨x, hx, rfl⟩
  obtain ⟨n, hn, hchart⟩ := B.exists_chart_subset (hs.mem_nhds hx)
  obtain ⟨m, hm, hmap⟩ := hf n hn
  apply Filter.mem_of_superset ((C.nhds_hasBasis (f x)).mem_of_mem hm)
  rintro z ⟨z₀, hz₀, rfl⟩
  rcases hmap hz₀ with ⟨k, hk, rfl⟩
  refine ⟨x * k, hchart ⟨k, hk, rfl⟩, ?_⟩
  simp only [map_mul]

end SubgroupNeighborhoodBasis

/-- A locally multiplicative section transfers a congruence subgroup basis to its image in a
central extension. `lift_conjugate` records the needed shrinking after conjugation, including any
central correction in the extension law. -/
structure LocallyMultiplicativeSectionBasis (G E : Type u) [Group G] [Group E] where
  /-- First level used in the basis. -/
  first : ℕ
  /-- Congruence subgroups in the base group. -/
  level : ℕ → Subgroup G
  /-- The source congruence subgroups shrink with their level. -/
  antitone : ∀ ⦃m n : ℕ⦄, first ≤ m → m ≤ n → level n ≤ level m
  /-- A set-theoretic section of the extension projection. -/
  lift : G → E
  /-- The section preserves the identity. -/
  lift_one : lift 1 = 1
  /-- The section is multiplicative on each sufficiently small congruence subgroup. -/
  lift_mul : ∀ (n : ℕ), first ≤ n → ∀ x y : G,
    x ∈ level n → y ∈ level n → lift (x * y) = lift x * lift y
  /-- Conjugation by any extension element preserves a sufficiently small lifted subgroup. -/
  lift_conjugate : ∀ (g : E) (n : ℕ), first ≤ n →
    ∃ m, first ≤ m ∧ ∀ x, x ∈ level m →
      ∃ y, y ∈ level n ∧ lift y = g * lift x * g⁻¹

namespace LocallyMultiplicativeSectionBasis

variable {G E : Type u} [Group G] [Group E] (B : LocallyMultiplicativeSectionBasis G E)

/-- Restrict a locally multiplicative section to one of its subgroup levels. -/
def liftHom (n : ℕ) (hn : B.first ≤ n) : B.level n →* E where
  toFun x := B.lift x
  map_one' := B.lift_one
  map_mul' x y := B.lift_mul n hn x y x.property y.property

/-- The image of the section on a congruence subgroup, as a subgroup of the extension. -/
def imageLevel (n : ℕ) : Subgroup E :=
  if hn : B.first ≤ n then (B.liftHom n hn).range else ⊥

/-- Membership in an image subgroup is represented by a lift from the corresponding base level. -/
theorem mem_imageLevel (n : ℕ) (hn : B.first ≤ n) {z : E} :
    z ∈ B.imageLevel n ↔ ∃ x, x ∈ B.level n ∧ B.lift x = z := by
  simp [imageLevel, hn, liftHom, MonoidHom.mem_range]

/-- The images of the congruence levels form a subgroup neighborhood basis on the extension. -/
def imageBasis : SubgroupNeighborhoodBasis (G := E) where
  first := B.first
  level := B.imageLevel
  antitone := by
    intro m n hm hmn z hz
    apply (B.mem_imageLevel m hm).2
    obtain ⟨x, hx, rfl⟩ := (B.mem_imageLevel n (le_trans hm hmn)).1 hz
    exact ⟨x, B.antitone hm hmn hx, rfl⟩
  conjugate := by
    intro g n hn
    obtain ⟨m, hm, hconj⟩ := B.lift_conjugate g n hn
    refine ⟨m, hm, ?_⟩
    intro z hz
    obtain ⟨x, hx, rfl⟩ := (B.mem_imageLevel m hm).1 hz
    obtain ⟨y, hy, hEq⟩ := hconj x hx
    exact (B.mem_imageLevel n hn).2 ⟨y, hy, hEq⟩

end LocallyMultiplicativeSectionBasis

end ArtinPrimitiveRoots.Theta.LocalTopology
