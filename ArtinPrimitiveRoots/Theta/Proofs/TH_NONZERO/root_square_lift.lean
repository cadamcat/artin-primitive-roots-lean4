import ArtinPrimitiveRoots.Theta.Cover

set_option autoImplicit false
open NumberField IsDedekindDomain
open scoped Classical
noncomputable section
namespace ArtinPrimitiveRoots.A1.Theta
open ArtinPrimitiveRoots.A1
variable {F : Type} [Field F] [NumberField F]
variable {D : FieldData F} {H : HilbertData F} {v : FinPlace F}

/-- A square torus element has a lift in the algebraic subgroup generated by
both root subgroups, up to its central phase. The six-root word projects to
`diag(t,t⁻¹)`, whose projective class is `diag(t²,1)`. -/
theorem root_square_lift (L : FinLocalCover D H v) (t : (v.adicCompletion F)ˣ) :
    ∃ h ∈ Subgroup.closure (Set.range L.n ∪ Set.range L.nbar),
      ∃ ζ, h = L.z ζ * L.a (t ^ 2) := by
  let R := Subgroup.closure (Set.range L.n ∪ Set.range L.nbar)
  let W (r : (v.adicCompletion F)ˣ) : L.L :=
    L.n (Multiplicative.ofAdd (r : v.adicCompletion F)) *
      L.nbar (Multiplicative.ofAdd (-((r⁻¹ : (v.adicCompletion F)ˣ) : v.adicCompletion F))) *
        L.n (Multiplicative.ofAdd (r : v.adicCompletion F))
  let h := W t * W (-1)
  have hW (r : (v.adicCompletion F)ˣ) : W r ∈ R := by
    have hn (x : Multiplicative (v.adicCompletion F)) : L.n x ∈ R :=
      Subgroup.subset_closure (Or.inl ⟨x, rfl⟩)
    have hnbar (x : Multiplicative (v.adicCompletion F)) : L.nbar x ∈ R :=
      Subgroup.subset_closure (Or.inr ⟨x, rfl⟩)
    exact R.mul_mem (R.mul_mem (hn _) (hnbar _)) (hn _)
  have hmatrix :
      (upperM (v.adicCompletion F) (t : v.adicCompletion F) *
          lowerM (v.adicCompletion F) (-((t⁻¹ : (v.adicCompletion F)ˣ) : v.adicCompletion F)) *
            upperM (v.adicCompletion F) (t : v.adicCompletion F)) *
        (upperM (v.adicCompletion F) (-1) * lowerM (v.adicCompletion F) 1 *
          upperM (v.adicCompletion F) (-1)) =
      Matrix.GeneralLinearGroup.scalar (Fin 2) t⁻¹ * diagM (v.adicCompletion F) (t ^ 2) := by
    apply Units.ext
    apply Matrix.ext
    intro i j
    fin_cases i <;> fin_cases j <;>
      simp [upperM, lowerM, diagM, Matrix.GeneralLinearGroup.scalar,
        Matrix.mul_apply, Fin.sum_univ_two, Units.val_inv_eq_inv_val,
        mul_neg, pow_two, ← mul_assoc]
  have hscalar :
      (QuotientGroup.mk (Matrix.GeneralLinearGroup.scalar (Fin 2) t⁻¹) :
        PGL2 (v.adicCompletion F)) = 1 := by
    rw [← L.sec_pr, L.sec_scalar, map_one]
  have hpr : L.pr h = L.pr (L.a (t ^ 2)) := by
    calc
      L.pr h = QuotientGroup.mk
          ((upperM (v.adicCompletion F) (t : v.adicCompletion F) *
              lowerM (v.adicCompletion F) (-((t⁻¹ : (v.adicCompletion F)ˣ) : v.adicCompletion F)) *
                upperM (v.adicCompletion F) (t : v.adicCompletion F)) *
            (upperM (v.adicCompletion F) (-1) * lowerM (v.adicCompletion F) 1 *
              upperM (v.adicCompletion F) (-1))) := by
        simp only [h, W, map_mul, L.pr_n, L.pr_nbar, QuotientGroup.mk_mul,
          Units.val_neg, Units.val_one, Units.val_inv_eq_inv_val, inv_neg, inv_one, neg_neg]
      _ = QuotientGroup.mk
          (Matrix.GeneralLinearGroup.scalar (Fin 2) t⁻¹ * diagM (v.adicCompletion F) (t ^ 2)) :=
        congrArg (fun g : GL (Fin 2) (v.adicCompletion F) =>
          (QuotientGroup.mk g : PGL2 (v.adicCompletion F))) hmatrix
      _ = L.pr (L.a (t ^ 2)) := by
        rw [QuotientGroup.mk_mul, hscalar, one_mul, L.pr_a]
  have hker : h * (L.a (t ^ 2))⁻¹ ∈ L.pr.ker := by
    rw [MonoidHom.mem_ker, map_mul, map_inv, hpr, mul_inv_cancel]
  rw [L.pr_ker] at hker
  obtain ⟨ζ, hζ⟩ := hker
  refine ⟨h, R.mul_mem (hW t) (hW (-1)), ζ, ?_⟩
  rw [hζ, mul_assoc, inv_mul_cancel, mul_one]
end ArtinPrimitiveRoots.A1.Theta
