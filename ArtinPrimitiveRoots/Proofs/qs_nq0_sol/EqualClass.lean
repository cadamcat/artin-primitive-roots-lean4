import ArtinPrimitiveRoots.Proofs.qs_nq0_sol.ConductorBounds
import ArtinPrimitiveRoots.Hecke.Theta.CFTIdealBridge

/-!
# Sixth powers from the allowed-generator complement

The quotient of two allowed generators belongs to B. If it differs from
an S-unit by a diagonal element with trivial power class, it also belongs
to E. The complement condition then makes that quotient a sixth power
in the product of the S-completions.
-/

set_option autoImplicit false

open scoped NumberField
open NumberField ArtinPrimitiveRoots.A1

noncomputable section

namespace ArtinPrimitiveRoots.A2

variable {K : Type} [Field K] [NumberField K]

/-- An allowed ratio whose power class comes from an S-unit is a sixth power at S. -/
theorem qs_nq0_allowed_ratio_sixth
    {CE : ℕ} {condη : Ideal (𝓞 K)}
    (Sd : SData K CE condη) (H : HilbertData K) (Bd : BData Sd H)
    (a b x : Kˣ) (ha : Bd.Allowed a) (hb : Bd.Allowed b)
    (hunit : a / b / x ∈ Sd.US)
    (hx : (QuotientGroup.mk (Sd.diagU x) : Sd.V) = 1) :
    ∃ y : Sd.FSˣ, Sd.diagU (a / b) = y ^ 6 := by
  let q : Kˣ →* Sd.V := (QuotientGroup.mk' _).comp Sd.diagU
  change q a ∈ Bd.B at ha
  change q b ∈ Bd.B at hb
  change q x = 1 at hx
  have hB : q (a / b) ∈ Bd.B := by
    rw [map_div]
    exact Bd.B.div_mem ha hb
  have hE : q (a / b) ∈ Sd.E := by
    have hunitClass : q (a / b / x) ∈ Sd.E := by
      exact ⟨a / b / x, hunit, rfl⟩
    simpa only [map_div, hx, div_one] using hunitClass
  have hclass : q (a / b) = 1 :=
    (Subgroup.disjoint_def.mp Bd.compl.disjoint) hE hB
  have hpower : Sd.diagU (a / b) ∈ (powMonoidHom 6 : Sd.FSˣ →* Sd.FSˣ).range :=
    (QuotientGroup.eq_one_iff (Sd.diagU (a / b))).mp hclass
  obtain ⟨y, hy⟩ := hpower
  exact ⟨y, hy.symm⟩


/-- Local sixth powers at S give the trivial diagonal sixth-power class. -/
theorem qs_nq0_diagonal_sixth_class
    {CE : ℕ} {condη : Ideal (𝓞 K)}
    (Sd : SData K CE condη) (x : Kˣ)
    (hx : ∀ v : FinPlace K, v ∈ Sd.Sf →
      ∃ y : (v.adicCompletion K)ˣ, toLoc v x = y ^ 6) :
    (QuotientGroup.mk (Sd.diagU x) : Sd.V) = 1 := by
  classical
  have hcomplex (w : InfinitePlace K) :
      ∃ y : ℂˣ, Units.map w.embedding.toMonoidHom x = y ^ 6 := by
    let z : ℂˣ := Units.map w.embedding.toMonoidHom x
    obtain ⟨y, hy⟩ := IsAlgClosed.exists_pow_nat_eq (z : ℂ) (n := 6) (by norm_num)
    have hy0 : y ≠ 0 := by
      intro hyzero
      have hz0 : (z : ℂ) = 0 := by rw [← hy, hyzero, zero_pow (by norm_num)]
      exact z.ne_zero hz0
    refine ⟨Units.mk0 y hy0, ?_⟩
    apply Units.ext
    exact hy.symm
  choose b hb using (fun v : Sd.Sf => hx v.1 v.2)
  choose c hc using hcomplex
  let y : Sd.FSˣ := {
    val := (fun v => (b v : v.1.adicCompletion K), fun w => (c w : ℂ))
    inv := (fun v => ((b v)⁻¹ : v.1.adicCompletion K), fun w => ((c w)⁻¹ : ℂ))
    val_inv := by ext v <;> simp
    inv_val := by ext v <;> simp }
  have hy : Sd.diagU x = y ^ 6 := by
    apply Units.ext
    apply Prod.ext
    · funext v
      change ((toLoc v.1 x : (v.1.adicCompletion K)ˣ) : v.1.adicCompletion K) =
        (b v : v.1.adicCompletion K) ^ 6
      exact congrArg (fun u : (v.1.adicCompletion K)ˣ => (u : v.1.adicCompletion K)) (hb v)
    · funext w
      change w.embedding (x : K) = (c w : ℂ) ^ 6
      exact congrArg (fun u : ℂˣ => (u : ℂ)) (hc w)
  apply (QuotientGroup.eq_one_iff (Sd.diagU x)).mpr
  exact ⟨y, hy.symm⟩


/-- Equal ray classes have a quotient generated by a ray-congruent field unit. -/
theorem qs_nq0_equal_rayclass_generator
    (m : ClassFieldTheory.RayClassModulus K) (I J : Ideal (𝓞 K))
    (hI : ArtinPrimitiveRoots.Hecke.IsCoprimeTo m I)
    (hJ : ArtinPrimitiveRoots.Hecke.IsCoprimeTo m J)
    (hclass : ArtinPrimitiveRoots.Hecke.rayClass m I hI =
      ArtinPrimitiveRoots.Hecke.rayClass m J hJ) :
    ∃ x : Kˣ, ClassFieldTheory.IsRayCongruent m x ∧
      toPrincipalIdeal (𝓞 K) K x =
        ArtinPrimitiveRoots.Hecke.idealUnit I hI.1 /
          ArtinPrimitiveRoots.Hecke.idealUnit J hJ.1 := by
  let pI : ClassFieldTheory.rayClassPrimeToIdeals m :=
    ⟨ArtinPrimitiveRoots.Hecke.idealUnit I hI.1, hI.2⟩
  let pJ : ClassFieldTheory.rayClassPrimeToIdeals m :=
    ⟨ArtinPrimitiveRoots.Hecke.idealUnit J hJ.1, hJ.2⟩
  have hquot : (QuotientGroup.mk pI : ClassFieldTheory.RayClassGroup m) =
      QuotientGroup.mk pJ := hclass
  have hmem : pI / pJ ∈ ClassFieldTheory.rayPrincipalIdealSubgroupInPrimeTo m :=
    QuotientGroup.eq_iff_div_mem.mp hquot
  obtain ⟨x, hx, hprincipal⟩ :=
    (ArtinPrimitiveRoots.Hecke.rayPrincipalIdealSubgroupInPrimeTo_mem_iff m (pI / pJ)).mp hmem
  exact ⟨x, hx, hprincipal⟩


/-- Exterior generators differ from a principal quotient generator by an S-unit. -/
theorem qs_nq0_generator_ratio_sunit
    {CE : ℕ} {condη : Ideal (𝓞 K)}
    (Sd : SData K CE condη) (I J : Ideal (𝓞 K)) (a b x : Kˣ)
    (ha : Sd.IsGen (a : K) I) (hb : Sd.IsGen (b : K) J)
    (hx : toPrincipalIdeal (𝓞 K) K x =
      ArtinPrimitiveRoots.Hecke.idealUnit I ha.1.1 /
        ArtinPrimitiveRoots.Hecke.idealUnit J hb.1.1) :
    a / b / x ∈ Sd.US := by
  have hprincipal : FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (x : K) =
      (I : FractionalIdeal (nonZeroDivisors (𝓞 K)) K) /
        (J : FractionalIdeal (nonZeroDivisors (𝓞 K)) K) := by
    have h := congrArg (fun U : ClassFieldTheory.NumberFieldFractionalIdealGroup K =>
      (U : FractionalIdeal (nonZeroDivisors (𝓞 K)) K)) hx
    simpa only [coe_toPrincipalIdeal, Units.val_div_eq_div_val,
      ArtinPrimitiveRoots.Hecke.idealUnit, Units.val_mk0] using h
  have hdiv (v : FinPlace K) (L M : FractionalIdeal (nonZeroDivisors (𝓞 K)) K)
      (hL : L ≠ 0) (hM : M ≠ 0) :
      FractionalIdeal.count K v (L / M) =
        FractionalIdeal.count K v L - FractionalIdeal.count K v M := by
    rw [div_eq_mul_inv, FractionalIdeal.count_mul K v hL (inv_ne_zero hM),
      FractionalIdeal.count_inv]
    ring
  change ∀ v : FinPlace K, v ∉ Sd.Sf → v.valuation K ((a / b / x : Kˣ) : K) = 1
  intro v hv
  have hcountx : FractionalIdeal.count K v
        (FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (x : K)) =
      FractionalIdeal.count K v (I : FractionalIdeal (nonZeroDivisors (𝓞 K)) K) -
        FractionalIdeal.count K v (J : FractionalIdeal (nonZeroDivisors (𝓞 K)) K) := by
    rw [hprincipal]
    exact hdiv v _ _ (FractionalIdeal.coeIdeal_ne_zero.mpr ha.1.1)
      (FractionalIdeal.coeIdeal_ne_zero.mpr hb.1.1)
  have hcount (c d : Kˣ) : FractionalIdeal.count K v
        (FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) ((c / d : Kˣ) : K)) =
      FractionalIdeal.count K v
          (FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (c : K)) -
        FractionalIdeal.count K v
          (FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (d : K)) := by
    rw [Units.val_div_eq_div_val, ← FractionalIdeal.spanSingleton_div_spanSingleton]
    exact hdiv v _ _ (FractionalIdeal.spanSingleton_ne_zero_iff.mpr c.ne_zero)
      (FractionalIdeal.spanSingleton_ne_zero_iff.mpr d.ne_zero)
  have hzero : FractionalIdeal.count K v
      (FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) ((a / b / x : Kˣ) : K)) = 0 := by
    rw [hcount (a / b) x, hcount a b, ha.2.2 v hv, hb.2.2 v hv, hcountx]
    ring
  have hlog := qs_nq0_count_spanSingleton_eq_neg_log_valuation v
    ((a / b / x : Kˣ) : K) (a / b / x).ne_zero
  rw [hzero] at hlog
  have hzlog : WithZero.log (v.valuation K ((a / b / x : Kˣ) : K)) = 0 :=
    neg_eq_zero.mp hlog.symm
  calc
    v.valuation K ((a / b / x : Kˣ) : K) =
        WithZero.exp (WithZero.log (v.valuation K ((a / b / x : Kˣ) : K))) :=
      (WithZero.exp_log ((Valuation.ne_zero_iff _).mpr (a / b / x).ne_zero)).symm
    _ = 1 := by rw [hzlog, WithZero.exp_zero]


/-- Local higher-unit membership implies the corresponding valuation congruence. -/
theorem qs_nq0_local_higher_unit_congruence
    (v : FinPlace K) (n : ℕ) (u : (v.adicCompletion K)ˣ)
    (hu : u ∈ ClassFieldTheory.rayLocalHigherUnitGroup v n) :
    Valued.v ((u : v.adicCompletion K) - 1) ≤
      WithZero.exp (-(n : ℤ)) := by
  change u ∈ RayClass.localHigherUnitGroup v n at hu
  obtain ⟨y, hy, hmap⟩ := (RayClass.mem_localHigherUnitGroup_iff v n u).mp hu
  let z : (v.adicCompletionIntegers K)ˣ :=
    (v.adicCompletionIntegers K).toSubmonoid.unitsEquivUnitsType y
  have hzy : ((z : v.adicCompletionIntegers K) : v.adicCompletion K) =
      (u : v.adicCompletion K) := by
    exact congrArg (fun t : (v.adicCompletion K)ˣ => (t : v.adicCompletion K)) hy
  have hzmap : Ideal.Quotient.mk
      ((IsLocalRing.maximalIdeal (v.adicCompletionIntegers K)) ^ n)
      (z : v.adicCompletionIntegers K) = 1 := by
    exact congrArg Units.val hmap
  have hzmem : (z : v.adicCompletionIntegers K) - 1 ∈
      (IsLocalRing.maximalIdeal (v.adicCompletionIntegers K)) ^ n :=
    (Ideal.Quotient.mk_eq_one_iff_sub_mem
      (I := (IsLocalRing.maximalIdeal (v.adicCompletionIntegers K)) ^ n)
      (z : v.adicCompletionIntegers K)).mp hzmap
  let w : Valuation (v.adicCompletion K) (WithZero (Multiplicative ℤ)) := Valued.v
  have hw : w.Integers (v.adicCompletionIntegers K) := Valuation.valuationSubring.integers w
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible (v.adicCompletionIntegers K)
  have hπmem : π ∈ IsLocalRing.maximalIdeal (v.adicCompletionIntegers K) := by
    rw [hπ.maximalIdeal_eq]
    exact Submodule.mem_span_singleton_self π
  have hπlt : w (π : v.adicCompletion K) < 1 :=
    (Valuation.mem_maximalIdeal_iff (v := w)).mp hπmem
  have hπbound : w (π : v.adicCompletion K) ≤ WithZero.exp (-1 : ℤ) := by
    by_cases hz : w (π : v.adicCompletion K) = 0
    · rw [hz]
      exact zero_le
    · rw [← WithZero.exp_log hz, ← WithZero.exp_zero, WithZero.exp_lt_exp] at hπlt
      rw [← WithZero.exp_log hz, WithZero.exp_le_exp]
      omega
  have hbound : w (((z : v.adicCompletionIntegers K) : v.adicCompletion K) - 1) ≤
      w (π : v.adicCompletion K) ^ n := by
    have hset := hw.maximalIdeal_pow_eq_setOfPred_le_v_algebraMap_pow hπ n
    change (z : v.adicCompletionIntegers K) - 1 ∈
      (((IsLocalRing.maximalIdeal (v.adicCompletionIntegers K)) ^ n :
        Ideal (v.adicCompletionIntegers K)) : Set (v.adicCompletionIntegers K)) at hzmem
    rw [hset] at hzmem
    exact hzmem
  rw [hzy] at hbound
  calc
    Valued.v ((u : v.adicCompletion K) - 1) ≤ w (π : v.adicCompletion K) ^ n := hbound
    _ ≤ WithZero.exp (-1 : ℤ) ^ n := pow_le_pow_left' hπbound n
    _ = WithZero.exp (-(n : ℤ)) := by
      rw [← WithZero.exp_nsmul]
      congr 1
      simp


/-- Equal ray classes make the ratio of allowed generators a sixth power at S. -/
theorem qs_nq0_equal_rayclass_allowed_ratio
    {CE : ℕ} {condη : Ideal (𝓞 K)}
    (Sd : SData K CE condη) (H : HilbertData K) (Bd : BData Sd H)
    (m : ClassFieldTheory.RayClassModulus K)
    (hm : m.finitePart.support = Sd.Sf)
    (hsix : ∀ v : FinPlace K, v ∈ Sd.Sf →
      ∀ u : (v.adicCompletion K)ˣ,
        Valued.v ((u : v.adicCompletion K) - 1) ≤
          WithZero.exp (-(m.finitePart v : ℤ)) →
        ∃ y : (v.adicCompletion K)ˣ, u = y ^ 6)
    (I J : Ideal (𝓞 K)) (a b : Kˣ)
    (ha : Sd.IsGen (a : K) I ∧ Bd.Allowed a)
    (hb : Sd.IsGen (b : K) J ∧ Bd.Allowed b)
    (hI : ArtinPrimitiveRoots.Hecke.IsCoprimeTo m I)
    (hJ : ArtinPrimitiveRoots.Hecke.IsCoprimeTo m J)
    (hclass : ArtinPrimitiveRoots.Hecke.rayClass m I hI =
      ArtinPrimitiveRoots.Hecke.rayClass m J hJ) :
    ∃ y : Sd.FSˣ, Sd.diagU (a / b) = y ^ 6 := by
  obtain ⟨x, hx, hprincipal⟩ := qs_nq0_equal_rayclass_generator m I J hI hJ hclass
  have hunit : a / b / x ∈ Sd.US :=
    qs_nq0_generator_ratio_sunit Sd I J a b x ha.1 hb.1 hprincipal
  have hxclass : (QuotientGroup.mk (Sd.diagU x) : Sd.V) = 1 := by
    apply qs_nq0_diagonal_sixth_class Sd x
    intro v hv
    apply hsix v hv (toLoc v x)
    apply qs_nq0_local_higher_unit_congruence v (m.finitePart v) (toLoc v x)
    exact hx.1 v (by rw [hm]; exact hv)
  exact qs_nq0_allowed_ratio_sixth Sd H Bd a b x ha.2 hb.2 hunit hxclass

end ArtinPrimitiveRoots.A2
