  have hpSpec : S.IsGen (primeGen R v : F) v.asIdeal ∧ Bd.Allowed (primeGen R v) := by
    have h := bc.gen_spec (R.exterior.prime v hv)
    simpa [primeGen, hv, R.exterior.prime_val] using h
  have hmaskFourierOne (k : Fin 6) :
