        _ = phi (τ * y) * (τ * y) := by rw [mul_comm y τ]
        _ = τ := hprod
        _ = 1 * τ := by simp
    have hmul : phi (τ * y) * y = 1 := mul_right_cancel₀ hτne hprod'
