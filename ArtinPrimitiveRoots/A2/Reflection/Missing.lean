        Units.val_pow_eq_pow_val, Units.val_zpow_eq_zpow_val]
    have hRhoEq : frozenRho R υ t sd d =
        Lvalue R υ (S.diagU (bc.gen d)) ^ (2 : ℕ) *
          (∏ v ∈ R.exterior.support d, localOmega R v * chi D v (θd v : F)) *
          (∏ v ∈ R.exterior.support t.f, chi D v (bc.gen d : F) ^ (-2 * frozenB t v)) := by
      rw [frozenRho, if_pos ⟨hd, hdh, hsd⟩]
      simp only [θd, Units.val_mul, Units.val_div_eq_div_val,
        Units.val_pow_eq_pow_val, Units.val_zpow_eq_zpow_val]
    have hLambdaEq : frozenLambda R υ t sc c =
        (Lvalue R υ (S.diagU (bc.gen (R.exterior.ofSqf c))))⁻¹ *
          (∏ v ∈ R.exterior.support t.f, chi D v (cgen R c) ^ frozenB t v) *
          (∏ v ∈ R.exterior.support (R.exterior.ofSqf c),
            gamma D S A 2 v.asIdeal (primeGen R v : F) * chi D v (θc v : F) ^ (2 : ℕ)) := by
      rw [frozenLambda, if_pos ⟨hcf, hsc⟩]
      congr 1
      apply Finset.prod_congr rfl
      intro v hvC
      rw [hθcDef v]
      simp only [τc, cgen, Units.val_mul, Units.val_div_eq_div_val,
        Units.val_zpow_eq_zpow_val]
    have hLnatEq :
        (Lvalue R υ (S.diagU (frozenFrequency R t d c)))⁻¹ =
          (Lvalue R υ (S.diagU (bc.gen t.a)))⁻¹ *
            Lvalue R υ (S.diagU (bc.gen t.n)) ^ (-3 : ℤ) *
            Lvalue R υ (S.diagU (bc.gen t.f)) ^ (2 : ℕ) *
            Lvalue R υ (S.diagU (bc.gen d)) ^ (2 : ℕ) *
            (Lvalue R υ (S.diagU (bc.gen (R.exterior.ofSqf c))))⁻¹ := by
      simpa using hLcomplexEq
    have hPair := rf_sqf_pairing_product R d c hd hdc
    rw [hgroupBase, hLnatEq, hgammaQ, hOmegaEq, hRhoEq, hLambdaEq, ← hPair]
    simp only [Finset.prod_mul_distrib, cgen]
    ring
private theorem rf_S_orbit_multiplier
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (u : UnitSix S) (γ : Gamma S) (ν : Fˣ) (y : S.FSˣ) :
    bCut (Bd := Bd) y * (Lvalue R u y)⁻¹ *
      sCocycle (D := D) (H := H) (S.diagU ((γ.1 : Fˣ) * ν)) y⁻¹ =
    (Lvalue R u (S.diagU ν))⁻¹ *
      (if cls (S.diagU ν) * (cls (S.diagU ((γ.1 : Fˣ) * ν) / y))⁻¹ ∈ Bd.B then 1 else 0) *
      R.pairing.pair (cls (S.diagU ν)) (cls (S.diagU ((γ.1 : Fˣ) * ν) / y)) ^ 2 *
      Lvalue R u (S.diagU ((γ.1 : Fˣ) * ν) / y) := by
  classical
  let x : S.FSˣ := S.diagU ((γ.1 : Fˣ) * ν)
  obtain ⟨ε, hε⟩ := γ.property
  have hεpow : ε ^ (6 : ℕ) = γ.1 := hε
  have hγF : (γ.1 : Fˣ) = (ε : Fˣ) ^ (6 : ℕ) := by
    simpa only [SubgroupClass.coe_pow] using
      congrArg (fun z : S.US => (z : Fˣ)) hεpow.symm
  have hγclass : cls (S.diagU (γ.1 : Fˣ)) = 1 := by
    have hmem : S.diagU (γ.1 : Fˣ) ∈ (powMonoidHom 6 : S.FSˣ →* S.FSˣ).range := by
      refine ⟨S.diagU (ε : Fˣ), ?_⟩
      change (S.diagU (ε : Fˣ)) ^ (6 : ℕ) = S.diagU (γ.1 : Fˣ)
      rw [hγF, map_pow]
    exact (QuotientGroup.eq_one_iff (S.diagU (γ.1 : Fˣ))).2 hmem
  have hxclass : cls x = cls (S.diagU ν) := by
    calc
      cls x = cls (S.diagU (γ.1 : Fˣ)) * cls (S.diagU ν) := by
        simp only [x, map_mul, cls, QuotientGroup.mk_mul]
      _ = cls (S.diagU ν) := by
        rw [hγclass]
        exact one_mul (cls (S.diagU ν))
  have hyclass : cls y = cls (S.diagU ν) * (cls (x / y))⁻¹ := by
    calc
      cls y = cls (x / (x / y)) := by simp
      _ = cls x * (cls (x / y))⁻¹ := by
        simp only [cls, QuotientGroup.mk_div, QuotientGroup.mk_mul,
          QuotientGroup.mk_inv, div_eq_mul_inv]
      _ = _ := by rw [hxclass]
  have hLγ : (R.chars.L u).L (S.diagU (γ.1 : Fˣ)) = 1 :=
    (R.chars.L u).trivial_US (γ.1 : S.US) (γ.1 : S.US).property
  have hLx : (R.chars.L u).L x = (R.chars.L u).L (S.diagU ν) := by
    simp only [x, map_mul, hLγ, one_mul]
  have hLunits : ((R.chars.L u).L y)⁻¹ =
      ((R.chars.L u).L (S.diagU ν))⁻¹ * (R.chars.L u).L (x / y) := by
    rw [map_div, hLx]
    simp [div_eq_mul_inv, mul_assoc]
  have hLfact : (Lvalue R u y)⁻¹ =
      (Lvalue R u (S.diagU ν))⁻¹ * Lvalue R u (x / y) := by
    have h := congrArg (fun z : ℂˣ => (z : ℂ)) hLunits
    simpa only [Lvalue, Units.val_inv_eq_inv_val, Units.val_mul] using h
  have hHSmul (a b c : S.FSˣ) :
      S.HS H a (b * c) = S.HS H a b * S.HS H a c := by
    simp only [SData.HS, map_mul, H.mul_right, Finset.prod_mul_distrib]
  have hHSself : (S.HS H x x) ^ (2 : ℕ) = 1 := by
    simp only [pow_two, SData.HS]
    rw [← Finset.prod_mul_distrib]
    apply Finset.prod_eq_one
    intro v hv
    exact H.skew v.1 (S.compU v x) (S.compU v x)
  have hσself : D.σ0 (((S.HS H x x : Fˣ) : F)) ^ (2 : ℕ) = 1 := by
    have h := congrArg (fun z : rootsOfUnity 6 F => D.σ0 (((z : Fˣ) : F))) hHSself
    simpa using h
  have hHSz : S.HS H x (x / y) = S.HS H x x * S.HS H x y⁻¹ := by
    simpa only [div_eq_mul_inv] using hHSmul x x y⁻¹
  have hσz : D.σ0 (((S.HS H x (x / y) : Fˣ) : F)) =
      D.σ0 (((S.HS H x x : Fˣ) : F)) * D.σ0 (((S.HS H x y⁻¹ : Fˣ) : F)) := by
    have h := congrArg (fun z : rootsOfUnity 6 F => D.σ0 (((z : Fˣ) : F))) hHSz
    simpa using h
  have hpair : R.pairing.pair (cls (S.diagU ν)) (cls (x / y)) =
      D.σ0 (((S.HS H x (x / y) : Fˣ) : F)) := by
    rw [← hxclass]
    exact R.pairing.pair_eq x (x / y)
  have hcocycle : sCocycle (D := D) (H := H) x y⁻¹ =
      R.pairing.pair (cls (S.diagU ν)) (cls (x / y)) ^ (2 : ℕ) := by
    rw [hpair, hσz, mul_pow, hσself, one_mul]
    rfl
  change bCut (Bd := Bd) y * (Lvalue R u y)⁻¹ * sCocycle (D := D) (H := H) x y⁻¹ =
    (Lvalue R u (S.diagU ν))⁻¹ *
      (if cls (S.diagU ν) * (cls (x / y))⁻¹ ∈ Bd.B then 1 else 0) *
      R.pairing.pair (cls (S.diagU ν)) (cls (x / y)) ^ 2 * Lvalue R u (x / y)
  rw [hLfact, hcocycle]
  unfold bCut
  rw [hyclass]
  ring

private theorem rf_S_profile_integral
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (u : UnitSix S) (κ : S.V) (l : ℝ) (hl : 0 < l) :
    let m : S.FSˣ → ℂ := fun y =>
      (if κ * (cls y)⁻¹ ∈ Bd.B then 1 else 0) *
        R.pairing.pair κ (cls y) ^ 2 * Lvalue R u y
    Integrable (onUnits (fun y => m y * rotated R u y)) (R.sheets.sheet l) ∧
      sheetIntegral R l (fun y => m y * rotated R u y) =
        ∑ ℓ : Fin (R.rotated u).J, profileH R u κ ℓ l := by
  classical
  let m : S.FSˣ → ℂ := fun y =>
    (if κ * (cls y)⁻¹ ∈ Bd.B then 1 else 0) *
      R.pairing.pair κ (cls y) ^ 2 * Lvalue R u y
  change Integrable (onUnits (fun y => m y * rotated R u y)) (R.sheets.sheet l) ∧
    sheetIntegral R l (fun y => m y * rotated R u y) =
      ∑ ℓ : Fin (R.rotated u).J, profileH R u κ ℓ l
  let b : S.V → ℂ := fun x =>
    (if κ * x⁻¹ ∈ Bd.B then 1 else 0) * R.pairing.pair κ x ^ 2
  have hb : ∀ x, ‖b x‖ ≤ 1 := by
    intro x
    by_cases hx : κ * x⁻¹ ∈ Bd.B <;> simp [b, hx, R.pairing.unitary κ x]
  have hm : Theta.SheetMultiplier S (onUnits m) := by
    refine ⟨R.chars.L u, 1, b, ⟨1, hb⟩, ?_⟩
    intro y
    have hunit : IsUnit (y : S.FS) := Units.isUnit y
    have hunit_eq : hunit.unit = y := by
      apply Units.ext
      exact hunit.unit_spec
    change (if h : IsUnit (y : S.FS) then m h.unit else 0) =
      (((R.chars.L u).L y : ℂˣ) : ℂ) ^ (1 : ℤ) * b (cls y)
    rw [dif_pos hunit, hunit_eq]
    by_cases hy : κ * (cls y)⁻¹ ∈ Bd.B
    · simp [m, b, Lvalue, hy, mul_comm, mul_left_comm]
    · simp [m, b, Lvalue, hy]
  let tensor : Fin (R.rotated u).J → S.FSˣ → ℂ := fun ℓ y =>
    m y * (∏ v : S.Sf, (R.rotated u).ff ℓ v ((y : S.FS).1 v)) *
      ∏ w : InfinitePlace F, (R.rotated u).fc ℓ w ((y : S.FS).2 w)
  have hTensor (ℓ : Fin (R.rotated u).J) :
      Integrable (onUnits (tensor ℓ)) (R.sheets.sheet l) :=
    a2_bridge_ANALYSIS_tensor (G := R.sheets) R.T.δ R.T.δ_pos
      (R.rotated u).J (R.rotated u).ff (R.rotated u).fc
      (R.rotated u).finite_bound (R.rotated u).complex_bound m hm ℓ l hl
  have hSum : onUnits (fun y => m y * rotated R u y) =
      fun y => ∑ ℓ : Fin (R.rotated u).J, onUnits (tensor ℓ) y := by
    funext y
    by_cases hy : IsUnit y
    · simp only [onUnits, dif_pos hy, tensor]
      rw [show rotated R u hy.unit =
        Theta.sumProd S (R.rotated u).J (R.rotated u).ff (R.rotated u).fc
          (hy.unit : S.FS) from R.rotated_eq u hy.unit]
      simp only [Theta.sumProd, Finset.mul_sum, mul_assoc]
    · simp [onUnits, hy]
  constructor
  · rw [hSum]
    exact integrable_finsetSum Finset.univ (fun ℓ _ => hTensor ℓ)
  · unfold sheetIntegral
    rw [hSum, integral_finsetSum Finset.univ (fun ℓ _ => hTensor ℓ)]
    rfl

private theorem rf_S_profile_pullback
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (u : UnitSix S) (ν : Fˣ) (l : ℝ) (hl : 0 < l) :
    let κ : S.V := cls (S.diagU ν)
    let g : S.FSˣ → ℂ := fun y =>
      (if κ * (cls y)⁻¹ ∈ Bd.B then 1 else 0) *
        R.pairing.pair κ (cls y) ^ 2 * Lvalue R u y * rotated R u y
    Integrable (onUnits (fun y => g (S.diagU ν / y))) (R.sheets.sheet l) ∧
      sheetIntegral R l (fun y => g (S.diagU ν / y)) =
        ∑ ℓ : Fin (R.rotated u).J,
          profileH R u κ ℓ (S.absS (S.diagU ν : S.FS) / l) := by
  classical
  let κ : S.V := cls (S.diagU ν)
  let g : S.FSˣ → ℂ := fun y =>
    (if κ * (cls y)⁻¹ ∈ Bd.B then 1 else 0) *
      R.pairing.pair κ (cls y) ^ 2 * Lvalue R u y * rotated R u y
  change Integrable (onUnits (fun y => g (S.diagU ν / y))) (R.sheets.sheet l) ∧
    sheetIntegral R l (fun y => g (S.diagU ν / y)) =
      ∑ ℓ : Fin (R.rotated u).J,
        profileH R u κ ℓ (S.absS (S.diagU ν : S.FS) / l)
  have hnorm : 0 < S.absS (S.diagU ν : S.FS) :=
    (a2_bridge_NORM D S).2.2.1 (S.diagU ν)
  have hprofile := rf_S_profile_integral R u κ
    (S.absS (S.diagU ν : S.FS) / l) (div_pos hnorm hl)
  change Integrable (onUnits g)
      (R.sheets.sheet (S.absS (S.diagU ν : S.FS) / l)) ∧
    sheetIntegral R (S.absS (S.diagU ν : S.FS) / l) g =
      ∑ ℓ : Fin (R.rotated u).J,
        profileH R u κ ℓ (S.absS (S.diagU ν : S.FS) / l) at hprofile
  have htranslate := a2_bridge_SHEET_transport (G := R.sheets)
    l⁻¹ (inv_pos.mpr hl) (S.diagU ν) g
      (by simpa only [div_eq_mul_inv] using hprofile.1)
  have hinvert := a2_bridge_SHEET_inversion (G := R.sheets) l hl
    (fun y => g (S.diagU ν * y)) htranslate.1
  constructor
  · simpa only [div_eq_mul_inv] using hinvert.1
  · calc
      sheetIntegral R l (fun y => g (S.diagU ν / y)) =
          bridgeSheetIntegral R.sheets l⁻¹ (fun y => g (S.diagU ν * y)) := by
        simpa only [sheetIntegral, bridgeSheetIntegral, div_eq_mul_inv] using hinvert.2
      _ = sheetIntegral R (S.absS (S.diagU ν : S.FS) / l) g := by
        simpa only [sheetIntegral, bridgeSheetIntegral, div_eq_mul_inv] using htranslate.2
      _ = ∑ ℓ : Fin (R.rotated u).J,
          profileH R u κ ℓ (S.absS (S.diagU ν : S.FS) / l) := hprofile.2

/-- rf:S-unfolding, 04:804–857. Inversion changes l to 1/l without a norm Jacobian. -/
theorem rf_S_unfolding : ∀ u ν l, 0 < l →
  let term := fun γ : Gamma S => omegaInt R l (fun y => bCut (Bd := Bd) y * (Lvalue R u y)⁻¹ *
    sCocycle (D := D) (H := H) (S.diagU ((γ.1 : Fˣ) * ν)) y⁻¹ * rotated R u (S.diagU ((γ.1 : Fˣ) * ν) / y))
  Summable term ∧ (∑' γ, term γ) = (Lvalue R u (S.diagU ν))⁻¹ *
    ∑ ℓ : Fin (R.rotated u).J, profileH R u (cls (S.diagU ν)) ℓ (S.absS (S.diagU ν : S.FS) / l) := by
  classical
  intro u ν l hl
  let term : Gamma S → ℂ := fun γ => omegaInt R l (fun y => bCut (Bd := Bd) y *
    (Lvalue R u y)⁻¹ * sCocycle (D := D) (H := H)
      (S.diagU ((γ.1 : Fˣ) * ν)) y⁻¹ * rotated R u (S.diagU ((γ.1 : Fˣ) * ν) / y))
  change Summable term ∧ (∑' γ, term γ) = (Lvalue R u (S.diagU ν))⁻¹ *
    ∑ ℓ : Fin (R.rotated u).J, profileH R u (cls (S.diagU ν)) ℓ
      (S.absS (S.diagU ν : S.FS) / l)
  let κ : S.V := cls (S.diagU ν)
  let g : S.FSˣ → ℂ := fun y =>
    (if κ * (cls y)⁻¹ ∈ Bd.B then 1 else 0) *
      R.pairing.pair κ (cls y) ^ 2 * Lvalue R u y * rotated R u y
  let pull : S.FSˣ → ℂ := fun y => g (S.diagU ν / y)
  let orbit : Gamma S → ℂ := fun γ =>
    bridgeOmegaInt R.sheets l (fun y => pull (S.diagU (γ.1 : Fˣ) * y))
  let z : ℂ := (Lvalue R u (S.diagU ν))⁻¹
  have hprofile := rf_S_profile_pullback R u ν l hl
  change Integrable (onUnits pull) (R.sheets.sheet l) ∧
    sheetIntegral R l pull = ∑ ℓ : Fin (R.rotated u).J,
      profileH R u κ ℓ (S.absS (S.diagU ν : S.FS) / l) at hprofile
  have hunfold := a2_bridge_SHEET_unfold (G := R.sheets) l hl pull hprofile.1
  have horbit : Summable orbit := hunfold.2.1
  have horbitSum : (∑' γ, orbit γ) = sheetIntegral R l pull := hunfold.2.2
  have harg (γ : Gamma S) (y : S.FSˣ) :
      S.diagU ν / (S.diagU ((γ⁻¹).1 : Fˣ) * y) =
        S.diagU ((γ.1 : Fˣ) * ν) / y := by
    have hco : ((γ⁻¹).1 : Fˣ) = (γ.1 : Fˣ)⁻¹ := rfl
    rw [hco, map_inv, map_mul]
    simp only [div_eq_mul_inv, mul_inv_rev, inv_inv]
    ac_rfl
  have hpoint (γ : Gamma S) (y : S.FSˣ) :
      bCut (Bd := Bd) y * (Lvalue R u y)⁻¹ *
        sCocycle (D := D) (H := H) (S.diagU ((γ.1 : Fˣ) * ν)) y⁻¹ *
          rotated R u (S.diagU ((γ.1 : Fˣ) * ν) / y) =
      z * pull (S.diagU ((γ⁻¹).1 : Fˣ) * y) := by
    dsimp only [pull]
    rw [harg, rf_S_orbit_multiplier R u γ ν y]
    dsimp only [z, g, κ]
    ring
  have hterm (γ : Gamma S) : term γ = z * orbit γ⁻¹ := by
    dsimp only [term, orbit, omegaInt, bridgeOmegaInt, omegaAt, bridgeOmegaAt]
    rw [← integral_const_mul]
    apply integral_congr_ae
    apply Filter.Eventually.of_forall
    intro y
    by_cases hy : IsUnit y
    · simp only [onUnits, dif_pos hy]
      exact hpoint γ hy.unit
    · simp [onUnits, hy]
  have hinv : Summable (fun γ : Gamma S => orbit γ⁻¹) := by
    simpa only [Function.comp_def, Equiv.inv_apply] using
      ((Equiv.inv (Gamma S)).summable_iff).2 horbit
  constructor
  · exact (hinv.mul_left z).congr (fun γ => (hterm γ).symm)
  · calc
      (∑' γ, term γ) = ∑' γ : Gamma S, z * orbit γ⁻¹ := tsum_congr hterm
      _ = z * ∑' γ : Gamma S, orbit γ⁻¹ := hinv.tsum_mul_left z
      _ = z * ∑' γ : Gamma S, orbit γ :=
        congrArg (fun w : ℂ => z * w) ((Equiv.inv (Gamma S)).tsum_eq orbit)
      _ = z * sheetIntegral R l pull := congrArg (fun w : ℂ => z * w) horbitSum
      _ = (Lvalue R u (S.diagU ν))⁻¹ *
          ∑ ℓ : Fin (R.rotated u).J, profileH R u (cls (S.diagU ν)) ℓ
            (S.absS (S.diagU ν : S.FS) / l) :=
        congrArg (fun w : ℂ => z * w) hprofile.2
/-- Nonnegative reflected Dirichlet mass in 04:859–910. -/
def reflectedDirichletTerm (f : S.ExtIdeal) (σ : ℝ)
    (p : {a : S.ExtIdeal // activeNumerator R f a} × S.SqfExtIdeal × S.ExtIdeal) : ℝ :=
  betaIdeal R f p.1 * qI p.2.1.1 ^ (-(1 / 2 : ℝ)) / qI p.2.2.1 *
    (qI p.1.1.1 * qI p.2.1.1 * qI p.2.2.1 ^ 3) ^ (-σ)

private theorem rf_active_exponent_injective
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0) (f : S.ExtIdeal) :
    Function.Injective (fun a : {a : S.ExtIdeal // activeNumerator R f a} =>
      fun v : {v : FinPlace F // v ∈ R.exterior.support f} => idealExp v.1 a.1.1) := by
  classical
  intro a b hab
  have hexp (v : FinPlace F) : idealExp v a.1.1 = idealExp v b.1.1 := by
    by_cases hv : v ∈ R.exterior.support f
    · exact congrFun hab ⟨v, hv⟩
    · have hva : v ∉ R.exterior.support a.1 := by
        intro h
        exact hv (a.property.1 v h)
      have hvb : v ∉ R.exterior.support b.1 := by
        intro h
        exact hv (b.property.1 v h)
      rw [rf_idealExp_zero_of_not_support R v a.1 hva,
        rf_idealExp_zero_of_not_support R v b.1 hvb]
  have ha0 : a.1.1 ≠ 0 := by
    simpa only [Ideal.zero_eq_bot] using a.1.property.1
  have hb0 : b.1.1 ≠ 0 := by
    simpa only [Ideal.zero_eq_bot] using b.1.property.1
  apply Subtype.ext
  apply Subtype.ext
  calc
    a.1.1 = ∏ᶠ v : FinPlace F, v.maxPowDividing a.1.1 :=
      (Ideal.finprod_heightOneSpectrum_factorization ha0).symm
    _ = ∏ᶠ v : FinPlace F, v.maxPowDividing b.1.1 := by
      apply finprod_congr
      intro v
      change v.asIdeal ^ idealExp v a.1.1 = v.asIdeal ^ idealExp v b.1.1
      rw [hexp v]
    _ = b.1.1 := Ideal.finprod_heightOneSpectrum_factorization hb0

private theorem rf_active_numerator_weight
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (f : S.ExtIdeal) (σ : ℝ) (a : {a : S.ExtIdeal // activeNumerator R f a}) :
    betaIdeal R f a.1 * qI a.1.1 ^ (-σ) =
      ∏ v : {v : FinPlace F // v ∈ R.exterior.support f},
        betaPrime (qI v.1.asIdeal) (qI_prime_gt_one v.1) (idealExp v.1 a.1.1) *
          qI v.1.asIdeal ^ (-σ * (idealExp v.1 a.1.1 : ℝ)) := by
  classical
  let s : Finset (FinPlace F) := R.exterior.support f
  have ha0 : a.1.1 ≠ 0 := by
    simpa only [Ideal.zero_eq_bot] using a.1.property.1
  have hsupp : Function.mulSupport (fun v : FinPlace F => v.maxPowDividing a.1.1) ⊆ s := by
    intro v hv
    simp only [Function.mem_mulSupport] at hv
    by_contra hvf
    have hva : v ∉ R.exterior.support a.1 := by
      intro h
      exact hvf (a.property.1 v h)
    apply hv
    change v.asIdeal ^ idealExp v a.1.1 = 1
    rw [rf_idealExp_zero_of_not_support R v a.1 hva, pow_zero]
  have hfac : a.1.1 = ∏ v ∈ s, v.asIdeal ^ idealExp v a.1.1 := by
    calc
      a.1.1 = ∏ᶠ v : FinPlace F, v.maxPowDividing a.1.1 :=
        (Ideal.finprod_heightOneSpectrum_factorization ha0).symm
      _ = ∏ v ∈ s, v.maxPowDividing a.1.1 :=
        finprod_eq_prod_of_mulSupport_subset _ hsupp
      _ = ∏ v ∈ s, v.asIdeal ^ idealExp v a.1.1 := rfl
  have hnorm : qI a.1.1 = ∏ v ∈ s, qI v.asIdeal ^ idealExp v a.1.1 := by
    have h := congrArg (fun I : Ideal (𝓞 F) => (Ideal.absNorm I : ℝ)) hfac
    simpa only [qI, map_prod, map_pow, Nat.cast_prod, Nat.cast_pow] using h
  have hq (v : FinPlace F) : 0 ≤ qI v.asIdeal :=
    le_trans zero_le_one (qI_prime_gt_one v).le
  have hnormPower : qI a.1.1 ^ (-σ) =
      ∏ v ∈ s, qI v.asIdeal ^ (-σ * (idealExp v a.1.1 : ℝ)) := by
    rw [hnorm]
    calc
      (∏ v ∈ s, qI v.asIdeal ^ idealExp v a.1.1) ^ (-σ) =
          ∏ v ∈ s, (qI v.asIdeal ^ idealExp v a.1.1) ^ (-σ) := by
        exact (Real.finsetProd_rpow s (fun v => qI v.asIdeal ^ idealExp v a.1.1)
          (fun v _ => pow_nonneg (hq v) _)
          (-σ)).symm
      _ = ∏ v ∈ s, qI v.asIdeal ^ (-σ * (idealExp v a.1.1 : ℝ)) := by
        apply Finset.prod_congr rfl
        intro v hv
        rw [← Real.rpow_natCast, ← Real.rpow_mul (hq v)]
        congr 1
        ring
  calc
    betaIdeal R f a.1 * qI a.1.1 ^ (-σ) =
        ∏ v ∈ s, betaPrime (qI v.asIdeal) (qI_prime_gt_one v) (idealExp v a.1.1) *
          qI v.asIdeal ^ (-σ * (idealExp v a.1.1 : ℝ)) := by
      change (∏ v ∈ s, betaPrime (qI v.asIdeal) (qI_prime_gt_one v) (idealExp v a.1.1)) *
        qI a.1.1 ^ (-σ) = _
      rw [hnormPower, Finset.prod_mul_distrib]
    _ = ∏ v : {v : FinPlace F // v ∈ R.exterior.support f},
        betaPrime (qI v.1.asIdeal) (qI_prime_gt_one v.1) (idealExp v.1 a.1.1) *
          qI v.1.asIdeal ^ (-σ * (idealExp v.1 a.1.1 : ℝ)) :=
      (Finset.prod_coe_sort s (fun v =>
        betaPrime (qI v.asIdeal) (qI_prime_gt_one v) (idealExp v a.1.1) *
          qI v.asIdeal ^ (-σ * (idealExp v a.1.1 : ℝ)))).symm

private theorem rf_active_numerator_mass
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (f : S.ExtIdeal) (σ : ℝ) (hσ : 0 ≤ σ) :
    Summable (fun a : {a : S.ExtIdeal // activeNumerator R f a} =>
      betaIdeal R f a.1 * qI a.1.1 ^ (-σ)) ∧
      (∑' a : {a : S.ExtIdeal // activeNumerator R f a},
        betaIdeal R f a.1 * qI a.1.1 ^ (-σ)) ≤ Eideal R f σ := by
  classical
  let V := {v : FinPlace F // v ∈ R.exterior.support f}
  let e : {a : S.ExtIdeal // activeNumerator R f a} → V → ℕ :=
    fun a v => idealExp v.1 a.1.1
  let w : V → ℕ → ℝ := fun v n =>
    betaPrime (qI v.1.asIdeal) (qI_prime_gt_one v.1) n *
      qI v.1.asIdeal ^ (-σ * (n : ℝ))
  let g : {a : S.ExtIdeal // activeNumerator R f a} → ℝ :=
    fun a => betaIdeal R f a.1 * qI a.1.1 ^ (-σ)
  have hinj : Function.Injective e := rf_active_exponent_injective R f
  have hw (v : V) (n : ℕ) : 0 ≤ w v n :=
    mul_nonneg (rf_betaPrime_nonneg v.1 n)
      (Real.rpow_nonneg (le_trans zero_le_one (qI_prime_gt_one v.1).le) _)
  have hlocal (v : V) : Summable (w v) :=
    ((rf_active_support_bounds R).2.2.1 v.1
      (R.exterior.support_exterior f v.1 v.2) σ hσ).1
  have hweight (a : {a : S.ExtIdeal // activeNumerator R f a}) :
      g a = ∏ v : V, w v (e a v) := rf_active_numerator_weight R f σ a
  have hg (a : {a : S.ExtIdeal // activeNumerator R f a}) : 0 ≤ g a := by
    rw [hweight]
    exact Finset.prod_nonneg (fun v _ => hw v (e a v))
  have hprod : (∏ v : V, Eprime v.1 σ) = Eideal R f σ :=
    Finset.prod_coe_sort (R.exterior.support f) (fun v => Eprime v σ)
  have hbound (t : Finset {a : S.ExtIdeal // activeNumerator R f a}) :
      (∑ a ∈ t, g a) ≤ Eideal R f σ := by
    let box : V → Finset ℕ := fun v => t.image (fun a => e a v)
    have hsub : t.image e ⊆ Fintype.piFinset box := by
      intro b hb
      obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hb
      apply Fintype.mem_piFinset.mpr
      intro v
      exact Finset.mem_image.mpr ⟨a, ha, rfl⟩
    calc
      (∑ a ∈ t, g a) = ∑ a ∈ t, ∏ v : V, w v (e a v) :=
        Finset.sum_congr rfl (fun a _ => hweight a)
      _ = ∑ b ∈ t.image e, ∏ v : V, w v (b v) :=
        (Finset.sum_image (s := t) (f := fun b : V → ℕ => ∏ v : V, w v (b v))
          (fun a _ b _ hab => hinj hab)).symm
      _ ≤ ∑ b ∈ Fintype.piFinset box, ∏ v : V, w v (b v) :=
        Finset.sum_le_sum_of_subset_of_nonneg hsub
          (fun b _ _ => Finset.prod_nonneg (fun v _ => hw v (b v)))
      _ = ∏ v : V, ∑ n ∈ box v, w v n := (Finset.prod_univ_sum box w).symm
      _ ≤ ∏ v : V, Eprime v.1 σ := by
        apply Finset.prod_le_prod₀
        · intro v hv
          exact Finset.sum_nonneg (fun n _ => hw v n)
        · intro v hv
          change (∑ n ∈ box v, w v n) ≤ ∑' n, w v n
          exact (hlocal v).sum_le_tsum (box v) (fun n _ => hw v n)
      _ = Eideal R f σ := hprod
  change Summable g ∧ (∑' a, g a) ≤ Eideal R f σ
  exact ⟨summable_of_sum_le hg hbound, Real.tsum_le_of_sum_le hg hbound⟩

private theorem rf_reflected_dirichlet_mass
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (f : S.ExtIdeal) (σ : ℝ) (hσ : 1 / 2 < σ) :
    Summable (reflectedDirichletTerm R f σ) ∧
      (∑' p, reflectedDirichletTerm R f σ p) ≤
        sphericalMajorant (S := S) σ * Eideal R f σ := by
  classical
  let aMass : {a : S.ExtIdeal // activeNumerator R f a} → ℝ := fun a =>
    betaIdeal R f a.1 * qI a.1.1 ^ (-σ)
  let cnMass : S.SqfExtIdeal × S.ExtIdeal → ℝ := fun p =>
    qI p.1.1 ^ (-1 / 2 - σ) * qI p.2.1 ^ (-1 - 3 * σ)
  have hpos (I : Ideal (𝓞 F)) (hI : I ≠ ⊥) : 0 < qI I := by
    unfold qI
    exact_mod_cast (Nat.pos_of_ne_zero (fun h => hI (Ideal.absNorm_eq_zero_iff.mp h)))
  have hnonneg (I : Ideal (𝓞 F)) : 0 ≤ qI I := by
    unfold qI
    exact Nat.cast_nonneg _
  have hsplit
      (p : {a : S.ExtIdeal // activeNumerator R f a} × S.SqfExtIdeal × S.ExtIdeal) :
      reflectedDirichletTerm R f σ p = aMass p.1 * cnMass p.2 := by
    have ha : 0 < qI p.1.1.1 := hpos p.1.1.1 p.1.1.property.1
    have hc : 0 < qI p.2.1.1 := hpos p.2.1.1 p.2.1.property.1.1
    have hn : 0 < qI p.2.2.1 := hpos p.2.2.1 p.2.2.property.1
    have hn3 : (qI p.2.2.1 ^ (3 : ℕ)) ^ (-σ) = qI p.2.2.1 ^ (-3 * σ) := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hn.le]
      congr 1
      ring
    have hpower : (qI p.1.1.1 * qI p.2.1.1 * qI p.2.2.1 ^ (3 : ℕ)) ^ (-σ) =
        qI p.1.1.1 ^ (-σ) * qI p.2.1.1 ^ (-σ) * qI p.2.2.1 ^ (-3 * σ) := by
      rw [Real.mul_rpow (mul_nonneg ha.le hc.le) (pow_nonneg hn.le 3),
        Real.mul_rpow ha.le hc.le, hn3]
    have hcAdd : qI p.2.1.1 ^ (-(1 / 2 : ℝ)) * qI p.2.1.1 ^ (-σ) =
        qI p.2.1.1 ^ (-1 / 2 - σ) := by
      rw [← Real.rpow_add hc]
      congr 1
      ring
    have hnAdd : (qI p.2.2.1)⁻¹ * qI p.2.2.1 ^ (-3 * σ) =
        qI p.2.2.1 ^ (-1 - 3 * σ) := by
      rw [← Real.rpow_neg_one, ← Real.rpow_add hn]
      congr 1
      ring
    dsimp only [reflectedDirichletTerm, aMass, cnMass]
    rw [hpower, ← hcAdd, ← hnAdd, div_eq_mul_inv]
    ring
  have haMass := rf_active_numerator_mass R f σ (by linarith : 0 ≤ σ)
  have hcnMass : Summable cnMass := ((rf_forward_assembly R).2 σ hσ).1
  have haNonneg (a : {a : S.ExtIdeal // activeNumerator R f a}) : 0 ≤ aMass a :=
    mul_nonneg (rf_betaIdeal_nonneg R f a.1) (Real.rpow_nonneg (hnonneg a.1.1) _)
  have hcnNonneg (p : S.SqfExtIdeal × S.ExtIdeal) : 0 ≤ cnMass p :=
    mul_nonneg (Real.rpow_nonneg (hnonneg p.1.1) _)
      (Real.rpow_nonneg (hnonneg p.2.1) _)
  have hprod : Summable (fun p :
      {a : S.ExtIdeal // activeNumerator R f a} × S.SqfExtIdeal × S.ExtIdeal =>
        aMass p.1 * cnMass p.2) :=
    haMass.1.mul_of_nonneg hcnMass haNonneg hcnNonneg
  have hsum : (∑' p, reflectedDirichletTerm R f σ p) =
      (∑' a, aMass a) * (∑' p, cnMass p) := by
    calc
      _ = ∑' p : {a : S.ExtIdeal // activeNumerator R f a} × S.SqfExtIdeal × S.ExtIdeal,
          aMass p.1 * cnMass p.2 := tsum_congr hsplit
      _ = (∑' a, aMass a) * (∑' p, cnMass p) :=
        (haMass.1.tsum_mul_tsum hcnMass hprod).symm
  constructor
  · exact hprod.congr (fun p => (hsplit p).symm)
  · calc
      (∑' p, reflectedDirichletTerm R f σ p) =
          (∑' a, aMass a) * (∑' p, cnMass p) := hsum
      _ ≤ Eideal R f σ * (∑' p, cnMass p) :=
        mul_le_mul_of_nonneg_right haMass.2 (tsum_nonneg hcnNonneg)
      _ = sphericalMajorant (S := S) σ * Eideal R f σ := mul_comm _ _

private theorem rf_profile_abs_analysis
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0) (u : UnitSix S) :
    (∀ x : ℝ, 0 < x → 0 ≤ profileAbs R u x) ∧
      ∀ x : ℝ, 0 < x →
        IntegrableOn (fun T : ℝ => ‖R.K T‖ * profileAbs R u (x / T) / T) (Set.Ioi 0) := by
  classical
  have hff : ∀ ℓ v, SheetHypFin v.1 R.T.δ ((R.rotated u).ff ℓ v) :=
    (R.rotated u).finite_bound
  have hfc : ∀ ℓ w, SheetHypC R.T.δ ((R.rotated u).fc ℓ w) :=
    (R.rotated u).complex_bound
  constructor
  · intro x hx
    have hInt : Integrable (onUnits (fun y => (rotatedAbs R u y : ℂ))) (R.sheets.sheet x) :=
      a2_bridge_ANALYSIS (G := R.sheets) R.T.δ R.T.δ_pos
        (R.rotated u).J (R.rotated u).ff (R.rotated u).fc hff hfc x hx
    have hRe : (∫ y, onUnits (fun y => (rotatedAbs R u y : ℂ)) y
        ∂(R.sheets.sheet x)).re =
        ∫ y, (onUnits (fun y => (rotatedAbs R u y : ℂ)) y).re ∂(R.sheets.sheet x) :=
      (integral_re hInt).symm
    unfold profileAbs sheetIntegral
    rw [hRe]
    apply integral_nonneg
    intro y
    by_cases hy : IsUnit y
    · simp only [onUnits, dif_pos hy, Complex.ofReal_re]
      unfold rotatedAbs
      apply Finset.sum_nonneg
      intro ℓ hℓ
      exact mul_nonneg (Finset.prod_nonneg (fun v _ => norm_nonneg _))
        (Finset.prod_nonneg (fun w _ => norm_nonneg _))
    · simp [onUnits, hy]
  · intro x hx
    let m : S.FSˣ → ℂ := fun _ => 1
    have hm : Theta.SheetMultiplier S (onUnits m) := by
      refine ⟨R.chars.L u, 0, (fun _ => 1), ⟨1, ?_⟩, ?_⟩
      · intro κ
        simp
      · intro y
        have hy : IsUnit (y : S.FS) := Units.isUnit y
        simp [m, onUnits, hy]
    have hKmeas : AEStronglyMeasurable R.K (volume.restrict (Set.Ioi (0 : ℝ))) :=
      R.K_smooth.continuousOn.aestronglyMeasurable measurableSet_Ioi
    exact (a2_bridge_ANALYSIS_convolution (G := R.sheets) R.T.δ R.T.δ_pos
      (R.rotated u).J (R.rotated u).ff (R.rotated u).fc hff hfc
      R.K hKmeas R.K_moments m hm x hx).1

private theorem rf_profile_absolute_series
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0) (σ : ℝ) (hσ : 1 / 2 < σ) :
    ∃ C : ℝ, 0 < C ∧
      ∀ (ι : Type) [Countable ι] (q a : ι → ℝ),
        (∀ i, 0 < q i) → (∀ i, 0 ≤ a i) →
        Summable (fun i => a i * q i ^ (-σ)) →
        ∀ u t, 0 < t →
          IntegrableOn (fun T : ℝ => ‖R.K T‖ *
            (∑' i, a i * profileAbs R u (q i / (t * T))) / T) (Set.Ioi 0) ∧
          (∫ T in Set.Ioi (0 : ℝ), ‖R.K T‖ *
            (∑' i, a i * profileAbs R u (q i / (t * T))) / T) ≤
              C * t ^ σ * Theta.absMoment R.K σ * ∑' i, a i * q i ^ (-σ) := by
  classical
  obtain ⟨C, hC, hProfile⟩ := (rf_profile_bound R).2.2 σ hσ
  refine ⟨C, hC, ?_⟩
  intro ι hι q a hq ha hsum u t ht
  let νT := volume.restrict (Set.Ioi (0 : ℝ))
  let mass : ℝ := ∑' i, a i * q i ^ (-σ)
  let f : ι → ℝ → ℝ := fun i T =>
    (‖R.K T‖ / T) * (a i * profileAbs R u (q i / (t * T)))
  let g : ℝ → ℝ := fun T =>
    ‖R.K T‖ * (∑' i, a i * profileAbs R u (q i / (t * T))) / T
  let majorant : ℝ → ℝ := fun T =>
    (C * t ^ σ * mass) * (‖R.K T‖ * T ^ σ / T)
  have hf (i : ι) : Integrable (f i) νT := by
    have hi := (rf_profile_abs_analysis R u).2 (q i / t) (div_pos (hq i) ht)
    convert hi.const_mul (a i) using 1
    funext T
    dsimp only [f]
    rw [div_div]
    ring
  have hfg : (fun T => ∑' i, f i T) = g := by
    funext T
    dsimp only [f, g]
    rw [tsum_mul_left]
    ring
  have hgMeas : AEStronglyMeasurable g νT := by
    rw [← hfg]
    exact AEStronglyMeasurable.tsum (fun i => (hf i).aestronglyMeasurable)
  have hdom (T : ℝ) (hT : 0 < T) : 0 ≤ g T ∧ g T ≤ majorant T := by
    have harg (i : ι) : 0 < q i / (t * T) := div_pos (hq i) (mul_pos ht hT)
    have hpow (i : ι) : (q i / (t * T)) ^ (-σ) =
        t ^ σ * T ^ σ * q i ^ (-σ) := by
      rw [Real.div_rpow (hq i).le (mul_pos ht hT).le,
        Real.mul_rpow ht.le hT.le, Real.rpow_neg ht.le σ, Real.rpow_neg hT.le σ]
      simp only [div_eq_mul_inv, mul_inv_rev, inv_inv]
      ring
    let b : ι → ℝ := fun i => (C * t ^ σ * T ^ σ) * (a i * q i ^ (-σ))
    have hb : Summable b := hsum.mul_left (C * t ^ σ * T ^ σ)
    have hnonneg (i : ι) : 0 ≤ a i * profileAbs R u (q i / (t * T)) :=
      mul_nonneg (ha i) ((rf_profile_abs_analysis R u).1 _ (harg i))
    have hle (i : ι) : a i * profileAbs R u (q i / (t * T)) ≤ b i := by
      calc
        _ ≤ a i * (C * (q i / (t * T)) ^ (-σ)) :=
          mul_le_mul_of_nonneg_left (hProfile u _ (harg i)) (ha i)
        _ = b i := by rw [hpow]; dsimp only [b]; ring
    have hseries : Summable (fun i => a i * profileAbs R u (q i / (t * T))) :=
      Summable.of_nonneg_of_le hnonneg hle hb
    have hmass : (∑' i, a i * profileAbs R u (q i / (t * T))) ≤
        C * t ^ σ * T ^ σ * mass := by
      calc
        _ ≤ ∑' i, b i := hseries.tsum_le_tsum hle hb
        _ = C * t ^ σ * T ^ σ * mass := by dsimp only [b, mass]; rw [tsum_mul_left]
    have hkernel : 0 ≤ ‖R.K T‖ / T := div_nonneg (norm_nonneg _) hT.le
    constructor
    · dsimp only [g]
      exact div_nonneg (mul_nonneg (norm_nonneg _) (tsum_nonneg hnonneg)) hT.le
    · calc
        g T = (‖R.K T‖ / T) * (∑' i, a i * profileAbs R u (q i / (t * T))) := by
          dsimp only [g]
          ring
        _ ≤ (‖R.K T‖ / T) * (C * t ^ σ * T ^ σ * mass) :=
          mul_le_mul_of_nonneg_left hmass hkernel
        _ = majorant T := by dsimp only [majorant]; ring
  have hmajorant : Integrable majorant νT :=
    (R.K_moments σ).const_mul (C * t ^ σ * mass)
  have hg : Integrable g νT := by
    apply hmajorant.mono' hgMeas
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with T hT
    rw [Real.norm_eq_abs, abs_of_nonneg (hdom T hT).1]
    exact (hdom T hT).2
  refine ⟨hg, ?_⟩
  change (∫ T, g T ∂νT) ≤ C * t ^ σ * Theta.absMoment R.K σ * mass
  calc
    _ ≤ ∫ T, majorant T ∂νT := by
      apply integral_mono_ae hg hmajorant
      filter_upwards [ae_restrict_mem measurableSet_Ioi] with T hT
      exact (hdom T hT).2
    _ = C * t ^ σ * Theta.absMoment R.K σ * mass := by
      dsimp only [majorant, νT]
      rw [integral_const_mul]
      unfold Theta.absMoment
      ring

/-- rf:grouped-absolute, 04:659-706. Absolute sums and the averaged integral use the same majorant. -/
theorem rf_grouped_absolute : ∀ σ : ℝ, 1 / 2 < σ → ∃ C : ℝ, 0 < C ∧ ∀ f,
  Summable (reflectedDirichletTerm R f σ) ∧
  (∑' p, reflectedDirichletTerm R f σ p) ≤
    sphericalMajorant (S := S) σ * Eideal R f σ ∧
  ∀ u t, 0 < t →
    IntegrableOn (fun T : ℝ => ‖R.K T‖ *
      (∑' p : {a : S.ExtIdeal // activeNumerator R f a} × S.SqfExtIdeal × S.ExtIdeal,
        betaIdeal R f p.1 * qI p.2.1.1 ^ (-(1 / 2 : ℝ)) / qI p.2.2.1 *
          profileAbs R u (qI p.1.1.1 * qI p.2.1.1 * qI p.2.2.1 ^ 3 / (t * T))) / T) (Set.Ioi 0) ∧
    (∫ T in Set.Ioi (0 : ℝ), ‖R.K T‖ *
      (∑' p : {a : S.ExtIdeal // activeNumerator R f a} × S.SqfExtIdeal × S.ExtIdeal,
        betaIdeal R f p.1 * qI p.2.1.1 ^ (-(1 / 2 : ℝ)) / qI p.2.2.1 *
          profileAbs R u (qI p.1.1.1 * qI p.2.1.1 * qI p.2.2.1 ^ 3 / (t * T))) / T) ≤
      C * t ^ σ * Theta.absMoment R.K σ * ∑' p, reflectedDirichletTerm R f σ p := by
  classical
  intro σ hσ
  obtain ⟨C, hC, hSeries⟩ := rf_profile_absolute_series R σ hσ
  refine ⟨C, hC, ?_⟩
  intro f
  have hmass := rf_reflected_dirichlet_mass R f σ hσ
  refine ⟨hmass.1, hmass.2, ?_⟩
  letI : Countable F := Finsupp.Countable.of_moduleFinite (R := ℚ)
  letI : Countable (𝓞 F) := inferInstance
  have hspan : Function.Surjective
      (fun s : Finset (𝓞 F) => Ideal.span (s : Set (𝓞 F))) := by
    intro I
    exact Ideal.fg_of_isNoetherianRing I
  letI : Countable (Ideal (𝓞 F)) := hspan.countable
  letI : Countable S.ExtIdeal :=
    inferInstanceAs (Countable {I : Ideal (𝓞 F) // S.IsExterior I})
  letI : Countable S.SqfExtIdeal :=
    inferInstanceAs (Countable {I : Ideal (𝓞 F) // S.IsExterior I ∧ Squarefree I})
  let ι := {a : S.ExtIdeal // activeNumerator R f a} × S.SqfExtIdeal × S.ExtIdeal
  letI : Countable ι := inferInstance
  let Q : ι → ℝ := fun p => qI p.1.1.1 * qI p.2.1.1 * qI p.2.2.1 ^ 3
  let w : ι → ℝ := fun p =>
    betaIdeal R f p.1 * qI p.2.1.1 ^ (-(1 / 2 : ℝ)) / qI p.2.2.1
  have hpos (I : Ideal (𝓞 F)) (hI : I ≠ ⊥) : 0 < qI I := by
    unfold qI
    exact_mod_cast (Nat.pos_of_ne_zero (fun h => hI (Ideal.absNorm_eq_zero_iff.mp h)))
  have hQ (p : ι) : 0 < Q p := by
    exact mul_pos (mul_pos (hpos p.1.1.1 p.1.1.property.1)
      (hpos p.2.1.1 p.2.1.property.1.1))
      (pow_pos (hpos p.2.2.1 p.2.2.property.1) 3)
  have hw (p : ι) : 0 ≤ w p := by
    exact div_nonneg (mul_nonneg (rf_betaIdeal_nonneg R f p.1)
      (Real.rpow_nonneg (hpos p.2.1.1 p.2.1.property.1.1).le _))
      (hpos p.2.2.1 p.2.2.property.1).le
  have hWeighted : (fun p => w p * Q p ^ (-σ)) = reflectedDirichletTerm R f σ := rfl
  have hs : Summable (fun p => w p * Q p ^ (-σ)) := by
    rw [hWeighted]
    exact hmass.1
  intro u t ht
  exact hSeries ι Q w hQ hw hs u t ht
/-- A single summand of the full reflected expansion; no conclusion is used in this definition. -/
def reflectedTerm (υ : UnitSix S) (h d : S.ExtIdeal) (Z : ℝ)
    (p : FrozenIndex R h × Bd.B × Bd.B × S.SqfExtIdeal) : ℂ :=
  let t := p.1
  let sd := p.2.1
  let sc := p.2.2.1
  let c := p.2.2.2
  frozenOmega R υ t * frozenRho R υ t sd d * frozenLambda R υ t sc c *
    (qI c.1 ^ (-(1 / 2 : ℝ)) / qI t.n.1 : ℝ) * chiIdealPow D d.1 (cgen R c) 3 *
    profilePhi R υ (kappaSix R t sd sc)
      (Z * qI t.a.1 * qI c.1 * qI t.n.1 ^ 3 / (qI d.1 ^ 2 * qI t.f.1 ^ 2))

private theorem rf_pairing_frequency_norm_class
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (h : S.ExtIdeal) (t : FrozenIndex R h) (d : S.ExtIdeal)
    (c : S.SqfExtIdeal) (sd sc : Bd.B)
    (hsd : cls (S.diagU (bc.gen d)) = sd.1)
    (hsc : cls (S.diagU (bc.gen (R.exterior.ofSqf c))) = sc.1) :
    S.absS (S.diagU (frozenFrequency R t d c) : S.FS) =
      qI t.a.1 * qI c.1 * qI t.n.1 ^ 3 / (qI d.1 ^ 2 * qI t.f.1 ^ 2) ∧
    cls (S.diagU (frozenFrequency R t d c)) = kappaSix R t sd sc := by
  constructor
  · have hbridge := a2_bridge_NORM D S
    have hmul (x y : S.FSˣ) :
        S.absS ((x * y : S.FSˣ) : S.FS) =
          S.absS (x : S.FS) * S.absS (y : S.FS) := by
      exact hbridge.2.1 (x : S.FS) (y : S.FS)
    have hdiv (x y : S.FSˣ) :
        S.absS ((x / y : S.FSˣ) : S.FS) =
          S.absS (x : S.FS) / S.absS (y : S.FS) := hbridge.2.2.2.2.1 x y
    have hpow2 (x : S.FSˣ) :
        S.absS ((x ^ 2 : S.FSˣ) : S.FS) = S.absS (x : S.FS) ^ 2 := by
      simpa [pow_succ] using hmul x x
    have hpow3 (x : S.FSˣ) :
        S.absS ((x ^ 3 : S.FSˣ) : S.FS) = S.absS (x : S.FS) ^ 3 := by
      calc
        S.absS ((x ^ 3 : S.FSˣ) : S.FS) =
            S.absS ((x ^ (3 : ℤ) : S.FSˣ) : S.FS) := by
          exact (congrArg (fun z : S.FSˣ => S.absS (z : S.FS))
            (zpow_natCast x 3)).symm
        _ = S.absS (x : S.FS) ^ (3 : ℤ) := hbridge.2.2.2.2.2 x (3 : ℤ)
        _ = S.absS (x : S.FS) ^ 3 := rfl
    have heps : S.absS (S.diagU (R.sheets.eps t.u) : S.FS) = 1 :=
      hbridge.2.2.2.1 (R.sheets.eps t.u)
    have ha := a2_bridge_NORM_gen D S H Bd bc t.a
    have hc := a2_bridge_NORM_gen D S H Bd bc (R.exterior.ofSqf c)
    have hn := a2_bridge_NORM_gen D S H Bd bc t.n
    have hd := a2_bridge_NORM_gen D S H Bd bc d
    have hf := a2_bridge_NORM_gen D S H Bd bc t.f
    change S.absS (S.diagU (frozenFrequency R t d c) : S.FS) = _
    simp only [frozenFrequency, map_div, map_mul, map_pow]
    simp only [hdiv, hmul, hpow2, hpow3]
    rw [heps, ha, hc, hn, hd, hf]
    simp only [idealNorm, qI, R.exterior.ofSqf_val]
    ring
  · simp only [frozenFrequency, kappaSix, map_div, map_mul, map_pow]
    dsimp only [cls] at hsd hsc ⊢
    simp only [QuotientGroup.mk_div, QuotientGroup.mk_mul, QuotientGroup.mk_pow] at *
    rw [hsd, hsc]
    have hden (x y : S.V) : ((x * y) ^ 2)⁻¹ = x ^ (-2 : ℤ) * y ^ (-2 : ℤ) := by
      calc
        ((x * y) ^ 2)⁻¹ = (x * y) ^ (-2 : ℤ) := by
          rw [show (-2 : ℤ) = Int.negSucc 1 by rfl, zpow_negSucc]
        _ = x ^ (-2 : ℤ) * y ^ (-2 : ℤ) := mul_zpow x y (-2 : ℤ)
    rw [div_eq_mul_inv, hden]
    let pref : S.V := cls (S.diagU (R.sheets.eps t.u)) *
      cls (S.diagU (bc.gen t.a)) * sc.1 * cls (S.diagU (bc.gen t.n)) ^ 3
    change pref * (sd.1 ^ (-2 : ℤ) * cls (S.diagU (bc.gen t.f)) ^ (-2 : ℤ)) =
      (pref * sd.1 ^ (-2 : ℤ)) * cls (S.diagU (bc.gen t.f)) ^ (-2 : ℤ)
    exact (mul_assoc pref (sd.1 ^ (-2 : ℤ))
      (cls (S.diagU (bc.gen t.f)) ^ (-2 : ℤ))).symm

private theorem rf_pairing_S_averaged
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (u : UnitSix S) (ν : Fˣ) (Z : ℝ) (hZ : 0 < Z) :
    let g : ℝ → ℂ := fun T => R.K T *
      (∑' γ : Gamma S, omegaInt R (T / Z) (fun y =>
        bCut (Bd := Bd) y * (Lvalue R u y)⁻¹ *
          sCocycle (D := D) (H := H) (S.diagU ((γ.1 : Fˣ) * ν)) y⁻¹ *
            rotated R u (S.diagU ((γ.1 : Fˣ) * ν) / y))) / (T : ℂ)
    IntegrableOn g (Set.Ioi 0) ∧
      (∫ T in Set.Ioi (0 : ℝ), g T) =
        (Lvalue R u (S.diagU ν))⁻¹ *
          profilePhi R u (cls (S.diagU ν)) (Z * S.absS (S.diagU ν : S.FS)) := by
  let κ : S.V := cls (S.diagU ν)
  let m : S.FSˣ → ℂ := fun y =>
    (if κ * (cls y)⁻¹ ∈ Bd.B then 1 else 0) *
      R.pairing.pair κ (cls y) ^ 2 * Lvalue R u y
  let b : S.V → ℂ := fun x =>
    (if κ * x⁻¹ ∈ Bd.B then 1 else 0) * R.pairing.pair κ x ^ 2
  have hb : ∀ x, ‖b x‖ ≤ 1 := by
    intro x
    by_cases hx : κ * x⁻¹ ∈ Bd.B <;> simp [b, hx, R.pairing.unitary κ x]
  have hm : Theta.SheetMultiplier S (onUnits m) := by
    refine ⟨R.chars.L u, 1, b, ⟨1, hb⟩, ?_⟩
    intro y
    have hunit : IsUnit (y : S.FS) := Units.isUnit y
    have hunit_eq : hunit.unit = y := by
      apply Units.ext
      exact hunit.unit_spec
    change (if h : IsUnit (y : S.FS) then m h.unit else 0) =
      (((R.chars.L u).L y : ℂˣ) : ℂ) ^ (1 : ℤ) * b (cls y)
    rw [dif_pos hunit, hunit_eq]
    by_cases hy : κ * (cls y)⁻¹ ∈ Bd.B
    · simp [m, b, Lvalue, hy, mul_comm, mul_left_comm]
    · simp [m, b, Lvalue, hy]
  have hprofile (ℓ : Fin (R.rotated u).J) (x : ℝ) :
      profileH R u κ ℓ x =
        bridgeProfileH R.sheets m (R.rotated u).J (R.rotated u).ff (R.rotated u).fc ℓ x := by
    rfl
  have hKmeas : AEStronglyMeasurable R.K (volume.restrict (Set.Ioi (0 : ℝ))) :=
    R.K_smooth.continuousOn.aestronglyMeasurable measurableSet_Ioi
  have hff : ∀ ℓ v, SheetHypFin v.1 R.T.δ ((R.rotated u).ff ℓ v) :=
    (R.rotated u).finite_bound
  have hfc : ∀ ℓ w, SheetHypC R.T.δ ((R.rotated u).fc ℓ w) :=
    (R.rotated u).complex_bound
  have hconv := a2_bridge_ANALYSIS_convolution (G := R.sheets) R.T.δ R.T.δ_pos
    (R.rotated u).J (R.rotated u).ff (R.rotated u).fc hff hfc R.K hKmeas
    R.K_moments m hm
  have hnormν : 0 < S.absS (S.diagU ν : S.FS) :=
    (a2_bridge_NORM D S).2.2.1 (S.diagU ν)
  let x : ℝ := Z * S.absS (S.diagU ν : S.FS)
  have hx : 0 < x := mul_pos hZ hnormν
  have hprofInt (ℓ : Fin (R.rotated u).J) :
      IntegrableOn (fun T : ℝ =>
        R.K T * profileH R u κ ℓ (x / T) / (T : ℂ)) (Set.Ioi 0) := by
    simpa only [← hprofile] using (hconv x hx).2.2 ℓ
  have hpoint (T : ℝ) (hT : 0 < T) :
      (∑' γ : Gamma S, omegaInt R (T / Z) (fun y => bCut (Bd := Bd) y *
        (Lvalue R u y)⁻¹ *
          sCocycle (D := D) (H := H) (S.diagU ((γ.1 : Fˣ) * ν)) y⁻¹ *
            rotated R u (S.diagU ((γ.1 : Fˣ) * ν) / y))) =
        (Lvalue R u (S.diagU ν))⁻¹ *
          ∑ ℓ : Fin (R.rotated u).J, profileH R u κ ℓ (x / T) := by
    have hu := rf_S_unfolding R u ν (T / Z) (div_pos hT hZ)
    have harg : S.absS (S.diagU ν : S.FS) / (T / Z) = x / T := by
      dsimp [x]
      field_simp [ne_of_gt hT, ne_of_gt hZ]
    simpa only [harg] using hu.2
  have hcongr :
      (fun T : ℝ => R.K T *
        (∑' γ : Gamma S, omegaInt R (T / Z) (fun y => bCut (Bd := Bd) y *
          (Lvalue R u y)⁻¹ *
            sCocycle (D := D) (H := H) (S.diagU ((γ.1 : Fˣ) * ν)) y⁻¹ *
              rotated R u (S.diagU ((γ.1 : Fˣ) * ν) / y))) / (T : ℂ)) =ᵐ[
        volume.restrict (Set.Ioi (0 : ℝ))]
      fun T => (Lvalue R u (S.diagU ν))⁻¹ *
        ∑ ℓ : Fin (R.rotated u).J,
          R.K T * profileH R u κ ℓ (x / T) / (T : ℂ) := by
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with T hT
    calc
      _ = (Lvalue R u (S.diagU ν))⁻¹ *
          ((R.K T / (T : ℂ)) *
            ∑ ℓ : Fin (R.rotated u).J, profileH R u κ ℓ (x / T)) := by
        rw [hpoint T hT]
        ring
      _ = (Lvalue R u (S.diagU ν))⁻¹ *
          ∑ ℓ : Fin (R.rotated u).J,
            R.K T * profileH R u κ ℓ (x / T) / (T : ℂ) := by
        rw [Finset.mul_sum]
        apply congrArg (fun z : ℂ => (Lvalue R u (S.diagU ν))⁻¹ * z)
        apply Finset.sum_congr rfl
        intro ℓ hℓ
        ring
  have hsumInt : IntegrableOn (fun T : ℝ =>
      ∑ ℓ : Fin (R.rotated u).J,
        R.K T * profileH R u κ ℓ (x / T) / (T : ℂ)) (Set.Ioi 0) :=
    integrable_finsetSum Finset.univ (fun ℓ _ => hprofInt ℓ)
  refine ⟨(hsumInt.const_mul (Lvalue R u (S.diagU ν))⁻¹).congr hcongr.symm, ?_⟩

  calc
    (∫ T in Set.Ioi (0 : ℝ), R.K T *
        (∑' γ : Gamma S, omegaInt R (T / Z) (fun y => bCut (Bd := Bd) y *
          (Lvalue R u y)⁻¹ *
            sCocycle (D := D) (H := H) (S.diagU ((γ.1 : Fˣ) * ν)) y⁻¹ *
              rotated R u (S.diagU ((γ.1 : Fˣ) * ν) / y))) / (T : ℂ)) =
        ∫ T in Set.Ioi (0 : ℝ), (Lvalue R u (S.diagU ν))⁻¹ *
          ∑ ℓ : Fin (R.rotated u).J,
            R.K T * profileH R u κ ℓ (x / T) / (T : ℂ) := by
      exact integral_congr_ae hcongr
    _ = (Lvalue R u (S.diagU ν))⁻¹ *
        ∑ ℓ : Fin (R.rotated u).J,
          ∫ T in Set.Ioi (0 : ℝ),
            R.K T * profileH R u κ ℓ (x / T) / (T : ℂ) := by
      rw [integral_const_mul, integral_finsetSum]
      intro ℓ hℓ
      exact hprofInt ℓ
    _ = (Lvalue R u (S.diagU ν))⁻¹ * profilePhi R u κ x := by
      simp [profilePhi, profilePhiTerm]

private theorem rf_pairing_activeFactor_finite
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0) (h : S.ExtIdeal) :
    Set.Finite {f : S.ExtIdeal | activeFactor R h f} := by
  classical
  have hfactor (f : S.ExtIdeal) (hf : activeFactor R h f) :
      f.1 = ∏ v ∈ R.exterior.support f, v.asIdeal := by
    let c : S.SqfExtIdeal := ⟨f.1, f.property, hf.1⟩
    have hof : R.exterior.ofSqf c = f :=
      Subtype.ext (R.exterior.ofSqf_val c)
    simpa only [hof] using rf_sqfIdeal_factorization R c
  have hmap : Set.MapsTo R.exterior.support {f : S.ExtIdeal | activeFactor R h f}
      (↑(R.exterior.support h).powerset : Set (Finset (FinPlace F))) := by
    intro f hf
    exact Finset.mem_powerset.mpr hf.2.1
  have hinj : Set.InjOn R.exterior.support {f : S.ExtIdeal | activeFactor R h f} := by
    intro f hf g hg hs
    apply Subtype.ext
    rw [hfactor f hf, hfactor g hg, hs]
  exact Set.Finite.of_injOn hmap hinj (R.exterior.support h).powerset.finite_toSet

private theorem rf_pairing_profile_inverse_bound
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0) :
    ∃ C : ℝ, 0 < C ∧ ∀ u κ x, 0 < x →
      ‖profilePhi R u κ x‖ ≤ C * x ^ (-1 : ℝ) := by
  obtain ⟨α, hα, hDecay⟩ := (rf_profile_bound R).2.1
  obtain ⟨C, hC, hBound⟩ := hDecay 1 (by norm_num) 0
  refine ⟨C, hC, ?_⟩
  intro u κ x hx
  have hzero : Theta.normDerivR 0 (profilePhi R u κ) x = profilePhi R u κ x := by
    simp only [Theta.normDerivR, iteratedDeriv_zero, Real.exp_log hx]
  calc
    ‖profilePhi R u κ x‖ ≤ C * min (x ^ α) (x ^ (-1 : ℝ)) := by
      simpa only [hzero] using hBound u κ x hx
    _ ≤ C * x ^ (-1 : ℝ) := mul_le_mul_of_nonneg_left (min_le_right _ _) hC.le

private theorem rf_pairing_reflectedTerm_majorant
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0) :
    ∃ C : ℝ, 0 < C ∧ ∀ υ h (t : FrozenIndex R h) sd sc d c Z, 0 < Z →
      ‖reflectedTerm R υ h d Z (t, sd, sc, c)‖ ≤
        C * (qI d.1 ^ 2 * qI t.f.1 ^ 2 / Z) *
          reflectedDirichletTerm R t.f 1 (⟨t.a, t.numerator⟩, c, t.n) := by
  obtain ⟨C, hC, hProfile⟩ := rf_pairing_profile_inverse_bound R
  refine ⟨C, hC, ?_⟩
  intro υ h t sd sc d c Z hZ
  have hpos (I : Ideal (𝓞 F)) (hI : I ≠ ⊥) : 0 < qI I := by
    unfold qI
    exact_mod_cast (Nat.pos_of_ne_zero (fun h => hI (Ideal.absNorm_eq_zero_iff.mp h)))
  have ha := hpos t.a.1 t.a.property.1
  have hc := hpos c.1 c.property.1.1
  have hn := hpos t.n.1 t.n.property.1
  have hd := hpos d.1 d.property.1
  have hf := hpos t.f.1 t.f.property.1
  let w0 : ℝ := qI c.1 ^ (-(1 / 2 : ℝ)) / qI t.n.1
  let X : ℝ := Z * qI t.a.1 * qI c.1 * qI t.n.1 ^ 3 /
    (qI d.1 ^ 2 * qI t.f.1 ^ 2)
  let Q : ℝ := qI t.a.1 * qI c.1 * qI t.n.1 ^ 3
  let scale : ℝ := qI d.1 ^ 2 * qI t.f.1 ^ 2 / Z
  let coeff : ℂ := frozenOmega R υ t * frozenRho R υ t sd d *
    frozenLambda R υ t sc c * (w0 : ℂ) * chiIdealPow D d.1 (cgen R c) 3
  have hw0 : 0 ≤ w0 := div_nonneg (Real.rpow_nonneg hc.le _) hn.le
  have hX : 0 < X := div_pos
    (mul_pos (mul_pos (mul_pos hZ ha) hc) (pow_pos hn 3))
    (mul_pos (pow_pos hd 2) (pow_pos hf 2))
  have hβ : 0 ≤ betaIdeal R t.f t.a := rf_betaIdeal_nonneg R t.f t.a
  have hcoeff : ‖coeff‖ ≤ betaIdeal R t.f t.a * w0 := by
    have hb := (rf_exterior_factorization R).1 υ h t
    have hχ := (a2_bridge_SYMBOL D S).ideal_norm_le d.1 (cgen R c) 3
    calc
      ‖coeff‖ = ‖frozenOmega R υ t‖ * ‖frozenRho R υ t sd d‖ *
          ‖frozenLambda R υ t sc c‖ * w0 * ‖chiIdealPow D d.1 (cgen R c) 3‖ := by
        simp only [coeff, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hw0]
      _ ≤ betaIdeal R t.f t.a * 1 * 1 * w0 * 1 := by
        gcongr
        · exact hb.1
        · exact hb.2.1 sd d
        · exact hb.2.2 sc c
      _ = betaIdeal R t.f t.a * w0 := by ring
  have hpower : X ^ (-1 : ℝ) = scale * Q ^ (-1 : ℝ) := by
    dsimp only [X, scale, Q]
    simp only [Real.rpow_neg_one, div_eq_mul_inv, mul_inv_rev, inv_inv]
    ring
  calc
    ‖reflectedTerm R υ h d Z (t, sd, sc, c)‖ =
        ‖coeff‖ * ‖profilePhi R υ (kappaSix R t sd sc) X‖ := by
      change ‖coeff * profilePhi R υ (kappaSix R t sd sc) X‖ = _
      exact norm_mul _ _
    _ ≤ ‖coeff‖ * (C * X ^ (-1 : ℝ)) :=
      mul_le_mul_of_nonneg_left (hProfile υ (kappaSix R t sd sc) X hX) (norm_nonneg _)
    _ ≤ (betaIdeal R t.f t.a * w0) * (C * X ^ (-1 : ℝ)) :=
      mul_le_mul_of_nonneg_right hcoeff (mul_nonneg hC.le (Real.rpow_nonneg hX.le _))
    _ = C * (qI d.1 ^ 2 * qI t.f.1 ^ 2 / Z) *
        reflectedDirichletTerm R t.f 1 (⟨t.a, t.numerator⟩, c, t.n) := by
      rw [hpower]
      dsimp only [reflectedDirichletTerm, w0, scale, Q]
      ring

private theorem rf_reflected_row_summable
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (r : ReflectionRow S) (Z : ℝ) (hZ : 0 < Z) :
    Summable (fun p => ‖reflectedTerm R (rowClass R r) r.h r.d Z p‖) := by
  classical
  obtain ⟨C, hC, hTerm⟩ := rf_pairing_reflectedTerm_majorant R
  letI : Fintype (UnitSix S) := R.sheets.unitSixFinite
  letI : Fintype S.V := R.sheets.classFinite
  let AF := {f : S.ExtIdeal // activeFactor R r.h f}
  letI : Fintype AF := (rf_pairing_activeFactor_finite R r.h).fintype
  let J (f : AF) := (UnitSix S × Bd.B × Bd.B) ×
    ({a : S.ExtIdeal // activeNumerator R f.1 a} × S.SqfExtIdeal × S.ExtIdeal)
  let I := Σ f : AF, J f
  let e : (FrozenIndex R r.h × Bd.B × Bd.B × S.SqfExtIdeal) → I := fun p =>
    ⟨⟨p.1.f, p.1.active⟩,
      ((p.1.u, p.2.1, p.2.2.1), (⟨p.1.a, p.1.numerator⟩, p.2.2.2, p.1.n))⟩
  let M : I → ℝ := fun p =>
    C * (qI r.d.1 ^ 2 * qI p.1.1.1 ^ 2 / Z) *
      reflectedDirichletTerm R p.1.1 1 p.2.2
  have he : Function.Injective e := by
    intro p q hpq
    have hf : p.1.f = q.1.f := congrArg (fun z : I => z.1.1) hpq
    have ha : p.1.a = q.1.a := congrArg (fun z : I => z.2.2.1.1) hpq
    have hn : p.1.n = q.1.n := congrArg (fun z : I => z.2.2.2.2) hpq
    have hu : p.1.u = q.1.u := congrArg (fun z : I => z.2.1.1) hpq
    have hsd : p.2.1 = q.2.1 := congrArg (fun z : I => z.2.1.2.1) hpq
    have hsc : p.2.2.1 = q.2.2.1 := congrArg (fun z : I => z.2.1.2.2) hpq
    have hc : p.2.2.2 = q.2.2.2 := congrArg (fun z : I => z.2.2.2.1) hpq
    rcases p with ⟨⟨pf, pa, pn, pu, pactive, pnum, pcop⟩, psd, psc, pc⟩
    rcases q with ⟨⟨qf, qa, qn, qu, qactive, qnum, qcop⟩, qsd, qsc, qc⟩
    dsimp only at hf ha hn hu hsd hsc hc
    cases hf
    cases ha
    cases hn
    cases hu
    cases hsd
    cases hsc
    cases hc
    rfl
  have hq (I : Ideal (𝓞 F)) : 0 ≤ qI I := by
    unfold qI
    exact Nat.cast_nonneg _
  have hw (f : S.ExtIdeal)
      (p : {a : S.ExtIdeal // activeNumerator R f a} × S.SqfExtIdeal × S.ExtIdeal) :
      0 ≤ reflectedDirichletTerm R f 1 p := by
    unfold reflectedDirichletTerm
    exact mul_nonneg
      (div_nonneg
        (mul_nonneg (rf_betaIdeal_nonneg R f p.1) (Real.rpow_nonneg (hq p.2.1.1) _))
        (hq p.2.2.1))
      (Real.rpow_nonneg
        (mul_nonneg (mul_nonneg (hq p.1.1.1) (hq p.2.1.1))
          (pow_nonneg (hq p.2.2.1) 3)) _)
  have hMnonneg (p : I) : 0 ≤ M p :=
    mul_nonneg
      (mul_nonneg hC.le
        (div_nonneg (mul_nonneg (sq_nonneg _) (sq_nonneg _)) hZ.le))
      (hw p.1.1 p.2.2)
  have hfiber (f : AF) : Summable (fun q : J f => M ⟨f, q⟩) := by
    apply (summable_prod_of_nonneg (fun q : J f => hMnonneg ⟨f, q⟩)).2
    refine ⟨?_, Summable.of_finite⟩
    intro k
    exact (rf_reflected_dirichlet_mass R f.1 1 (by norm_num)).1.mul_left
      (C * (qI r.d.1 ^ 2 * qI f.1.1 ^ 2 / Z))
  have hM : Summable M :=
    (summable_sigma_of_nonneg hMnonneg).2 ⟨hfiber, Summable.of_finite⟩
  apply Summable.of_nonneg_of_le (fun p => norm_nonneg _) ?_ (hM.comp_injective he)
  intro p
  exact hTerm (rowClass R r) r.h p.1 p.2.1 p.2.2.1 r.d p.2.2.2 Z hZ

private theorem rf_pairing_unit_orbit
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (h : S.ExtIdeal) (t : FrozenIndex R h) (d : S.ExtIdeal)
    (c : S.SqfExtIdeal) (ν : Fˣ)
    (hdecomp : ∃ ε : S.US,
      ν = (ε : Fˣ) * bc.gen t.a * bc.gen (R.exterior.ofSqf c) * bc.gen t.n ^ 3 /
        (bc.gen d * bc.gen t.f) ^ 2) :
    ∃! ug : UnitSix S × Gamma S,
      ν = (ug.2.1 : Fˣ) * (R.sheets.eps ug.1 : Fˣ) *
        bc.gen t.a * bc.gen (R.exterior.ofSqf c) * bc.gen t.n ^ 3 /
          (bc.gen d * bc.gen t.f) ^ 2 := by
  rcases hdecomp with ⟨ε, hν⟩
  let u : UnitSix S := unitSixClass S ε
  have hepsClass : unitSixClass S (R.sheets.eps u) = unitSixClass S ε := by
    simpa [u] using R.sheets.eps_class u
  have hclass : unitSixClass S ε = unitSixClass S (R.sheets.eps u) :=
    hepsClass.symm
  have hmem : ε / R.sheets.eps u ∈ Gamma S :=
    (QuotientGroup.eq_iff_div_mem).mp (by simpa [unitSixClass] using hclass)
  let γ : Gamma S := ⟨ε / R.sheets.eps u, hmem⟩
  have hεUS : ε = γ.1 * R.sheets.eps u := by
    dsimp [γ]
    exact (div_mul_cancel _ _).symm
  have hεF : (ε : Fˣ) = (γ.1 : Fˣ) * (R.sheets.eps u : Fˣ) :=
    congrArg (fun x : S.US => (x : Fˣ)) hεUS
  let tail : Fˣ :=
    (bc.gen t.a * bc.gen (R.exterior.ofSqf c) * bc.gen t.n ^ 3) /
      (bc.gen d * bc.gen t.f) ^ 2
  have hνtail : ν = (ε : Fˣ) * tail := by
    calc
      ν = ((ε : Fˣ) * bc.gen t.a * bc.gen (R.exterior.ofSqf c) *
          bc.gen t.n ^ 3) / (bc.gen d * bc.gen t.f) ^ 2 := hν
      _ = (ε : Fˣ) * tail := by
        dsimp [tail]
        rw [show (ε : Fˣ) * bc.gen t.a * bc.gen (R.exterior.ofSqf c) *
            bc.gen t.n ^ 3 = (ε : Fˣ) *
              (bc.gen t.a * bc.gen (R.exterior.ofSqf c) * bc.gen t.n ^ 3) by group]
        exact mul_div_assoc _ _ _
  refine ⟨(u, γ), ?_, ?_⟩
  · rw [hν]
    rw [hεF]
  · intro ug' hEq
    rcases ug' with ⟨u', γ'⟩
    have hEqTail : ν = ((γ'.1 : Fˣ) * (R.sheets.eps u' : Fˣ)) * tail := by
      calc
        ν = ((γ'.1 : Fˣ) * (R.sheets.eps u' : Fˣ) * bc.gen t.a *
            bc.gen (R.exterior.ofSqf c) * bc.gen t.n ^ 3) /
            (bc.gen d * bc.gen t.f) ^ 2 := hEq
        _ = ((γ'.1 : Fˣ) * (R.sheets.eps u' : Fˣ)) * tail := by
          dsimp [tail]
          rw [show (γ'.1 : Fˣ) * (R.sheets.eps u' : Fˣ) * bc.gen t.a *
              bc.gen (R.exterior.ofSqf c) * bc.gen t.n ^ 3 =
                ((γ'.1 : Fˣ) * (R.sheets.eps u' : Fˣ)) *
                  (bc.gen t.a * bc.gen (R.exterior.ofSqf c) * bc.gen t.n ^ 3) by group]
          exact mul_div_assoc _ _ _
    have hεeqF : (ε : Fˣ) = (γ'.1 : Fˣ) * (R.sheets.eps u' : Fˣ) :=
      mul_right_cancel (hνtail.symm.trans hEqTail)
    have hεeqUS : ε = γ'.1 * R.sheets.eps u' := by
      exact Subtype.ext hεeqF
    have hratio : ε / R.sheets.eps u' = γ'.1 := by
      rw [hεeqUS]
      simp
    have hclass' : unitSixClass S ε = unitSixClass S (R.sheets.eps u') := by
      apply (QuotientGroup.eq_iff_div_mem).2
      rw [hratio]
      exact γ'.property
    have hu' : u' = u := by
      dsimp [u]
      exact (hclass'.trans (R.sheets.eps_class u')).symm
    have hεeqUS' : ε = γ'.1 * R.sheets.eps u := by
      simpa [hu'] using hεeqUS
    have hγ : γ.1 = γ'.1 := mul_right_cancel (hεUS.symm.trans hεeqUS')
    apply Prod.ext
    · exact hu'
    · apply Subtype.ext
      exact hγ.symm

private theorem rf_pairing_minus_fourier
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (r : ReflectionRow S) (y : S.FSˣ) :
    let term : Fˣ → ℂ := fun ν =>
      ∑ᶠ d : Digits R r, digitAlpha R r d *
        R.T.W (R.chars.L (rowClass R r))
          (R.C.rat (diagGL ν) * R.C.rat weylGL * digitPoint R r y d)
    Summable term ∧
      digitSum R r true false y = digitSum R r true true y + ∑' ν, term ν := by
  classical
  let V := {v : FinPlace F // v ∈ R.exterior.support r.ideal}
  letI : ∀ v : V, Fintype (𝓞 F ⧸ v.1.asIdeal) := fun v => bridgeResidueFintype v.1
  letI : Fintype (Digits R r) := inferInstance
  let L := R.chars.L (rowClass R r)
  let W (d : Digits R r) (ν : Fˣ) : ℂ :=
    R.T.W L (R.C.rat (diagGL ν) * R.C.rat weylGL * digitPoint R r y d)
  have hW (d : Digits R r) : Summable (W d) := by
    simpa only [W, mul_assoc] using
      (R.T.fourier L (R.mem_family (rowClass R r))
        (R.C.rat weylGL * digitPoint R r y d)).1
  have hA (d : Digits R r) : Summable (fun ν => digitAlpha R r d * W d ν) :=
    (hW d).mul_left _
  have hsum : Summable (fun ν => ∑ d : Digits R r, digitAlpha R r d * W d ν) :=
    summable_sum (fun d _ => hA d)
  have hθ (d : Digits R r) :
      digitAlpha R r d * R.T.θ L (R.C.rat weylGL * digitPoint R r y d) =
        digitAlpha R r d * R.T.θN L (R.C.rat weylGL * digitPoint R r y d) +
          ∑' ν, digitAlpha R r d * W d ν := by
    have h := (R.T.fourier L (R.mem_family (rowClass R r))
      (R.C.rat weylGL * digitPoint R r y d)).2
    have h' : R.T.θ L (R.C.rat weylGL * digitPoint R r y d) =
        R.T.θN L (R.C.rat weylGL * digitPoint R r y d) + ∑' ν, W d ν := by
      simpa only [W, mul_assoc] using h
    rw [h', mul_add, (hW d).tsum_mul_left]
  constructor
  · simpa only [finsum_eq_sum_of_fintype] using hsum
  · change (∑ᶠ d : Digits R r,
        digitAlpha R r d * R.T.θ L (R.C.rat weylGL * digitPoint R r y d)) =
      (∑ᶠ d : Digits R r,
        digitAlpha R r d * R.T.θN L (R.C.rat weylGL * digitPoint R r y d)) +
          ∑' ν, ∑ᶠ d : Digits R r, digitAlpha R r d * W d ν
    simp only [finsum_eq_sum_of_fintype]
    calc
      (∑ d : Digits R r,
          digitAlpha R r d * R.T.θ L (R.C.rat weylGL * digitPoint R r y d)) =
        ∑ d : Digits R r,
          (digitAlpha R r d * R.T.θN L (R.C.rat weylGL * digitPoint R r y d) +
            ∑' ν, digitAlpha R r d * W d ν) :=
        Finset.sum_congr rfl (fun d _ => hθ d)
      _ = (∑ d : Digits R r,
          digitAlpha R r d * R.T.θN L (R.C.rat weylGL * digitPoint R r y d)) +
            ∑' ν, ∑ d : Digits R r, digitAlpha R r d * W d ν := by
        rw [Finset.sum_add_distrib, Summable.tsum_finsetSum (fun d _ => hA d)]

private theorem rf_pairing_masked_factorization
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (r : ReflectionRow S) (ν : Fˣ) (y : S.FSˣ) :
    (∑ᶠ d : Digits R r, digitAlpha R r d *
      R.T.W (R.chars.L (rowClass R r))
        (R.C.rat (diagGL ν) * R.C.rat weylGL * digitPoint R r y d)) =
      sCocycle (D := D) (H := H) (S.diagU ν) y⁻¹ *
        rotated R (rowClass R r) (S.diagU ν / y) *
        (∏ v ∈ R.exterior.support r.ideal,
          ∑ᶠ x : 𝓞 F ⧸ v.asIdeal,
            maskAlpha D A v (primeGen R v) (digitExponent r v) x *
              R.T.Wv v (R.C.a v (toLoc v ν) * R.C.w v *
                R.C.n v (Multiplicative.ofAdd (algebraMap F _
                  (algebraMap (𝓞 F) F x.out / (primeGen R v : F)))))) *
        (∏ᶠ (v : FinPlace F) (_ : v ∉ S.Sf ∧ v ∉ R.exterior.support r.ideal),
          R.T.Wv v (R.C.a v (toLoc v ν))) := by
  classical
  let T0 := R.exterior.support r.ideal
  let V := {v : FinPlace F // v ∈ T0}
  letI : ∀ v : V, Fintype (𝓞 F ⧸ v.1.asIdeal) := fun v => bridgeResidueFintype v.1
  letI : Fintype (Digits R r) := inferInstance
  let sPart : ℂ := sCocycle (D := D) (H := H) (S.diagU ν) y⁻¹ *
    rotated R (rowClass R r) (S.diagU ν / y)
  let tail : ℂ :=
    ∏ᶠ (v : FinPlace F) (_ : v ∉ S.Sf ∧ v ∉ T0),
      R.T.Wv v (R.C.a v (toLoc v ν))
  let localWeyl (v : FinPlace F) (x : 𝓞 F ⧸ v.asIdeal) : ℂ :=
    R.T.Wv v (R.C.a v (toLoc v ν) * R.C.w v *
      R.C.n v (Multiplicative.ofAdd (algebraMap F _
        (algebraMap (𝓞 F) F x.out / (primeGen R v : F)))))
  let masked (v : FinPlace F) (x : 𝓞 F ⧸ v.asIdeal) : ℂ :=
    maskAlpha D A v (primeGen R v) (digitExponent r v) x * localWeyl v x
  have hw : R.C.wS * R.C.aS y = R.C.aS y⁻¹ * R.C.wS := by
    calc
      R.C.wS * R.C.aS y = (R.C.wS * R.C.aS y * R.C.wS⁻¹) * R.C.wS := by group
      _ = R.C.aS y⁻¹ * R.C.wS := by rw [R.C.liftS_wa]
  have hS : R.T.WS (R.chars.L (rowClass R r))
      (R.C.aS (S.diagU ν) * R.C.wS * R.C.aS y) = sPart := by
    rw [mul_assoc, hw, ← mul_assoc, R.C.aS_mul, mul_assoc,
      R.T.WS_genuine (R.chars.L (rowClass R r)) (R.mem_family (rowClass R r))]
    simp [sPart, rotated, sCocycle, muThree, map_pow, div_eq_mul_inv]
  have hFactor (d : Digits R r) :
      R.T.W (R.chars.L (rowClass R r))
        (R.C.rat (diagGL ν) * R.C.rat weylGL * digitPoint R r y d) =
      sPart * (∏ v : V, localWeyl v.1 (d v)) * tail := by
    let g : FinPlace F → R.C.G := fun v =>
      if hv : v ∈ T0 then
        R.C.n v (Multiplicative.ofAdd (algebraMap F (v.adicCompletion F)
          (algebraMap (𝓞 F) F (d ⟨v, hv⟩).out / (primeGen R v : F))))
      else 1
    have hg : ∀ v ∈ T0, g v ∈ R.C.Gloc v := by
      intro v hv
      simp [g, hv]
      exact R.C.n_mem v _
    have hT0ext : ∀ v ∈ T0, v ∉ S.Sf :=
      fun v hv => R.exterior.support_exterior r.ideal v hv
    have hmapDigit : T0.attach.toList.map (fun v =>
        R.C.n v.1 (Multiplicative.ofAdd (algebraMap F (v.1.adicCompletion F)
          (algebraMap (𝓞 F) F (d v).out / (primeGen R v.1 : F))))) =
        T0.attach.toList.map (fun v => g v.1) := by
      apply List.map_congr_left
      intro v hv
      simp [g, v.2]
    have hperm0 : (T0.attach.toList.map Subtype.val).Perm T0.toList := by
      apply List.perm_of_nodup_nodup_toFinset_eq
      · exact (T0.attach.nodup_toList).map Subtype.val_injective
      · exact T0.nodup_toList
      · ext v
        simp
    have hpermG :
        (T0.attach.toList.map (fun v => g v.1)).Perm (T0.toList.map g) := by
      change List.Perm (List.map (g ∘ Subtype.val) T0.attach.toList) (List.map g T0.toList)
      simpa only [List.map_map] using hperm0.map g
    have hpairNe : (T0.attach.toList).Pairwise (· ≠ ·) :=
      List.nodup_iff_pairwise_ne.mp T0.attach.nodup_toList
    have hpairG : (T0.attach.toList.map (fun v => g v.1)).Pairwise Commute := by
      exact List.Pairwise.map (fun v : {v // v ∈ T0} => g v.1)
        (by
          intro v w hne
          have hplaces : v.1 ≠ w.1 := by
            intro heq
            apply hne
            exact Subtype.ext heq
          exact R.C.comm_loc v.1 w.1 hplaces (g v.1) (hg v.1 v.2)
            (g w.1) (hg w.1 w.2))
        hpairNe
    have harg : R.C.rat (diagGL ν) * R.C.rat weylGL * digitPoint R r y d =
        (R.C.rat (diagGL ν) * R.C.rat weylGL * R.C.aS y) *
          (T0.toList.map g).prod := by
      rw [digitPoint, hmapDigit]
      calc
        (R.C.rat (diagGL ν) * R.C.rat weylGL) *
            (R.C.aS y * (T0.attach.toList.map (fun v => g v.1)).prod) =
            (R.C.rat (diagGL ν) * R.C.rat weylGL * R.C.aS y) *
              (T0.attach.toList.map (fun v => g v.1)).prod := by simp only [mul_assoc]
        _ = _ := by rw [List.Perm.prod_eq' hpermG hpairG]
    have hProduct :
        (∏ v ∈ T0, R.T.Wv v (R.C.a v (toLoc v ν) * R.C.w v * g v)) =
          ∏ v : V, localWeyl v.1 (d v) := by
      rw [← Finset.prod_coe_sort T0]
      apply Finset.prod_congr rfl
      intro v hv
      simp [g, v.2, localWeyl]
    have h := R.T.factor (R.chars.L (rowClass R r))
      (R.mem_family (rowClass R r)) ν true (R.C.aS y) (R.C.aS_mem y)
      T0 hT0ext g hg
    simp only [↓reduceIte] at h
    rw [← harg, hS, hProduct] at h
    exact h
  have hWeighted (d : Digits R r) :
      digitAlpha R r d * R.T.W (R.chars.L (rowClass R r))
        (R.C.rat (diagGL ν) * R.C.rat weylGL * digitPoint R r y d) =
      sPart * (∏ v : V, masked v.1 (d v)) * tail := by
    rw [hFactor]
    change (∏ v : V, maskAlpha D A v.1 (primeGen R v.1) (digitExponent r v.1) (d v)) *
        (sPart * (∏ v : V, localWeyl v.1 (d v)) * tail) =
      sPart * (∏ v : V,
        maskAlpha D A v.1 (primeGen R v.1) (digitExponent r v.1) (d v) *
          localWeyl v.1 (d v)) * tail
    rw [Finset.prod_mul_distrib]
    ring
  have hMass : (∑ d : Digits R r, ∏ v : V, masked v.1 (d v)) =
      ∏ v ∈ T0, ∑ᶠ x : 𝓞 F ⧸ v.asIdeal, masked v x := by
    rw [← Finset.prod_coe_sort T0]
    simp only [finsum_eq_sum_of_fintype]
    exact (Fintype.prod_sum (fun v : V => masked v.1)).symm
  change (∑ᶠ d : Digits R r, digitAlpha R r d *
      R.T.W (R.chars.L (rowClass R r))
        (R.C.rat (diagGL ν) * R.C.rat weylGL * digitPoint R r y d)) =
    sPart * (∏ v ∈ T0, ∑ᶠ x : 𝓞 F ⧸ v.asIdeal, masked v x) * tail
  calc
    (∑ᶠ d : Digits R r, digitAlpha R r d *
        R.T.W (R.chars.L (rowClass R r))
          (R.C.rat (diagGL ν) * R.C.rat weylGL * digitPoint R r y d)) =
      ∑ d : Digits R r, sPart * (∏ v : V, masked v.1 (d v)) * tail := by
        rw [finsum_eq_sum_of_fintype]
        exact Finset.sum_congr rfl (fun d _ => hWeighted d)
    _ = sPart * (∑ d : Digits R r, ∏ v : V, masked v.1 (d v)) * tail := by
      rw [Finset.mul_sum, Finset.sum_mul]
    _ = sPart * (∏ v ∈ T0, ∑ᶠ x : 𝓞 F ⧸ v.asIdeal, masked v x) * tail := by
      rw [hMass]

private theorem rf_pairing_local_mask_split
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (v : FinPlace F) (hv : v ∉ S.Sf) (j : Fin 6) (ν : Fˣ) (e : ℤ) :
    (∑ᶠ x : 𝓞 F ⧸ v.asIdeal,
      maskAlpha D A v (primeGen R v) j x *
        R.T.Wv v (R.C.a v (toLoc v ν) * R.C.w v *
          R.C.n v (Multiplicative.ofAdd (algebraMap F _
            (algebraMap (𝓞 F) F x.out / (primeGen R v : F)))))) =
      localR R v j e (toLoc v ν * toLoc v (primeGen R v) ^ (2 - e)) +
      (if j = 0 then (1 - (qI v.asIdeal : ℂ)⁻¹) *
        R.T.Wv v (R.C.a v (toLoc v ν)) else 0) := by
  classical
  letI := bridgeResidueFintype v
  let p : Fˣ := primeGen R v
  let m (x : 𝓞 F ⧸ v.asIdeal) : ℂ :=
    maskAlpha D A v p j x *
      R.T.Wv v (R.C.a v (toLoc v ν) * R.C.w v *
        R.C.n v (Multiplicative.ofAdd (algebraMap F _
          (algebraMap (𝓞 F) F x.out / (p : F)))))
  have hcancel : toLoc v p ^ (e - 2) *
      (toLoc v ν * toLoc v p ^ (2 - e)) = toLoc v ν := by
    calc
      _ = toLoc v ν * (toLoc v p ^ (e - 2) * toLoc v p ^ (2 - e)) := by
        ac_rfl
      _ = toLoc v ν := by
        rw [← zpow_add, show e - 2 + (2 - e) = 0 by omega]
        simp
  have hnonzero :
      localR R v j e (toLoc v ν * toLoc v p ^ (2 - e)) =
        ∑ x : 𝓞 F ⧸ v.asIdeal, if x = 0 then 0 else m x := by
    simp only [localR, finsum_eq_sum_of_fintype]
    have harg : toLoc v (primeGen R v) ^ (e - 2) *
        (toLoc v ν * toLoc v p ^ (2 - e)) = toLoc v ν := hcancel
    rw [harg]
  have hpgen : S.IsGen (p : F) v.asIdeal := by
    have h := bc.gen_spec (R.exterior.prime v hv)
    simpa [p, primeGen, hv, R.exterior.prime_val] using h.1
  have hres0 : residue v (0 : F) = (0 : 𝓞 F ⧸ v.asIdeal) := by
    simpa using (a2_bridge_SYMBOL D S).residue_algebraMap v (0 : 𝓞 F)
  have hquot := rf_residue_div_prime_integral v hv p hpgen (0 : F)
    (by simp) (0 : 𝓞 F ⧸ v.asIdeal) hres0
  have hquotVal : HeightOneSpectrum.valuation F v
      (algebraMap (𝓞 F) F (0 : 𝓞 F ⧸ v.asIdeal).out / (p : F)) ≤ 1 := by
    simpa only [zero_sub, neg_div, Valuation.map_neg] using hquot
  have hquotInt : algebraMap F (v.adicCompletion F)
      (algebraMap (𝓞 F) F (0 : 𝓞 F ⧸ v.asIdeal).out / (p : F)) ∈
        v.adicCompletionIntegers F := by
    rw [HeightOneSpectrum.mem_adicCompletionIntegers,
      HeightOneSpectrum.algebraMap_adicCompletion, Function.comp_apply,
      Algebra.algebraMap_self, RingHom.id_apply, v.valuedAdicCompletion_eq_valuation']
    exact hquotVal
  have hzero : m 0 =
      if j = 0 then (1 - (qI v.asIdeal : ℂ)⁻¹) *
        R.T.Wv v (R.C.a v (toLoc v ν)) else 0 := by
    dsimp only [m]
    rw [R.T.Wv_right v hv (R.C.a v (toLoc v ν) * R.C.w v)
      (R.C.n v (Multiplicative.ofAdd (algebraMap F _
        (algebraMap (𝓞 F) F (0 : 𝓞 F ⧸ v.asIdeal).out / (p : F)))))
      (R.C.n_Kext v hv _ hquotInt) (R.C.n_mem v _)]
    by_cases hj : j = 0
    · subst j
      simpa [p] using rf_local_zero_digit R v hv ν
    · simp [maskAlpha, hj]
  have hsplit : (∑ x : 𝓞 F ⧸ v.asIdeal, m x) =
      (∑ x : 𝓞 F ⧸ v.asIdeal, if x = 0 then 0 else m x) + m 0 := by
    calc
      _ = ∑ x : 𝓞 F ⧸ v.asIdeal,
          ((if x = 0 then 0 else m x) + (if x = 0 then m 0 else 0)) := by
        apply Finset.sum_congr rfl
        intro x hx
        by_cases h : x = 0 <;> simp [h]
      _ = _ := by rw [Finset.sum_add_distrib]; simp
  change (∑ᶠ x : 𝓞 F ⧸ v.asIdeal, m x) =
    localR R v j e (toLoc v ν * toLoc v p ^ (2 - e)) +
      (if j = 0 then (1 - (qI v.asIdeal : ℂ)⁻¹) *
        R.T.Wv v (R.C.a v (toLoc v ν)) else 0)
  rw [finsum_eq_sum_of_fintype, hnonzero, hsplit, hzero]

private theorem rf_pairing_row_support
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0) (r : ReflectionRow S) :
    R.exterior.support r.ideal = R.exterior.support r.d ∪ R.exterior.support r.h ∧
      Disjoint (R.exterior.support r.d) (R.exterior.support r.h) ∧
      (∀ v ∈ R.exterior.support r.d, digitExponent r v = 1) ∧
      (∀ v ∈ R.exterior.support r.h,
        (digitExponent r v).val = idealExp v r.h.1 % 6) := by
  classical
  have hexp (v : FinPlace F) :
      idealExp v r.ideal.1 = idealExp v r.h.1 + idealExp v r.d.1 := by
    rw [r.factorization, rf_idealExp_mul v r.h.1 r.d.1 r.h.property.1 r.d.property.1]
  have hdis : Disjoint (R.exterior.support r.d) (R.exterior.support r.h) := by
    apply Finset.disjoint_left.mpr
    intro v hvd hvh
    exact rf_no_common_prime v r.h.1 r.d.1 r.coprime
      ((R.exterior.mem_support r.h v).mp hvh)
      ((R.exterior.mem_support r.d v).mp hvd)
  have hunion : R.exterior.support r.ideal =
      R.exterior.support r.d ∪ R.exterior.support r.h := by
    ext v
    simp only [Finset.mem_union]
    rw [← rf_idealExp_ne_zero_iff_support R v r.ideal,
      ← rf_idealExp_ne_zero_iff_support R v r.d,
      ← rf_idealExp_ne_zero_iff_support R v r.h, hexp v]
    omega
  refine ⟨hunion, hdis, ?_, ?_⟩
  · intro v hvd
    have hnotH : v ∉ R.exterior.support r.h := by
      intro hvh
      exact Finset.disjoint_left.mp hdis hvd hvh
    have hzero := rf_idealExp_zero_of_not_support R v r.h hnotH
    have hone := rf_idealExp_eq_one_of_squarefree_support R v r.d r.d_squarefree hvd
    apply Fin.ext
    change idealExp v r.ideal.1 % 6 = 1
    norm_num [hexp v, hzero, hone]
  · intro v hvh
    have hnotD : v ∉ R.exterior.support r.d := by
      intro hvd
      exact Finset.disjoint_left.mp hdis hvd hvh
    have hzero := rf_idealExp_zero_of_not_support R v r.d hnotD
    change idealExp v r.ideal.1 % 6 = idealExp v r.h.1 % 6
    rw [hexp v, hzero, Nat.add_zero]

private theorem rf_pairing_sqf_support_exists
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (s : Finset (FinPlace F)) (hgood : ∀ v ∈ s, v ∉ S.Sf) :
    ∃ f : S.ExtIdeal, Squarefree f.1 ∧ R.exterior.support f = s := by
  classical
  obtain ⟨f, hf, _, _⟩ := rf_prime_product_ext R s hgood
  refine ⟨f, ?_, ?_⟩
  · rw [hf]
    apply Finset.squarefree_prod_of_pairwise_isCoprime
    · intro v hv w hw hne
      exact (v.isCoprime_of_ne w hne).isRelPrime
    · intro v hv
      exact v.prime.squarefree
  · ext v
    constructor
    · intro hv
      by_contra hvs
      have hle : (∏ w ∈ s, w.asIdeal) ≤ v.asIdeal := by
        rw [← hf]
        exact Ideal.dvd_iff_le.mp ((R.exterior.mem_support f v).mp hv)
      exact rf_prime_product_not_le v s (fun w hw heq => hvs (heq ▸ hw)) hle
    · intro hv
      rw [R.exterior.mem_support f v, hf]
      exact Finset.dvd_prod_of_mem (fun w : FinPlace F => w.asIdeal) hv

private theorem rf_pairing_active_support_equiv
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0) (h : S.ExtIdeal) :
    ∃ e :
      {s : Finset (FinPlace F) // s ⊆ R.exterior.support h ∧
        ∀ v ∈ R.exterior.support h, idealExp v h.1 % 6 ≠ 0 → v ∈ s} ≃
      {f : S.ExtIdeal // activeFactor R h f},
      ∀ s, R.exterior.support (e s).1 = s.1 := by
  classical
  let SS := {s : Finset (FinPlace F) // s ⊆ R.exterior.support h ∧
    ∀ v ∈ R.exterior.support h, idealExp v h.1 % 6 ≠ 0 → v ∈ s}
  let AF := {f : S.ExtIdeal // activeFactor R h f}
  let φ : AF → SS := fun f => ⟨R.exterior.support f.1, f.2.2.1, f.2.2.2⟩
  have hfactor (f : AF) : f.1.1 = ∏ v ∈ R.exterior.support f.1, v.asIdeal := by
    let c : S.SqfExtIdeal := ⟨f.1.1, f.1.property, f.2.1⟩
    have hof : R.exterior.ofSqf c = f.1 := Subtype.ext (R.exterior.ofSqf_val c)
    simpa only [hof] using rf_sqfIdeal_factorization R c
  have hinj : Function.Injective φ := by
    intro f g heq
    have hs : R.exterior.support f.1 = R.exterior.support g.1 :=
      congrArg (fun s : SS => s.1) heq
    apply Subtype.ext
    apply Subtype.ext
    rw [hfactor f, hfactor g, hs]
  have hsurj : Function.Surjective φ := by
    intro s
    have hgood : ∀ v ∈ s.1, v ∉ S.Sf := fun v hv =>
      R.exterior.support_exterior h v (s.2.1 hv)
    obtain ⟨f, hfsq, hs⟩ := rf_pairing_sqf_support_exists R s.1 hgood
    have hfactive : activeFactor R h f := by
      refine ⟨hfsq, ?_, ?_⟩
      · intro v hv
        exact s.2.1 (hs ▸ hv)
      · intro v hv hnon
        rw [hs]
        exact s.2.2 v hv hnon
    refine ⟨⟨f, hfactive⟩, ?_⟩
    apply Subtype.ext
    exact hs
  let E : AF ≃ SS := Equiv.ofBijective φ ⟨hinj, hsurj⟩
  refine ⟨E.symm, ?_⟩
  intro s
  have hs : φ (E.symm s) = s := E.apply_symm_apply s
  exact congrArg (fun s : SS => s.1) hs

private theorem rf_pairing_spherical_support_finite
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0) (ν : Fˣ) :
    (fun v : FinPlace F =>
      if v ∉ S.Sf then R.T.Wv v (R.C.a v (toLoc v ν)) else 1).HasFiniteMulSupport := by
  classical
  let a := IsDedekindDomain.FiniteAdeleRing.unitEmbedding (𝓞 F) F ν
  have hfinite := IsDedekindDomain.FiniteAdeleRing.hasFiniteMulSupport_valued a
  have hval (v : FinPlace F) :
      Valued.v (a.1 v) = HeightOneSpectrum.valuation F v (ν : F) := by
    change Valued.v (algebraMap F (v.adicCompletion F) (ν : F)) = _
    simp only [HeightOneSpectrum.algebraMap_adicCompletion, Function.comp_apply,
      Algebra.algebraMap_self, RingHom.id_apply, v.valuedAdicCompletion_eq_valuation']
  apply Set.Finite.subset hfinite
  intro v hv
  simp only [Function.mem_mulSupport] at hv ⊢
  intro hv1
  by_cases hvS : v ∉ S.Sf
  · have hν : HeightOneSpectrum.valuation F v (ν : F) = 1 := by
      rw [← hval v]
      exact hv1
    have hW := rf_Wv_one_of_valuation_one R v hvS ν hν
    exact hv (by simp only [if_pos hvS, hW])
  · exact hv (by simp only [if_neg hvS])

private theorem rf_pairing_spherical_tail_split
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (r : ReflectionRow S) (ν : Fˣ) (s : Finset (FinPlace F))
    (hs : s ⊆ R.exterior.support r.h) :
    (∏ v ∈ R.exterior.support r.h \ s, R.T.Wv v (R.C.a v (toLoc v ν))) *
      (∏ᶠ v : FinPlace F, if v ∉ S.Sf ∧ v ∉ R.exterior.support r.ideal then
        R.T.Wv v (R.C.a v (toLoc v ν)) else 1) =
    ∏ᶠ v : FinPlace F, if v ∉ S.Sf ∧ v ∉ R.exterior.support r.d ∧ v ∉ s then
      R.T.Wv v (R.C.a v (toLoc v ν)) else 1 := by
  classical
  let inactive (v : FinPlace F) : ℂ :=
    if v ∈ R.exterior.support r.h \ s then R.T.Wv v (R.C.a v (toLoc v ν)) else 1
  let tail (v : FinPlace F) : ℂ :=
    if v ∉ S.Sf ∧ v ∉ R.exterior.support r.ideal then
      R.T.Wv v (R.C.a v (toLoc v ν)) else 1
  have hInactiveSubset : Function.mulSupport inactive ⊆
      (R.exterior.support r.h \ s : Finset (FinPlace F)) := by
    intro v hv
    simp only [Function.mem_mulSupport] at hv
    by_contra hvnot
    change v ∉ R.exterior.support r.h \ s at hvnot
    exact hv (by simp only [inactive, if_neg hvnot])
  have hInactive : inactive.HasFiniteMulSupport :=
    (R.exterior.support r.h \ s).finite_toSet.subset hInactiveSubset
  have hTail : tail.HasFiniteMulSupport := by
    apply (rf_pairing_spherical_support_finite R ν).subset
    intro v hv
    simp only [Function.mem_mulSupport] at hv ⊢
    by_cases ht : v ∉ S.Sf ∧ v ∉ R.exterior.support r.ideal
    · simpa only [tail, if_pos ht, if_pos ht.1] using hv
    · exact (hv (by simp only [tail, if_neg ht])).elim
  obtain ⟨hrow, hdis, _, _⟩ := rf_pairing_row_support R r
  have hFactor (v : FinPlace F) : inactive v * tail v =
      if v ∉ S.Sf ∧ v ∉ R.exterior.support r.d ∧ v ∉ s then
        R.T.Wv v (R.C.a v (toLoc v ν)) else 1 := by
    by_cases hi : v ∈ R.exterior.support r.h \ s
    · have hvh := (Finset.mem_sdiff.mp hi).1
      have hvs := (Finset.mem_sdiff.mp hi).2
      have hvD : v ∉ R.exterior.support r.d := by
        intro hvd
        exact Finset.disjoint_left.mp hdis hvd hvh
      have hvS := R.exterior.support_exterior r.h v hvh
      have hvI : v ∈ R.exterior.support r.ideal := by
        rw [hrow]
        exact Finset.mem_union.mpr (Or.inr hvh)
      have hsmall : v ∉ S.Sf ∧ v ∉ R.exterior.support r.d ∧ v ∉ s :=
        ⟨hvS, hvD, hvs⟩
      simp only [inactive, if_pos hi, tail, not_not.mpr hvI,
        and_false, if_false, mul_one, if_pos hsmall]
    · by_cases ht : v ∉ S.Sf ∧ v ∉ R.exterior.support r.ideal
      · have hvD : v ∉ R.exterior.support r.d := by
          intro hvd
          apply ht.2
          rw [hrow]
          exact Finset.mem_union.mpr (Or.inl hvd)
        have hvs : v ∉ s := by
          intro hvs
          apply ht.2
          rw [hrow]
          exact Finset.mem_union.mpr (Or.inr (hs hvs))
        have hsmall : v ∉ S.Sf ∧ v ∉ R.exterior.support r.d ∧ v ∉ s :=
          ⟨ht.1, hvD, hvs⟩
        simp only [inactive, if_neg hi, tail, if_pos ht, one_mul, if_pos hsmall]
      · have hsmall : ¬(v ∉ S.Sf ∧ v ∉ R.exterior.support r.d ∧ v ∉ s) := by
          intro h
          apply ht
          refine ⟨h.1, ?_⟩
          intro hvI
          rw [hrow] at hvI
          rcases Finset.mem_union.mp hvI with hvd | hvh
          · exact h.2.1 hvd
          · exact hi (Finset.mem_sdiff.mpr ⟨hvh, h.2.2⟩)
        simp only [inactive, if_neg hi, tail, if_neg ht, one_mul, if_neg hsmall]
  have hInactiveProd : (∏ᶠ v, inactive v) =
      ∏ v ∈ R.exterior.support r.h \ s, R.T.Wv v (R.C.a v (toLoc v ν)) := by
    rw [finprod_eq_prod_of_mulSupport_subset inactive hInactiveSubset]
    apply Finset.prod_congr rfl
    intro v hv
    simp only [inactive, if_pos hv]
  change _ * (∏ᶠ v, tail v) = _
  rw [← hInactiveProd, ← finprod_mul_distrib hInactive hTail]
  exact finprod_congr hFactor

private theorem rf_pairing_active_product_partition
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (r : ReflectionRow S) (ν : Fˣ) :
    (∏ v ∈ R.exterior.support r.h,
      (localR R v (digitExponent r v) (ordv v (toLoc v ν) + 2)
        (toLoc v ν * toLoc v (primeGen R v) ^ (-ordv v (toLoc v ν))) +
      (if digitExponent r v = 0 then (1 - (qI v.asIdeal : ℂ)⁻¹) *
        R.T.Wv v (R.C.a v (toLoc v ν)) else 0))) *
      (∏ᶠ v : FinPlace F, if v ∉ S.Sf ∧ v ∉ R.exterior.support r.ideal then
        R.T.Wv v (R.C.a v (toLoc v ν)) else 1) =
    ∑ᶠ f : {f : S.ExtIdeal // activeFactor R r.h f},
      inactiveScalar R r.h f.1 *
        (∏ v ∈ R.exterior.support f.1,
          localR R v (digitExponent r v) (ordv v (toLoc v ν) + 2)
            (toLoc v ν * toLoc v (primeGen R v) ^ (-ordv v (toLoc v ν)))) *
        ∏ᶠ v : FinPlace F,
          if v ∉ S.Sf ∧ v ∉ R.exterior.support r.d ∧ v ∉ R.exterior.support f.1 then
            R.T.Wv v (R.C.a v (toLoc v ν)) else 1 := by
  classical
  let H0 := R.exterior.support r.h
  let A0 (v : FinPlace F) : ℂ :=
    localR R v (digitExponent r v) (ordv v (toLoc v ν) + 2)
      (toLoc v ν * toLoc v (primeGen R v) ^ (-ordv v (toLoc v ν)))
  let G0 (v : FinPlace F) : ℂ :=
    if digitExponent r v = 0 then (1 - (qI v.asIdeal : ℂ)⁻¹) *
      R.T.Wv v (R.C.a v (toLoc v ν)) else 0
  let tail : ℂ := ∏ᶠ v : FinPlace F,
    if v ∉ S.Sf ∧ v ∉ R.exterior.support r.ideal then
      R.T.Wv v (R.C.a v (toLoc v ν)) else 1
  let mandatory (s : Finset (FinPlace F)) : Prop :=
    ∀ v ∈ H0, idealExp v r.h.1 % 6 ≠ 0 → v ∈ s
  let subs := H0.powerset.filter mandatory
  let SS := {s : Finset (FinPlace F) // s ⊆ H0 ∧ mandatory s}
  let AF := {f : S.ExtIdeal // activeFactor R r.h f}
  have hmem (s : Finset (FinPlace F)) :
      s ∈ subs ↔ s ⊆ H0 ∧ mandatory s := by
    simp only [subs, Finset.mem_filter, Finset.mem_powerset]
  letI : Fintype SS := Fintype.ofFinset subs hmem
  letI : Fintype AF := (rf_pairing_activeFactor_finite R r.h).fintype
  obtain ⟨e, he⟩ := rf_pairing_active_support_equiv R r.h
  have hdigit := (rf_pairing_row_support R r).2.2.2
  let poly (s : Finset (FinPlace F)) : ℂ :=
    (∏ v ∈ s, A0 v) * ∏ v ∈ H0 \ s, G0 v
  let activeTerm (f : AF) : ℂ :=
    inactiveScalar R r.h f.1 * (∏ v ∈ R.exterior.support f.1, A0 v) *
      ∏ᶠ v : FinPlace F,
        if v ∉ S.Sf ∧ v ∉ R.exterior.support r.d ∧ v ∉ R.exterior.support f.1 then
          R.T.Wv v (R.C.a v (toLoc v ν)) else 1
  have hrestrict : (∑ s ∈ subs, poly s) = ∑ s ∈ H0.powerset, poly s := by
    apply Finset.sum_subset (Finset.filter_subset _ _)
    intro s hs hn
    have hsH : s ⊆ H0 := Finset.mem_powerset.mp hs
    have hmiss : ¬mandatory s := by
      intro hc
      exact hn ((hmem s).mpr ⟨hsH, hc⟩)
    simp only [mandatory, not_forall, not_imp] at hmiss
    obtain ⟨v, hv, hnonzero, hvs⟩ := hmiss
    have hj : digitExponent r v ≠ 0 := by
      intro hj0
      apply hnonzero
      exact (hdigit v hv).symm.trans (congrArg (fun j : Fin 6 => j.val) hj0)
    have hG : (∏ w ∈ H0 \ s, G0 w) = 0 :=
      Finset.prod_eq_zero (Finset.mem_sdiff.mpr ⟨hv, hvs⟩)
        (by simp only [G0, if_neg hj])
    simp only [poly, hG, mul_zero]
  have hterm (s : SS) : poly s.1 * tail = activeTerm (e s) := by
    have hj0 (v : FinPlace F) (hv : v ∈ H0 \ s.1) : digitExponent r v = 0 := by
      apply Fin.ext
      change (digitExponent r v).val = 0
      rw [hdigit v (Finset.mem_sdiff.mp hv).1]
      by_contra hnonzero
      exact (Finset.mem_sdiff.mp hv).2
        (s.2.2 v (Finset.mem_sdiff.mp hv).1 hnonzero)
    have hG : (∏ v ∈ H0 \ s.1, G0 v) =
        (∏ v ∈ H0 \ s.1, (1 - (qI v.asIdeal : ℂ)⁻¹)) *
          ∏ v ∈ H0 \ s.1, R.T.Wv v (R.C.a v (toLoc v ν)) := by
      rw [← Finset.prod_mul_distrib]
      apply Finset.prod_congr rfl
      intro v hv
      simp only [G0, if_pos (hj0 v hv)]
    have hfilter : H0.filter (fun v => v ∉ s.1) = H0 \ s.1 := by
      ext v
      simp only [Finset.mem_filter, Finset.mem_sdiff]
    have hscalar : (∏ v ∈ H0 \ s.1, (1 - (qI v.asIdeal : ℂ)⁻¹)) =
        inactiveScalar R r.h (e s).1 := by
      simp only [inactiveScalar, he s]
      exact congrArg (fun t : Finset (FinPlace F) =>
        ∏ v ∈ t, (1 - (qI v.asIdeal : ℂ)⁻¹)) hfilter.symm
    have htail := rf_pairing_spherical_tail_split R r ν s.1 s.2.1
    change (∏ v ∈ H0 \ s.1, R.T.Wv v (R.C.a v (toLoc v ν))) * tail = _ at htail
    dsimp only [poly, activeTerm]
    rw [hG, hscalar, he s, ← htail]
    ring
  change (∏ v ∈ H0, (A0 v + G0 v)) * tail = ∑ᶠ f : AF, activeTerm f
  calc
    _ = (∑ s ∈ H0.powerset, poly s) * tail := by
      rw [Finset.prod_add]
    _ = (∑ s ∈ subs, poly s) * tail := by rw [hrestrict]
    _ = ∑ s ∈ subs, poly s * tail := Finset.sum_mul _ _ _
    _ = ∑ s : SS, poly s.1 * tail :=
      Finset.sum_subtype subs hmem (fun s => poly s * tail)
    _ = ∑ᶠ s : SS, poly s.1 * tail := (finsum_eq_sum_of_fintype _).symm
    _ = ∑ᶠ f : AF, activeTerm f := finsum_eq_of_bijective e e.bijective hterm

private def rf_pairing_active_coefficient
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (r : ReflectionRow S) (f : S.ExtIdeal) (ν : Fˣ) : ℂ :=
  inactiveScalar R r.h f *
    (∏ v ∈ R.exterior.support r.d,
      localR R v 1 0 (toLoc v ν * toLoc v (primeGen R v) ^ 2)) *
    (∏ v ∈ R.exterior.support f,
      localR R v (digitExponent r v) (ordv v (toLoc v ν) + 2)
        (toLoc v ν * toLoc v (primeGen R v) ^ (-ordv v (toLoc v ν)))) *
    ∏ᶠ v : FinPlace F,
      if v ∉ S.Sf ∧ v ∉ R.exterior.support r.d ∧ v ∉ R.exterior.support f then
        R.T.Wv v (R.C.a v (toLoc v ν)) else 1

private theorem rf_pairing_digit_active_partition
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (r : ReflectionRow S) (ν : Fˣ) (y : S.FSˣ) :
    (∑ᶠ d : Digits R r, digitAlpha R r d *
      R.T.W (R.chars.L (rowClass R r))
        (R.C.rat (diagGL ν) * R.C.rat weylGL * digitPoint R r y d)) =
      sCocycle (D := D) (H := H) (S.diagU ν) y⁻¹ *
        rotated R (rowClass R r) (S.diagU ν / y) *
        ∑ᶠ f : {f : S.ExtIdeal // activeFactor R r.h f},
          rf_pairing_active_coefficient R r f.1 ν := by
  classical
  let AF := {f : S.ExtIdeal // activeFactor R r.h f}
  letI : Fintype AF := (rf_pairing_activeFactor_finite R r.h).fintype
  let rowLocal (v : FinPlace F) : ℂ :=
    ∑ᶠ x : 𝓞 F ⧸ v.asIdeal,
      maskAlpha D A v (primeGen R v) (digitExponent r v) x *
        R.T.Wv v (R.C.a v (toLoc v ν) * R.C.w v *
          R.C.n v (Multiplicative.ofAdd (algebraMap F _
            (algebraMap (𝓞 F) F x.out / (primeGen R v : F)))))
  let hLocal (v : FinPlace F) : ℂ :=
    localR R v (digitExponent r v) (ordv v (toLoc v ν) + 2)
      (toLoc v ν * toLoc v (primeGen R v) ^ (-ordv v (toLoc v ν))) +
    (if digitExponent r v = 0 then (1 - (qI v.asIdeal : ℂ)⁻¹) *
      R.T.Wv v (R.C.a v (toLoc v ν)) else 0)
  let dProd : ℂ := ∏ v ∈ R.exterior.support r.d,
    localR R v 1 0 (toLoc v ν * toLoc v (primeGen R v) ^ 2)
  let tail : ℂ := ∏ᶠ v : FinPlace F,
    if v ∉ S.Sf ∧ v ∉ R.exterior.support r.ideal then
      R.T.Wv v (R.C.a v (toLoc v ν)) else 1
  let sPart : ℂ := sCocycle (D := D) (H := H) (S.diagU ν) y⁻¹ *
    rotated R (rowClass R r) (S.diagU ν / y)
  let activeTerm (f : AF) : ℂ :=
    inactiveScalar R r.h f.1 *
      (∏ v ∈ R.exterior.support f.1,
        localR R v (digitExponent r v) (ordv v (toLoc v ν) + 2)
          (toLoc v ν * toLoc v (primeGen R v) ^ (-ordv v (toLoc v ν)))) *
      ∏ᶠ v : FinPlace F,
        if v ∉ S.Sf ∧ v ∉ R.exterior.support r.d ∧ v ∉ R.exterior.support f.1 then
          R.T.Wv v (R.C.a v (toLoc v ν)) else 1
  obtain ⟨hrow, hdis, hdigit, _⟩ := rf_pairing_row_support R r
  have hD (v : FinPlace F) (hv : v ∈ R.exterior.support r.d) :
      rowLocal v = localR R v 1 0 (toLoc v ν * toLoc v (primeGen R v) ^ 2) := by
    have h := rf_pairing_local_mask_split R v
      (R.exterior.support_exterior r.d v hv) (digitExponent r v) ν 0
    simpa [rowLocal, hdigit v hv] using h
  have hH (v : FinPlace F) (hv : v ∈ R.exterior.support r.h) :
      rowLocal v = hLocal v := by
    have h := rf_pairing_local_mask_split R v
      (R.exterior.support_exterior r.h v hv) (digitExponent r v) ν
      (ordv v (toLoc v ν) + 2)
    have he : 2 - (ordv v (toLoc v ν) + 2) = -ordv v (toLoc v ν) := by ring
    simpa only [rowLocal, hLocal, he] using h
  have hProd : (∏ v ∈ R.exterior.support r.ideal, rowLocal v) =
      dProd * ∏ v ∈ R.exterior.support r.h, hLocal v := by
    rw [hrow, Finset.prod_union hdis]
    apply congrArg₂ (· * ·)
    · apply Finset.prod_congr rfl
      exact hD
    · apply Finset.prod_congr rfl
      exact hH
  have hmasked := rf_pairing_masked_factorization R r ν y
  simp_rw [finprod_eq_if] at hmasked
  change (∑ᶠ d : Digits R r, digitAlpha R r d *
      R.T.W (R.chars.L (rowClass R r))
        (R.C.rat (diagGL ν) * R.C.rat weylGL * digitPoint R r y d)) =
      sPart * (∏ v ∈ R.exterior.support r.ideal, rowLocal v) * tail at hmasked
  have hpartition := rf_pairing_active_product_partition R r ν
  change (∏ v ∈ R.exterior.support r.h, hLocal v) * tail =
    ∑ᶠ f : AF, activeTerm f at hpartition
  have hsum : dProd * (∑ᶠ f : AF, activeTerm f) =
      ∑ᶠ f : AF, rf_pairing_active_coefficient R r f.1 ν := by
    rw [finsum_eq_sum_of_fintype, finsum_eq_sum_of_fintype, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro f hf
    dsimp only [activeTerm, dProd, rf_pairing_active_coefficient]
    ring
  change _ = sPart * ∑ᶠ f : AF, rf_pairing_active_coefficient R r f.1 ν
  rw [hmasked, hProd]
  calc
    sPart * (dProd * ∏ v ∈ R.exterior.support r.h, hLocal v) * tail =
        sPart * (dProd * ((∏ v ∈ R.exterior.support r.h, hLocal v) * tail)) := by ring
    _ = _ := by rw [hpartition, hsum]

private theorem rf_pairing_active_coefficient_gamma
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (r : ReflectionRow S) (f : S.ExtIdeal) (γ : Gamma S) (ν : Fˣ) :
    rf_pairing_active_coefficient R r f ((γ.1 : Fˣ) * ν) =
      rf_pairing_active_coefficient R r f ν := by
  classical
  have localVal (v : FinPlace F) (hv : v ∉ S.Sf) :
      Valued.v (toLoc v (γ.1 : Fˣ) : v.adicCompletion F) = 1 := by
    have hglobal : HeightOneSpectrum.valuation F v ((γ.1 : Fˣ) : F) = 1 :=
      Set.unit_valuation_eq_one (S := (S.Sf : Set (FinPlace F))) (K := F) γ.1 hv
    change Valued.v (algebraMap F (v.adicCompletion F) ((γ.1 : Fˣ) : F)) = 1
    simpa only [HeightOneSpectrum.algebraMap_adicCompletion, Function.comp_apply,
      Algebra.algebraMap_self, RingHom.id_apply, v.valuedAdicCompletion_eq_valuation'] using hglobal
  have localOrd (v : FinPlace F) (hv : v ∉ S.Sf) :
      ordv v (toLoc v (γ.1 : Fˣ)) = 0 := by
    rw [rf_ordv_local_log, localVal v hv]
    simp
  have ordMul (v : FinPlace F) (hv : v ∉ S.Sf) (ξ : Fˣ) :
      ordv v (toLoc v ((γ.1 : Fˣ) * ξ)) = ordv v (toLoc v ξ) := by
    rw [map_mul, rf_ordv_mul, localOrd v hv, zero_add]
  have hlocal (v : FinPlace F) (hv : v ∉ S.Sf) :
      R.T.Wv v (R.C.a v (toLoc v ((γ.1 : Fˣ) * ν))) =
        R.T.Wv v (R.C.a v (toLoc v ν)) ∧
      ∀ (j : Fin 6) (e : ℤ),
        localR R v j e
          (toLoc v ((γ.1 : Fˣ) * ν) * toLoc v (primeGen R v) ^ (2 - e)) =
        localR R v j e (toLoc v ν * toLoc v (primeGen R v) ^ (2 - e)) := by
    let g : (v.adicCompletion F)ˣ := toLoc v (γ.1 : Fˣ)
    have hgval : Valued.v (g : v.adicCompletion F) = 1 := localVal v hv
    have hgord : ordv v g = 0 := localOrd v hv
    have hgchi : localChi D v g = 1 := by
      have hglobal : HeightOneSpectrum.valuation F v ((γ.1 : Fˣ) : F) = 1 :=
        Set.unit_valuation_eq_one (S := (S.Sf : Set (FinPlace F))) (K := F) γ.1 hv
      rw [show g = toLoc v (γ.1 : Fˣ) by rfl,
        rf_localChi_toLoc v hv (γ.1 : Fˣ) hglobal, rf_gamma_chi_one D γ v hv]
    have isUnitLoc (x : (v.adicCompletion F)ˣ)
        (hx : Valued.v (x : v.adicCompletion F) = 1) :
        ArtinPrimitiveRoots.A1.Theta.IsLocUnit v x := by
      constructor
      · rw [HeightOneSpectrum.mem_adicCompletionIntegers, hx]
      · rw [HeightOneSpectrum.mem_adicCompletionIntegers]
        simp only [Units.val_inv_eq_inv_val, map_inv₀, hx, inv_one, le_refl]
    have hgunit := isUnitLoc g hgval
    have hunitPart : unitPart v g = g := by simp [unitPart, hgord]
    have hcright (x : (v.adicCompletion F)ˣ) : extCocycle D v x g = 1 := by
      simp [extCocycle, hunitPart, hgchi, hgord]
    have har (x : (v.adicCompletion F)ˣ) :
        R.C.a v x * R.C.a v g = R.C.a v (x * g) := by
      obtain ⟨ζ, hζval, hmul⟩ := R.C.a_mul v hv x g
      have hζ : ζ = 1 := by
        apply Subtype.ext
        apply Units.ext
        exact hζval.trans (hcright x)
      simpa [hζ] using hmul
    constructor
    · have hK : R.C.a v g ∈ R.C.Kext :=
        R.C.a_Kext v hv g hgunit.1 hgunit.2
      calc
        R.T.Wv v (R.C.a v (toLoc v ((γ.1 : Fˣ) * ν))) =
            R.T.Wv v (R.C.a v (toLoc v ν) * R.C.a v g) := by
              rw [map_mul, mul_comm g (toLoc v ν)]
              exact congrArg (R.T.Wv v) (har (toLoc v ν)).symm
        _ = R.T.Wv v (R.C.a v (toLoc v ν)) :=
          R.T.Wv_right v hv (R.C.a v (toLoc v ν)) (R.C.a v g) hK (R.C.a_mem v g)
    · intro j e
      have hnormal (ξ : Fˣ) (k : ℤ) :
          localR R v j k (toLoc v ξ * toLoc v (primeGen R v) ^ (2 - k)) =
            localR R v j (ordv v (toLoc v ξ) + 2)
              (toLoc v ξ * toLoc v (primeGen R v) ^ (-ordv v (toLoc v ξ))) := by
        have ha := rf_pairing_local_mask_split R v hv j ξ k
        have hb := rf_pairing_local_mask_split R v hv j ξ (ordv v (toLoc v ξ) + 2)
        have he : 2 - (ordv v (toLoc v ξ) + 2) = -ordv v (toLoc v ξ) := by ring
        rw [he] at hb
        exact add_right_cancel (ha.symm.trans hb)
      have hpgen : S.IsGen (primeGen R v : F) (R.exterior.prime v hv).1 := by
        simpa [primeGen, hv] using (bc.gen_spec (R.exterior.prime v hv)).1
      have hpsq : Squarefree (R.exterior.prime v hv).1 := by
        rw [R.exterior.prime_val]
        exact v.prime.squarefree
      have hpmem : v ∈ R.exterior.support (R.exterior.prime v hv) := by
        apply (R.exterior.mem_support (R.exterior.prime v hv) v).mpr
        simpa only [R.exterior.prime_val] using (dvd_refl v.asIdeal)
      have hpord : ordv v (toLoc v (primeGen R v)) = 1 :=
        (rf_ordv_toLoc_ofGen v hv (R.exterior.prime v hv) (primeGen R v) hpgen).trans
          (congrArg (fun n : ℕ => (n : ℤ))
            (rf_idealExp_eq_one_of_squarefree_support R v (R.exterior.prime v hv) hpsq hpmem))
      let x : (v.adicCompletion F)ˣ :=
        toLoc v ν * toLoc v (primeGen R v) ^ (-ordv v (toLoc v ν))
      have hxord : ordv v x = 0 := by
        dsimp only [x]
        rw [rf_ordv_mul, rf_ordv_zpow, hpord]
        ring
      have hxval := rf_localVal_one_of_ordv_zero v x hxord
      have hgxval : Valued.v ((g * x : (v.adicCompletion F)ˣ) : v.adicCompletion F) = 1 := by
        simp only [Units.val_mul, map_mul, hgval, hxval, one_mul]
      have hxunit := isUnitLoc x hxval
      have hgxunit := isUnitLoc (g * x) hgxval
      have hv6 : (6 : 𝓞 F) ∉ v.asIdeal := fun h => hv (S.over6 v h)
      have hχgx : localChi D v (g * x) = localChi D v x := by
        rw [(ArtinPrimitiveRoots.A1.Theta.localChi_basic (D := D) hv6).2.2.1
          g x hgunit hxunit, hgchi, one_mul]
      have harg : toLoc v ((γ.1 : Fˣ) * ν) *
          toLoc v (primeGen R v) ^ (-ordv v (toLoc v ν)) = g * x := by
        simp only [map_mul, g, x, mul_assoc]
      rw [hnormal ((γ.1 : Fˣ) * ν) e, hnormal ν e, ordMul v hv ν, harg]
      change localR R v j (ordv v (toLoc v ν) + 2) (g * x) =
        localR R v j (ordv v (toLoc v ν) + 2) x
      obtain ⟨hnegx, _, _, _, _, _, _, hscalex, _, _⟩ :=
        lem_reflection_local_Weyl R v hv j (ordv v (toLoc v ν) + 2) x hxunit.1 hxunit.2
      obtain ⟨hneggx, _, _, _, _, _, _, hscalegx, _, _⟩ :=
        lem_reflection_local_Weyl R v hv j (ordv v (toLoc v ν) + 2) (g * x)
          hgxunit.1 hgxunit.2
      by_cases hn : ordv v (toLoc v ν) + 2 < 0
      · rw [hnegx hn, hneggx hn]
      · have he : 0 ≤ ordv v (toLoc v ν) + 2 := by omega
        rw [hscalex he, hscalegx he, hχgx]
  have hD : (∏ v ∈ R.exterior.support r.d,
      localR R v 1 0 (toLoc v ((γ.1 : Fˣ) * ν) * toLoc v (primeGen R v) ^ 2)) =
      ∏ v ∈ R.exterior.support r.d,
        localR R v 1 0 (toLoc v ν * toLoc v (primeGen R v) ^ 2) := by
    apply Finset.prod_congr rfl
    intro v hv
    simpa using (hlocal v (R.exterior.support_exterior r.d v hv)).2 1 0
  have hF : (∏ v ∈ R.exterior.support f,
      localR R v (digitExponent r v) (ordv v (toLoc v ((γ.1 : Fˣ) * ν)) + 2)
        (toLoc v ((γ.1 : Fˣ) * ν) *
          toLoc v (primeGen R v) ^ (-ordv v (toLoc v ((γ.1 : Fˣ) * ν))))) =
      ∏ v ∈ R.exterior.support f,
        localR R v (digitExponent r v) (ordv v (toLoc v ν) + 2)
          (toLoc v ν * toLoc v (primeGen R v) ^ (-ordv v (toLoc v ν))) := by
    apply Finset.prod_congr rfl
    intro v hv
    have hvS := R.exterior.support_exterior f v hv
    rw [ordMul v hvS ν]
    have he : 2 - (ordv v (toLoc v ν) + 2) = -ordv v (toLoc v ν) := by ring
    simpa only [he] using (hlocal v hvS).2 (digitExponent r v) (ordv v (toLoc v ν) + 2)
  have hTail : (∏ᶠ v : FinPlace F,
      if v ∉ S.Sf ∧ v ∉ R.exterior.support r.d ∧ v ∉ R.exterior.support f then
        R.T.Wv v (R.C.a v (toLoc v ((γ.1 : Fˣ) * ν))) else 1) =
      ∏ᶠ v : FinPlace F,
        if v ∉ S.Sf ∧ v ∉ R.exterior.support r.d ∧ v ∉ R.exterior.support f then
          R.T.Wv v (R.C.a v (toLoc v ν)) else 1 := by
    apply finprod_congr
    intro v
    by_cases hv : v ∉ S.Sf ∧ v ∉ R.exterior.support r.d ∧ v ∉ R.exterior.support f
    · simp only [if_pos hv, (hlocal v hv.1).1]
    · simp only [if_neg hv]
  unfold rf_pairing_active_coefficient
  rw [hD, hF, hTail]

private theorem rf_pairing_active_coefficient_frozen
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (r : ReflectionRow S) (t : FrozenIndex R r.h) (c : S.SqfExtIdeal)
    (hcf : IsCoprime c.1 t.f.1) :
    rf_pairing_active_coefficient R r t.f (frozenFrequency R t r.d c) =
      groupedExterior R t r.d (frozenFrequency R t r.d c) := by
  classical
  let ν : Fˣ := frozenFrequency R t r.d c
  have hrow := rf_pairing_row_support R r
  have hOrdInv (v : FinPlace F) (x : (v.adicCompletion F)ˣ) :
      ordv v x⁻¹ = -ordv v x := by
    have hm := rf_ordv_mul v x x⁻¹
    have hone : ordv v (1 : (v.adicCompletion F)ˣ) = 0 := by
      simp [ordv]
      rfl
    rw [mul_inv_cancel, hone] at hm
    linarith
  have hOrdDiv (v : FinPlace F) (x y : (v.adicCompletion F)ˣ) :
      ordv v (x / y) = ordv v x - ordv v y := by
    rw [div_eq_mul_inv, rf_ordv_mul, hOrdInv]
    ring
  have hOrdPow (v : FinPlace F) (x : (v.adicCompletion F)ˣ) (n : ℕ) :
      ordv v (x ^ n) = (n : ℤ) * ordv v x := by
    simpa only [zpow_natCast] using rf_ordv_zpow v x (n : ℤ)
  have horder (v : FinPlace F) (hvf : v ∈ R.exterior.support t.f) :
      ordv v (toLoc v ν) = (idealExp v t.a.1 : ℤ) - 2 := by
    have hv := R.exterior.support_exterior t.f v hvf
    have hvh := t.active.2.1 v hvf
    have hnotD : v ∉ R.exterior.support r.d := by
      intro hvd
      exact Finset.disjoint_left.mp hrow.2.1 hvd hvh
    have hnotC : v ∉ R.exterior.support (R.exterior.ofSqf c) := by
      intro hvc
      apply rf_no_common_prime v c.1 t.f.1 hcf
      · simpa only [R.exterior.ofSqf_val] using
          (R.exterior.mem_support (R.exterior.ofSqf c) v).mp hvc
      · exact (R.exterior.mem_support t.f v).mp hvf
    have hnotN : v ∉ R.exterior.support t.n := by
      intro hvn
      exact rf_no_common_prime v t.n.1 t.f.1 t.coprime
        ((R.exterior.mem_support t.n v).mp hvn)
        ((R.exterior.mem_support t.f v).mp hvf)
    have heps : ordv v (toLoc v (R.sheets.eps t.u : Fˣ)) = 0 := by
      have hglobal : HeightOneSpectrum.valuation F v
          ((R.sheets.eps t.u : Fˣ) : F) = 1 :=
        Set.unit_valuation_eq_one (S := (S.Sf : Set (FinPlace F))) (K := F)
          (R.sheets.eps t.u) hv
      have hloc : Valued.v (toLoc v (R.sheets.eps t.u : Fˣ) : v.adicCompletion F) = 1 := by
        change Valued.v (algebraMap F (v.adicCompletion F)
          ((R.sheets.eps t.u : Fˣ) : F)) = 1
        simpa only [HeightOneSpectrum.algebraMap_adicCompletion, Function.comp_apply,
          Algebra.algebraMap_self, RingHom.id_apply, v.valuedAdicCompletion_eq_valuation'] using hglobal
      rw [rf_ordv_local_log, hloc]
      simp
    have hgen (I : S.ExtIdeal) :
        ordv v (toLoc v (bc.gen I)) = (idealExp v I.1 : ℤ) :=
      rf_ordv_toLoc_ofGen v hv I (bc.gen I) (bc.gen_spec I).1
    have hc := rf_idealExp_zero_of_not_support R v (R.exterior.ofSqf c) hnotC
    have hn := rf_idealExp_zero_of_not_support R v t.n hnotN
    have hd := rf_idealExp_zero_of_not_support R v r.d hnotD
    have hf := rf_idealExp_eq_one_of_squarefree_support R v t.f t.active.1 hvf
    dsimp only [ν, frozenFrequency]
    rw [map_div, map_mul, map_mul, map_mul, map_pow, map_pow, map_mul,
      hOrdDiv, rf_ordv_mul, rf_ordv_mul, rf_ordv_mul, hOrdPow, hOrdPow,
      rf_ordv_mul, heps, hgen t.a, hgen (R.exterior.ofSqf c), hgen t.n,
      hgen r.d, hgen t.f, hc, hn, hd, hf]
    norm_num
  have hprod :
      (∏ v ∈ R.exterior.support t.f,
        localR R v (digitExponent r v) (ordv v (toLoc v ν) + 2)
          (toLoc v ν * toLoc v (primeGen R v) ^ (-ordv v (toLoc v ν)))) =
      ∏ v ∈ R.exterior.support t.f,
        localR R v (frozenJ t v) (idealExp v t.a.1)
          (toLoc v ν * toLoc v (primeGen R v) ^ (2 - (idealExp v t.a.1 : ℤ))) := by
    apply Finset.prod_congr rfl
    intro v hvf
    have hj : digitExponent r v = frozenJ t v := by
      apply Fin.ext
      exact hrow.2.2.2 v (t.active.2.1 v hvf)
    rw [hj, horder v hvf]
    have he : (idealExp v t.a.1 : ℤ) - 2 + 2 = (idealExp v t.a.1 : ℤ) := by ring
    have ht : -((idealExp v t.a.1 : ℤ) - 2) = 2 - (idealExp v t.a.1 : ℤ) := by ring
    rw [he, ht]
  unfold rf_pairing_active_coefficient groupedExterior
  rw [hprod]

private theorem rf_pairing_frequency_indices
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (r : ReflectionRow S) (f : S.ExtIdeal) (hf : activeFactor R r.h f) (ν : Fˣ)
    (hν : rf_pairing_active_coefficient R r f ν ≠ 0) :
    ∃! p : {t : FrozenIndex R r.h // t.f = f} × S.SqfExtIdeal × Gamma S,
      IsCoprime (p.2.1.1 * p.1.1.n.1) (r.d.1 * f.1) ∧
        ν = (p.2.2.1 : Fˣ) * frozenFrequency R p.1.1 r.d p.2.1 := by
  classical
  have hmulDiv (g ε a c n d f : Fˣ) :
      g * (ε * a * c * n ^ 3 / (d * f) ^ 2) =
        g * ε * a * c * n ^ 3 / (d * f) ^ 2 := by
    rw [← mul_div_assoc]
    congr 1
    ac_rfl
  obtain ⟨acn, hacn, hacnUnique⟩ := rf_active_support_frequencies R r f hf ν hν
  let t0 : FrozenIndex R r.h :=
    { f := f
      a := acn.1
      n := acn.2.2
      u := 1
      active := hf
      numerator := hacn.1
      coprime := hacn.2.1.of_mul_left_right.of_mul_right_right }
  obtain ⟨ug, hug, hugUnique⟩ :=
    rf_pairing_unit_orbit R r.h t0 r.d acn.2.1 ν hacn.2.2
  let t : FrozenIndex R r.h := { t0 with u := ug.1 }
  refine ⟨(⟨t, rfl⟩, acn.2.1, ug.2), ⟨hacn.2.1, ?_⟩, ?_⟩
  · calc
      ν = (ug.2.1 : Fˣ) * (R.sheets.eps ug.1 : Fˣ) * bc.gen acn.1 *
          bc.gen (R.exterior.ofSqf acn.2.1) * bc.gen acn.2.2 ^ 3 /
            (bc.gen r.d * bc.gen f) ^ 2 := hug
      _ = (ug.2.1 : Fˣ) * frozenFrequency R t r.d acn.2.1 := by
        dsimp [frozenFrequency, t, t0]
        exact (hmulDiv (ug.2.1 : Fˣ) (R.sheets.eps ug.1 : Fˣ)
          (bc.gen acn.1) (bc.gen (R.exterior.ofSqf acn.2.1))
          (bc.gen acn.2.2) (bc.gen r.d) (bc.gen f)).symm
  · intro p' hp'
    rcases p' with ⟨⟨t', ht'f⟩, c', γ'⟩
    rcases hp' with ⟨hcp', hfreq'⟩
    have hdecomp' : ∃ ε : S.US,
        ν = (ε : Fˣ) * bc.gen t'.a * bc.gen (R.exterior.ofSqf c') *
          bc.gen t'.n ^ 3 / (bc.gen r.d * bc.gen f) ^ 2 := by
      refine ⟨γ'.1 * R.sheets.eps t'.u, ?_⟩
      rw [hfreq']
      dsimp [frozenFrequency]
      rw [ht'f]
      change (γ'.1 : Fˣ) *
        ((R.sheets.eps t'.u : Fˣ) * bc.gen t'.a * bc.gen (R.exterior.ofSqf c') *
          bc.gen t'.n ^ 3 / (bc.gen r.d * bc.gen f) ^ 2) =
        ((γ'.1 : Fˣ) * (R.sheets.eps t'.u : Fˣ)) * bc.gen t'.a *
          bc.gen (R.exterior.ofSqf c') * bc.gen t'.n ^ 3 /
            (bc.gen r.d * bc.gen f) ^ 2
      exact hmulDiv (γ'.1 : Fˣ) (R.sheets.eps t'.u : Fˣ)
        (bc.gen t'.a) (bc.gen (R.exterior.ofSqf c')) (bc.gen t'.n)
        (bc.gen r.d) (bc.gen f)
    have hnum' : activeNumerator R f t'.a := by
      simpa only [ht'f] using t'.numerator
    have hacn' : (t'.a, c', t'.n) = acn :=
      hacnUnique (t'.a, c', t'.n) ⟨hnum', hcp', hdecomp'⟩
    have ha' : t'.a = acn.1 := congrArg Prod.fst hacn'
    have hc' : c' = acn.2.1 := congrArg (fun q => q.2.1) hacn'
    have hn' : t'.n = acn.2.2 := congrArg (fun q => q.2.2) hacn'
    have hug' :
        ν = (γ'.1 : Fˣ) * (R.sheets.eps t'.u : Fˣ) * bc.gen t0.a *
          bc.gen (R.exterior.ofSqf acn.2.1) * bc.gen t0.n ^ 3 /
            (bc.gen r.d * bc.gen t0.f) ^ 2 := by
      rw [hfreq']
      dsimp [frozenFrequency, t0]
      rw [ha', hc', hn', ht'f]
      exact hmulDiv (γ'.1 : Fˣ) (R.sheets.eps t'.u : Fˣ)
        (bc.gen acn.1) (bc.gen (R.exterior.ofSqf acn.2.1))
        (bc.gen acn.2.2) (bc.gen r.d) (bc.gen f)
    have huγ' : (t'.u, γ') = ug := hugUnique (t'.u, γ') hug'
    have hu' : t'.u = ug.1 := congrArg Prod.fst huγ'
    have hγ' : γ' = ug.2 := congrArg Prod.snd huγ'
    have ht' : t' = t := by
      have hExt (x y : FrozenIndex R r.h)
          (hfx : x.f = y.f) (hax : x.a = y.a) (hnx : x.n = y.n) (hux : x.u = y.u) :
          x = y := by
        cases x
        cases y
        cases hfx
        cases hax
        cases hnx
        cases hux
        rfl
      exact hExt t' t ht'f ha' hn' hu'
    apply Prod.ext
    · exact Subtype.ext ht'
    · exact Prod.ext hc' hγ'

private theorem rf_pairing_frequency_reindex
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (r : ReflectionRow S) (f : S.ExtIdeal) (hf : activeFactor R r.h f)
    (g : Fˣ → ℂ)
    (hs : Summable (fun ν => rf_pairing_active_coefficient R r f ν * g ν)) :
    let term : {t : FrozenIndex R r.h // t.f = f} × S.SqfExtIdeal × Gamma S → ℂ :=
      fun p => if IsCoprime (p.2.1.1 * p.1.1.n.1) (r.d.1 * f.1) then
        groupedExterior R p.1.1 r.d (frozenFrequency R p.1.1 r.d p.2.1) *
          g ((p.2.2.1 : Fˣ) * frozenFrequency R p.1.1 r.d p.2.1) else 0
    Summable term ∧
      (∑' ν, rf_pairing_active_coefficient R r f ν * g ν) = ∑' p, term p := by
  classical
  let P := {t : FrozenIndex R r.h // t.f = f} × S.SqfExtIdeal × Gamma S
  let freq (p : P) : Fˣ := (p.2.2.1 : Fˣ) * frozenFrequency R p.1.1 r.d p.2.1
  let src (ν : Fˣ) : ℂ := rf_pairing_active_coefficient R r f ν * g ν
  let cp (p : P) : Prop := IsCoprime (p.2.1.1 * p.1.1.n.1) (r.d.1 * f.1)
  let term (p : P) : ℂ := if cp p then
    groupedExterior R p.1.1 r.d (frozenFrequency R p.1.1 r.d p.2.1) * g (freq p) else 0
  change Summable term ∧ (∑' ν, src ν) = ∑' p, term p
  have coeffEq (p : P) (hp : cp p) :
      rf_pairing_active_coefficient R r f (freq p) =
        groupedExterior R p.1.1 r.d (frozenFrequency R p.1.1 r.d p.2.1) := by
    have hcf : IsCoprime p.2.1.1 p.1.1.f.1 := by
      rw [p.1.property]
      exact hp.of_mul_left_left.of_mul_right_right
    dsimp only [freq]
    rw [rf_pairing_active_coefficient_gamma R r f]
    exact (congrArg (fun I : S.ExtIdeal => rf_pairing_active_coefficient R r I
      (frozenFrequency R p.1.1 r.d p.2.1)) p.1.property.symm).trans
        (rf_pairing_active_coefficient_frozen R r p.1.1 p.2.1 hcf)
  have valueEq (p : P) (hp : cp p) : src (freq p) = term p := by
    dsimp only [src, term]
    rw [if_pos hp, coeffEq p hp]
  have cpOfNonzero (p : P) (hp : term p ≠ 0) : cp p := by
    by_contra hcp
    exact hp (by simp only [term, if_neg hcp])
  have coeffOfNonzero (p : P) (hp : term p ≠ 0) :
      rf_pairing_active_coefficient R r f (freq p) ≠ 0 := by
    have hn : src (freq p) ≠ 0 := by
      rw [valueEq p (cpOfNonzero p hp)]
      exact hp
    exact (mul_ne_zero_iff.mp hn).1
  let i : Function.support term → Fˣ := fun p => freq p.1
  have hi : Function.Injective i := by
    intro x y hxy
    have hxcp := cpOfNonzero x.1 x.property
    have hycp := cpOfNonzero y.1 y.property
    obtain ⟨p, hp, hpUnique⟩ :=
      rf_pairing_frequency_indices R r f hf (freq x.1) (coeffOfNonzero x.1 x.property)
    have hx : x.1 = p := hpUnique x.1 ⟨hxcp, rfl⟩
    have hy : y.1 = p := hpUnique y.1 ⟨hycp, hxy⟩
    exact Subtype.ext (hx.trans hy.symm)
  have hcover : Function.support src ⊆ Set.range i := by
    intro ν hν
    have hcoeff : rf_pairing_active_coefficient R r f ν ≠ 0 :=
      (mul_ne_zero_iff.mp hν).1
    obtain ⟨p, hp, _⟩ := rf_pairing_frequency_indices R r f hf ν hcoeff
    have heq : src ν = term p := by
      rw [hp.2]
      exact valueEq p hp.1
    have hpnz : term p ≠ 0 := by
      rw [← heq]
      exact hν
    exact ⟨⟨p, hpnz⟩, hp.2.symm⟩
  have hvalue (p : Function.support term) : src (i p) = term p.1 :=
    valueEq p.1 (cpOfNonzero p.1 p.property)
  have hterm : HasSum term (∑' ν, src ν) :=
    (hasSum_iff_hasSum_of_ne_zero_bij i hi hcover hvalue).mp hs.hasSum
  exact ⟨hterm.summable, hterm.tsum_eq.symm⟩

private theorem rf_pairing_active_coefficient_unique
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (r : ReflectionRow S) (ν : Fˣ) (f₁ f₂ : S.ExtIdeal)
    (hf₁ : activeFactor R r.h f₁) (hf₂ : activeFactor R r.h f₂)
    (hn₁ : rf_pairing_active_coefficient R r f₁ ν ≠ 0)
    (hn₂ : rf_pairing_active_coefficient R r f₂ ν ≠ 0) :
    f₁ = f₂ := by
  classical
  have hrow := rf_pairing_row_support R r
  have hOrdInv (v : FinPlace F) (x : (v.adicCompletion F)ˣ) :
      ordv v x⁻¹ = -ordv v x := by
    have hm := rf_ordv_mul v x x⁻¹
    have hone : ordv v (1 : (v.adicCompletion F)ˣ) = 0 := by
      simp [ordv]
      rfl
    rw [mul_inv_cancel, hone] at hm
    linarith
  have hOrdDiv (v : FinPlace F) (x y : (v.adicCompletion F)ˣ) :
      ordv v (x / y) = ordv v x - ordv v y := by
    rw [div_eq_mul_inv, rf_ordv_mul, hOrdInv]
    ring
  have hOrdPow (v : FinPlace F) (x : (v.adicCompletion F)ˣ) (n : ℕ) :
      ordv v (x ^ n) = (n : ℤ) * ordv v x := by
    simpa only [zpow_natCast] using rf_ordv_zpow v x (n : ℤ)
  have hsub (fa fb : S.ExtIdeal)
      (hfa : activeFactor R r.h fa) (hfb : activeFactor R r.h fb)
      (hna : rf_pairing_active_coefficient R r fa ν ≠ 0)
      (hnb : rf_pairing_active_coefficient R r fb ν ≠ 0) :
      R.exterior.support fb ⊆ R.exterior.support fa := by
    intro v hvb
    by_contra hva
    have hvS := R.exterior.support_exterior fb v hvb
    have hvh := hfb.2.1 v hvb
    have hvd : v ∉ R.exterior.support r.d := by
      intro h
      exact Finset.disjoint_left.mp hrow.2.1 h hvh
    have hjh : idealExp v r.h.1 % 6 = 0 := by
      by_contra h
      exact hva (hfa.2.2 v hvh h)
    have hj : digitExponent r v = 0 := by
      apply Fin.ext
      exact (hrow.2.2.2 v hvh).trans hjh
    obtain ⟨acn, hacn, _⟩ := rf_active_support_frequencies R r fa hfa ν hna
    obtain ⟨ε, hν⟩ := hacn.2.2
    have hvaa : v ∉ R.exterior.support acn.1 := by
      intro h
      exact hva (hacn.1.1 v h)
    have hgen (I : S.ExtIdeal) :
        ordv v (toLoc v (bc.gen I)) = (idealExp v I.1 : ℤ) :=
      rf_ordv_toLoc_ofGen v hvS I (bc.gen I) (bc.gen_spec I).1
    have hgenZero (I : S.ExtIdeal) (hI : v ∉ R.exterior.support I) :
        ordv v (toLoc v (bc.gen I)) = 0 := by
      rw [hgen, rf_idealExp_zero_of_not_support R v I hI]
      norm_num
    have heps : ordv v (toLoc v (ε : Fˣ)) = 0 := by
      have hglobal : HeightOneSpectrum.valuation F v ((ε : Fˣ) : F) = 1 :=
        Set.unit_valuation_eq_one (S := (S.Sf : Set (FinPlace F))) (K := F) ε hvS
      have hloc : Valued.v (toLoc v (ε : Fˣ) : v.adicCompletion F) = 1 := by
        change Valued.v (algebraMap F (v.adicCompletion F) ((ε : Fˣ) : F)) = 1
        simpa only [HeightOneSpectrum.algebraMap_adicCompletion, Function.comp_apply,
          Algebra.algebraMap_self, RingHom.id_apply, v.valuedAdicCompletion_eq_valuation'] using hglobal
      rw [rf_ordv_local_log, hloc]
      simp
    have hνord : ordv v (toLoc v ν) =
        (idealExp v (R.exterior.ofSqf acn.2.1).1 : ℤ) + 3 * (idealExp v acn.2.2.1 : ℤ) := by
      rw [hν, map_div, map_mul, map_mul, map_mul, map_pow, map_pow, map_mul,
        hOrdDiv, rf_ordv_mul, rf_ordv_mul, rf_ordv_mul, hOrdPow, hOrdPow,
        rf_ordv_mul, heps, hgenZero acn.1 hvaa, hgenZero r.d hvd, hgenZero fa hva,
        hgen (R.exterior.ofSqf acn.2.1), hgen acn.2.2]
      ring
    have hnonneg : 0 ≤ ordv v (toLoc v ν) := by
      rw [hνord]
      positivity
    let x : (v.adicCompletion F)ˣ :=
      toLoc v ν * toLoc v (primeGen R v) ^ (-ordv v (toLoc v ν))
    have hxord : ordv v x = 0 := by
      dsimp only [x]
      rw [rf_ordv_mul, rf_ordv_zpow, rf_local_primeGen_ord R v hvS]
      ring
    have hxval := rf_localVal_one_of_ordv_zero v x hxord
    have hxunit : ArtinPrimitiveRoots.A1.Theta.IsLocUnit v x := by
      constructor
      · rw [HeightOneSpectrum.mem_adicCompletionIntegers, hxval]
      · rw [HeightOneSpectrum.mem_adicCompletionIntegers]
        simp only [Units.val_inv_eq_inv_val, map_inv₀, hxval, inv_one, le_refl]
    obtain ⟨_, _, _, _, _, _, _, hscale, hzero, _⟩ :=
      lem_reflection_local_Weyl R v hvS 0 (ordv v (toLoc v ν) + 2) x hxunit.1 hxunit.2
    have hpos : 0 < ordv v (toLoc v ν) + 2 := by omega
    have hfactorZero : localR R v 0 (ordv v (toLoc v ν) + 2) x = 0 := by
      rw [hscale hpos.le, hzero hpos (by norm_num : (0 : Fin 6) ≠ 4), zero_mul]
    have hbProd :
        (∏ w ∈ R.exterior.support fb,
          localR R w (digitExponent r w) (ordv w (toLoc w ν) + 2)
            (toLoc w ν * toLoc w (primeGen R w) ^ (-ordv w (toLoc w ν)))) ≠ 0 :=
      (mul_ne_zero_iff.mp ((mul_ne_zero_iff.mp hnb).1)).2
    have hvNonzero := (Finset.prod_ne_zero_iff.mp hbProd) v hvb
    apply hvNonzero
    rw [hj]
    exact hfactorZero
  have hs : R.exterior.support f₁ = R.exterior.support f₂ :=
    Finset.Subset.antisymm (hsub f₂ f₁ hf₂ hf₁ hn₂ hn₁) (hsub f₁ f₂ hf₁ hf₂ hn₁ hn₂)
  have hfactor (f : S.ExtIdeal) (hf : activeFactor R r.h f) :
      f.1 = ∏ v ∈ R.exterior.support f, v.asIdeal := by
    let c : S.SqfExtIdeal := ⟨f.1, f.property, hf.1⟩
    have hof : R.exterior.ofSqf c = f := Subtype.ext (R.exterior.ofSqf_val c)
    simpa only [hof] using rf_sqfIdeal_factorization R c
  apply Subtype.ext
  rw [hfactor f₁ hf₁, hfactor f₂ hf₂, hs]

private theorem rf_pairing_active_component_summable
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (r : ReflectionRow S) (f : S.ExtIdeal) (hf : activeFactor R r.h f)
    (g : Fˣ → ℂ)
    (hs : Summable (fun ν =>
      (∑ᶠ k : {k : S.ExtIdeal // activeFactor R r.h k},
        rf_pairing_active_coefficient R r k.1 ν) * g ν)) :
    Summable (fun ν => rf_pairing_active_coefficient R r f ν * g ν) := by
  classical
  let AF := {k : S.ExtIdeal // activeFactor R r.h k}
  letI : Fintype AF := (rf_pairing_activeFactor_finite R r.h).fintype
  let f0 : AF := ⟨f, hf⟩
  have hsingle (ν : Fˣ) (hν : rf_pairing_active_coefficient R r f ν ≠ 0) :
      (∑ k : AF, rf_pairing_active_coefficient R r k.1 ν) =
        rf_pairing_active_coefficient R r f ν := by
    apply Finset.sum_eq_single f0
    · intro k hk hkne
      by_contra hkn
      have heq : k.1 = f :=
        rf_pairing_active_coefficient_unique R r ν k.1 f k.property hf hkn hν
      exact hkne (Subtype.ext heq)
    · intro hn
      exact (hn (Finset.mem_univ f0)).elim
  have hle (ν : Fˣ) :
      ‖rf_pairing_active_coefficient R r f ν * g ν‖ ≤
        ‖(∑ᶠ k : AF, rf_pairing_active_coefficient R r k.1 ν) * g ν‖ := by
    by_cases hν : rf_pairing_active_coefficient R r f ν = 0
    · rw [hν, zero_mul, norm_zero]
      exact norm_nonneg _
    · rw [finsum_eq_sum_of_fintype, hsingle ν hν]
  exact Summable.of_norm
    (Summable.of_nonneg_of_le (fun _ => norm_nonneg _) hle hs.norm)

private theorem rf_pairing_rotated_pullback_integrable
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (u : UnitSix S) (ν : Fˣ) (l : ℝ) (hl : 0 < l) :
    Integrable (onUnits (fun y => rotated R u (S.diagU ν / y)))
      (R.sheets.sheet l) := by
  classical
  have hRot (x : ℝ) (hx : 0 < x) :
      Integrable (onUnits (rotated R u)) (R.sheets.sheet x) := by
    let m : S.FSˣ → ℂ := fun _ => 1
    have hm : Theta.SheetMultiplier S (onUnits m) := by
      refine ⟨R.chars.L u, 0, (fun _ => 1), ⟨1, ?_⟩, ?_⟩
      · intro κ
        simp
      · intro y
        simp only [onUnits, dif_pos (Units.isUnit y), m, zpow_zero, mul_one]
    let tensor : Fin (R.rotated u).J → S.FSˣ → ℂ := fun ℓ y =>
      (∏ v : S.Sf, (R.rotated u).ff ℓ v ((y : S.FS).1 v)) *
        ∏ w : InfinitePlace F, (R.rotated u).fc ℓ w ((y : S.FS).2 w)
    have hTensor (ℓ : Fin (R.rotated u).J) :
        Integrable (onUnits (tensor ℓ)) (R.sheets.sheet x) := by
      simpa only [tensor, m, one_mul] using
        a2_bridge_ANALYSIS_tensor (G := R.sheets) R.T.δ R.T.δ_pos
          (R.rotated u).J (R.rotated u).ff (R.rotated u).fc
          (R.rotated u).finite_bound (R.rotated u).complex_bound m hm ℓ x hx
    have hSum : onUnits (rotated R u) =
        fun y => ∑ ℓ : Fin (R.rotated u).J, onUnits (tensor ℓ) y := by
      funext y
      by_cases hy : IsUnit y
      · simp only [onUnits, dif_pos hy, tensor]
        exact R.rotated_eq u hy.unit
      · simp [onUnits, hy]
    rw [hSum]
    exact integrable_finsetSum Finset.univ (fun ℓ _ => hTensor ℓ)
  have hnorm : 0 < S.absS (S.diagU ν : S.FS) :=
    (a2_bridge_NORM D S).2.2.1 (S.diagU ν)
  have htranslate := a2_bridge_SHEET_transport (G := R.sheets)
    l⁻¹ (inv_pos.mpr hl) (S.diagU ν) (rotated R u)
      (by simpa only [div_eq_mul_inv] using (hRot
        (S.absS (S.diagU ν : S.FS) / l) (div_pos hnorm hl)))
  have hinvert := a2_bridge_SHEET_inversion (G := R.sheets) l hl
    (fun y => rotated R u (S.diagU ν * y)) htranslate.1
  simpa only [div_eq_mul_inv] using hinvert.1

private theorem rf_pairing_masked_whittaker_factorization
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (r : ReflectionRow S) (ν : Fˣ) (y : S.FSˣ) (d : Digits R r) :
    R.T.W (R.chars.L (rowClass R r))
      (R.C.rat (diagGL ν) * R.C.rat weylGL * digitPoint R r y d) =
      sCocycle (D := D) (H := H) (S.diagU ν) y⁻¹ *
        rotated R (rowClass R r) (S.diagU ν / y) *
        (∏ v : {v : FinPlace F // v ∈ R.exterior.support r.ideal},
          R.T.Wv v.1 (R.C.a v.1 (toLoc v.1 ν) * R.C.w v.1 *
            R.C.n v.1 (Multiplicative.ofAdd (algebraMap F _
              (algebraMap (𝓞 F) F (d v).out / (primeGen R v.1 : F)))))) *
        (∏ᶠ (v : FinPlace F) (_ : v ∉ S.Sf ∧ v ∉ R.exterior.support r.ideal),
          R.T.Wv v (R.C.a v (toLoc v ν))) := by
  classical
  let T0 := R.exterior.support r.ideal
  let V := {v : FinPlace F // v ∈ T0}
  let sPart : ℂ := sCocycle (D := D) (H := H) (S.diagU ν) y⁻¹ *
    rotated R (rowClass R r) (S.diagU ν / y)
  let tail : ℂ :=
    ∏ᶠ (v : FinPlace F) (_ : v ∉ S.Sf ∧ v ∉ T0),
      R.T.Wv v (R.C.a v (toLoc v ν))
  let localWeyl (v : FinPlace F) (x : 𝓞 F ⧸ v.asIdeal) : ℂ :=
    R.T.Wv v (R.C.a v (toLoc v ν) * R.C.w v *
      R.C.n v (Multiplicative.ofAdd (algebraMap F _
        (algebraMap (𝓞 F) F x.out / (primeGen R v : F)))))
  have hw : R.C.wS * R.C.aS y = R.C.aS y⁻¹ * R.C.wS := by
    calc
      R.C.wS * R.C.aS y = (R.C.wS * R.C.aS y * R.C.wS⁻¹) * R.C.wS := by group
      _ = R.C.aS y⁻¹ * R.C.wS := by rw [R.C.liftS_wa]
  have hS : R.T.WS (R.chars.L (rowClass R r))
      (R.C.aS (S.diagU ν) * R.C.wS * R.C.aS y) = sPart := by
    rw [mul_assoc, hw, ← mul_assoc, R.C.aS_mul, mul_assoc,
      R.T.WS_genuine (R.chars.L (rowClass R r)) (R.mem_family (rowClass R r))]
    simp [sPart, rotated, sCocycle, muThree, map_pow, div_eq_mul_inv]
  have hFactor (d : Digits R r) :
      R.T.W (R.chars.L (rowClass R r))
        (R.C.rat (diagGL ν) * R.C.rat weylGL * digitPoint R r y d) =
      sPart * (∏ v : V, localWeyl v.1 (d v)) * tail := by
    let g : FinPlace F → R.C.G := fun v =>
      if hv : v ∈ T0 then
        R.C.n v (Multiplicative.ofAdd (algebraMap F (v.adicCompletion F)
          (algebraMap (𝓞 F) F (d ⟨v, hv⟩).out / (primeGen R v : F))))
      else 1
    have hg : ∀ v ∈ T0, g v ∈ R.C.Gloc v := by
      intro v hv
      simp [g, hv]
      exact R.C.n_mem v _
    have hT0ext : ∀ v ∈ T0, v ∉ S.Sf :=
      fun v hv => R.exterior.support_exterior r.ideal v hv
    have hmapDigit : T0.attach.toList.map (fun v =>
        R.C.n v.1 (Multiplicative.ofAdd (algebraMap F (v.1.adicCompletion F)
          (algebraMap (𝓞 F) F (d v).out / (primeGen R v.1 : F))))) =
        T0.attach.toList.map (fun v => g v.1) := by
      apply List.map_congr_left
      intro v hv
      simp [g, v.2]
    have hperm0 : (T0.attach.toList.map Subtype.val).Perm T0.toList := by
      apply List.perm_of_nodup_nodup_toFinset_eq
      · exact (T0.attach.nodup_toList).map Subtype.val_injective
      · exact T0.nodup_toList
      · ext v
        simp
    have hpermG :
        (T0.attach.toList.map (fun v => g v.1)).Perm (T0.toList.map g) := by
      change List.Perm (List.map (g ∘ Subtype.val) T0.attach.toList) (List.map g T0.toList)
      simpa only [List.map_map] using hperm0.map g
    have hpairNe : (T0.attach.toList).Pairwise (· ≠ ·) :=
      List.nodup_iff_pairwise_ne.mp T0.attach.nodup_toList
    have hpairG : (T0.attach.toList.map (fun v => g v.1)).Pairwise Commute := by
      exact List.Pairwise.map (fun v : {v // v ∈ T0} => g v.1)
        (by
          intro v w hne
          have hplaces : v.1 ≠ w.1 := by
            intro heq
            apply hne
            exact Subtype.ext heq
          exact R.C.comm_loc v.1 w.1 hplaces (g v.1) (hg v.1 v.2)
            (g w.1) (hg w.1 w.2))
        hpairNe
    have harg : R.C.rat (diagGL ν) * R.C.rat weylGL * digitPoint R r y d =
        (R.C.rat (diagGL ν) * R.C.rat weylGL * R.C.aS y) *
          (T0.toList.map g).prod := by
      rw [digitPoint, hmapDigit]
      calc
        (R.C.rat (diagGL ν) * R.C.rat weylGL) *
            (R.C.aS y * (T0.attach.toList.map (fun v => g v.1)).prod) =
            (R.C.rat (diagGL ν) * R.C.rat weylGL * R.C.aS y) *
              (T0.attach.toList.map (fun v => g v.1)).prod := by simp only [mul_assoc]
        _ = _ := by rw [List.Perm.prod_eq' hpermG hpairG]
    have hProduct :
        (∏ v ∈ T0, R.T.Wv v (R.C.a v (toLoc v ν) * R.C.w v * g v)) =
          ∏ v : V, localWeyl v.1 (d v) := by
      rw [← Finset.prod_coe_sort T0]
      apply Finset.prod_congr rfl
      intro v hv
      simp [g, v.2, localWeyl]
    have h := R.T.factor (R.chars.L (rowClass R r))
      (R.mem_family (rowClass R r)) ν true (R.C.aS y) (R.C.aS_mem y)
      T0 hT0ext g hg
    simp only [↓reduceIte] at h
    rw [← harg, hS, hProduct] at h
    exact h
  change R.T.W (R.chars.L (rowClass R r))
      (R.C.rat (diagGL ν) * R.C.rat weylGL * digitPoint R r y d) =
    sPart * (∏ v : V, localWeyl v.1 (d v)) * tail
  exact hFactor d

private theorem rf_pairing_masked_integrable
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (r : ReflectionRow S) (d : Digits R r) (ν : Fˣ)
    (l : ℝ) (hl : 0 < l) :
    let W : S.FSˣ → ℂ := fun y =>
      R.T.W (R.chars.L (rowClass R r))
        (R.C.rat (diagGL ν) * R.C.rat weylGL * digitPoint R r y d)
    Integrable (fun y : S.FS => ‖onUnits W y‖) (R.sheets.sheet l) ∧
      Integrable (onUnits (fun y => bCut (Bd := Bd) y *
        (Lvalue R (rowClass R r) y)⁻¹ * W y)) (R.sheets.sheet l) := by
  classical
  let u := rowClass R r
  let W : S.FSˣ → ℂ := fun y => R.T.W (R.chars.L u)
    (R.C.rat (diagGL ν) * R.C.rat weylGL * digitPoint R r y d)
  let rot : S.FSˣ → ℂ := fun y => rotated R u (S.diagU ν / y)
  let cext : ℂ :=
    (∏ v : {v : FinPlace F // v ∈ R.exterior.support r.ideal},
      R.T.Wv v.1 (R.C.a v.1 (toLoc v.1 ν) * R.C.w v.1 *
        R.C.n v.1 (Multiplicative.ofAdd (algebraMap F _
          (algebraMap (𝓞 F) F (d v).out / (primeGen R v.1 : F)))))) *
    (∏ᶠ (v : FinPlace F) (_ : v ∉ S.Sf ∧ v ∉ R.exterior.support r.ideal),
      R.T.Wv v (R.C.a v (toLoc v ν)))
  change Integrable (fun y : S.FS => ‖onUnits W y‖) (R.sheets.sheet l) ∧
    Integrable (onUnits (fun y => bCut (Bd := Bd) y *
      (Lvalue R u y)⁻¹ * W y)) (R.sheets.sheet l)
  have hW (y : S.FSˣ) : W y =
      sCocycle (D := D) (H := H) (S.diagU ν) y⁻¹ * rot y * cext := by
    dsimp only [W, u, rot, cext]
    rw [rf_pairing_masked_whittaker_factorization R r ν y d]
    ac_rfl
  have hCocNorm (y : S.FSˣ) :
      ‖sCocycle (D := D) (H := H) (S.diagU ν) y⁻¹‖ = 1 := by
    unfold sCocycle
    rw [← R.pairing.pair_eq, norm_pow, R.pairing.unitary]
    norm_num
  have hNormEq : (fun y : S.FS => ‖onUnits W y‖) =
      fun y => ‖cext‖ * ‖onUnits rot y‖ := by
    funext y
    by_cases hy : IsUnit y
    · simp only [onUnits, dif_pos hy, hW, norm_mul, hCocNorm, one_mul]
      ac_rfl
    · simp [onUnits, hy]
  have hRot := rf_pairing_rotated_pullback_integrable R u ν l hl
  change Integrable (onUnits rot) (R.sheets.sheet l) at hRot
  constructor
  · rw [hNormEq]
    exact hRot.norm.const_mul ‖cext‖
  · let κ : S.V := cls (S.diagU ν)
    let g : S.FSˣ → ℂ := fun y =>
      (if κ * (cls y)⁻¹ ∈ Bd.B then 1 else 0) *
        R.pairing.pair κ (cls y) ^ 2 * Lvalue R u y * rotated R u y
    let z : ℂ := (Lvalue R u (S.diagU ν))⁻¹
    let signed : S.FSˣ → ℂ := fun y =>
      bCut (Bd := Bd) y * (Lvalue R u y)⁻¹ *
        sCocycle (D := D) (H := H) (S.diagU ν) y⁻¹ * rot y
    have hSigned (y : S.FSˣ) : signed y = z * g (S.diagU ν / y) := by
      have hm := rf_S_orbit_multiplier R u (1 : Gamma S) ν y
      have hOne : ((1 : Gamma S).1 : Fˣ) = 1 := rfl
      rw [hOne, one_mul] at hm
      dsimp only [signed, rot, g, z, κ]
      rw [hm]
      ring
    have hProfile := (rf_S_profile_pullback R u ν l hl).1
    change Integrable (onUnits (fun y => g (S.diagU ν / y)))
      (R.sheets.sheet l) at hProfile
    have hSignedEq : onUnits signed =
        fun y : S.FS => z * onUnits (fun x => g (S.diagU ν / x)) y := by
      funext y
      by_cases hy : IsUnit y
      · simp only [onUnits, dif_pos hy, hSigned]
      · simp [onUnits, hy]
    have hSignedInt : Integrable (onUnits signed) (R.sheets.sheet l) := by
      rw [hSignedEq]
      exact hProfile.const_mul z
    have hWeightedEq : onUnits (fun y => bCut (Bd := Bd) y *
        (Lvalue R u y)⁻¹ * W y) =
        fun y : S.FS => cext * onUnits signed y := by
      funext y
      by_cases hy : IsUnit y
      · simp only [onUnits, dif_pos hy, hW, signed]
        ring
      · simp [onUnits, hy]
    rw [hWeightedEq]
    exact hSignedInt.const_mul cext

private theorem rf_pairing_masked_norm_integral_bound
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (r : ReflectionRow S) (d : Digits R r) (ν : Fˣ)
    (l : ℝ) (hl : 0 < l) :
    let W : S.FSˣ → ℂ := fun y =>
      R.T.W (R.chars.L (rowClass R r))
        (R.C.rat (diagGL ν) * R.C.rat weylGL * digitPoint R r y d)
    (∫ y in omegaAt R l,
      ‖onUnits (fun x => digitAlpha R r d * bCut (Bd := Bd) x *
        (Lvalue R (rowClass R r) x)⁻¹ * W x) y‖ ∂(R.sheets.sheet l)) ≤
      ‖digitAlpha R r d‖ *
        (omegaInt R l (fun y => (‖W y‖ : ℂ))).re := by
  classical
  let u := rowClass R r
  let W : S.FSˣ → ℂ := fun y => R.T.W (R.chars.L u)
    (R.C.rat (diagGL ν) * R.C.rat weylGL * digitPoint R r y d)
  let w : S.FSˣ → ℂ := fun y =>
    bCut (Bd := Bd) y * (Lvalue R u y)⁻¹ * W y
  let g : S.FSˣ → ℂ := fun y =>
    digitAlpha R r d * bCut (Bd := Bd) y * (Lvalue R u y)⁻¹ * W y
  let m := (R.sheets.sheet l).restrict (omegaAt R l)
  change (∫ y, ‖onUnits g y‖ ∂m) ≤
    ‖digitAlpha R r d‖ * (omegaInt R l (fun y => (‖W y‖ : ℂ))).re
  have hData := rf_pairing_masked_integrable R r d ν l hl
  change Integrable (fun y : S.FS => ‖onUnits W y‖) (R.sheets.sheet l) ∧
    Integrable (onUnits w) (R.sheets.sheet l) at hData
  have hConst : onUnits g = fun y : S.FS => digitAlpha R r d * onUnits w y := by
    funext y
    by_cases hy : IsUnit y
    · simp only [onUnits, dif_pos hy, g, w, mul_assoc]
    · simp [onUnits, hy]
  have hG : Integrable (onUnits g) m := by
    rw [hConst]
    exact (hData.2.const_mul (digitAlpha R r d)).restrict
  have hNorm : Integrable (fun y : S.FS => ‖onUnits W y‖) m := hData.1.restrict
  have hBnorm (y : S.FSˣ) : ‖bCut (Bd := Bd) y‖ ≤ 1 := by
    unfold bCut
    split_ifs <;> simp
  have hLinvNorm (y : S.FSˣ) : ‖(Lvalue R u y)⁻¹‖ = 1 := by
    rw [norm_inv]
    have hLnorm : ‖Lvalue R u y‖ = 1 := by
      simpa only [Lvalue] using (R.chars.L u).unitary y
    rw [hLnorm, inv_one]
  have hDom (y : S.FS) : ‖onUnits g y‖ ≤
      ‖digitAlpha R r d‖ * ‖onUnits W y‖ := by
    by_cases hy : IsUnit y
    · simp only [onUnits, dif_pos hy, g, norm_mul, hLinvNorm, mul_one]
      calc
        ‖digitAlpha R r d‖ * ‖bCut (Bd := Bd) hy.unit‖ * ‖W hy.unit‖ =
            ‖digitAlpha R r d‖ * (‖bCut (Bd := Bd) hy.unit‖ * ‖W hy.unit‖) :=
          mul_assoc _ _ _
        _ ≤ ‖digitAlpha R r d‖ * ‖W hy.unit‖ :=
          mul_le_mul_of_nonneg_left
            (by simpa only [one_mul] using
              mul_le_mul_of_nonneg_right (hBnorm hy.unit) (norm_nonneg (W hy.unit)))
            (norm_nonneg _)
    · simp [onUnits, hy]
  have hLift : onUnits (fun y => (‖W y‖ : ℂ)) =
      fun y : S.FS => (‖onUnits W y‖ : ℂ) := by
    funext y
    by_cases hy : IsUnit y <;> simp [onUnits, hy]
  have hRe : (omegaInt R l (fun y => (‖W y‖ : ℂ))).re =
      ∫ y, ‖onUnits W y‖ ∂m := by
    change (∫ y, onUnits (fun x => (‖W x‖ : ℂ)) y ∂m).re = _
    rw [hLift, integral_complex_ofReal, Complex.ofReal_re]
  rw [hRe, ← integral_const_mul]
  exact integral_mono_ae hG.norm (hNorm.const_mul ‖digitAlpha R r d‖)
    (Filter.Eventually.of_forall hDom)

private theorem rf_pairing_orbit_norm_integrals
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (u : UnitSix S) (ν : Fˣ) (l : ℝ) (hl : 0 < l) :
    let w : Gamma S → S.FSˣ → ℂ := fun γ y =>
      bCut (Bd := Bd) y * (Lvalue R u y)⁻¹ *
        sCocycle (D := D) (H := H) (S.diagU ((γ.1 : Fˣ) * ν)) y⁻¹ *
          rotated R u (S.diagU ((γ.1 : Fˣ) * ν) / y)
    (∀ γ, IntegrableOn (onUnits (w γ)) (omegaAt R l) (R.sheets.sheet l)) ∧
      Summable (fun γ => ∫ y in omegaAt R l, ‖onUnits (w γ) y‖
        ∂(R.sheets.sheet l)) ∧
      (∑' γ, ∫ y in omegaAt R l, ‖onUnits (w γ) y‖ ∂(R.sheets.sheet l)) ≤
        profileAbs R u (S.absS (S.diagU ν : S.FS) / l) := by
  classical
  let w : Gamma S → S.FSˣ → ℂ := fun γ y =>
    bCut (Bd := Bd) y * (Lvalue R u y)⁻¹ *
      sCocycle (D := D) (H := H) (S.diagU ((γ.1 : Fˣ) * ν)) y⁻¹ *
        rotated R u (S.diagU ((γ.1 : Fˣ) * ν) / y)
  let m := (R.sheets.sheet l).restrict (omegaAt R l)
  let major : Gamma S → S.FSˣ → ℂ := fun γ y =>
    (rotatedAbs R u (S.diagU ((γ.1 : Fˣ) * ν) / y) : ℂ)
  change (∀ γ, Integrable (onUnits (w γ)) m) ∧
    Summable (fun γ => ∫ y, ‖onUnits (w γ) y‖ ∂m) ∧
    (∑' γ, ∫ y, ‖onUnits (w γ) y‖ ∂m) ≤
      profileAbs R u (S.absS (S.diagU ν : S.FS) / l)
  obtain ⟨C, hC, hRef⟩ := rf_reflected_absolute R 1 (by norm_num)
  have hAbs := hRef u ν l hl
  change (∀ γ, Integrable (onUnits (major γ)) m) ∧
    Summable (fun γ => (∫ y, onUnits (major γ) y ∂m).re) ∧
    (∑' γ, (∫ y, onUnits (major γ) y ∂m).re) =
      profileAbs R u (S.absS (S.diagU ν : S.FS) / l) ∧
    profileAbs R u (S.absS (S.diagU ν : S.FS) / l) ≤
      C * (S.absS (S.diagU ν : S.FS) / l) ^ (-1 : ℝ) at hAbs
  have hSignedInt (γ : Gamma S) : Integrable (onUnits (w γ)) (R.sheets.sheet l) := by
    let ν0 : Fˣ := (γ.1 : Fˣ) * ν
    let κ : S.V := cls (S.diagU ν0)
    let g : S.FSˣ → ℂ := fun y =>
      (if κ * (cls y)⁻¹ ∈ Bd.B then 1 else 0) *
        R.pairing.pair κ (cls y) ^ 2 * Lvalue R u y * rotated R u y
    let z : ℂ := (Lvalue R u (S.diagU ν0))⁻¹
    have hSigned (y : S.FSˣ) : w γ y = z * g (S.diagU ν0 / y) := by
      have hm := rf_S_orbit_multiplier R u (1 : Gamma S) ν0 y
      have hOne : ((1 : Gamma S).1 : Fˣ) = 1 := rfl
      rw [hOne, one_mul] at hm
      change bCut (Bd := Bd) y * (Lvalue R u y)⁻¹ *
        sCocycle (D := D) (H := H) (S.diagU ν0) y⁻¹ *
          rotated R u (S.diagU ν0 / y) = z * g (S.diagU ν0 / y)
      dsimp only [g, z, κ]
      rw [hm]
      ring
    have hProfile := (rf_S_profile_pullback R u ν0 l hl).1
    change Integrable (onUnits (fun y => g (S.diagU ν0 / y)))
      (R.sheets.sheet l) at hProfile
    have hEq : onUnits (w γ) = fun y : S.FS =>
        z * onUnits (fun x => g (S.diagU ν0 / x)) y := by
      funext y
      by_cases hy : IsUnit y
      · simp only [onUnits, dif_pos hy, hSigned]
      · simp [onUnits, hy]
    rw [hEq]
    exact hProfile.const_mul z
  have hInt (γ : Gamma S) : Integrable (onUnits (w γ)) m := (hSignedInt γ).restrict
  have hRotNorm (y : S.FSˣ) : ‖rotated R u y‖ ≤ rotatedAbs R u y := by
    calc
      ‖rotated R u y‖ =
          ‖∑ ℓ : Fin (R.rotated u).J,
            (∏ v : S.Sf, (R.rotated u).ff ℓ v ((y : S.FS).1 v)) *
              ∏ a : InfinitePlace F, (R.rotated u).fc ℓ a ((y : S.FS).2 a)‖ := by
        simpa only [rotated, Theta.sumProd] using congrArg norm (R.rotated_eq u y)
      _ ≤ ∑ ℓ : Fin (R.rotated u).J,
          ‖(∏ v : S.Sf, (R.rotated u).ff ℓ v ((y : S.FS).1 v)) *
            ∏ a : InfinitePlace F, (R.rotated u).fc ℓ a ((y : S.FS).2 a)‖ :=
        norm_sum_le _ _
      _ = rotatedAbs R u y := by simp only [rotatedAbs, norm_mul, norm_prod]
  have hBnorm (y : S.FSˣ) : ‖bCut (Bd := Bd) y‖ ≤ 1 := by
    unfold bCut
    split_ifs <;> simp
  have hLinvNorm (y : S.FSˣ) : ‖(Lvalue R u y)⁻¹‖ = 1 := by
    rw [norm_inv]
    have hLnorm : ‖Lvalue R u y‖ = 1 := by
      simpa only [Lvalue] using (R.chars.L u).unitary y
    rw [hLnorm, inv_one]
  have hCocNorm (γ : Gamma S) (y : S.FSˣ) :
      ‖sCocycle (D := D) (H := H) (S.diagU ((γ.1 : Fˣ) * ν)) y⁻¹‖ = 1 := by
    unfold sCocycle
    rw [← R.pairing.pair_eq, norm_pow, R.pairing.unitary]
    norm_num
  have hDom (γ : Gamma S) (y : S.FS) :
      ‖onUnits (w γ) y‖ ≤ (onUnits (major γ) y).re := by
    by_cases hy : IsUnit y
    · simp only [onUnits, dif_pos hy, w, major, norm_mul,
        hLinvNorm, hCocNorm, mul_one, Complex.ofReal_re]
      calc
        ‖bCut (Bd := Bd) hy.unit‖ *
            ‖rotated R u (S.diagU ((γ.1 : Fˣ) * ν) / hy.unit)‖ ≤
            1 * ‖rotated R u (S.diagU ((γ.1 : Fˣ) * ν) / hy.unit)‖ :=
          mul_le_mul_of_nonneg_right (hBnorm hy.unit) (norm_nonneg _)
        _ = ‖rotated R u (S.diagU ((γ.1 : Fˣ) * ν) / hy.unit)‖ := one_mul _
        _ ≤ rotatedAbs R u (S.diagU ((γ.1 : Fˣ) * ν) / hy.unit) := hRotNorm _
    · simp [onUnits, hy]
  have hLe (γ : Gamma S) :
      (∫ y, ‖onUnits (w γ) y‖ ∂m) ≤ (∫ y, onUnits (major γ) y ∂m).re := by
    calc
      _ ≤ ∫ y, (onUnits (major γ) y).re ∂m :=
        integral_mono_ae (hInt γ).norm (hAbs.1 γ).re
          (Filter.Eventually.of_forall (hDom γ))
      _ = _ := integral_re (hAbs.1 γ)
  have hNonneg (γ : Gamma S) : 0 ≤ ∫ y, ‖onUnits (w γ) y‖ ∂m :=
    integral_nonneg (fun y => norm_nonneg _)
  have hs : Summable (fun γ => ∫ y, ‖onUnits (w γ) y‖ ∂m) :=
    Summable.of_nonneg_of_le hNonneg hLe hAbs.2.1
  refine ⟨hInt, hs, ?_⟩
  calc
    _ ≤ ∑' γ, (∫ y, onUnits (major γ) y ∂m).re := hs.tsum_le_tsum hLe hAbs.2.1
    _ = _ := hAbs.2.2.1

private theorem rf_pairing_grouped_orbit_integrals
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (r : ReflectionRow S) (t : FrozenIndex R r.h) (c : S.SqfExtIdeal)
    (l : ℝ) (hl : 0 < l) :
    let ν := frozenFrequency R t r.d c
    let w : Gamma S → S.FSˣ → ℂ := fun γ y =>
      if IsCoprime (c.1 * t.n.1) (r.d.1 * t.f.1) then
        groupedExterior R t r.d ν *
          (bCut (Bd := Bd) y * (Lvalue R (rowClass R r) y)⁻¹ *
            sCocycle (D := D) (H := H) (S.diagU ((γ.1 : Fˣ) * ν)) y⁻¹ *
              rotated R (rowClass R r) (S.diagU ((γ.1 : Fˣ) * ν) / y))
      else 0
    (∀ γ, IntegrableOn (onUnits (w γ)) (omegaAt R l) (R.sheets.sheet l)) ∧
      Summable (fun γ => ∫ y in omegaAt R l, ‖onUnits (w γ) y‖
        ∂(R.sheets.sheet l)) ∧
      (∑' γ, ∫ y in omegaAt R l, ‖onUnits (w γ) y‖ ∂(R.sheets.sheet l)) ≤
        (betaIdeal R t.f t.a * qI c.1 ^ (-(1 / 2 : ℝ)) / qI t.n.1) *
          profileAbs R (rowClass R r) (S.absS (S.diagU ν : S.FS) / l) := by
  classical
  let u := rowClass R r
  let ν := frozenFrequency R t r.d c
  let z : ℂ := if IsCoprime (c.1 * t.n.1) (r.d.1 * t.f.1) then
    groupedExterior R t r.d ν else 0
  let orbit : Gamma S → S.FSˣ → ℂ := fun γ y =>
    bCut (Bd := Bd) y * (Lvalue R u y)⁻¹ *
      sCocycle (D := D) (H := H) (S.diagU ((γ.1 : Fˣ) * ν)) y⁻¹ *
        rotated R u (S.diagU ((γ.1 : Fˣ) * ν) / y)
  let w : Gamma S → S.FSˣ → ℂ := fun γ y =>
    if IsCoprime (c.1 * t.n.1) (r.d.1 * t.f.1) then
      groupedExterior R t r.d ν * orbit γ y else 0
  let m := (R.sheets.sheet l).restrict (omegaAt R l)
  let weight : ℝ := betaIdeal R t.f t.a * qI c.1 ^ (-(1 / 2 : ℝ)) / qI t.n.1
  change (∀ γ, Integrable (onUnits (w γ)) m) ∧
    Summable (fun γ => ∫ y, ‖onUnits (w γ) y‖ ∂m) ∧
    (∑' γ, ∫ y, ‖onUnits (w γ) y‖ ∂m) ≤
      weight * profileAbs R u (S.absS (S.diagU ν : S.FS) / l)
  have hpos (I : Ideal (𝓞 F)) (hI : I ≠ ⊥) : 0 < qI I := by
    unfold qI
    exact_mod_cast (Nat.pos_of_ne_zero (fun h => hI (Ideal.absNorm_eq_zero_iff.mp h)))
  have hc := hpos c.1 c.property.1.1
  have hn := hpos t.n.1 t.n.property.1
  have hβ : 0 ≤ betaIdeal R t.f t.a := rf_betaIdeal_nonneg R t.f t.a
  have hWeight : 0 ≤ weight := div_nonneg
    (mul_nonneg hβ (Real.rpow_nonneg hc.le _)) hn.le
  have hCoeff : ‖z‖ ≤ weight := by
    by_cases hcp : IsCoprime (c.1 * t.n.1) (r.d.1 * t.f.1)
    · let sd : Bd.B := ⟨cls (S.diagU (bc.gen r.d)), (bc.gen_spec r.d).2⟩
      let sc : Bd.B := ⟨cls (S.diagU (bc.gen (R.exterior.ofSqf c))),
        (bc.gen_spec (R.exterior.ofSqf c)).2⟩
      have hdn : IsCoprime r.d.1 t.n.1 :=
        hcp.of_mul_left_right.of_mul_right_left.symm
      have hcf : IsCoprime c.1 t.f.1 := hcp.of_mul_left_left.of_mul_right_right
      have hdc : IsCoprime r.d.1 c.1 :=
        hcp.of_mul_left_left.of_mul_right_left.symm
      have hfactor := (rf_exterior_factorization R).2 u r.h t sd sc r.d c
        r.d_squarefree (r.coprime.symm.mul_right hdn) hcf hdc rfl rfl
      have hLinv : ‖(Lvalue R u (S.diagU ν))⁻¹‖ = 1 := by
        rw [norm_inv]
        have hL : ‖Lvalue R u (S.diagU ν)‖ = 1 := by
          simpa only [Lvalue] using (R.chars.L u).unitary (S.diagU ν)
        rw [hL, inv_one]
      let w0 : ℝ := qI c.1 ^ (-(1 / 2 : ℝ)) / qI t.n.1
      have hw0 : 0 ≤ w0 := div_nonneg (Real.rpow_nonneg hc.le _) hn.le
      have hnorm : ‖groupedExterior R t r.d ν‖ =
          ‖frozenOmega R u t * frozenRho R u t sd r.d * frozenLambda R u t sc c *
            (w0 : ℂ) * chiIdealPow D r.d.1 (cgen R c) 3‖ := by
        calc
          _ = ‖groupedExterior R t r.d ν * (Lvalue R u (S.diagU ν))⁻¹‖ := by
            rw [norm_mul, hLinv, mul_one]
          _ = _ := congrArg norm hfactor
      have hb := (rf_exterior_factorization R).1 u r.h t
      have hχ := (a2_bridge_SYMBOL D S).ideal_norm_le r.d.1 (cgen R c) 3
      simp only [z, if_pos hcp]
      rw [hnorm]
      simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hw0]
      calc
        ‖frozenOmega R u t‖ * ‖frozenRho R u t sd r.d‖ * ‖frozenLambda R u t sc c‖ *
            w0 * ‖chiIdealPow D r.d.1 (cgen R c) 3‖ ≤
            betaIdeal R t.f t.a * 1 * 1 * w0 * 1 := by
          gcongr
          · exact hb.1
          · exact hb.2.1 sd r.d
          · exact hb.2.2 sc c
        _ = weight := by dsimp only [weight, w0]; ring
    · simpa only [z, if_neg hcp, norm_zero] using hWeight
  have hOrbit := rf_pairing_orbit_norm_integrals R u ν l hl
  change (∀ γ, Integrable (onUnits (orbit γ)) m) ∧
    Summable (fun γ => ∫ y, ‖onUnits (orbit γ) y‖ ∂m) ∧
    (∑' γ, ∫ y, ‖onUnits (orbit γ) y‖ ∂m) ≤
      profileAbs R u (S.absS (S.diagU ν : S.FS) / l) at hOrbit
  have hOn (γ : Gamma S) : onUnits (w γ) =
      fun y : S.FS => z * onUnits (orbit γ) y := by
    funext y
    by_cases hy : IsUnit y
    · by_cases hcp : IsCoprime (c.1 * t.n.1) (r.d.1 * t.f.1) <;>
        simp [onUnits, hy, w, z, hcp]
    · simp [onUnits, hy]
  have hInt (γ : Gamma S) : Integrable (onUnits (w γ)) m := by
    rw [hOn γ]
    exact (hOrbit.1 γ).const_mul z
  have hNorm (γ : Gamma S) : (∫ y, ‖onUnits (w γ) y‖ ∂m) =
      ‖z‖ * ∫ y, ‖onUnits (orbit γ) y‖ ∂m := by
    rw [hOn γ]
    simp_rw [norm_mul]
    exact integral_const_mul _ _
  have hs : Summable (fun γ => ∫ y, ‖onUnits (w γ) y‖ ∂m) :=
    (hOrbit.2.1.mul_left ‖z‖).congr (fun γ => (hNorm γ).symm)
  have hProfile : 0 ≤ profileAbs R u (S.absS (S.diagU ν : S.FS) / l) :=
    (rf_profile_abs_analysis R u).1 _
      (div_pos ((a2_bridge_NORM D S).2.2.1 (S.diagU ν)) hl)
  refine ⟨hInt, hs, ?_⟩
  calc
    _ = ∑' γ, ‖z‖ * ∫ y, ‖onUnits (orbit γ) y‖ ∂m := tsum_congr hNorm
    _ = ‖z‖ * ∑' γ, ∫ y, ‖onUnits (orbit γ) y‖ ∂m := hOrbit.2.1.tsum_mul_left _
    _ ≤ ‖z‖ * profileAbs R u (S.absS (S.diagU ν : S.FS) / l) :=
      mul_le_mul_of_nonneg_left hOrbit.2.2 (norm_nonneg _)
    _ ≤ weight * profileAbs R u (S.absS (S.diagU ν : S.FS) / l) :=
      mul_le_mul_of_nonneg_right hCoeff hProfile

private def rf_pairing_grouped_fourier_term
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0) (r : ReflectionRow S)
    (p : FrozenIndex R r.h × S.SqfExtIdeal × Gamma S) (y : S.FSˣ) : ℂ :=
  let ν := frozenFrequency R p.1 r.d p.2.1
  if IsCoprime (p.2.1.1 * p.1.n.1) (r.d.1 * p.1.f.1) then
    groupedExterior R p.1 r.d ν *
      (bCut (Bd := Bd) y * (Lvalue R (rowClass R r) y)⁻¹ *
        sCocycle (D := D) (H := H) (S.diagU ((p.2.2.1 : Fˣ) * ν)) y⁻¹ *
          rotated R (rowClass R r) (S.diagU ((p.2.2.1 : Fˣ) * ν) / y))
  else 0

private theorem rf_pairing_grouped_integral_norm_summable
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (r : ReflectionRow S) (l : ℝ) (hl : 0 < l) :
    (∀ p : FrozenIndex R r.h × S.SqfExtIdeal × Gamma S,
      IntegrableOn (onUnits (rf_pairing_grouped_fourier_term R r p))
        (omegaAt R l) (R.sheets.sheet l)) ∧
      Summable (fun p : FrozenIndex R r.h × S.SqfExtIdeal × Gamma S =>
        ∫ y in omegaAt R l, ‖onUnits (rf_pairing_grouped_fourier_term R r p) y‖
          ∂(R.sheets.sheet l)) := by
  classical
  let u := rowClass R r
  let P := FrozenIndex R r.h × S.SqfExtIdeal × Gamma S
  let J := FrozenIndex R r.h × S.SqfExtIdeal
  let m := (R.sheets.sheet l).restrict (omegaAt R l)
  let N : J × Gamma S → ℝ := fun p =>
    ∫ y, ‖onUnits (rf_pairing_grouped_fourier_term R r (p.1.1, p.1.2, p.2)) y‖ ∂m
  let weight : J → ℝ := fun q =>
    betaIdeal R q.1.f q.1.a * qI q.2.1 ^ (-(1 / 2 : ℝ)) / qI q.1.n.1
  let profile : J → ℝ := fun q => profileAbs R u
    (S.absS (S.diagU (frozenFrequency R q.1 r.d q.2) : S.FS) / l)
  let Q : J → ℝ := fun q => qI q.1.a.1 * qI q.2.1 * qI q.1.n.1 ^ 3
  let den : J → ℝ := fun q => qI r.d.1 ^ 2 * qI q.1.f.1 ^ 2
  have hEach (q : J) :
      (∀ γ, Integrable (onUnits (rf_pairing_grouped_fourier_term R r (q.1, q.2, γ))) m) ∧
      Summable (fun γ => N (q, γ)) ∧
      (∑' γ, N (q, γ)) ≤ weight q * profile q := by
    dsimp only [N, weight, profile, u, m, rf_pairing_grouped_fourier_term]
    exact rf_pairing_grouped_orbit_integrals R r q.1 q.2 l hl
  have hNnonneg (p : J × Gamma S) : 0 ≤ N p := integral_nonneg (fun y => norm_nonneg _)
  constructor
  · intro p
    exact (hEach (p.1, p.2.1)).1 p.2.2
  · obtain ⟨C, hC, hProfile⟩ := (rf_profile_bound R).2.2 1 (by norm_num)
    have hq (I : Ideal (𝓞 F)) : 0 ≤ qI I := by
      unfold qI
      exact Nat.cast_nonneg _
    have hWeight (q : J) : 0 ≤ weight q := div_nonneg
      (mul_nonneg (rf_betaIdeal_nonneg R q.1.f q.1.a)
        (Real.rpow_nonneg (hq q.2.1) _)) (hq q.1.n.1)
    have hMassBound (q : J) : (∑' γ, N (q, γ)) ≤
        C * (den q * l) *
          reflectedDirichletTerm R q.1.f 1 (⟨q.1.a, q.1.numerator⟩, q.2, q.1.n) := by
      let sd : Bd.B := ⟨cls (S.diagU (bc.gen r.d)), (bc.gen_spec r.d).2⟩
      let sc : Bd.B := ⟨cls (S.diagU (bc.gen (R.exterior.ofSqf q.2))),
        (bc.gen_spec (R.exterior.ofSqf q.2)).2⟩
      have hNorm : S.absS (S.diagU (frozenFrequency R q.1 r.d q.2) : S.FS) =
          Q q / den q :=
        (rf_pairing_frequency_norm_class R r.h q.1 r.d q.2 sd sc rfl rfl).1
      have hArg : 0 < S.absS (S.diagU (frozenFrequency R q.1 r.d q.2) : S.FS) / l :=
        div_pos ((a2_bridge_NORM D S).2.2.1
          (S.diagU (frozenFrequency R q.1 r.d q.2))) hl
      have hPower : (S.absS (S.diagU (frozenFrequency R q.1 r.d q.2) : S.FS) / l) ^
          (-1 : ℝ) = (den q * l) * (Q q) ^ (-1 : ℝ) := by
        rw [hNorm]
        simp only [Real.rpow_neg_one, div_eq_mul_inv, mul_inv_rev, inv_inv]
        ring
      calc
        _ ≤ weight q * profile q := (hEach q).2.2
        _ ≤ weight q * (C *
            (S.absS (S.diagU (frozenFrequency R q.1 r.d q.2) : S.FS) / l) ^ (-1 : ℝ)) :=
          mul_le_mul_of_nonneg_left (hProfile u _ hArg) (hWeight q)
        _ = _ := by
          rw [hPower]
          dsimp only [weight, Q, den, reflectedDirichletTerm]
          ring
    letI : Fintype (UnitSix S) := R.sheets.unitSixFinite
    let AF := {f : S.ExtIdeal // activeFactor R r.h f}
    letI : Fintype AF := (rf_pairing_activeFactor_finite R r.h).fintype
    let I := Σ f : AF, UnitSix S ×
      ({a : S.ExtIdeal // activeNumerator R f.1 a} × S.SqfExtIdeal × S.ExtIdeal)
    let e : J → I := fun q =>
      ⟨⟨q.1.f, q.1.active⟩, (q.1.u, (⟨q.1.a, q.1.numerator⟩, q.2, q.1.n))⟩
    let M : I → ℝ := fun p =>
      C * (qI r.d.1 ^ 2 * qI p.1.1.1 ^ 2 * l) *
        reflectedDirichletTerm R p.1.1 1 p.2.2
    have he : Function.Injective e := by
      intro p q hpq
      have hf : p.1.f = q.1.f := congrArg (fun z : I => z.1.1) hpq
      have ha : p.1.a = q.1.a := congrArg (fun z : I => z.2.2.1.1) hpq
      have hn : p.1.n = q.1.n := congrArg (fun z : I => z.2.2.2.2) hpq
      have hu : p.1.u = q.1.u := congrArg (fun z : I => z.2.1) hpq
      have hc : p.2 = q.2 := congrArg (fun z : I => z.2.2.2.1) hpq
      rcases p with ⟨⟨pf, pa, pn, pu, pactive, pnum, pcop⟩, pc⟩
      rcases q with ⟨⟨qf, qa, qn, qu, qactive, qnum, qcop⟩, qc⟩
      dsimp only at hf ha hn hu hc
      cases hf
      cases ha
      cases hn
      cases hu
      cases hc
      rfl
    have hDirNonneg (f : S.ExtIdeal)
        (p : {a : S.ExtIdeal // activeNumerator R f a} × S.SqfExtIdeal × S.ExtIdeal) :
        0 ≤ reflectedDirichletTerm R f 1 p := by
      unfold reflectedDirichletTerm
      exact mul_nonneg
        (div_nonneg
          (mul_nonneg (rf_betaIdeal_nonneg R f p.1) (Real.rpow_nonneg (hq p.2.1.1) _))
          (hq p.2.2.1))
        (Real.rpow_nonneg
          (mul_nonneg (mul_nonneg (hq p.1.1.1) (hq p.2.1.1))
            (pow_nonneg (hq p.2.2.1) 3)) _)
    have hMnonneg (p : I) : 0 ≤ M p :=
      mul_nonneg
        (mul_nonneg hC.le
          (mul_nonneg (mul_nonneg (sq_nonneg _) (sq_nonneg _)) hl.le))
        (hDirNonneg p.1.1 p.2.2)
    have hfiber (f : AF) : Summable (fun q : UnitSix S ×
        ({a : S.ExtIdeal // activeNumerator R f.1 a} × S.SqfExtIdeal × S.ExtIdeal) => M ⟨f, q⟩) := by
      apply (summable_prod_of_nonneg (fun q => hMnonneg ⟨f, q⟩)).2
      refine ⟨?_, Summable.of_finite⟩
      intro k
      exact (rf_reflected_dirichlet_mass R f.1 1 (by norm_num)).1.mul_left
        (C * (qI r.d.1 ^ 2 * qI f.1.1 ^ 2 * l))
    have hM : Summable M :=
      (summable_sigma_of_nonneg hMnonneg).2 ⟨hfiber, Summable.of_finite⟩
    have hsMass : Summable (fun q : J => ∑' γ, N (q, γ)) := by
      apply Summable.of_nonneg_of_le (fun q => tsum_nonneg (fun γ => hNnonneg (q, γ)))
        ?_ (hM.comp_injective he)
      intro q
      exact hMassBound q
    have hsJG : Summable N :=
      (summable_prod_of_nonneg hNnonneg).2 ⟨fun q => (hEach q).2.1, hsMass⟩
    let eP : J × Gamma S ≃ P :=
      Equiv.prodAssoc (FrozenIndex R r.h) S.SqfExtIdeal (Gamma S)
    have hsComp : Summable ((fun p : P =>
        ∫ y, ‖onUnits (rf_pairing_grouped_fourier_term R r p) y‖ ∂m) ∘ eP) := hsJG
    exact (eP.summable_iff).1 hsComp

private theorem rf_pairing_grouped_pointwise
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (r : ReflectionRow S) (y : S.FSˣ) :
    Summable (fun p : FrozenIndex R r.h × S.SqfExtIdeal × Gamma S =>
      rf_pairing_grouped_fourier_term R r p y) ∧
      bCut (Bd := Bd) y * (Lvalue R (rowClass R r) y)⁻¹ *
        digitSum R r true false y =
      bCut (Bd := Bd) y * (Lvalue R (rowClass R r) y)⁻¹ *
        digitSum R r true true y +
          ∑' p : FrozenIndex R r.h × S.SqfExtIdeal × Gamma S,
            rf_pairing_grouped_fourier_term R r p y := by
  classical
  let u := rowClass R r
  let α : ℂ := bCut (Bd := Bd) y * (Lvalue R u y)⁻¹
  let g : Fˣ → ℂ := fun ν => α *
    sCocycle (D := D) (H := H) (S.diagU ν) y⁻¹ * rotated R u (S.diagU ν / y)
  let Fterm : Fˣ → ℂ := fun ν =>
    ∑ᶠ d : Digits R r, digitAlpha R r d *
      R.T.W (R.chars.L u)
        (R.C.rat (diagGL ν) * R.C.rat weylGL * digitPoint R r y d)
  let AF := {f : S.ExtIdeal // activeFactor R r.h f}
  letI : Fintype AF := (rf_pairing_activeFactor_finite R r.h).fintype
  let src : Fˣ → ℂ := fun ν =>
    (∑ᶠ f : AF, rf_pairing_active_coefficient R r f.1 ν) * g ν
  let component : AF → Fˣ → ℂ := fun f ν =>
    rf_pairing_active_coefficient R r f.1 ν * g ν
  let K : AF → Type := fun f =>
    {t : FrozenIndex R r.h // t.f = f.1} × S.SqfExtIdeal × Gamma S
  let fiberTerm (f : AF) (p : K f) : ℂ :=
    rf_pairing_grouped_fourier_term R r (p.1.1, p.2.1, p.2.2) y
  let reindexTerm (f : AF) (p : K f) : ℂ :=
    if IsCoprime (p.2.1.1 * p.1.1.n.1) (r.d.1 * f.1.1) then
      groupedExterior R p.1.1 r.d (frozenFrequency R p.1.1 r.d p.2.1) *
        g ((p.2.2.1 : Fˣ) * frozenFrequency R p.1.1 r.d p.2.1) else 0
  have hFourier := rf_pairing_minus_fourier R r y
  change Summable Fterm ∧
    digitSum R r true false y = digitSum R r true true y + ∑' ν, Fterm ν at hFourier
  have hSourcePoint (ν : Fˣ) : α * Fterm ν = src ν := by
    dsimp only [Fterm, src, u]
    rw [rf_pairing_digit_active_partition R r ν y]
    dsimp only [g, u]
    ring
  have hSource : Summable src := (hFourier.1.mul_left α).congr hSourcePoint
  have hComponent (f : AF) : Summable (component f) :=
    rf_pairing_active_component_summable R r f.1 f.property g hSource
  have hTermEq (f : AF) (p : K f) : reindexTerm f p = fiberTerm f p := by
    dsimp only [reindexTerm, fiberTerm, rf_pairing_grouped_fourier_term, g, α, u]
    rw [p.1.property]
  have hReindex (f : AF) : Summable (fiberTerm f) ∧
      (∑' ν, component f ν) = ∑' p : K f, fiberTerm f p := by
    have h := rf_pairing_frequency_reindex R r f.1 f.property g (hComponent f)
    change Summable (reindexTerm f) ∧
      (∑' ν, component f ν) = ∑' p : K f, reindexTerm f p at h
    exact ⟨h.1.congr (hTermEq f), h.2.trans (tsum_congr (hTermEq f))⟩
  let P := FrozenIndex R r.h × S.SqfExtIdeal × Gamma S
  let I := Σ f : AF, K f
  let termI (p : I) : ℂ := fiberTerm p.1 p.2
  let e : P ≃ I := {
    toFun := fun p =>
      ⟨⟨p.1.f, p.1.active⟩, (⟨p.1, rfl⟩, p.2.1, p.2.2)⟩
    invFun := fun p => (p.2.1.1, p.2.2.1, p.2.2.2)
    left_inv := by
      intro p
      rcases p with ⟨t, c, γ⟩
      rfl
    right_inv := by
      intro p
      rcases p with ⟨⟨f, hf⟩, ⟨⟨t, ht⟩, c, γ⟩⟩
      cases ht
      rfl }
  have hsINorm : Summable (fun p : I => ‖termI p‖) :=
    (summable_sigma_of_nonneg (fun p : I => norm_nonneg (termI p))).2
      ⟨fun f => (hReindex f).1.norm, Summable.of_finite⟩
  have hsI : Summable termI := Summable.of_norm hsINorm
  have hsP : Summable (fun p : P => rf_pairing_grouped_fourier_term R r p y) :=
    (e.summable_iff).2 hsI
  have hFullSum : (∑' p : P, rf_pairing_grouped_fourier_term R r p y) =
      ∑ f : AF, ∑' p : K f, fiberTerm f p := by
    calc
      _ = ∑' p : I, termI p := e.tsum_eq termI
      _ = ∑' f : AF, ∑' p : K f, fiberTerm f p := hsI.tsum_sigma
      _ = _ := tsum_fintype _
  have hSourceAt (ν : Fˣ) : src ν = ∑ f : AF, component f ν := by
    dsimp only [src, component]
    rw [finsum_eq_sum_of_fintype, Finset.sum_mul]
  have hSourceSum : (∑' ν, src ν) = ∑ f : AF, ∑' ν, component f ν := by
    calc
      _ = ∑' ν, ∑ f : AF, component f ν := tsum_congr hSourceAt
      _ = _ := Summable.tsum_finsetSum (fun f _ => hComponent f)
  have hSums : (∑' ν, src ν) = ∑' p : P, rf_pairing_grouped_fourier_term R r p y := by
    rw [hSourceSum, hFullSum]
    apply Finset.sum_congr rfl
    intro f hf
    exact (hReindex f).2
  have hWeighted : α * (∑' ν, Fterm ν) = ∑' ν, src ν := by
    rw [← hFourier.1.tsum_mul_left α]
    exact tsum_congr hSourcePoint
  change Summable (fun p : P => rf_pairing_grouped_fourier_term R r p y) ∧
    α * digitSum R r true false y =
      α * digitSum R r true true y + ∑' p : P, rf_pairing_grouped_fourier_term R r p y
  refine ⟨hsP, ?_⟩
  rw [hFourier.2, mul_add, hWeighted, hSums]

private theorem rf_pairing_grouped_sheet_exchange
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (r : ReflectionRow S) (l : ℝ) (hl : 0 < l) :
    IntegrableOn (onUnits (fun y =>
      ∑' p : FrozenIndex R r.h × S.SqfExtIdeal × Gamma S,
        rf_pairing_grouped_fourier_term R r p y))
      (omegaAt R l) (R.sheets.sheet l) ∧
      (∫ y in omegaAt R l, onUnits (fun y =>
        ∑' p : FrozenIndex R r.h × S.SqfExtIdeal × Gamma S,
          rf_pairing_grouped_fourier_term R r p y) y ∂(R.sheets.sheet l)) =
        ∑' p : FrozenIndex R r.h × S.SqfExtIdeal × Gamma S,
          ∫ y in omegaAt R l,
            onUnits (rf_pairing_grouped_fourier_term R r p) y ∂(R.sheets.sheet l) := by
  classical
  letI : Countable F := Finsupp.Countable.of_moduleFinite (R := ℚ)
  letI : Countable (𝓞 F) := inferInstance
  have hspan : Function.Surjective
      (fun s : Finset (𝓞 F) => Ideal.span (s : Set (𝓞 F))) := by
    intro I
    exact Ideal.fg_of_isNoetherianRing I
  letI : Countable (Ideal (𝓞 F)) := hspan.countable
  letI : Countable S.ExtIdeal :=
    inferInstanceAs (Countable {I : Ideal (𝓞 F) // S.IsExterior I})
  letI : Countable S.SqfExtIdeal :=
    inferInstanceAs (Countable {I : Ideal (𝓞 F) // S.IsExterior I ∧ Squarefree I})
  letI : Fintype (UnitSix S) := R.sheets.unitSixFinite
  let i : FrozenIndex R r.h → S.ExtIdeal × S.ExtIdeal × S.ExtIdeal × UnitSix S :=
    fun t => (t.f, t.a, t.n, t.u)
  have hi : Function.Injective i := by
    intro t s h
    have hf : t.f = s.f := congrArg (fun p => p.1) h
    have ha : t.a = s.a := congrArg (fun p => p.2.1) h
    have hn : t.n = s.n := congrArg (fun p => p.2.2.1) h
    have hu : t.u = s.u := congrArg (fun p => p.2.2.2) h
    rcases t with ⟨tf, ta, tn, tu, tactive, tnum, tcop⟩
    rcases s with ⟨sf, sa, sn, su, sactive, snum, scop⟩
    dsimp only at hf ha hn hu
    cases hf
    cases ha
    cases hn
    cases hu
    rfl
  letI : Countable (FrozenIndex R r.h) := hi.countable
  letI : Countable (Gamma S) :=
    (a2_bridge_SHEET (D := D) (S := S) (G := R.sheets) l hl).2.2
  let P := FrozenIndex R r.h × S.SqfExtIdeal × Gamma S
  let m := (R.sheets.sheet l).restrict (omegaAt R l)
  let term (p : P) : S.FS → ℂ := onUnits (rf_pairing_grouped_fourier_term R r p)
  have hBase := rf_pairing_grouped_integral_norm_summable R r l hl
  change (∀ p : P, Integrable (term p) m) ∧
    Summable (fun p : P => ∫ y, ‖term p y‖ ∂m) at hBase
  have hPoint : ∀ᵐ y ∂m, Summable (fun p : P => ‖term p y‖) := by
    apply Filter.Eventually.of_forall
    intro y
    by_cases hy : IsUnit y
    · simpa only [term, onUnits, dif_pos hy] using
        (rf_pairing_grouped_pointwise R r hy.unit).1.norm
    · simp only [term, onUnits, dif_neg hy, norm_zero]
      exact summable_zero
  have hNorm := ArtinPrimitiveRoots.Proofs.a2_rffwd_sol.norm_series_integrable_of_integral_norm
    m term hBase.1 hPoint hBase.2
  have hExchange := ArtinPrimitiveRoots.Proofs.a2_rffwd_sol.integral_tsum_of_norm_sum
    m term (fun p => (hBase.1 p).1) hPoint hNorm
  have hEq : onUnits (fun y => ∑' p : P, rf_pairing_grouped_fourier_term R r p y) =
      fun y => ∑' p : P, term p y := by
    funext y
    by_cases hy : IsUnit y
    · simp only [onUnits, dif_pos hy, term]
    · simp [onUnits, hy, term]
  change Integrable (onUnits (fun y =>
    ∑' p : P, rf_pairing_grouped_fourier_term R r p y)) m ∧
      (∫ y, onUnits (fun y =>
        ∑' p : P, rf_pairing_grouped_fourier_term R r p y) y ∂m) =
          ∑' p : P, ∫ y, term p y ∂m
  rw [hEq]
  exact hExchange

private theorem rf_pairing_units_compact_lift
    (K : Set S.FS) (hK : IsCompact K)
    (hunit : ∀ y ∈ K, IsUnit y) :
    IsCompact ((Units.val : S.FSˣ → S.FS) ⁻¹' K) := by
  have hInv : ContinuousOn (fun y : S.FS => y⁻¹) K := by
    apply ContinuousOn.prodMk
    · apply continuousOn_pi.mpr
      intro v
      exact ((continuous_apply v).comp continuous_fst).continuousOn.inv₀
        (fun y hy => isUnit_iff_ne_zero.mp
          ((Pi.isUnit_iff.mp (Prod.isUnit_iff.mp (hunit y hy)).1) v))
    · apply continuousOn_pi.mpr
      intro w
      exact ((continuous_apply w).comp continuous_snd).continuousOn.inv₀
        (fun y hy => isUnit_iff_ne_zero.mp
          ((Pi.isUnit_iff.mp (Prod.isUnit_iff.mp (hunit y hy)).2) w))
  let graph : S.FS → S.FS × S.FSᵐᵒᵖ := fun y => (y, MulOpposite.op y⁻¹)
  have hgraph : ContinuousOn graph K :=
    continuous_id.continuousOn.prodMk
      ((MulOpposite.opHomeomorph : S.FS ≃ₜ S.FSᵐᵒᵖ).continuous.comp_continuousOn hInv)
  have hCompact : IsCompact ((Units.embedProduct S.FS) ⁻¹' (graph '' K)) :=
    Units.isClosedEmbedding_embedProduct.isCompact_preimage
      (hK.image_of_continuousOn hgraph)
  have hEq : (Units.embedProduct S.FS) ⁻¹' (graph '' K) =
      (Units.val : S.FSˣ → S.FS) ⁻¹' K := by
    ext z
    constructor
    · rintro ⟨y, hy, heq⟩
      have hval : y = (z : S.FS) := congrArg Prod.fst heq
      simpa only [Set.mem_preimage, hval] using hy
    · intro hz
      refine ⟨(z : S.FS), hz, ?_⟩
      simp [graph, Units.embedProduct]
  rwa [hEq] at hCompact

private theorem rf_pairing_constant_integrable
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (r : ReflectionRow S) (l : ℝ) (hl : 0 < l) :
    IntegrableOn (onUnits (fun y =>
      bCut (Bd := Bd) y * (Lvalue R (rowClass R r) y)⁻¹ *
        digitSum R r true true y))
      (omegaAt R l) (R.sheets.sheet l) := by
  classical
  letI : MeasurableSpace S.FSˣ := Units.instMeasurableSpace
  letI : OpensMeasurableSpace S.FSˣ := rf_FS_units_opensMeasurable
  let V := {v : FinPlace F // v ∈ R.exterior.support r.ideal}
  letI : ∀ v : V, Fintype (𝓞 F ⧸ v.1.asIdeal) := fun v => bridgeResidueFintype v.1
  letI : Fintype (Digits R r) := inferInstance
  let u := rowClass R r
  let c : S.FSˣ → ℂ := digitSum R r true true
  let tail (d : Digits R r) : R.C.G :=
    ((R.exterior.support r.ideal).attach.toList.map (fun v =>
      R.C.n v.1 (Multiplicative.ofAdd (algebraMap F _
        (algebraMap (𝓞 F) F (d v).out / (primeGen R v.1 : F)))))).prod
  have hDigit (d : Digits R r) : Continuous (fun y : S.FSˣ =>
      R.T.θN (R.chars.L u) (R.C.rat weylGL * digitPoint R r y d)) := by
    simpa only [u, tail, digitPoint, mul_assoc] using
      R.T.cont_N (R.chars.L u) (R.mem_family u) (R.C.rat weylGL) (tail d)
  have hc : Continuous c := by
    have hsum : Continuous (fun y : S.FSˣ =>
        ∑ d : Digits R r, digitAlpha R r d *
          R.T.θN (R.chars.L u) (R.C.rat weylGL * digitPoint R r y d)) :=
      continuous_finsetSum Finset.univ (fun d _ => continuous_const.mul (hDigit d))
    change Continuous (fun y : S.FSˣ => digitSum R r true true y)
    simpa [u, digitSum, finsum_eq_sum_of_fintype] using hsum
  have hAbs : Continuous S.absS := by
    unfold SData.absS
    apply Continuous.mul
    · apply continuous_finsetProd Finset.univ
      intro v hv
      have ha : Continuous (absFin v.1) := by
        convert (continuous_norm : Continuous fun x : v.1.adicCompletion F => ‖x‖) using 1
        ext x
        exact A1.Theta.absFin_eq_norm v.1 x
      exact ha.comp ((continuous_apply v).comp continuous_fst)
    · apply continuous_finsetProd Finset.univ
      intro w hw
      exact Complex.continuous_normSq.comp ((continuous_apply w).comp continuous_snd)
  have hUnit1 (y : S.FS) (hy : S.absS y = 1) : IsUnit y := by
    have hfin (v : S.Sf) : absFin v.1 (y.1 v) ≠ 0 := by
      intro hv
      have hp : (∏ v' : S.Sf, absFin v'.1 (y.1 v')) = 0 :=
        Finset.prod_eq_zero (Finset.mem_univ v) hv
      have hz : S.absS y = 0 := by
        unfold SData.absS
        rw [hp]
        simp
      rw [hy] at hz
      exact one_ne_zero hz
    have harch (w : InfinitePlace F) : Complex.normSq (y.2 w) ≠ 0 := by
      intro hw
      have hp : (∏ w' : InfinitePlace F, Complex.normSq (y.2 w')) = 0 :=
        Finset.prod_eq_zero (Finset.mem_univ w) hw
      have hz : S.absS y = 0 := by
        unfold SData.absS
        rw [hp]
        simp
      rw [hy] at hz
      exact one_ne_zero hz
    rw [Prod.isUnit_iff, Pi.isUnit_iff, Pi.isUnit_iff]
    constructor
    · intro v
      apply isUnit_iff_ne_zero.mpr
      intro hv
      apply hfin v
      rw [hv, A1.Theta.absFin_eq_norm]
      simp
    · intro w
      apply isUnit_iff_ne_zero.mpr
      intro hw
      apply harch w
      simp [hw]
  obtain ⟨K, hK, hOmegaK⟩ := R.sheets.omega_bounded
  let K1 := K ∩ {y : S.FS | S.absS y = 1}
  have hK1 : IsCompact K1 :=
    hK.inter_right (isClosed_singleton.preimage hAbs)
  let Kl := (fun y : S.FS => (R.sheets.ellU l : S.FS) * y) '' K1
  have hKl : IsCompact Kl := hK1.image (continuous_const.mul continuous_id)
  have hUnitL : ∀ y ∈ Kl, IsUnit y := by
    rintro y ⟨x, hx, rfl⟩
    exact (R.sheets.ellU l).isUnit.mul (hUnit1 x hx.2)
  have hOmegaL : omegaAt R l ⊆ Kl := by
    rintro y ⟨x, hx, rfl⟩
    exact ⟨x, ⟨hOmegaK hx, (R.sheets.omega_norm x hx).2⟩, rfl⟩
  let U := (Units.val : S.FSˣ → S.FS) ⁻¹' Kl
  have hU : IsCompact U := rf_pairing_units_compact_lift Kl hKl hUnitL
  obtain ⟨M, hM⟩ := (hU.image hc.norm).bddAbove
  have hBound (y : S.FSˣ) (hy : y ∈ U) : ‖c y‖ ≤ M := hM ⟨y, hy, rfl⟩
  let weighted : S.FSˣ → ℂ := fun y => bCut (Bd := Bd) y * (Lvalue R u y)⁻¹ * c y
  have hInvMeas : Measurable (fun y : S.FSˣ => (Lvalue R u y)⁻¹) := by
    have hcont : Continuous (fun y : S.FSˣ => Lvalue R u y) := by
      simpa only [Lvalue] using (R.chars.L u).cont
    exact measurable_inv.comp hcont.measurable
  have hWeightedMeas : Measurable weighted :=
    ((rf_bCut_measurable R).mul hInvMeas).mul hc.measurable
  have hBridge := a2_bridge_SHEET (D := D) (S := S) (G := R.sheets) l hl
  have hOmegaMeas : MeasurableSet (omegaAt R l) := hBridge.1.1
  let m := (R.sheets.sheet l).restrict (omegaAt R l)
  letI : IsFiniteMeasure m := ⟨by
    simpa only [m, Measure.restrict_apply_univ, bridgeOmegaAt, omegaAt] using hBridge.2.1⟩
  have hConst : Integrable (fun _ : S.FS => M) m := integrable_const M
  have hInt : Integrable (onUnits weighted) m := by
    apply hConst.mono' (rf_onUnits_measurable weighted hWeightedMeas).aestronglyMeasurable
    filter_upwards [ae_restrict_mem hOmegaMeas] with y hy
    have hyu : IsUnit y := hUnitL y (hOmegaL hy)
    have hyU : hyu.unit ∈ U := by
      change (hyu.unit : S.FS) ∈ Kl
      rw [hyu.unit_spec]
      exact hOmegaL hy
    have hB : ‖bCut (Bd := Bd) hyu.unit‖ ≤ 1 := by
      unfold bCut
      split_ifs <;> simp
    have hInv : ‖(Lvalue R u hyu.unit)⁻¹‖ = 1 := by
      rw [norm_inv]
      have hL : ‖Lvalue R u hyu.unit‖ = 1 := by
        simpa only [Lvalue] using (R.chars.L u).unitary hyu.unit
      rw [hL, inv_one]
    rw [onUnits, dif_pos hyu]
    dsimp only [weighted]
    calc
      _ = ‖bCut (Bd := Bd) hyu.unit‖ * ‖c hyu.unit‖ := by
        simp only [norm_mul, hInv, mul_one]
      _ ≤ 1 * ‖c hyu.unit‖ := mul_le_mul_of_nonneg_right hB (norm_nonneg _)
      _ = ‖c hyu.unit‖ := one_mul _
      _ ≤ M := hBound hyu.unit hyU
  exact hInt

private theorem rf_pairing_thetaAverage_series
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (r : ReflectionRow S) (l : ℝ) (hl : 0 < l) :
    thetaAverage R r l =
      ∑' p : FrozenIndex R r.h × S.SqfExtIdeal × Gamma S,
        omegaInt R l (rf_pairing_grouped_fourier_term R r p) := by
  classical
  let P := FrozenIndex R r.h × S.SqfExtIdeal × Gamma S
  let m := (R.sheets.sheet l).restrict (omegaAt R l)
  let full : S.FSˣ → ℂ := fun y =>
    bCut (Bd := Bd) y * (Lvalue R (rowClass R r) y)⁻¹ * digitSum R r true false y
  let c : S.FSˣ → ℂ := fun y =>
    bCut (Bd := Bd) y * (Lvalue R (rowClass R r) y)⁻¹ * digitSum R r true true y
  let s : S.FSˣ → ℂ := fun y => ∑' p : P, rf_pairing_grouped_fourier_term R r p y
  have hSheet := rf_pairing_grouped_sheet_exchange R r l hl
  change Integrable (onUnits s) m ∧
    (∫ y, onUnits s y ∂m) =
      ∑' p : P, ∫ y, onUnits (rf_pairing_grouped_fourier_term R r p) y ∂m at hSheet
  have hConst : Integrable (onUnits c) m := rf_pairing_constant_integrable R r l hl
  have hEq : onUnits full = onUnits c + onUnits s := by
    funext y
    by_cases hy : IsUnit y
    · simp only [Pi.add_apply, onUnits, dif_pos hy]
      exact (rf_pairing_grouped_pointwise R r hy.unit).2
    · simp only [Pi.add_apply, onUnits, dif_neg hy, zero_add]
  have hIntegral : (∫ y, onUnits full y ∂m) =
      (∫ y, onUnits c y ∂m) +
        ∑' p : P, ∫ y, onUnits (rf_pairing_grouped_fourier_term R r p) y ∂m := by
    rw [hEq]
    simp only [Pi.add_apply]
    rw [integral_add hConst hSheet.1, hSheet.2]
  change omegaInt R l full = omegaInt R l c +
    ∑' p : P, omegaInt R l (rf_pairing_grouped_fourier_term R r p) at hIntegral
  have hAngular := rf_angular_cancellation R r l hl
  have hZero : omegaInt R l c = 0 := hAngular.1 true
  calc
    thetaAverage R r l = omegaInt R l full := hAngular.2
    _ = omegaInt R l c +
        ∑' p : P, omegaInt R l (rf_pairing_grouped_fourier_term R r p) := hIntegral
    _ = _ := by rw [hZero, zero_add]

private theorem rf_pairing_thetaAverage_grouped_series
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (r : ReflectionRow S) (l : ℝ) (hl : 0 < l) :
    Summable (fun q : FrozenIndex R r.h × S.SqfExtIdeal =>
      ∑' γ : Gamma S, omegaInt R l
        (rf_pairing_grouped_fourier_term R r (q.1, q.2, γ))) ∧
      thetaAverage R r l =
        ∑' q : FrozenIndex R r.h × S.SqfExtIdeal,
          ∑' γ : Gamma S, omegaInt R l
            (rf_pairing_grouped_fourier_term R r (q.1, q.2, γ)) := by
  classical
  let J := FrozenIndex R r.h × S.SqfExtIdeal
  let P := FrozenIndex R r.h × S.SqfExtIdeal × Gamma S
  let m := (R.sheets.sheet l).restrict (omegaAt R l)
  let f : P → ℂ := fun p => omegaInt R l (rf_pairing_grouped_fourier_term R r p)
  let N : P → ℝ := fun p =>
    ∫ y, ‖onUnits (rf_pairing_grouped_fourier_term R r p) y‖ ∂m
  have hBase := rf_pairing_grouped_integral_norm_summable R r l hl
  change (∀ p : P, Integrable (onUnits (rf_pairing_grouped_fourier_term R r p)) m) ∧
    Summable N at hBase
  have hsNorm : Summable (fun p : P => ‖f p‖) :=
    Summable.of_nonneg_of_le (fun p => norm_nonneg (f p))
      (fun p => norm_integral_le_integral_norm _) hBase.2
  have hs : Summable f := Summable.of_norm hsNorm
  let e : J × Gamma S ≃ P :=
    Equiv.prodAssoc (FrozenIndex R r.h) S.SqfExtIdeal (Gamma S)
  have hsReindex : Summable (f ∘ e) := (e.summable_iff).2 hs
  refine ⟨hsReindex.prod, ?_⟩
  calc
    thetaAverage R r l = ∑' p : P, f p := rf_pairing_thetaAverage_series R r l hl
    _ = ∑' p : J × Gamma S, (f ∘ e) p := (e.tsum_eq f).symm
    _ = _ := hsReindex.tsum_prod

private theorem rf_pairing_frequency_weight_summable
    (R : ReflectionSetup D S H Bd A ϑ bc μ v0)
    (r : ReflectionRow S) :
    Summable (fun q : FrozenIndex R r.h × S.SqfExtIdeal =>
      (betaIdeal R q.1.f q.1.a * qI q.2.1 ^ (-(1 / 2 : ℝ)) / qI q.1.n.1) *
        S.absS (S.diagU (frozenFrequency R q.1 r.d q.2) : S.FS) ^ (-1 : ℝ)) := by
  classical
  let J := FrozenIndex R r.h × S.SqfExtIdeal
  let weight : J → ℝ := fun q =>
    betaIdeal R q.1.f q.1.a * qI q.2.1 ^ (-(1 / 2 : ℝ)) / qI q.1.n.1
  let Q : J → ℝ := fun q => qI q.1.a.1 * qI q.2.1 * qI q.1.n.1 ^ 3
  let den : J → ℝ := fun q => qI r.d.1 ^ 2 * qI q.1.f.1 ^ 2
  have hq (I : Ideal (𝓞 F)) : 0 ≤ qI I := by
    unfold qI
    exact Nat.cast_nonneg _
  have hEq (q : J) : weight q *
      S.absS (S.diagU (frozenFrequency R q.1 r.d q.2) : S.FS) ^ (-1 : ℝ) =
        den q * reflectedDirichletTerm R q.1.f 1
          (⟨q.1.a, q.1.numerator⟩, q.2, q.1.n) := by
    let sd : Bd.B := ⟨cls (S.diagU (bc.gen r.d)), (bc.gen_spec r.d).2⟩
    let sc : Bd.B := ⟨cls (S.diagU (bc.gen (R.exterior.ofSqf q.2))),
      (bc.gen_spec (R.exterior.ofSqf q.2)).2⟩
    have hNorm : S.absS (S.diagU (frozenFrequency R q.1 r.d q.2) : S.FS) =
        Q q / den q :=
      (rf_pairing_frequency_norm_class R r.h q.1 r.d q.2 sd sc rfl rfl).1
    rw [hNorm]
    dsimp only [weight, Q, den, reflectedDirichletTerm]
    simp only [Real.rpow_neg_one, div_eq_mul_inv, mul_inv_rev, inv_inv]
    ring
  letI : Fintype (UnitSix S) := R.sheets.unitSixFinite
  let AF := {f : S.ExtIdeal // activeFactor R r.h f}
  letI : Fintype AF := (rf_pairing_activeFactor_finite R r.h).fintype
  let I := Σ f : AF, UnitSix S ×
    ({a : S.ExtIdeal // activeNumerator R f.1 a} × S.SqfExtIdeal × S.ExtIdeal)
  let e : J → I := fun q =>
    ⟨⟨q.1.f, q.1.active⟩, (q.1.u, (⟨q.1.a, q.1.numerator⟩, q.2, q.1.n))⟩
  let M : I → ℝ := fun p =>
    (qI r.d.1 ^ 2 * qI p.1.1.1 ^ 2) *
      reflectedDirichletTerm R p.1.1 1 p.2.2
  have he : Function.Injective e := by
    intro p q hpq
    have hf : p.1.f = q.1.f := congrArg (fun z : I => z.1.1) hpq
    have ha : p.1.a = q.1.a := congrArg (fun z : I => z.2.2.1.1) hpq
    have hn : p.1.n = q.1.n := congrArg (fun z : I => z.2.2.2.2) hpq
    have hu : p.1.u = q.1.u := congrArg (fun z : I => z.2.1) hpq
    have hc : p.2 = q.2 := congrArg (fun z : I => z.2.2.2.1) hpq
    rcases p with ⟨⟨pf, pa, pn, pu, pactive, pnum, pcop⟩, pc⟩
    rcases q with ⟨⟨qf, qa, qn, qu, qactive, qnum, qcop⟩, qc⟩
    dsimp only at hf ha hn hu hc
    cases hf
    cases ha
    cases hn
    cases hu
    cases hc
    rfl
  have hDirNonneg (f : S.ExtIdeal)
      (p : {a : S.ExtIdeal // activeNumerator R f a} × S.SqfExtIdeal × S.ExtIdeal) :
      0 ≤ reflectedDirichletTerm R f 1 p := by
    unfold reflectedDirichletTerm
    exact mul_nonneg
      (div_nonneg
        (mul_nonneg (rf_betaIdeal_nonneg R f p.1) (Real.rpow_nonneg (hq p.2.1.1) _))
        (hq p.2.2.1))
      (Real.rpow_nonneg
        (mul_nonneg (mul_nonneg (hq p.1.1.1) (hq p.2.1.1))
          (pow_nonneg (hq p.2.2.1) 3)) _)
  have hMnonneg (p : I) : 0 ≤ M p :=
    mul_nonneg (mul_nonneg (sq_nonneg _) (sq_nonneg _))
      (hDirNonneg p.1.1 p.2.2)
  have hfiber (f : AF) : Summable (fun q : UnitSix S ×
      ({a : S.ExtIdeal // activeNumerator R f.1 a} × S.SqfExtIdeal × S.ExtIdeal) => M ⟨f, q⟩) := by
    apply (summable_prod_of_nonneg (fun q => hMnonneg ⟨f, q⟩)).2
    refine ⟨?_, Summable.of_finite⟩
    intro k
    exact (rf_reflected_dirichlet_mass R f.1 1 (by norm_num)).1.mul_left
      (qI r.d.1 ^ 2 * qI f.1.1 ^ 2)
  have hM : Summable M :=
    (summable_sigma_of_nonneg hMnonneg).2 ⟨hfiber, Summable.of_finite⟩
  have hs : Summable (fun q : J => M (e q)) := hM.comp_injective he
  exact hs.congr (fun q => (hEq q).symm)

/-- lem:reflection-quadratic-pairing, 04:625–657. -/
theorem lem_reflection_quadratic_pairing : ∀ r Z, 0 < Z →
  Summable (fun p => ‖reflectedTerm R (rowClass R r) r.h r.d Z p‖) ∧
  Bm D S A ϑ (cgen R) (r.m : F) Z = ∑' p, reflectedTerm R (rowClass R r) r.h r.d Z p := by
  sorry
/-- Retained and discarded masses use the same dyadic threshold, with the row support explicit. -/
def splitReflection (retained : Bool) (υ : UnitSix S) (h d : S.ExtIdeal) (Z R0 : ℝ) : ℂ :=
  if Squarefree d.1 ∧ IsCoprime d.1 h.1 then
    ∑' p : FrozenIndex R h × Bd.B × Bd.B × S.SqfExtIdeal,
      if (qI p.1.a.1 * qI p.2.2.2.1 * qI p.1.n.1 ^ 3 ≤ R0) = retained then
        reflectedTerm R υ h d Z p else 0
  else 0

/-- Sum over actual ideals, not ReflectionRow structures with auxiliary choices. -/
def reflectionMass (retained : Bool) (υ : UnitSix S) (P D0 Z δ : ℝ) : ℝ :=
  ∑' hd : S.ExtIdeal × S.ExtIdeal, if IsPowerful hd.1.1 ∧ P ≤ qI hd.1.1 ∧ qI hd.1.1 < 2 * P ∧
    D0 ≤ qI hd.2.1 ∧ qI hd.2.1 < 2 * D0 then
      ‖splitReflection R retained υ hd.1 hd.2 Z (reflectionColumnCutoff P D0 Z δ)‖ ^ 2 else 0

private lemma rf_idealExp_zero_of_not_dvd (v : FinPlace F) {I : Ideal (𝓞 F)}
    (hI : I ≠ ⊥) (hnd : ¬ v.asIdeal ∣ I) : idealExp v I = 0 := by
  by_contra hne
  have hpos : 0 < idealExp v I := Nat.pos_of_ne_zero hne
  have hpowdvd : v.asIdeal ^ idealExp v I ∣ I := by
    change v.asIdeal ^ (Associates.mk v.asIdeal).count (Associates.mk I).factors ∣ I
    rw [← Associates.mk_dvd_mk, Associates.mk_pow]
    exact (Associates.prime_pow_dvd_iff_le
      (Associates.mk_ne_zero.mpr (by simpa [Ideal.zero_eq_bot] using hI))
      v.associates_irreducible).2 le_rfl
  exact hnd (dvd_trans (dvd_pow_self _ (Nat.ne_of_gt hpos)) hpowdvd)

private lemma rf_extIdeal_eq_of_numerator_exponents (f a b : S.ExtIdeal)
    (ha : activeNumerator R f a) (hb : activeNumerator R f b)
    (hexp : ∀ v ∈ R.exterior.support f, idealExp v a.1 = idealExp v b.1) : a = b := by
  apply Subtype.ext
  have ha0 : a.1 ≠ 0 := by simpa only [Ideal.zero_eq_bot] using a.2.1
  have hb0 : b.1 ≠ 0 := by simpa only [Ideal.zero_eq_bot] using b.2.1
  have hmax (v : FinPlace F) : v.maxPowDividing a.1 = v.maxPowDividing b.1 := by
    by_cases hvf : v ∈ R.exterior.support f
    · have he := hexp v hvf
      change v.asIdeal ^ idealExp v a.1 = v.asIdeal ^ idealExp v b.1
      rw [he]
    · have hnotA : ¬ v.asIdeal ∣ a.1 := by
        intro hdiv
        exact hvf (ha.1 v ((R.exterior.mem_support a v).2 hdiv))
      have hnotB : ¬ v.asIdeal ∣ b.1 := by
        intro hdiv
        exact hvf (hb.1 v ((R.exterior.mem_support b v).2 hdiv))
      have hzeroA := rf_idealExp_zero_of_not_dvd v
        (by simpa [Ideal.zero_eq_bot] using a.2.1) hnotA
      have hzeroB := rf_idealExp_zero_of_not_dvd v
        (by simpa [Ideal.zero_eq_bot] using b.2.1) hnotB
      change v.asIdeal ^ idealExp v a.1 = v.asIdeal ^ idealExp v b.1
      rw [hzeroA, hzeroB]
  calc
    a.1 = ∏ᶠ v : FinPlace F, v.maxPowDividing a.1 :=
      (Ideal.finprod_heightOneSpectrum_factorization ha0).symm
    _ = ∏ᶠ v : FinPlace F, v.maxPowDividing b.1 := finprod_congr hmax
    _ = b.1 := Ideal.finprod_heightOneSpectrum_factorization hb0

private lemma rf_betaIdeal_sum_le_Eideal (f : S.ExtIdeal) (Aset : Finset S.ExtIdeal)
    (hA : ∀ a ∈ Aset, activeNumerator R f a) :
    (∑ a ∈ Aset, betaIdeal R f a) ≤ Eideal R f 0 := by
  classical
  let V : Type := {v : FinPlace F // v ∈ R.exterior.support f}
  letI : Fintype V := Finset.Subtype.fintype (R.exterior.support f)
  let E : V → Finset ℕ := fun v => Aset.image (fun a => idealExp v.1 a.1)
  let Aidx : Type := {a : S.ExtIdeal // a ∈ Aset}
  letI : Fintype Aidx := Aset.finite_toSet.fintype
  let ExpVec : Type := V → ℕ
  let expCode (a : Aidx) : ExpVec := fun v => idealExp v.1 a.1.1
  have hExpCodeIn (a : Aidx) : expCode a ∈ Fintype.piFinset E := by
    apply Fintype.mem_piFinset.mpr
    intro v
    exact Finset.mem_image.mpr ⟨a.1, a.2, rfl⟩
  have hExpCodeInj : Function.Injective expCode := by
    intro a b hab
    apply Subtype.ext
    apply rf_extIdeal_eq_of_numerator_exponents R f a.1 b.1 (hA a.1 a.2) (hA b.1 b.2)
    intro v hv
    have h := congrFun hab ⟨v, hv⟩
    exact h
  let localBeta (v : V) (e : ℕ) : ℝ :=
    betaPrime (qI v.1.asIdeal) (qI_prime_gt_one v.1) e
  let codeWeight (x : ExpVec) : ℝ := ∏ v : V, localBeta v (x v)
  have hlocalNonneg (v : V) (e : ℕ) : 0 ≤ localBeta v e := by
    have hvS : v.1 ∉ S.Sf := R.exterior.support_exterior f v.1 v.2
    have hbound := (rf_active_support_bounds R).2.1 v.1 hvS 0 e
    exact le_trans (norm_nonneg _) hbound
  have hcodeNonneg (x : ExpVec) : 0 ≤ codeWeight x := by
    unfold codeWeight
    apply Finset.prod_nonneg
    intro v hv
    exact hlocalNonneg v (x v)
  have hBetaIdealCode (a : Aidx) : betaIdeal R f a.1 = codeWeight (expCode a) := by
    unfold betaIdeal
    rw [← Finset.prod_coe_sort]
  have hsumA (g : S.ExtIdeal → ℝ) :
      (∑ a : Aidx, g a.1) = ∑ a ∈ Aset, g a := by
    change (∑ a ∈ (Finset.univ : Finset Aidx), g a.1) = _
    refine Finset.sum_bij (fun a _ => a.1) ?_ ?_ ?_ ?_
    · intro a ha
      exact a.2
    · intro a ha b hb hab
      exact Subtype.ext hab
    · intro b hb
      exact ⟨⟨b, hb⟩, by simp, rfl⟩
    · intro a ha
      rfl
  let codeSet : Finset ExpVec := (Finset.univ : Finset Aidx).image expCode
  have hcodeSet : codeSet ⊆ Fintype.piFinset E := by
    intro x hx
    rcases Finset.mem_image.mp hx with ⟨a, ha, rfl⟩
    exact hExpCodeIn a
  have hsumCodes :
      (∑ a : Aidx, codeWeight (expCode a)) = ∑ x ∈ codeSet, codeWeight x := by
    dsimp [codeSet]
    symm
    exact Finset.sum_image (fun a ha b hb hab => hExpCodeInj hab)
  have hpiSum :
      (∑ x ∈ Fintype.piFinset E, codeWeight x) =
        ∏ v : V, ∑ e ∈ E v, localBeta v e := by
    dsimp [codeWeight]
    exact (Finset.prod_univ_sum E localBeta).symm
  have hlocalSum (v : V) :
      (∑ e ∈ E v, localBeta v e) ≤ Eprime v.1 0 := by
    have hvS : v.1 ∉ S.Sf := R.exterior.support_exterior f v.1 v.2
    obtain ⟨hsummable, _, _⟩ :=
      (rf_active_support_bounds R).2.2.1 v.1 hvS 0 (by norm_num)
    have hs : Summable (fun e : ℕ => localBeta v e) := by
      simpa [localBeta, zero_mul, Real.rpow_zero] using hsummable
    calc
      _ ≤ ∑' e : ℕ, localBeta v e :=
        hs.sum_le_tsum (E v) (fun e he => hlocalNonneg v e)
      _ = Eprime v.1 0 := by
        simp [Eprime, localBeta, zero_mul]
  have hlocalSumNonneg (v : V) : 0 ≤ ∑ e ∈ E v, localBeta v e := by
    apply Finset.sum_nonneg
    intro e he
    exact hlocalNonneg v e
  have hEprimeNonneg (v : V) : 0 ≤ Eprime v.1 0 :=
    (hlocalSumNonneg v).trans (hlocalSum v)
  have hprodBound :
      (∏ v : V, ∑ e ∈ E v, localBeta v e) ≤ ∏ v : V, Eprime v.1 0 := by
    apply Finset.prod_le_prod₀
    · intro v hv
      exact hlocalSumNonneg v
    · intro v hv
      exact hlocalSum v
  have hprodE : (∏ v : V, Eprime v.1 0) = Eideal R f 0 := by
    unfold Eideal
    exact Finset.prod_coe_sort (R.exterior.support f) (fun v => Eprime v 0)
  calc
    (∑ a ∈ Aset, betaIdeal R f a) = ∑ a : Aidx, betaIdeal R f a.1 :=
      (hsumA (betaIdeal R f)).symm
    _ = ∑ a : Aidx, codeWeight (expCode a) := by
      apply Finset.sum_congr rfl
      intro a ha
      exact hBetaIdealCode a
    _ = ∑ x ∈ codeSet, codeWeight x := hsumCodes
    _ ≤ ∑ x ∈ Fintype.piFinset E, codeWeight x :=
      Finset.sum_le_sum_of_subset_of_nonneg hcodeSet (fun x hx hnot => hcodeNonneg x)
    _ = ∏ v : V, ∑ e ∈ E v, localBeta v e := hpiSum
    _ ≤ ∏ v : V, Eprime v.1 0 := hprodBound
    _ = Eideal R f 0 := hprodE

private lemma rf_sqf_norm_dyad_bounds (c : S.SqfExtIdeal) :
    let k := Nat.log 2 (Ideal.absNorm c.1)
    ((2 ^ k : ℕ) : ℝ) ≤ qI c.1 ∧
      qI c.1 < ((2 ^ (k + 1) : ℕ) : ℝ) := by
  dsimp only
  have hI : c.1 ≠ ⊥ := by
    simpa [Ideal.zero_eq_bot] using c.2.1.1
  have hnormpos : 0 < Ideal.absNorm c.1 :=
    Ideal.absNorm_pos_of_nonZeroDivisors
      ⟨c.1, mem_nonZeroDivisors_iff_ne_zero.mpr
        (by simpa [Ideal.zero_eq_bot] using hI)⟩
  have hn : Ideal.absNorm c.1 ≠ 0 := by
    exact Nat.ne_of_gt hnormpos
  constructor
  · change ((2 ^ Nat.log 2 (Ideal.absNorm c.1) : ℕ) : ℝ) ≤
      (Ideal.absNorm c.1 : ℝ)
    exact_mod_cast Nat.pow_log_le_self 2 hn
  · change (Ideal.absNorm c.1 : ℝ) <
      ((2 ^ (Nat.log 2 (Ideal.absNorm c.1) + 1) : ℕ) : ℝ)
    exact_mod_cast Nat.lt_pow_succ_log_self (by norm_num : 1 < 2) _

private lemma rf_retained_cutoff_components (qa qc qn R0 : ℝ)
    (hqa : 1 ≤ qa) (hqc : 1 ≤ qc) (hqn : 1 ≤ qn)
    (hQ : qa * qc * qn ^ 3 ≤ R0) : qa ≤ R0 ∧ qc ≤ R0 ∧ qn ≤ R0 := by
  have hqn2 : 1 ≤ qn ^ 2 := one_le_pow₀ hqn
  have hqn3 : qn ≤ qn ^ 3 := by
    calc
      qn = qn * 1 := by ring
      _ ≤ qn * qn ^ 2 := mul_le_mul_of_nonneg_left hqn2 (by linarith)
      _ = qn ^ 3 := by ring
  have hone3 : 1 ≤ qn ^ 3 := by
    calc
      1 = 1 * 1 * 1 := by ring
      _ ≤ qn * qn * qn := by gcongr
      _ = qn ^ 3 := by ring
  have hqaQ : qa ≤ qa * qc * qn ^ 3 := by
    calc
      qa = qa * 1 * 1 := by ring
      _ ≤ qa * qc * qn ^ 3 := by
        gcongr
  have hqcQ : qc ≤ qa * qc * qn ^ 3 := by
    calc
      qc = 1 * qc * 1 := by ring
      _ ≤ qa * qc * qn ^ 3 := by gcongr
  have hqnQ : qn ≤ qa * qc * qn ^ 3 := by
    calc
      qn ≤ qn ^ 3 := hqn3
      _ = 1 * 1 * qn ^ 3 := by ring
      _ ≤ qa * qc * qn ^ 3 := by gcongr
  exact ⟨hqaQ.trans hQ, hqcQ.trans hQ, hqnQ.trans hQ⟩

private lemma rf_retained_qI_ge_one (I : Ideal (𝓞 F)) (hI : I ≠ ⊥) :
    1 ≤ qI I := by
  have hn : 0 < Ideal.absNorm I :=
    Ideal.absNorm_pos_of_nonZeroDivisors
      ⟨I, mem_nonZeroDivisors_iff_ne_zero.mpr (by simpa [Ideal.zero_eq_bot] using hI)⟩
  dsimp [qI]
  exact_mod_cast (Nat.one_le_iff_ne_zero.mpr (Nat.ne_of_gt hn))

private lemma rf_retained_split_zero_of_cutoff_lt_one (υ : UnitSix S)
    (h d : S.ExtIdeal) (Z R0 : ℝ) (hR0 : R0 < 1) :
    splitReflection R true υ h d Z R0 = 0 := by
  classical
  have hnot (p : FrozenIndex R h × Bd.B × Bd.B × S.SqfExtIdeal) :
      ¬ qI p.1.a.1 * qI p.2.2.2.1 * qI p.1.n.1 ^ 3 ≤ R0 := by
    let qa := qI p.1.a.1
    let qc := qI p.2.2.2.1
    let qn := qI p.1.n.1
    have hqa : 1 ≤ qa := rf_retained_qI_ge_one p.1.a.1 p.1.a.2.1
    have hqc : 1 ≤ qc := rf_retained_qI_ge_one p.2.2.2.1
      (by simpa using p.2.2.2.2.1.1)
    have hqn : 1 ≤ qn := rf_retained_qI_ge_one p.1.n.1 p.1.n.2.1
    have hqn3 : 1 ≤ qn ^ 3 := one_le_pow₀ hqn
    have hQ : 1 ≤ qa * qc * qn ^ 3 := by
      calc
        1 = 1 * 1 * 1 := by ring
        _ ≤ qa * qc * qn ^ 3 := by gcongr
    exact not_le_of_gt (lt_of_lt_of_le hR0 hQ)
  by_cases hdc : Squarefree d.1 ∧ IsCoprime d.1 h.1
  · simp [splitReflection, hdc, hnot]
  · simp [splitReflection, hdc]

private lemma rf_retained_natlog_count (X : ℝ) (hX : 1 ≤ X) :
    (((Nat.log 2 ⌊X⌋₊ + 1 : ℕ) : ℝ) ≤
      (1 / Real.log 2) * Real.log (2 * X)) := by
  let n : ℕ := ⌊X⌋₊
  let N : ℕ := Nat.log 2 n
  have hn : 1 ≤ n := by
    dsimp [n]
    exact Nat.le_floor (by exact_mod_cast hX)
  have hpow : 2 ^ (N + 1) ≤ 2 * n := by
    calc
      2 ^ (N + 1) = 2 ^ N * 2 := by rw [pow_succ]
      _ ≤ n * 2 := Nat.mul_le_mul_right 2
        (Nat.pow_log_le_self 2 (by omega : n ≠ 0))
      _ = 2 * n := by omega
  have hlogNat : N + 1 ≤ Nat.log 2 (2 * n) := by
    dsimp [N]
    exact Nat.le_log_of_pow_le (by norm_num : 1 < 2) hpow
  have hlogb : ((N + 1 : ℕ) : ℝ) ≤ Real.logb 2 (2 * (n : ℝ)) := by
    calc
      ((N + 1 : ℕ) : ℝ) ≤ (Nat.log 2 (2 * n) : ℝ) := by exact_mod_cast hlogNat
      _ = (Nat.log2 (2 * n) : ℝ) := by simp [Nat.log2_eq_log_two]
      _ ≤ Real.logb 2 (2 * (n : ℝ)) := by
        convert Real.log2_le_logb (2 * n) using 1 <;> norm_cast
  have hfloor : (n : ℝ) ≤ X := by
    dsimp [n]
    exact Nat.floor_le (le_trans (by norm_num) hX)
  have hlogbX : Real.logb 2 (2 * (n : ℝ)) ≤ Real.logb 2 (2 * X) :=
    Real.logb_le_logb_of_le (by norm_num : (1 : ℝ) < 2) (by positivity)
      (by nlinarith [hfloor])
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hlogCount : ((N + 1 : ℕ) : ℝ) * Real.log 2 ≤ Real.log (2 * X) := by
    apply (le_div_iff₀ hlog2).1
    simpa [Real.logb] using hlogb.trans hlogbX
  have hNdef : N = Nat.log 2 ⌊X⌋₊ := by rfl
  rw [← hNdef]
  have hdivide : ((Nat.log 2 ⌊X⌋₊ + 1 : ℕ) : ℝ) ≤
      Real.log (2 * X) / Real.log 2 := (le_div_iff₀ hlog2).2 hlogCount
  calc
    ((Nat.log 2 ⌊X⌋₊ + 1 : ℕ) : ℝ) ≤ Real.log (2 * X) / Real.log 2 := hdivide
    _ = (1 / Real.log 2) * Real.log (2 * X) := by ring

end Reflection

section SupplementaryClauses
variable {D : FieldData F} {S : SData F CE condη} {H : HilbertData F}
  {Bd : BData S H} {A : AddCharData F} {ϑ : HeckeChar F}
  {bc : BalancedChoices D S H Bd} {μ : ∀ v : FinPlace F, Theta.LocHaar v}
  {v0 : InfinitePlace F}
variable (R : ReflectionSetup D S H Bd A ϑ bc μ v0)

def forwardExterior (ν : Fˣ) : ℂ :=
  ∏ᶠ v : FinPlace F, if v ∉ S.Sf then R.T.Wv v (R.C.a v (toLoc v ν)) else 1

/-- rf:forward-frequencies: remaining S-factor and exterior Γ-invariance clauses. -/
theorem rf_forward_frequency_factors :
  (∀ u ν y, R.T.WS (R.chars.L u) (R.C.aS (S.diagU ν) * R.C.aS y) =
    sCocycle (D := D) (H := H) (S.diagU ν) y * unrotated R u (S.diagU ν * y)) ∧
  ∀ (γ : Gamma S) ν, forwardExterior R ((γ.1 : Fˣ) * ν) = forwardExterior R ν := by
  constructor
  · intro u ν y
    rw [R.C.aS_mul]
    rw [R.T.WS_genuine (R.chars.L u) (R.mem_family u)]
    simp [sCocycle, unrotated, muThree, map_pow]
  · intro γ ν
    classical
    have hroot : ∃ u : S.US, (γ.1 : S.US) = u ^ 6 := by
      have hmem : (γ.1 : S.US) ∈ (sixthPowerOnUS S).range := γ.2
      rcases MonoidHom.mem_range.mp hmem with ⟨u, hu⟩
      change u ^ 6 = γ.1 at hu
      exact ⟨u, hu.symm⟩
    obtain ⟨u, hu⟩ := hroot
    have localVal (v : FinPlace F) (hv : v ∉ S.Sf) (e : S.US) :
        Valued.v (toLoc v (e : Fˣ) : v.adicCompletion F) = 1 := by
      have hglob : HeightOneSpectrum.valuation F v ((e : Fˣ) : F) = 1 :=
        Set.unit_valuation_eq_one (S := (S.Sf : Set (FinPlace F))) (K := F) e hv
      change Valued.v (algebraMap F (v.adicCompletion F) ((e : Fˣ) : F)) = 1
      simpa only [HeightOneSpectrum.algebraMap_adicCompletion, Function.comp_apply,
        Algebra.algebraMap_self, RingHom.id_apply, v.valuedAdicCompletion_eq_valuation', hglob]
    have hglobalPow : (γ.1 : Fˣ) = (u : Fˣ) ^ 6 := by
      exact congrArg (fun e : S.US => (e : Fˣ)) hu
    have hlocal (v : FinPlace F) (hv : v ∉ S.Sf) :
        R.T.Wv v (R.C.a v (toLoc v ((γ.1 : Fˣ) * ν))) =
          R.T.Wv v (R.C.a v (toLoc v ν)) := by
      let g : (v.adicCompletion F)ˣ := toLoc v (γ.1 : Fˣ)
      let t : (v.adicCompletion F)ˣ := toLoc v (u : Fˣ)
      have hvalg : Valued.v (g : v.adicCompletion F) = 1 := by
        exact localVal v hv (γ.1 : S.US)
      have hvalt : Valued.v (t : v.adicCompletion F) = 1 := by
        exact localVal v hv u
      have hgintegral : (g : v.adicCompletion F) ∈ v.adicCompletionIntegers F := by
        rw [HeightOneSpectrum.mem_adicCompletionIntegers, hvalg]
      have hginvIntegral : ((g⁻¹ : (v.adicCompletion F)ˣ) : v.adicCompletion F) ∈
          v.adicCompletionIntegers F := by
        rw [HeightOneSpectrum.mem_adicCompletionIntegers]
        simp only [Units.val_inv_eq_inv_val, map_inv₀, hvalg, inv_one, le_refl]
      have hK : R.C.a v g ∈ R.C.Kext :=
        R.C.a_Kext v hv g hgintegral hginvIntegral
      have hv6 : (6 : 𝓞 F) ∉ v.asIdeal := by
        intro h
        exact hv (S.over6 v h)
      have hbasic := ArtinPrimitiveRoots.A1.Theta.localChi_basic (D := D) hv6
      have htLoc : ArtinPrimitiveRoots.A1.Theta.IsLocUnit v t := by
        constructor
        · rw [HeightOneSpectrum.mem_adicCompletionIntegers, hvalt]
        · rw [HeightOneSpectrum.mem_adicCompletionIntegers]
          simp only [Units.val_inv_eq_inv_val, map_inv₀, hvalt, inv_one, le_refl]
      have htPowLoc (n : ℕ) : ArtinPrimitiveRoots.A1.Theta.IsLocUnit v (t ^ n) := by
        have hpowval : Valued.v ((t ^ n : (v.adicCompletion F)ˣ) : v.adicCompletion F) = 1 := by
          simp only [Units.val_pow_eq_pow_val, map_pow, hvalt, one_pow]
        constructor
        · rw [HeightOneSpectrum.mem_adicCompletionIntegers, hpowval]
        · rw [HeightOneSpectrum.mem_adicCompletionIntegers]
          have hinv : Valued.v (((t ^ n)⁻¹ : (v.adicCompletion F)ˣ) : v.adicCompletion F) = 1 := by
            simp only [Units.val_inv_eq_inv_val, map_inv₀, hpowval, inv_one]
          rw [hinv]
      have hchiPow : ∀ n : ℕ,
          ArtinPrimitiveRoots.A1.localChi D v (t ^ n) =
            ArtinPrimitiveRoots.A1.localChi D v t ^ n := by
        intro n
        induction n with
        | zero => simpa using hbasic.1
        | succ n ih =>
          calc
            ArtinPrimitiveRoots.A1.localChi D v (t ^ (n + 1)) =
                ArtinPrimitiveRoots.A1.localChi D v (t ^ n * t) := by rw [pow_succ]
            _ = ArtinPrimitiveRoots.A1.localChi D v (t ^ n) *
                ArtinPrimitiveRoots.A1.localChi D v t :=
              hbasic.2.2.1 _ _ (htPowLoc n) htLoc
            _ = _ := by rw [ih, pow_succ]
      have hgammaLocalPow : g = t ^ 6 := by
        change toLoc v ((γ.1 : Fˣ)) = (toLoc v (u : Fˣ)) ^ 6
        rw [← map_pow]
        exact congrArg (toLoc v) hglobalPow
      have hchiG : ArtinPrimitiveRoots.A1.localChi D v g = 1 := by
        calc
          ArtinPrimitiveRoots.A1.localChi D v g =
              ArtinPrimitiveRoots.A1.localChi D v (t ^ 6) := by rw [hgammaLocalPow]
          _ = ArtinPrimitiveRoots.A1.localChi D v t ^ 6 := hchiPow 6
          _ = 1 := hbasic.2.2.2.1 t htLoc
      have hordG : ArtinPrimitiveRoots.A1.ordv v g = 0 := by
        have hne : Valued.v (g : v.adicCompletion F) ≠ 0 := by
          rw [hvalg]
          exact one_ne_zero
        unfold ArtinPrimitiveRoots.A1.ordv
        rw [WithZero.toAdd_unzero_eq_log hne, hvalg]
        simp
      have hunitPartG : ArtinPrimitiveRoots.A1.unitPart v g = g := by
        simp [ArtinPrimitiveRoots.A1.unitPart, hordG]
      have hCocLeft : ArtinPrimitiveRoots.A1.extCocycle D v g (toLoc v ν) = 1 := by
        simp [ArtinPrimitiveRoots.A1.extCocycle, hunitPartG, hchiG, hordG]
      have hCocRight : ArtinPrimitiveRoots.A1.extCocycle D v (toLoc v ν) g = 1 := by
        simp [ArtinPrimitiveRoots.A1.extCocycle, hunitPartG, hchiG, hordG]
      obtain ⟨ζ₁, hζ₁, hmul₁⟩ := R.C.a_mul v hv g (toLoc v ν)
      have hζ₁ : ζ₁ = 1 := by
        apply Subtype.ext
        apply Units.ext
        exact hζ₁.trans hCocLeft
      have hmul₁ : R.C.a v g * R.C.a v (toLoc v ν) = R.C.a v (g * toLoc v ν) := by
        simpa [hζ₁] using hmul₁
      obtain ⟨ζ₂, hζ₂, hmul₂⟩ := R.C.a_mul v hv (toLoc v ν) g
      have hζ₂ : ζ₂ = 1 := by
        apply Subtype.ext
        apply Units.ext
        exact hζ₂.trans hCocRight
      have hmul₂ : R.C.a v (toLoc v ν) * R.C.a v g =
          R.C.a v (toLoc v ν * g) := by
        simpa [hζ₂] using hmul₂
      have hcomm : R.C.a v g * R.C.a v (toLoc v ν) =
          R.C.a v (toLoc v ν) * R.C.a v g := by
        calc
          _ = R.C.a v (g * toLoc v ν) := hmul₁
          _ = R.C.a v (toLoc v ν * g) := by rw [mul_comm]
          _ = _ := hmul₂.symm
      calc
        R.T.Wv v (R.C.a v (toLoc v ((γ.1 : Fˣ) * ν))) =
            R.T.Wv v (R.C.a v g * R.C.a v (toLoc v ν)) := by
              rw [map_mul]
              exact congrArg (R.T.Wv v) hmul₁.symm
        _ = R.T.Wv v (R.C.a v (toLoc v ν) * R.C.a v g) := by rw [hcomm]
        _ = R.T.Wv v (R.C.a v (toLoc v ν)) :=
          R.T.Wv_right v hv (R.C.a v (toLoc v ν)) (R.C.a v g) hK (R.C.a_mem v g)
    apply finprod_congr
    intro v
    by_cases hv : v ∉ S.Sf
    · simpa [forwardExterior, hv] using hlocal v hv
    · simp [forwardExterior, hv]
/-- rf:reflected-absolute: spherical series and convergence BEFORE digit evaluation. -/
theorem rf_reflected_pre_digit_absolute :
  (∀ v, v ∉ S.Sf → ∀ σ : ℝ, 1 / 2 < σ →
    Summable (fun e : ℕ => ‖localW R v e‖ * qI v.asIdeal ^ (-σ * (e : ℝ))) ∧
    (∑' e : ℕ, ‖localW R v e‖ * qI v.asIdeal ^ (-σ * (e : ℝ))) =
      (1 + qI v.asIdeal ^ (-1 / 2 - σ)) / (1 - qI v.asIdeal ^ (-1 - 3 * σ))) ∧
  ∀ r l, 0 < l → Summable (fun p : Digits R r × Fˣ =>
    ‖digitAlpha R r p.1‖ * (omegaInt R l (fun y =>
      (‖R.T.W (R.chars.L (rowClass R r))
        (R.C.rat (diagGL p.2) * R.C.rat weylGL * digitPoint R r y p.1)‖ : ℂ))).re) := by
  sorry
/-- rf:grouped-absolute: explicit incomplete zeta majorant. -/
def exteriorZeta (σ : ℝ) : ℝ := ∑' I : S.ExtIdeal, qI I.1 ^ (-σ)
/-- rf:grouped-absolute, 04:659-706. The original incomplete zeta majorant is explicit. -/
theorem rf_original_majorant : ∀ σ : ℝ, 1 / 2 < σ →
  sphericalMajorant (S := S) σ ≤ exteriorZeta (S := S) (σ + 1 / 2) * exteriorZeta (S := S) (3 * σ + 1) ∧
  Summable (fun I : S.ExtIdeal => qI I.1 ^ (-(σ + 1 / 2))) ∧
  Summable (fun I : S.ExtIdeal => qI I.1 ^ (-(3 * σ + 1))) := by
  intro σ hσ
  let a : S.ExtIdeal → ℝ := fun I => qI I.1 ^ (-1 / 2 - σ)
  let b : S.ExtIdeal → ℝ := fun I => qI I.1 ^ (-1 - 3 * σ)
  have haBase := a2_bridge_COUNT_summable (S := S) (σ + 1 / 2) (by linarith)
  have hbBase := a2_bridge_COUNT_summable (S := S) (3 * σ + 1) (by linarith)
  have ha : Summable a := by
    apply haBase.congr
    intro I
    dsimp [a, qI, idealNorm]
    congr 1
    ring
  have hb : Summable b := by
    apply hbBase.congr
    intro I
    dsimp [b, qI, idealNorm]
    congr 1
    ring
  have haResult : Summable (fun I : S.ExtIdeal => qI I.1 ^ (-(σ + 1 / 2))) := by
    simpa [qI, idealNorm] using haBase
  have hbResult : Summable (fun I : S.ExtIdeal => qI I.1 ^ (-(3 * σ + 1))) := by
    simpa [qI, idealNorm] using hbBase
  have ha_nonneg : ∀ I, 0 ≤ a I := by
    intro I
    change 0 ≤ Real.rpow (Ideal.absNorm I.1 : ℝ) _
    exact Real.rpow_nonneg (Nat.cast_nonneg _) _
  have hb_nonneg : ∀ I, 0 ≤ b I := by
    intro I
    change 0 ≤ Real.rpow (Ideal.absNorm I.1 : ℝ) _
    exact Real.rpow_nonneg (Nat.cast_nonneg _) _
  let incl : S.SqfExtIdeal → S.ExtIdeal := fun I => ⟨I.1, I.2.1⟩
  have hincl : Function.Injective incl := by
    intro I J h
    apply Subtype.ext
    change (incl I).1 = (incl J).1
    exact congrArg (fun x : S.ExtIdeal => x.1) h
  let aSqf : S.SqfExtIdeal → ℝ := fun I => a (incl I)
  have haSqf : Summable aSqf := by
    let e : S.SqfExtIdeal ≃ {I : S.ExtIdeal // Squarefree I.1} :=
      { toFun := fun I => ⟨incl I, I.2.2⟩
        invFun := fun I => ⟨I.1.1, ⟨I.1.2, I.2⟩⟩
        left_inv := by intro I; apply Subtype.ext; rfl
        right_inv := by intro I; apply Subtype.ext; apply Subtype.ext; rfl }
    have hsub : Summable (fun I : {I : S.ExtIdeal // Squarefree I.1} => a I.1) :=
      ha.subtype (fun I : S.ExtIdeal => Squarefree I.1)
    have heq : aSqf = fun I : S.SqfExtIdeal => a (e I).1 := by
      funext I
      rfl
    rw [heq]
    exact (Equiv.summable_iff e).mpr hsub
  have hpair : Summable (fun p : S.SqfExtIdeal × S.ExtIdeal => aSqf p.1 * b p.2) :=
    haSqf.mul_of_nonneg hb (fun I => ha_nonneg (incl I)) hb_nonneg
  have hprod :
      (∑' p : S.SqfExtIdeal × S.ExtIdeal, aSqf p.1 * b p.2) =
        (∑' I : S.SqfExtIdeal, aSqf I) * (∑' I : S.ExtIdeal, b I) := by
    calc
      _ = ∑' I : S.SqfExtIdeal, ∑' J : S.ExtIdeal, aSqf I * b J := hpair.tsum_prod
      _ = _ := by simp [tsum_mul_left, tsum_mul_right]
  have hsub : (∑' I : S.SqfExtIdeal, aSqf I) ≤ ∑' I : S.ExtIdeal, a I :=
    tsum_comp_le_tsum_of_inj ha ha_nonneg hincl
  have hb_tsum_nonneg : 0 ≤ ∑' I : S.ExtIdeal, b I := tsum_nonneg hb_nonneg
  have hbound :
      (∑' p : S.SqfExtIdeal × S.ExtIdeal, aSqf p.1 * b p.2) ≤
        (∑' I : S.ExtIdeal, a I) * (∑' I : S.ExtIdeal, b I) := by
    rw [hprod]
    exact mul_le_mul_of_nonneg_right hsub hb_tsum_nonneg
  have hmaj_eq : sphericalMajorant (S := S) σ =
      ∑' p : S.SqfExtIdeal × S.ExtIdeal, aSqf p.1 * b p.2 := by
    unfold sphericalMajorant
    apply tsum_congr
    intro p
    rfl
  have hza : (∑' I : S.ExtIdeal, a I) = exteriorZeta (S := S) (σ + 1 / 2) := by
    unfold exteriorZeta
    apply tsum_congr
    intro I
    dsimp [a]
    congr 1
    ring
  have hzb : (∑' I : S.ExtIdeal, b I) = exteriorZeta (S := S) (3 * σ + 1) := by
    unfold exteriorZeta
    apply tsum_congr
    intro I
    dsimp [b]
    congr 1
    ring
  refine ⟨?_, haResult, hbResult⟩
  calc
    sphericalMajorant (S := S) σ = _ := hmaj_eq
    _ ≤ (∑' I : S.ExtIdeal, a I) * (∑' I : S.ExtIdeal, b I) := hbound
    _ = _ := by rw [hza, hzb]
/-- rf:S-unfolding, 04:804-857. The norm identity and selected frequency class are fixed together. -/
theorem rf_frozen_frequency_norm_class : ∀ h (t : FrozenIndex R h) d c sd sc,
  cls (S.diagU (bc.gen d)) = sd.1 → cls (S.diagU (bc.gen (R.exterior.ofSqf c))) = sc.1 →
    S.absS (S.diagU (frozenFrequency R t d c) : S.FS) =
      qI t.a.1 * qI c.1 * qI t.n.1 ^ 3 / (qI d.1 ^ 2 * qI t.f.1 ^ 2) ∧
    cls (S.diagU (frozenFrequency R t d c)) = kappaSix R t sd sc := by
  intro h t d c sd sc hsd hsc
  exact rf_pairing_frequency_norm_class R h t d c sd sc hsd hsc

def activePartial (retained : Bool) (υ : UnitSix S) (h d f : S.ExtIdeal)
    (u : UnitSix S) (sd sc : Bd.B) (Z R0 : ℝ) : ℂ :=
  ∑' p : {t : FrozenIndex R h // t.f = f ∧ t.u = u} × S.SqfExtIdeal,
    if (qI p.1.1.a.1 * qI p.2.1 * qI p.1.1.n.1 ^ 3 ≤ R0) = retained then
      reflectedTerm R υ h d Z (p.1.1, sd, sc, p.2) else 0

private lemma rf_qI_pos_ge_one (I : Ideal (𝓞 F)) (hI : I ≠ ⊥) :
    0 < qI I ∧ 1 ≤ qI I := by
  have hn : 0 < Ideal.absNorm I :=
    Ideal.absNorm_pos_of_nonZeroDivisors
      ⟨I, mem_nonZeroDivisors_iff_ne_zero.mpr (by simpa [Ideal.zero_eq_bot] using hI)⟩
  constructor
  · dsimp [qI]
    exact_mod_cast hn
  · dsimp [qI]
    exact_mod_cast (Nat.one_le_iff_ne_zero.mpr (Nat.ne_of_gt hn))

set_option maxHeartbeats 4000000
/-- Absolute-summability form of the pointwise discarded-slice bound. -/
private theorem rf_tail_bound_abs : ∀ δ σ N : ℝ, 0 < δ → 1 / 2 < σ → σ < N →
  ∃ C : ℝ, 0 < C ∧ ∀ υ P D0 Z h d f u sd sc,
    1 ≤ P → 1 ≤ D0 → 2 ≤ Z → P ≤ qI h.1 → qI h.1 < 2 * P →
    D0 ≤ qI d.1 → qI d.1 < 2 * D0 → IsPowerful h.1 → activeFactor R h f →
    let R0 := reflectionColumnCutoff P D0 Z δ
    let Src := {t : FrozenIndex R h // t.f = f ∧ t.u = u} × S.SqfExtIdeal
    Summable (fun p : Src => ‖if (qI p.1.1.a.1 * qI p.2.1 * qI p.1.1.n.1 ^ 3 ≤ R0) = false then
      reflectedTerm R υ h d Z (p.1.1, sd, sc, p.2) else 0‖) ∧
    (∑' p : Src, ‖if (qI p.1.1.a.1 * qI p.2.1 * qI p.1.1.n.1 ^ 3 ≤ R0) = false then
      reflectedTerm R υ h d Z (p.1.1, sd, sc, p.2) else 0‖) ≤
      C * reflectionColumnLength P D0 Z ^ σ *
        max (Z ^ δ) (reflectionColumnLength P D0 Z)⁻¹ ^ (-(N - σ)) *
          sphericalMajorant (S := S) σ * Eideal R f σ := by
  intro δ σ N hδ hσ hN
  have hNpos : 0 < N := by linarith
  obtain ⟨α, hα, hprofN⟩ := (rf_profile_bound R).2.1
  obtain ⟨Cprof, hCprof, hprof⟩ := hprofN N hNpos 0
  obtain ⟨_, _, hGrouped⟩ := rf_grouped_absolute R σ hσ
  refine ⟨Cprof, hCprof, ?_⟩
  intro υ P D0 Z h d f u sd sc hP hD0 hZ hPh hPhigh hDd hDhigh hPower hActive
  have hPpos : 0 < P := by linarith
  have hDpos : 0 < D0 := by linarith
  have hZpos : 0 < Z := by linarith
  rcases rf_qI_pos_ge_one h.1 h.2.1 with ⟨hqH, hqHone⟩
  rcases rf_qI_pos_ge_one d.1 d.2.1 with ⟨hqD, hqDone⟩
  rcases rf_qI_pos_ge_one f.1 f.2.1 with ⟨hqF, hqFone⟩
  have hqFSquare : qI f.1 ^ 2 ≤ qI h.1 :=
    (rf_active_support_bounds R).1 h f hPower hActive
  have hqFSquareLt : qI f.1 ^ 2 < 2 * P := lt_of_le_of_lt hqFSquare hPhigh
  let L : ℝ := reflectionColumnLength P D0 Z
  let Tscale : ℝ := qI d.1 ^ 2 * qI f.1 ^ 2 / Z
  let R0 : ℝ := reflectionColumnCutoff P D0 Z δ
  let J : ℝ := max (Z ^ δ) L⁻¹
  let Cfac : ℝ := Cprof * L ^ σ * J ^ (-(N - σ))
  have hLpos : 0 < L := by
    dsimp [L, reflectionColumnLength]
    positivity
  have hTpos : 0 < Tscale := by
    dsimp [Tscale]
    positivity
  have hZδpos : 0 < Z ^ δ := Real.rpow_pos_of_pos hZpos δ
  have hJpos : 0 < J := lt_of_lt_of_le hZδpos (le_max_left _ _)
  have hCfac : 0 < Cfac := by dsimp [Cfac]; positivity
  have hZδT : 1 ≤ Z ^ δ := Real.one_le_rpow (by linarith) hδ.le
  have hqdSquare : qI d.1 ^ 2 ≤ 4 * D0 ^ 2 := by
    nlinarith [mul_nonneg (by linarith : 0 ≤ 2 * D0 - qI d.1)
      (by positivity : 0 ≤ 2 * D0 + qI d.1)]
  have hqfSquare : qI f.1 ^ 2 ≤ 2 * P := hqFSquareLt.le
  have hnum : qI d.1 ^ 2 * qI f.1 ^ 2 ≤ 8 * D0 ^ 2 * P := by
    calc
      qI d.1 ^ 2 * qI f.1 ^ 2 ≤ (4 * D0 ^ 2) * (2 * P) :=
        mul_le_mul hqdSquare hqfSquare (by positivity) (by positivity)
      _ = 8 * D0 ^ 2 * P := by ring
  have hTL : Tscale ≤ L := by
    dsimp [Tscale, L, reflectionColumnLength]
    exact div_le_div_of_nonneg_right hnum hZpos.le
  have hTpow : Tscale ^ σ ≤ L ^ σ := Real.rpow_le_rpow hTpos.le hTL (by linarith)
  have hR0formula : R0 = Z ^ δ * L := by
    rfl
  have hJpow : 0 < J ^ (-(N - σ)) := Real.rpow_pos_of_pos hJpos (-(N - σ))
  let Src : Type := {t : FrozenIndex R h // t.f = f ∧ t.u = u} × S.SqfExtIdeal
  let Dst : Type := {a : S.ExtIdeal // activeNumerator R f a} × S.SqfExtIdeal × S.ExtIdeal
  have transportNumerator (t : FrozenIndex R h) (htf : t.f = f) :
      activeNumerator R f t.a := by
    rw [← htf]
    exact t.numerator
  let ψ : Src → Dst := fun p =>
    ((⟨p.1.1.a, transportNumerator p.1.1 p.1.2.1⟩ :
        {a : S.ExtIdeal // activeNumerator R f a}), (p.2, p.1.1.n))
  have hψ : Function.Injective ψ := by
    intro p q hpq
    rcases p with ⟨⟨t, ht⟩, c⟩
    rcases q with ⟨⟨t', ht'⟩, c'⟩
    change (((⟨t.a, transportNumerator t ht.1⟩ :
        {a : S.ExtIdeal // activeNumerator R f a}), (c, t.n)) =
      ((⟨t'.a, transportNumerator t' ht'.1⟩ :
        {a : S.ExtIdeal // activeNumerator R f a}), (c', t'.n))) at hpq
    have hsub := congrArg Prod.fst hpq
    have hpair := congrArg Prod.snd hpq
    have ha := congrArg Subtype.val hsub
    have hc := congrArg Prod.fst hpair
    have hn := congrArg Prod.snd hpair
    have htf : t.f = t'.f := ht.1.trans ht'.1.symm
    have hta : t.a = t'.a := ha
    have htn : t.n = t'.n := hn
    have htu : t.u = t'.u := ht.2.trans ht'.2.symm
    have htEq : t = t' := by
      cases t
      cases t'
      simp_all
    apply Prod.ext
    · apply Subtype.ext
      exact htEq
    · exact hc
  obtain ⟨hDir, hDirBound, _⟩ := hGrouped f
  have hMappedSum : Summable (fun p : Src => reflectedDirichletTerm R f σ (ψ p)) :=
    hDir.comp_injective hψ
  have hWeightNonneg : ∀ p : Dst, 0 ≤ reflectedDirichletTerm R f σ p := by
    intro p
    have hβ : 0 ≤ betaIdeal R f p.1.1 := rf_betaIdeal_nonneg R f p.1.1
    have hqa : 0 < qI p.1.1.1 :=
      (rf_qI_pos_ge_one p.1.1.1 p.1.1.2.1).1
    have hqc : 0 < qI p.2.1.1 :=
      (rf_qI_pos_ge_one p.2.1.1 p.2.1.2.1.1).1
    have hqn : 0 < qI p.2.2.1 := (rf_qI_pos_ge_one p.2.2.1 p.2.2.2.1).1
    unfold reflectedDirichletTerm
    apply mul_nonneg
    · apply div_nonneg
      · exact mul_nonneg hβ (Real.rpow_nonneg hqc.le _)
      · exact hqn.le
    · have hQ : 0 ≤ qI p.1.1.1 * qI p.2.1.1 * qI p.2.2.1 ^ 3 := by
        exact mul_nonneg (mul_nonneg hqa.le hqc.le) (pow_nonneg hqn.le 3)
      exact Real.rpow_nonneg hQ _
  have hMappedBound :
      (∑' p : Src, reflectedDirichletTerm R f σ (ψ p)) ≤
        sphericalMajorant (S := S) σ * Eideal R f σ := by
    calc
      (∑' p : Src, reflectedDirichletTerm R f σ (ψ p)) ≤
          ∑' p : Dst, reflectedDirichletTerm R f σ p :=
        tsum_comp_le_tsum_of_inj hDir hWeightNonneg hψ
      _ ≤ sphericalMajorant (S := S) σ * Eideal R f σ := hDirBound
  have hScaledSum : Summable (fun p : Src => Cfac * reflectedDirichletTerm R f σ (ψ p)) :=
    hMappedSum.mul_left Cfac
  have hScaledNonneg : ∀ p : Src,
      0 ≤ Cfac * reflectedDirichletTerm R f σ (ψ p) := by
    intro p
    exact mul_nonneg hCfac.le (hWeightNonneg (ψ p))
  have hScaledNorm : Summable (fun p : Src => ‖Cfac * reflectedDirichletTerm R f σ (ψ p)‖) := by
    exact hScaledSum.norm.congr fun p => by
      simp [abs_of_nonneg (hScaledNonneg p)]
  let act : Src → ℂ := fun p =>
    if R0 < qI p.1.1.a.1 * qI p.2.1 * qI p.1.1.n.1 ^ 3 then
      reflectedTerm R υ h d Z (p.1.1, sd, sc, p.2) else 0
  have hpoint : ∀ p : Src, ‖act p‖ ≤ Cfac * reflectedDirichletTerm R f σ (ψ p) := by
    intro p
    rcases p with ⟨⟨t, htu⟩, c⟩
    by_cases hle : qI t.a.1 * qI c.1 * qI t.n.1 ^ 3 ≤ R0
    · have hnot : ¬R0 < qI t.a.1 * qI c.1 * qI t.n.1 ^ 3 := not_lt_of_ge hle
      simpa [act, hnot] using hScaledNonneg ⟨⟨t, htu⟩, c⟩
    · have hQlt : R0 < qI t.a.1 * qI c.1 * qI t.n.1 ^ 3 := lt_of_not_ge hle
      let qa : ℝ := qI t.a.1
      let qc : ℝ := qI c.1
      let qn : ℝ := qI t.n.1
      let Q : ℝ := qa * qc * qn ^ 3
      let x : ℝ := Q / Tscale
      have hqa : 0 < qa ∧ 1 ≤ qa := rf_qI_pos_ge_one t.a.1 t.a.2.1
      have hqc : 0 < qc ∧ 1 ≤ qc :=
        rf_qI_pos_ge_one c.1 (by simpa using c.2.1.1)
      have hqn : 0 < qn ∧ 1 ≤ qn := rf_qI_pos_ge_one t.n.1 t.n.2.1
      have hQpos : 0 < Q := by
        dsimp [Q]
        exact mul_pos (mul_pos hqa.1 hqc.1) (pow_pos hqn.1 3)
      have hQone : 1 ≤ Q := by
        have hqn3 : 1 ≤ qn ^ 3 := one_le_pow₀ hqn.2
        have hqac : 1 ≤ qa * qc := by
          calc
            1 = 1 * 1 := by ring
            _ ≤ qa * qc :=
              mul_le_mul hqa.2 hqc.2 (by norm_num) (le_trans (by norm_num) hqa.2)
        calc
          1 ≤ qa * qc := hqac
          _ ≤ qa * qc * qn ^ 3 := by
            have hmul := mul_le_mul_of_nonneg_left hqn3 (by positivity : 0 ≤ qa * qc)
            simpa using hmul
      have hxpos : 0 < x := by dsimp [x]; positivity
      have hxarg :
          Z * qI t.a.1 * qI c.1 * qI t.n.1 ^ 3 /
              (qI d.1 ^ 2 * qI t.f.1 ^ 2) = x := by
        dsimp [x, Q, qa, qc, qn, Tscale]
        rw [htu.1]
        field_simp [ne_of_gt hZpos, ne_of_gt hqD, ne_of_gt hqF]
        <;> ring
      have hR0ltQ : Z ^ δ * L < Q := by
        simpa [R0, reflectionColumnCutoff, L, Q, qa, qc, qn] using hQlt
      have hZδT : Z ^ δ * Tscale < Q := by
        exact lt_of_le_of_lt
          (mul_le_mul_of_nonneg_left hTL (Real.rpow_nonneg hZpos.le δ)) hR0ltQ
      have hxZ : Z ^ δ < x := by
        dsimp [x]
        exact (lt_div_iff₀ hTpos).2 hZδT
      have hInv : L⁻¹ ≤ Tscale⁻¹ := (inv_le_inv₀ hLpos hTpos).2 hTL
      have hDiv : Tscale⁻¹ ≤ Q / Tscale := by
        calc
          Tscale⁻¹ = 1 / Tscale := by rw [one_div]
          _ ≤ Q / Tscale := div_le_div_of_nonneg_right hQone hTpos.le
      have hxInv : L⁻¹ ≤ x := by dsimp [x]; exact hInv.trans hDiv
      have hJle : J ≤ x := max_le_iff.mpr ⟨hxZ.le, hxInv⟩
      have hJpos : 0 < J := lt_of_lt_of_le hZδpos (le_max_left _ _)
      have hgap : 0 ≤ N - σ := by linarith
      have hdecayPow : x ^ (-N) ≤ J ^ (-(N - σ)) * Tscale ^ σ * Q ^ (-σ) := by
        have hsplit : x ^ (-N) = x ^ (-(N - σ)) * x ^ (-σ) := by
          calc
            x ^ (-N) = x ^ (-(N - σ) + (-σ)) := by congr 1 <;> ring
            _ = x ^ (-(N - σ)) * x ^ (-σ) := Real.rpow_add hxpos _ _
        have hanti := Real.rpow_le_rpow_of_nonpos hJpos hJle (neg_nonpos.mpr hgap)
        have hInvX : x⁻¹ = Tscale / Q := by
          dsimp [x]
          field_simp [ne_of_gt hTpos, ne_of_gt hQpos]
          <;> ring
        have hneg : x ^ (-σ) = Tscale ^ σ * Q ^ (-σ) := by
          rw [Real.rpow_neg_eq_inv_rpow, hInvX, Real.div_rpow hTpos.le hQpos.le] <;>
            rw [Real.rpow_neg hQpos.le σ] <;> ring
        calc
          x ^ (-N) = x ^ (-(N - σ)) * x ^ (-σ) := hsplit
          _ ≤ J ^ (-(N - σ)) * x ^ (-σ) :=
            mul_le_mul_of_nonneg_right hanti (Real.rpow_nonneg hxpos.le _)
          _ = J ^ (-(N - σ)) * Tscale ^ σ * Q ^ (-σ) := by rw [hneg] <;> ring
      have hPhi :
          ‖profilePhi R υ (kappaSix R t sd sc) x‖ ≤
            Cprof * min (x ^ α) (x ^ (-N)) := by
        have h := hprof υ (kappaSix R t sd sc) x hxpos
        simpa [Theta.normDerivR, Real.exp_log hxpos] using h
      have hPhiTail :
          ‖profilePhi R υ (kappaSix R t sd sc) x‖ ≤
            Cprof * (J ^ (-(N - σ)) * Tscale ^ σ * Q ^ (-σ)) := by
        calc
          ‖profilePhi R υ (kappaSix R t sd sc) x‖ ≤
              Cprof * min (x ^ α) (x ^ (-N)) := hPhi
          _ ≤ Cprof * x ^ (-N) :=
            mul_le_mul_of_nonneg_left (min_le_right _ _) hCprof.le
          _ ≤ Cprof * (J ^ (-(N - σ)) * Tscale ^ σ * Q ^ (-σ)) :=
            mul_le_mul_of_nonneg_left hdecayPow hCprof.le
      have hPhiTailAssoc :
          ‖profilePhi R υ (kappaSix R t sd sc) x‖ ≤
            Cprof * J ^ (-(N - σ)) * Tscale ^ σ * Q ^ (-σ) := by
        calc
          _ ≤ Cprof * (J ^ (-(N - σ)) * Tscale ^ σ * Q ^ (-σ)) := hPhiTail
          _ = Cprof * J ^ (-(N - σ)) * Tscale ^ σ * Q ^ (-σ) := by ring
      let coeff : ℝ := qc ^ (-(1 / 2 : ℝ)) / qn
      have hcoeffPos : 0 < coeff := by
        change 0 < qc ^ (-(1 / 2 : ℝ)) / qn
        exact div_pos (Real.rpow_pos_of_pos hqc.1 _) hqn.1
      have hcoeffNorm : ‖(coeff : ℂ)‖ = coeff := by
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hcoeffPos]
      have hfac := (rf_exterior_factorization R).1 υ h t
      have hOmega : ‖frozenOmega R υ t‖ ≤ betaIdeal R f t.a := by
        simpa [htu.1] using hfac.1
      have hRho : ‖frozenRho R υ t sd d‖ ≤ 1 := hfac.2.1 sd d
      have hLambda : ‖frozenLambda R υ t sc c‖ ≤ 1 := hfac.2.2 sc c
      have hBeta : 0 ≤ betaIdeal R f t.a := le_trans (norm_nonneg _) hOmega
      have hchi : ‖chiIdealPow D d.1 (cgen R c) 3‖ ≤ 1 :=
        (a2_bridge_SYMBOL D S).ideal_norm_le d.1 (cgen R c) 3
      have hcoeffProduct :
          ‖frozenOmega R υ t * frozenRho R υ t sd d * frozenLambda R υ t sc c *
              (coeff : ℝ) * chiIdealPow D d.1 (cgen R c) 3‖ ≤
            betaIdeal R f t.a * coeff := by
        have hprod :
            ‖frozenOmega R υ t * frozenRho R υ t sd d * frozenLambda R υ t sc c *
                (coeff : ℝ) * chiIdealPow D d.1 (cgen R c) 3‖ =
              ‖frozenOmega R υ t‖ * ‖frozenRho R υ t sd d‖ *
                ‖frozenLambda R υ t sc c‖ * coeff *
                  ‖chiIdealPow D d.1 (cgen R c) 3‖ := by
          simp only [norm_mul, hcoeffNorm]
        rw [hprod]
        calc
          ‖frozenOmega R υ t‖ * ‖frozenRho R υ t sd d‖ *
              ‖frozenLambda R υ t sc c‖ * coeff * ‖chiIdealPow D d.1 (cgen R c) 3‖ ≤
            betaIdeal R f t.a * 1 * 1 * coeff * 1 := by
              gcongr
          _ = betaIdeal R f t.a * coeff := by ring
      have htermExpr :
          reflectedTerm R υ h d Z (t, sd, sc, c) =
            (frozenOmega R υ t * frozenRho R υ t sd d * frozenLambda R υ t sc c *
              (coeff : ℝ) * chiIdealPow D d.1 (cgen R c) 3) *
                profilePhi R υ (kappaSix R t sd sc) x := by
        simp [reflectedTerm, coeff, qc, qn, hxarg]
      have hdirEval :
          reflectedDirichletTerm R f σ (ψ ((⟨t, htu⟩, c))) =
            betaIdeal R f t.a * coeff * Q ^ (-σ) := by
        change betaIdeal R f t.a * qI c.1 ^ (-(1 / 2 : ℝ)) / qI t.n.1 *
            (qI t.a.1 * qI c.1 * qI t.n.1 ^ 3) ^ (-σ) =
          betaIdeal R f t.a * coeff * Q ^ (-σ)
        dsimp [coeff, Q, qa, qc, qn] <;> ring
      have hTfac : Cprof * J ^ (-(N - σ)) * Tscale ^ σ ≤
          Cprof * L ^ σ * J ^ (-(N - σ)) := by
        calc
          Cprof * J ^ (-(N - σ)) * Tscale ^ σ ≤
              Cprof * J ^ (-(N - σ)) * L ^ σ :=
            mul_le_mul_of_nonneg_left hTpow (by positivity)
          _ = Cprof * L ^ σ * J ^ (-(N - σ)) := by ring
      have hterm :
          ‖reflectedTerm R υ h d Z (t, sd, sc, c)‖ ≤
            Cfac * reflectedDirichletTerm R f σ (ψ ((⟨t, htu⟩, c))) := by
        calc
          ‖reflectedTerm R υ h d Z (t, sd, sc, c)‖ =
              ‖frozenOmega R υ t * frozenRho R υ t sd d * frozenLambda R υ t sc c *
                (coeff : ℝ) * chiIdealPow D d.1 (cgen R c) 3‖ *
                  ‖profilePhi R υ (kappaSix R t sd sc) x‖ := by
            rw [htermExpr, norm_mul]
          _ ≤ betaIdeal R f t.a * coeff *
                (Cprof * J ^ (-(N - σ)) * Tscale ^ σ * Q ^ (-σ)) :=
              mul_le_mul hcoeffProduct hPhiTailAssoc (norm_nonneg _)
                (mul_nonneg hBeta hcoeffPos.le)
          _ ≤ Cprof * L ^ σ * J ^ (-(N - σ)) *
                (betaIdeal R f t.a * coeff * Q ^ (-σ)) := by
              calc
                betaIdeal R f t.a * coeff *
                    (Cprof * J ^ (-(N - σ)) * Tscale ^ σ * Q ^ (-σ)) =
                  (betaIdeal R f t.a * coeff * Q ^ (-σ)) *
                    (Cprof * J ^ (-(N - σ)) * Tscale ^ σ) := by ring
                _ ≤ (betaIdeal R f t.a * coeff * Q ^ (-σ)) *
                    (Cprof * L ^ σ * J ^ (-(N - σ))) := by
                  exact mul_le_mul_of_nonneg_left hTfac (by positivity)
                _ = Cprof * L ^ σ * J ^ (-(N - σ)) *
                    (betaIdeal R f t.a * coeff * Q ^ (-σ)) := by ring
          _ = Cfac * (betaIdeal R f t.a * coeff * Q ^ (-σ)) := by
              dsimp [Cfac] <;> ring
          _ = Cfac * reflectedDirichletTerm R f σ (ψ ((⟨t, htu⟩, c))) := by
              rw [hdirEval] <;> rfl
      simpa [act, hQlt, ψ] using hterm
  have hpointNorm : ∀ p : Src,
      ‖act p‖ ≤ ‖(Cfac * reflectedDirichletTerm R f σ (ψ p) : ℝ)‖ := by
    intro p
    rw [Real.norm_eq_abs, abs_of_nonneg (hScaledNonneg p)]
    exact hpoint p
  have hActSummable : Summable act :=
    Summable.of_norm_bounded hScaledNorm hpointNorm
  have hActNorm : Summable (fun p : Src => ‖act p‖) := hActSummable.norm
  have hsumPoint :
      (∑' p : Src, ‖act p‖) ≤
        ∑' p : Src, Cfac * reflectedDirichletTerm R f σ (ψ p) :=
    hActNorm.tsum_le_tsum hpoint hScaledSum
  have hsumScaled :
      (∑' p : Src, Cfac * reflectedDirichletTerm R f σ (ψ p)) =
        Cfac * ∑' p : Src, reflectedDirichletTerm R f σ (ψ p) := by
    rw [tsum_mul_left]
  have hsumDir :
      Cfac * ∑' p : Src, reflectedDirichletTerm R f σ (ψ p) ≤
        Cfac * (sphericalMajorant (S := S) σ * Eideal R f σ) :=
    mul_le_mul_of_nonneg_left hMappedBound (le_of_lt hCfac)
  have hsumAct :
      (∑' p : Src, ‖act p‖) ≤
        Cprof * L ^ σ * J ^ (-(N - σ)) * sphericalMajorant (S := S) σ * Eideal R f σ := by
    calc
      (∑' p : Src, ‖act p‖) ≤ ∑' p : Src, Cfac * reflectedDirichletTerm R f σ (ψ p) := hsumPoint
      _ = Cfac * ∑' p : Src, reflectedDirichletTerm R f σ (ψ p) := hsumScaled
      _ ≤ Cfac * (sphericalMajorant (S := S) σ * Eideal R f σ) := hsumDir
      _ = Cprof * L ^ σ * J ^ (-(N - σ)) * sphericalMajorant (S := S) σ * Eideal R f σ := by
        simp [Cfac, mul_assoc]
  refine ⟨?_, ?_⟩
  · simpa [act, not_le] using hActNorm
  · simpa [act, not_le] using hsumAct

/-- rf:tail-mass: pointwise active/slice bound, before summing squares over powerful parts. -/
theorem rf_tail_bound : ∀ δ σ N : ℝ, 0 < δ → 1 / 2 < σ → σ < N →
  ∃ C : ℝ, 0 < C ∧ ∀ υ P D0 Z h d f u sd sc,
    1 ≤ P → 1 ≤ D0 → 2 ≤ Z → P ≤ qI h.1 → qI h.1 < 2 * P →
    D0 ≤ qI d.1 → qI d.1 < 2 * D0 → IsPowerful h.1 → activeFactor R h f →
    ‖activePartial R false υ h d f u sd sc Z (reflectionColumnCutoff P D0 Z δ)‖ ≤
      C * reflectionColumnLength P D0 Z ^ σ *
        max (Z ^ δ) (reflectionColumnLength P D0 Z)⁻¹ ^ (-(N - σ)) *
          sphericalMajorant (S := S) σ * Eideal R f σ := by
  intro δ σ N hδ hσ hN
  obtain ⟨C, hC, hbound⟩ := rf_tail_bound_abs R δ σ N hδ hσ hN
  refine ⟨C, hC, ?_⟩
  intro υ P D0 Z h d f u sd sc hP hD0 hZ hPh hPhigh hDd hDhigh hPower hActive
  obtain ⟨hSummable, hNormBound⟩ :=
    hbound υ P D0 Z h d f u sd sc hP hD0 hZ hPh hPhigh hDd hDhigh hPower hActive
  let Src := {t : FrozenIndex R h // t.f = f ∧ t.u = u} × S.SqfExtIdeal
  have hpartial :
      activePartial R false υ h d f u sd sc Z (reflectionColumnCutoff P D0 Z δ) =
        ∑' p : Src, if (qI p.1.1.a.1 * qI p.2.1 * qI p.1.1.n.1 ^ 3 ≤
            reflectionColumnCutoff P D0 Z δ) = false then
          reflectedTerm R υ h d Z (p.1.1, sd, sc, p.2) else 0 := by
    rfl
  rw [hpartial]
  exact (norm_tsum_le_tsum_norm hSummable).trans hNormBound

set_option maxHeartbeats 8000000 in
private lemma rf_squarefree_support_finite (h : S.ExtIdeal) (hh : IsPowerful h.1) :
    Finite {f : S.ExtIdeal // Squarefree f.1 ∧
      ∀ v ∈ R.exterior.support f, v ∈ R.exterior.support h} := by
  classical
  let h6 : S.ExtIdeal := R.exterior.pow h 6
  have h6power : IsPowerful h6.1 := by
    intro v hv
    have hvh : v.asIdeal ∣ h.1 := by
      have hv' : v.asIdeal ∣ h.1 ^ 6 := by
        simpa [h6, R.exterior.pow_val] using hv
      exact v.prime.dvd_of_dvd_pow hv'
    have hp2 : v.asIdeal ^ 2 ∣ h.1 := hh v hvh
    have hh6 : h.1 ∣ h6.1 := by
      dsimp [h6]
      rw [R.exterior.pow_val]
      exact dvd_pow_self h.1 (by norm_num : (6 : ℕ) ≠ 0)
    exact dvd_trans hp2 hh6
  have hexp (v : FinPlace F) : idealExp v h6.1 = 6 * idealExp v h.1 := by
    dsimp [idealExp, h6]
    rw [R.exterior.pow_val]
    exact Associates.count_pow (Associates.mk_ne_zero.mpr h.2.1)
      v.associates_irreducible 6
  have hactive (f : {f : S.ExtIdeal // Squarefree f.1 ∧
      ∀ v ∈ R.exterior.support f, v ∈ R.exterior.support h}) : activeFactor R h6 f.1 := by
    refine ⟨f.2.1, ?_, ?_⟩
    · intro v hv
      apply (R.exterior.mem_support h6 v).2
      rw [R.exterior.pow_val]
      exact dvd_trans ((R.exterior.mem_support h v).1 (f.2.2 v hv))
        (dvd_pow_self h.1 (by norm_num : (6 : ℕ) ≠ 0))
    · intro v hv hn
      have hzero : idealExp v h6.1 % 6 = 0 := by rw [hexp]; simp
      exact (hn hzero).elim
  have hqfsq (f : {f : S.ExtIdeal // Squarefree f.1 ∧
      ∀ v ∈ R.exterior.support f, v ∈ R.exterior.support h}) :
      qI f.1.1 ^ 2 ≤ qI h6.1 :=
    (rf_active_support_bounds R).1 h6 f.1 h6power (hactive f)
  have hqh6 : qI h6.1 = qI h.1 ^ 6 := by
    simp [h6, qI, R.exterior.pow_val]
  have hnormBound (f : {f : S.ExtIdeal // Squarefree f.1 ∧
      ∀ v ∈ R.exterior.support f, v ∈ R.exterior.support h}) :
      qI f.1.1 ≤ qI h.1 ^ 3 := by
    have hqf : 0 ≤ qI f.1.1 := by
      change 0 ≤ (Ideal.absNorm f.1.1 : ℝ)
      exact Nat.cast_nonneg _
    have hqh : 0 ≤ qI h.1 := by
      change 0 ≤ (Ideal.absNorm h.1 : ℝ)
      exact Nat.cast_nonneg _
    have hsquare : qI f.1.1 ^ 2 ≤ qI h.1 ^ 6 := by
      rw [← hqh6]
      exact hqfsq f
    calc
      qI f.1.1 = Real.sqrt (qI f.1.1 ^ 2) := by
        rw [Real.sqrt_sq_eq_abs, abs_of_nonneg hqf]
      _ ≤ Real.sqrt (qI h.1 ^ 6) := Real.sqrt_le_sqrt hsquare
      _ = qI h.1 ^ 3 := by
        rw [show qI h.1 ^ 6 = (qI h.1 ^ 3) ^ 2 by ring,
          Real.sqrt_sq_eq_abs, abs_of_nonneg (by positivity)]
  let X : ℝ := qI h.1 ^ 3
  have hX : 0 ≤ X := by
    dsimp [X]
    exact pow_nonneg (le_of_lt (rf_qI_pos_ge_one h.1 h.2.1).1) 3
  have hnormFinite : {f : S.ExtIdeal | qI f.1 ≤ X}.Finite := by
    have hfinite := (a2_bridge_COUNT_finite S X hX).1
    simpa [X, qI, idealNorm] using hfinite
  letI : Fintype {f : S.ExtIdeal // qI f.1 ≤ X} := hnormFinite.fintype
  apply Finite.of_injective (fun f => (⟨f.1, by simpa [X] using hnormBound f⟩ :
      {f : S.ExtIdeal // qI f.1 ≤ X}))
  intro f g hfg
  rcases f with ⟨f, hf⟩
  rcases g with ⟨g, hg⟩
  have hfg' : f = g := congrArg
    (fun z : {f : S.ExtIdeal // qI f.1 ≤ X} => z.1) hfg
  subst g
  rfl

private lemma rf_Eideal_nonneg (f : S.ExtIdeal) {σ : ℝ} (hσ : 0 ≤ σ) :
    0 ≤ Eideal R f σ := by
  unfold Eideal
  apply Finset.prod_nonneg
  intro v hv
  have hvS : v ∉ S.Sf := R.exterior.support_exterior f v hv
  obtain ⟨hsum, _, _⟩ := (rf_active_support_bounds R).2.2.1 v hvS σ hσ
  have hq : 1 < qI v.asIdeal := qI_prime_gt_one v
  have hqpos : 0 < qI v.asIdeal := lt_trans (by norm_num) hq
  apply tsum_nonneg
  intro e
  have hbeta : 0 ≤ betaPrime (qI v.asIdeal) (qI_prime_gt_one v) e := by
    unfold betaPrime
    by_cases h0 : e = 0
    · rw [if_pos h0]
      norm_num
    · by_cases h1 : e % 3 = 1
      · rw [if_neg h0, if_pos h1]
        exact Real.rpow_nonneg hqpos.le _
      · by_cases h2 : e % 3 = 0
        · rw [if_neg h0, if_neg h1, if_pos h2]
          exact Real.rpow_nonneg hqpos.le _
        · rw [if_neg h0, if_neg h1, if_neg h2]
  exact mul_nonneg hbeta (Real.rpow_nonneg hqpos.le _)

private lemma rf_sphericalMajorant_nonneg (σ : ℝ) :
    0 ≤ sphericalMajorant (S := S) σ := by
  unfold sphericalMajorant
  apply tsum_nonneg
  intro p
  have hq1 : 0 ≤ qI p.1.1 := by
    change 0 ≤ (Ideal.absNorm p.1.1 : ℝ)
    exact Nat.cast_nonneg _
  have hq2 : 0 ≤ qI p.2.1 := by
    change 0 ≤ (Ideal.absNorm p.2.1 : ℝ)
    exact Nat.cast_nonneg _
  exact mul_nonneg (Real.rpow_nonneg hq1 _) (Real.rpow_nonneg hq2 _)

set_option maxHeartbeats 4000000 in
private lemma rf_tail_split_bound : ∀ δ δ₁ σ N : ℝ, 0 < δ → 0 < δ₁ →
  1 / 2 < σ → σ < N → ∃ C : ℝ, 0 < C ∧ ∀ υ P D0 Z h d,
    1 ≤ P → 1 ≤ D0 → 2 ≤ Z → P ≤ qI h.1 → qI h.1 < 2 * P →
    D0 ≤ qI d.1 → qI d.1 < 2 * D0 → IsPowerful h.1 →
    ‖splitReflection R false υ h d Z (reflectionColumnCutoff P D0 Z δ)‖ ≤
      C * P ^ δ₁ * reflectionColumnLength P D0 Z ^ σ *
        max (Z ^ δ) (reflectionColumnLength P D0 Z)⁻¹ ^ (-(N - σ)) := by
  intro δ δ₁ σ N hδ hδ₁ hσ hN
  obtain ⟨Ctail, hCtail, hTail⟩ := rf_tail_bound_abs R δ σ N hδ hσ hN
  obtain ⟨Cact, hCact, hActBound⟩ := (rf_active_support_bounds R).2.2.2 δ₁ hδ₁
  classical
  letI : Fintype (UnitSix S) := R.sheets.unitSixFinite
  letI : Fintype S.V := R.sheets.classFinite
  letI : Fintype Bd.B := inferInstance
  let Slice : Type := UnitSix S × Bd.B × Bd.B
  let Cslice : ℝ := Fintype.card Slice
  refine ⟨max 1 (Ctail * Cact * Cslice * 2 ^ δ₁ *
    sphericalMajorant (S := S) σ), ?_, ?_⟩
  · positivity
  · intro υ P D0 Z h d hP hD0 hZ hPh hPhigh hDd hDhigh hPower
    let R0 := reflectionColumnCutoff P D0 Z δ
    let L := reflectionColumnLength P D0 Z
    let J := max (Z ^ δ) L⁻¹
    have hPpos : 0 < P := by linarith
    have hDpos : 0 < D0 := by linarith
    have hZpos : 0 < Z := by linarith
    have hqHpos : 0 < qI h.1 := (rf_qI_pos_ge_one h.1 h.2.1).1
    have hLpos : 0 < L := by dsimp [L, reflectionColumnLength]; positivity
    have hJpos : 0 < J := by
      apply lt_of_lt_of_le (Real.rpow_pos_of_pos hZpos δ)
      exact le_max_left _ _
    have hJpow : 0 < J ^ (-(N - σ)) := Real.rpow_pos_of_pos hJpos _
    have hMaj : 0 ≤ sphericalMajorant (S := S) σ := rf_sphericalMajorant_nonneg σ
    let F0 : Type := {f : S.ExtIdeal // Squarefree f.1 ∧
      ∀ v ∈ R.exterior.support f, v ∈ R.exterior.support h}
    letI : Finite F0 := rf_squarefree_support_finite R h hPower
    letI : Fintype F0 := Fintype.ofFinite F0
    let Active : Type := {f : F0 // activeFactor R h f.1}
    letI : Fintype Active := Subtype.fintype (fun f : F0 => activeFactor R h f.1)
    let Base : Type := Active × Slice
    let Fiber (b : Base) : Type :=
      {t : FrozenIndex R h // t.f = b.1.1.1 ∧ t.u = b.2.1} × S.SqfExtIdeal
    let Source : Type := FrozenIndex R h × Bd.B × Bd.B × S.SqfExtIdeal
    let mkActive (t : FrozenIndex R h) : Active :=
      ⟨⟨t.f, ⟨t.active.1, t.active.2.1⟩⟩, t.active⟩
    let baseOf (p : Source) : Base :=
      (mkActive p.1, p.1.u, p.2.1, p.2.2.1)
    let tailTerm (p : Source) : ℂ :=
      if (qI p.1.a.1 * qI p.2.2.2.1 * qI p.1.n.1 ^ 3 ≤ R0) = false then
        reflectedTerm R υ h d Z (p.1, p.2.1, p.2.2.1, p.2.2.2) else 0
    let blockTerm (b : Base) (x : Fiber b) : ℂ :=
      if (qI x.1.1.a.1 * qI x.2.1 * qI x.1.1.n.1 ^ 3 ≤ R0) = false then
        reflectedTerm R υ h d Z (x.1.1, b.2.2.1, b.2.2.2, x.2) else 0
    let e : Source ≃ Σ b : Base, Fiber b :=
      { toFun := fun p => ⟨baseOf p,
          (⟨p.1, ⟨rfl, rfl⟩⟩, p.2.2.2)⟩
        invFun := fun z =>
          (z.2.1.1, (z.1.2.2.1, (z.1.2.2.2, z.2.2)))
        left_inv := by
          intro p
          rcases p with ⟨t, sd, sc, c⟩
          rfl
        right_inv := by
          intro z
          rcases z with ⟨b, x⟩
          rcases b with ⟨a, u, sd, sc⟩
          rcases a with ⟨f0, ha⟩
          rcases f0 with ⟨f, hf⟩
          rcases x with ⟨⟨t, htf, htu⟩, c⟩
          have hf0 : (⟨t.f, ⟨t.active.1, t.active.2.1⟩⟩ : F0) = ⟨f, hf⟩ := by
            apply Subtype.ext
            exact htf
          have ha' : mkActive t = ⟨⟨f, hf⟩, ha⟩ := by
            apply Subtype.ext
            exact hf0
          have hb : (mkActive t, t.u, sd, sc) = (⟨⟨f, hf⟩, ha⟩, u, sd, sc) := by
            apply Prod.ext ha'
            apply Prod.ext htu
            rfl
          cases hb
          rfl
      }
    have hterm : ∀ z : (Σ b : Base, Fiber b),
        tailTerm (e.symm z) = blockTerm z.1 z.2 := by
      intro z
      rcases z with ⟨b, x⟩
      rcases b with ⟨a, u, sd, sc⟩
      rcases x with ⟨⟨t, ht⟩, c⟩
      simp [tailTerm, blockTerm, e]
    have hσ0 : 0 ≤ σ := by linarith
    have hAllActive : (∑ f : F0, Eideal R f.1 σ) ≤ Cact * qI h.1 ^ δ₁ := by
      have h := hActBound h σ hσ0
      simpa [F0, finsum_eq_sum_of_fintype] using h
    have hActiveSum : (∑ f : Active, Eideal R f.1.1 σ) ≤ Cact * qI h.1 ^ δ₁ := by
      have hsplit := Fintype.sum_subtype_add_sum_subtype
        (fun f : F0 => activeFactor R h f.1) (fun f : F0 => Eideal R f.1 σ)
      have hdecomp :
          (∑ f : Active, Eideal R f.1.1 σ) +
            ∑ f : {f : F0 // ¬ activeFactor R h f.1}, Eideal R f.1.1 σ =
              ∑ f : F0, Eideal R f.1 σ := by
        simpa [Active] using hsplit
      have hcompl : 0 ≤
          ∑ f : {f : F0 // ¬ activeFactor R h f.1}, Eideal R f.1.1 σ := by
        apply Finset.sum_nonneg
        intro f hf
        exact rf_Eideal_nonneg R f.1.1 hσ0
      linarith
    have hFiberNorm (b : Base) : Summable (fun x : Fiber b => ‖blockTerm b x‖) := by
      obtain ⟨hs, _⟩ := hTail υ P D0 Z h d b.1.1.1 b.2.1 b.2.2.1 b.2.2.2
        hP hD0 hZ hPh hPhigh hDd hDhigh hPower b.1.2
      simpa [Fiber, blockTerm, R0] using hs
    have hOuterNorm : Summable (fun b : Base => ∑' x : Fiber b, ‖blockTerm b x‖) := by
      exact Summable.of_finite
    have hSigmaNorm : Summable (fun z : (Σ b : Base, Fiber b) =>
        ‖blockTerm z.1 z.2‖) := by
      apply (summable_sigma_of_nonneg (fun z => norm_nonneg _)).2
      exact ⟨hFiberNorm, by simpa using hOuterNorm⟩
    have hSourceNorm : Summable (fun p : Source => ‖tailTerm p‖) := by
      have hs := hSigmaNorm.comp_injective e.injective
      apply hs.congr
      intro p
      exact congrArg (fun z : ℂ => ‖z‖) (hterm (e p)).symm
    have hNormTsum :
        (∑' p : Source, ‖tailTerm p‖) =
          ∑ b : Base, ∑' x : Fiber b, ‖blockTerm b x‖ := by
      calc
        _ = ∑' p : Source, ‖tailTerm (e.symm (e p))‖ := by
          apply tsum_congr
          intro p
          simp
        _ = ∑' z : (Σ b : Base, Fiber b), ‖tailTerm (e.symm z)‖ :=
          Equiv.tsum_eq e (fun z : (Σ b : Base, Fiber b) =>
            ‖tailTerm (e.symm z)‖)
        _ = ∑' z : (Σ b : Base, Fiber b), ‖blockTerm z.1 z.2‖ := by
          apply tsum_congr
          intro z
          rw [hterm z]
        _ = ∑' b : Base, ∑' x : Fiber b, ‖blockTerm b x‖ :=
          Summable.tsum_sigma' hFiberNorm hSigmaNorm
        _ = ∑ b : Base, ∑' x : Fiber b, ‖blockTerm b x‖ := by rw [tsum_fintype]
    have hFiberBound (b : Base) :
        (∑' x : Fiber b, ‖blockTerm b x‖) ≤
          Ctail * L ^ σ * J ^ (-(N - σ)) * sphericalMajorant (S := S) σ *
            Eideal R b.1.1.1 σ := by
      obtain ⟨_, hb⟩ := hTail υ P D0 Z h d b.1.1.1 b.2.1 b.2.2.1 b.2.2.2
        hP hD0 hZ hPh hPhigh hDd hDhigh hPower b.1.2
      simpa [Fiber, blockTerm, R0, L, J, mul_assoc] using hb
    have hsumFibers :
        (∑ b : Base, ∑' x : Fiber b, ‖blockTerm b x‖) ≤
          ∑ b : Base,
            Ctail * L ^ σ * J ^ (-(N - σ)) * sphericalMajorant (S := S) σ *
              Eideal R b.1.1.1 σ := by
      apply Finset.sum_le_sum
      intro b hb
      exact hFiberBound b
    let K : ℝ := Ctail * L ^ σ * J ^ (-(N - σ)) * sphericalMajorant (S := S) σ
    have hfactor :
        (∑ b : Base, K * Eideal R b.1.1.1 σ) =
          Cslice * K * (∑ f : Active, Eideal R f.1.1 σ) := by
      dsimp [Base]
      rw [Fintype.sum_prod_type]
      calc
        _ = ∑ f : Active, ∑ s : Slice, K * Eideal R f.1.1 σ := rfl
        _ = ∑ f : Active, Cslice * (K * Eideal R f.1.1 σ) := by
          apply Finset.sum_congr rfl
          intro f hf
          simp [Cslice, Finset.sum_const, nsmul_eq_mul]
        _ = Cslice * K * (∑ f : Active, Eideal R f.1.1 σ) := by
          calc
            _ = ∑ f : Active, (Cslice * K) * Eideal R f.1.1 σ := by
              apply Finset.sum_congr rfl
              intro f hf
              ring
            _ = (Cslice * K) * (∑ f : Active, Eideal R f.1.1 σ) := by
              rw [Finset.mul_sum]
            _ = _ := by ring
    have hKnonneg : 0 ≤ K := by dsimp [K]; positivity
    have hCslice : 0 ≤ Cslice := by positivity
    have hsumUpper :
        (∑ b : Base, ∑' x : Fiber b, ‖blockTerm b x‖) ≤
          Cslice * K * (Cact * qI h.1 ^ δ₁) := by
      calc
        _ ≤ ∑ b : Base, K * Eideal R b.1.1.1 σ := by
          apply Finset.sum_le_sum
          intro b hb
          simpa [K, mul_assoc] using hFiberBound b
        _ = Cslice * K * (∑ f : Active, Eideal R f.1.1 σ) := hfactor
        _ ≤ Cslice * K * (Cact * qI h.1 ^ δ₁) :=
          mul_le_mul_of_nonneg_left hActiveSum (mul_nonneg hCslice hKnonneg)
    have hqhpow : qI h.1 ^ δ₁ ≤ (2 * P) ^ δ₁ :=
      Real.rpow_le_rpow (by positivity) hPhigh.le hδ₁.le
    have hmulPow : (2 * P) ^ δ₁ = 2 ^ δ₁ * P ^ δ₁ := by
      rw [Real.mul_rpow (by norm_num) (by positivity)]
    have hcoef : Ctail * Cact * Cslice * 2 ^ δ₁ *
        sphericalMajorant (S := S) σ ≤
          max 1 (Ctail * Cact * Cslice * 2 ^ δ₁ *
            sphericalMajorant (S := S) σ) := le_max_right _ _
    have hboundNorm : ‖splitReflection R false υ h d Z R0‖ ≤
        max 1 (Ctail * Cact * Cslice * 2 ^ δ₁ *
          sphericalMajorant (S := S) σ) * P ^ δ₁ * L ^ σ * J ^ (-(N - σ)) := by
      by_cases hdc : Squarefree d.1 ∧ IsCoprime d.1 h.1
      · have hsplitEq : splitReflection R false υ h d Z R0 = ∑' p : Source, tailTerm p := by
          unfold splitReflection
          simp only [hdc, ↓reduceIte]
          apply tsum_congr
          intro p
          rfl
        rw [hsplitEq]
        calc
          ‖∑' p : Source, tailTerm p‖ ≤ ∑' p : Source, ‖tailTerm p‖ :=
            norm_tsum_le_tsum_norm hSourceNorm
          _ = ∑ b : Base, ∑' x : Fiber b, ‖blockTerm b x‖ := hNormTsum
          _ ≤ Cslice * K * (Cact * qI h.1 ^ δ₁) := hsumUpper
          _ ≤ Cslice * K * (Cact * ((2 * P) ^ δ₁)) :=
            mul_le_mul_of_nonneg_left
