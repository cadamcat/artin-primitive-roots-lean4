    intro h
    apply hψprim (a := (1 : 𝓞 F ⧸ v.asIdeal)) one_ne_zero
    simpa [h]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro he
    rw [rf_localR_formula R v hv j e t htLoc]
    rw [rf_localW_zero_of_negative R v hv e he]
    simp
  · intro he
    exact rf_localR_formula R v hv j e t htLoc
  · intro hj1 he
    subst j
