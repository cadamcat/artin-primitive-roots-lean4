import ArtinPrimitiveRoots.Hecke.Defs
import ArtinPrimitiveRoots.Hecke.Theta.RayUnits
import ClassFieldTheory.AlgebraicNumberTheory.RayClass.Ideal
import ClassFieldTheory.AlgebraicNumberTheory.RayClass.Narrow

/-!
# Bridge the frozen ray-class copy to the compiled CFT ideal API

The CFT ideal/idele API lives in the separate `RayClass` namespace. For totally complex fields,
this file identifies its ray class group with the frozen worktree copy without importing the
unbuilt legacy `RayClassIdealModulusProjection` module.
-/

set_option autoImplicit false

open scoped NumberField
open NumberField IsDedekindDomain
open ClassFieldTheory

noncomputable section

namespace ArtinPrimitiveRoots.Hecke

variable {K : Type*} [Field K] [NumberField K]

/-- Interpret the frozen copied modulus in the compiled CFT ray-class API. -/
def rayModulusToCFT (m : RayClassModulus K) : RayClass.Modulus K where
  finitePart := m.finitePart
  infinitePart := m.infinitePart

@[simp] theorem rayModulusToCFT_finitePart (m : RayClassModulus K) :
    (rayModulusToCFT m).finitePart = m.finitePart := rfl

@[simp] theorem rayModulusToCFT_infinitePart (m : RayClassModulus K) :
    (rayModulusToCFT m).infinitePart = m.infinitePart := rfl

theorem rayPrimeToIdealGroups_eq (m : RayClassModulus K) :
    rayClassPrimeToIdeals m = RayClass.primeToModulusIdeals (rayModulusToCFT m) := by
  ext I
  rfl

noncomputable def rayPrimeToIdealEquiv (m : RayClassModulus K) :
    rayClassPrimeToIdeals m ≃* RayClass.primeToModulusIdeals (rayModulusToCFT m) where
  toFun I := ⟨I.1, I.2⟩
  invFun I := ⟨I.1, I.2⟩
  left_inv I := by apply Subtype.ext; rfl
  right_inv I := by apply Subtype.ext; rfl
  map_mul' I J := by apply Subtype.ext; rfl

theorem rayLocalHigherUnitGroup_eq (v : HeightOneSpectrum (𝓞 K)) (n : ℕ) :
    ClassFieldTheory.rayLocalHigherUnitGroup v n = RayClass.localHigherUnitGroup v n := rfl

theorem principalIdele_finiteComponent_eq (x : Kˣ) (v : HeightOneSpectrum (𝓞 K)) :
    (IdeleGroup.principalIdele K x).2 v =
      ClassFieldTheory.finitePlaceUnitEmbedding v x := by
  apply Units.ext
  rfl

theorem isRayCongruent_iff_principalIdele_mem [IsTotallyComplex K]
    (m : RayClassModulus K) (x : Kˣ) :
    ClassFieldTheory.IsRayCongruent m x ↔
      IdeleGroup.principalIdele K x ∈
        RayClass.idelePrimeToModulusSubgroup (rayModulusToCFT m) := by
  let m' := rayModulusToCFT m
  have hinf : m'.infiniteCongruenceSubgroup = ⊤ := by
    ext a
    rw [RayClass.Modulus.mem_infiniteCongruenceSubgroup_iff]
    simp [m', rayModulusToCFT,
      rayClassModulus_infinitePart_eq_empty (K := K) m]
  rw [ClassFieldTheory.IsRayCongruent,
    rayClassModulus_infinitePart_eq_empty (K := K) m]
  rw [RayClass.idelePrimeToModulusSubgroup, hinf]
  change
    (∀ v, v ∈ m.finitePart.support →
        ClassFieldTheory.finitePlaceUnitEmbedding v x ∈
          ClassFieldTheory.rayLocalHigherUnitGroup v (m.finitePart v)) ∧
      (∀ v : ClassFieldTheory.RayClassRealPlace K, v ∈ ∅ →
        0 < v.1.embedding_of_isReal v.2 (x : K)) ↔
    (IdeleGroup.principalIdele K x).1 ∈ ⊤ ∧
      (IdeleGroup.principalIdele K x).2 ∈
        RayClass.finitePrimeToModulusSubgroup m'
  simp [RayClass.finitePrimeToModulusSubgroup,
    principalIdele_finiteComponent_eq, rayLocalHigherUnitGroup_eq, m', rayModulusToCFT]

theorem rayPrincipalIdealSubgroup_eq_map (m : RayClassModulus K) :
    ClassFieldTheory.rayPrincipalIdealSubgroup m =
      Subgroup.map (toPrincipalIdeal (𝓞 K) K) (rayCongruentUnits m) := by
  unfold ClassFieldTheory.rayPrincipalIdealSubgroup
  apply le_antisymm
  · apply (Subgroup.closure_le
      (Subgroup.map (toPrincipalIdeal (𝓞 K) K) (rayCongruentUnits m))).mpr
    rintro I ⟨x, hx, hI⟩
    rw [← hI]
    exact ⟨x, hx, rfl⟩
  · apply Subgroup.map_le_iff_le_comap.mpr
    intro x hx
    exact Subgroup.subset_closure ⟨x, hx, rfl⟩

theorem rayPrincipalIdeal_of_integralUnit (u : (𝓞 K)ˣ) :
    toPrincipalIdeal (𝓞 K) K (Units.map (algebraMap (𝓞 K) K).toMonoidHom u) = 1 := by
  apply (RayClass.toPrincipalIdeal_eq_one_iff_mem_integralUnits
    (K := K) (Units.map (algebraMap (𝓞 K) K).toMonoidHom u)).2
  exact ⟨u, rfl⟩

theorem toPrincipalIdeal_mul_integralUnit_eq (u : (𝓞 K)ˣ) (x : Kˣ) :
    toPrincipalIdeal (𝓞 K) K
        ((Units.map (algebraMap (𝓞 K) K).toMonoidHom u) * x) =
      toPrincipalIdeal (𝓞 K) K x := by
  rw [map_mul, rayPrincipalIdeal_of_integralUnit, one_mul]

/-- Field generators whose principal ideals are prime to the finite modulus. -/
def rayPrimeToPrincipalFieldUnits (m : RayClassModulus K) : Subgroup Kˣ :=
  Subgroup.comap (toPrincipalIdeal (𝓞 K) K) (ClassFieldTheory.rayClassPrimeToIdeals m)

/-- The ray class of the principal ideal generated by a prime-to-modulus field element. -/
noncomputable def rayPrincipalFieldUnitClassHom (m : RayClassModulus K) :
    rayPrimeToPrincipalFieldUnits m →* ClassFieldTheory.RayClassGroup m :=
  (QuotientGroup.mk' (ClassFieldTheory.rayPrincipalIdealSubgroupInPrimeTo m)).comp
    (MonoidHom.codRestrict
      ((toPrincipalIdeal (𝓞 K) K).comp (rayPrimeToPrincipalFieldUnits m).subtype)
      (ClassFieldTheory.rayClassPrimeToIdeals m) (fun x => x.2))

noncomputable def cftRayClassOfPrincipalMultiply (m : RayClass.Modulus K)
    (A : RayClass.primeToModulusIdeals m) (x : Kˣ)
    (hx : toPrincipalIdeal (𝓞 K) K x ∈ RayClass.primeToModulusIdeals m) :
    RayClass.IdealRayClassGroup m :=
  QuotientGroup.mk' (RayClass.principalRayIdealSubgroup m)
    ⟨toPrincipalIdeal (𝓞 K) K x * (A : FractionalIdealGroup K),
      (RayClass.primeToModulusIdeals m).mul_mem hx A.2⟩

theorem cftRayClassOfPrincipalMultiply_eq_of_congruent [IsTotallyComplex K]
    (m : RayClassModulus K) (A : RayClass.primeToModulusIdeals (rayModulusToCFT m))
    (x y : Kˣ)
    (hx : toPrincipalIdeal (𝓞 K) K x ∈ RayClass.primeToModulusIdeals (rayModulusToCFT m))
    (hy : toPrincipalIdeal (𝓞 K) K y ∈ RayClass.primeToModulusIdeals (rayModulusToCFT m))
    (hxy : ClassFieldTheory.IsRayCongruent m (x * y⁻¹)) :
    cftRayClassOfPrincipalMultiply (rayModulusToCFT m) A x hx =
      cftRayClassOfPrincipalMultiply (rayModulusToCFT m) A y hy := by
  let m' := rayModulusToCFT m
  let z := x * y⁻¹
  have hidele : IdeleGroup.principalIdele K z ∈
      RayClass.idelePrimeToModulusSubgroup m' :=
    (isRayCongruent_iff_principalIdele_mem m z).mp hxy
  have hzPrime : toPrincipalIdeal (𝓞 K) K z ∈ RayClass.primeToModulusIdeals m' := by
    have h := RayClass.fractionalIdeal_mem_primeToModulusIdeals m'
      (IdeleGroup.principalIdele K z) hidele
    simpa [IdeleGroup.fractionalIdeal_principalIdele] using h
  let pz : RayClass.primeToModulusIdeals m' := ⟨toPrincipalIdeal (𝓞 K) K z, hzPrime⟩
  have hpz : pz ∈ RayClass.principalRayIdealSubgroup m' :=
    (RayClass.mem_principalRayIdealSubgroup_iff m' pz).2 ⟨z, hidele, rfl⟩
  let px : RayClass.primeToModulusIdeals m' :=
    ⟨toPrincipalIdeal (𝓞 K) K x * (A : FractionalIdealGroup K),
      (RayClass.primeToModulusIdeals m').mul_mem hx A.2⟩
  let py : RayClass.primeToModulusIdeals m' :=
    ⟨toPrincipalIdeal (𝓞 K) K y * (A : FractionalIdealGroup K),
      (RayClass.primeToModulusIdeals m').mul_mem hy A.2⟩
  have hdiv : px / py = pz := by
    apply Subtype.ext
    change (toPrincipalIdeal (𝓞 K) K x * (A : FractionalIdealGroup K)) /
        (toPrincipalIdeal (𝓞 K) K y * (A : FractionalIdealGroup K)) =
      toPrincipalIdeal (𝓞 K) K z
    rw [mul_div_mul_right_eq_div]
    simp [z, map_mul, map_inv, div_eq_mul_inv]
  rw [cftRayClassOfPrincipalMultiply, cftRayClassOfPrincipalMultiply]
  exact (QuotientGroup.eq_iff_div_mem).2 (hdiv ▸ hpz)

noncomputable def rayClassOfPrincipalMultiply (m : RayClassModulus K)
    (A : ClassFieldTheory.rayClassPrimeToIdeals m) (x : Kˣ)
    (hx : toPrincipalIdeal (𝓞 K) K x ∈ ClassFieldTheory.rayClassPrimeToIdeals m) :
    ClassFieldTheory.RayClassGroup m :=
  QuotientGroup.mk'
    (ClassFieldTheory.rayPrincipalIdealSubgroupInPrimeTo m)
    ⟨toPrincipalIdeal (𝓞 K) K x * (A : ClassFieldTheory.NumberFieldFractionalIdealGroup K),
      (ClassFieldTheory.rayClassPrimeToIdeals m).mul_mem hx A.2⟩

theorem rayClassOfPrincipalMultiply_integralUnit_eq (m : RayClassModulus K)
    (A : ClassFieldTheory.rayClassPrimeToIdeals m) (x : Kˣ)
    (hx : toPrincipalIdeal (𝓞 K) K x ∈ ClassFieldTheory.rayClassPrimeToIdeals m)
    (u : (𝓞 K)ˣ) :
    rayClassOfPrincipalMultiply m A
      (Units.map (algebraMap (𝓞 K) K).toMonoidHom u * x)
      (by
        have h := toPrincipalIdeal_mul_integralUnit_eq u x
        exact h ▸ hx) =
    rayClassOfPrincipalMultiply m A x hx := by
  apply congrArg (QuotientGroup.mk'
    (ClassFieldTheory.rayPrincipalIdealSubgroupInPrimeTo m))
  apply Subtype.ext
  exact congrArg
    (fun I : ClassFieldTheory.NumberFieldFractionalIdealGroup K =>
      I * (A : ClassFieldTheory.NumberFieldFractionalIdealGroup K))
    (toPrincipalIdeal_mul_integralUnit_eq u x)

theorem rayPrincipalIdealSubgroup_mem_iff (m : RayClassModulus K)
    (I : ClassFieldTheory.NumberFieldFractionalIdealGroup K) :
    I ∈ ClassFieldTheory.rayPrincipalIdealSubgroup m ↔
      ∃ x : Kˣ, ClassFieldTheory.IsRayCongruent m x ∧
        toPrincipalIdeal (𝓞 K) K x = I := by
  rw [rayPrincipalIdealSubgroup_eq_map, Subgroup.mem_map]
  simp [mem_rayCongruentUnits]

theorem rayPrincipalIdealSubgroupInPrimeTo_mem_iff (m : RayClassModulus K)
    (I : ClassFieldTheory.rayClassPrimeToIdeals m) :
    I ∈ ClassFieldTheory.rayPrincipalIdealSubgroupInPrimeTo m ↔
      ∃ x : Kˣ, ClassFieldTheory.IsRayCongruent m x ∧
        toPrincipalIdeal (𝓞 K) K x = (I : ClassFieldTheory.NumberFieldFractionalIdealGroup K) := by
  rw [ClassFieldTheory.rayPrincipalIdealSubgroupInPrimeTo, Subgroup.mem_comap]
  exact rayPrincipalIdealSubgroup_mem_iff m (I : ClassFieldTheory.NumberFieldFractionalIdealGroup K)

theorem rayPrincipalIdealSubgroupInPrimeTo_map_eq [IsTotallyComplex K]
    (m : RayClassModulus K) :
    (ClassFieldTheory.rayPrincipalIdealSubgroupInPrimeTo m).map
        (rayPrimeToIdealEquiv m).toMonoidHom =
      RayClass.principalRayIdealSubgroup (rayModulusToCFT m) := by
  ext J
  rw [Subgroup.mem_map, RayClass.mem_principalRayIdealSubgroup_iff]
  constructor
  · rintro ⟨I, hI, hIJ⟩
    obtain ⟨x, hx, hxI⟩ := (rayPrincipalIdealSubgroupInPrimeTo_mem_iff m I).mp hI
    refine ⟨x, (isRayCongruent_iff_principalIdele_mem m x).mp hx, ?_⟩
    have hval : (I : ClassFieldTheory.NumberFieldFractionalIdealGroup K) =
        (J : FractionalIdealGroup K) := by
      simpa [rayPrimeToIdealEquiv] using congrArg Subtype.val hIJ
    rw [← hval]
    exact hxI
  · rintro ⟨x, hx, hxJ⟩
    have hRay := (isRayCongruent_iff_principalIdele_mem m x).mpr hx
    let I := (rayPrimeToIdealEquiv m).symm J
    have hval : (I : ClassFieldTheory.NumberFieldFractionalIdealGroup K) =
        (J : FractionalIdealGroup K) := by
      simp [I, rayPrimeToIdealEquiv]
    refine ⟨I, (rayPrincipalIdealSubgroupInPrimeTo_mem_iff m I).mpr
      ⟨x, hRay, ?_⟩, ?_⟩
    · exact hxJ.trans hval.symm
    · simp [I]

noncomputable def rayClassGroupToCFTIdealRayClassHom [IsTotallyComplex K]
    (m : RayClassModulus K) :
    ClassFieldTheory.RayClassGroup m →*
      RayClass.IdealRayClassGroup (rayModulusToCFT m) :=
  QuotientGroup.map
    (ClassFieldTheory.rayPrincipalIdealSubgroupInPrimeTo m)
    (RayClass.principalRayIdealSubgroup (rayModulusToCFT m))
    (rayPrimeToIdealEquiv m).toMonoidHom (by
      intro I hI
      rw [← rayPrincipalIdealSubgroupInPrimeTo_map_eq m]
      exact ⟨I, hI, rfl⟩)

theorem rayClassGroupToCFTIdealRayClassHom_surjective [IsTotallyComplex K]
    (m : RayClassModulus K) :
    Function.Surjective (rayClassGroupToCFTIdealRayClassHom m) := by
  intro q
  obtain ⟨J, rfl⟩ := QuotientGroup.mk'_surjective
    (RayClass.principalRayIdealSubgroup (rayModulusToCFT m)) q
  obtain ⟨I, rfl⟩ := (rayPrimeToIdealEquiv m).surjective J
  refine ⟨QuotientGroup.mk' (ClassFieldTheory.rayPrincipalIdealSubgroupInPrimeTo m) I, ?_⟩
  simp [rayClassGroupToCFTIdealRayClassHom]

noncomputable def rayPrimeToIdealQuotientHom [IsTotallyComplex K]
    (m : RayClassModulus K) :
    ClassFieldTheory.rayClassPrimeToIdeals m →*
      RayClass.IdealRayClassGroup (rayModulusToCFT m) :=
  (QuotientGroup.mk'
      (RayClass.principalRayIdealSubgroup (rayModulusToCFT m))).comp
    (rayPrimeToIdealEquiv m).toMonoidHom

theorem rayPrimeToIdealQuotientHom_ker [IsTotallyComplex K]
    (m : RayClassModulus K) :
    (rayPrimeToIdealQuotientHom m).ker =
      ClassFieldTheory.rayPrincipalIdealSubgroupInPrimeTo m := by
  ext I
  change
    (rayPrimeToIdealEquiv m I : RayClass.IdealRayClassGroup (rayModulusToCFT m)) = 1 ↔
      I ∈ ClassFieldTheory.rayPrincipalIdealSubgroupInPrimeTo m
  rw [QuotientGroup.eq_one_iff]
  rw [← rayPrincipalIdealSubgroupInPrimeTo_map_eq m]
  constructor
  · intro h
    obtain ⟨J, hJ, hJI⟩ := (Subgroup.mem_map).mp h
    have : J = I := (rayPrimeToIdealEquiv m).injective hJI
    simpa [this] using hJ
  · intro h
    exact Subgroup.mem_map.mpr ⟨I, h, rfl⟩

theorem rayPrimeToIdealQuotientHom_surjective [IsTotallyComplex K]
    (m : RayClassModulus K) : Function.Surjective (rayPrimeToIdealQuotientHom m) := by
  intro q
  obtain ⟨J, rfl⟩ := QuotientGroup.mk'_surjective
    (RayClass.principalRayIdealSubgroup (rayModulusToCFT m)) q
  obtain ⟨I, hI⟩ := (rayPrimeToIdealEquiv m).surjective J
  refine ⟨I, ?_⟩
  change QuotientGroup.mk'
      (RayClass.principalRayIdealSubgroup (rayModulusToCFT m))
      (rayPrimeToIdealEquiv m I) = _
  rw [hI]

noncomputable def rayClassGroupEquivCFTIdealRayClassGroup [IsTotallyComplex K]
    (m : RayClassModulus K) :
    ClassFieldTheory.RayClassGroup m ≃*
      RayClass.IdealRayClassGroup (rayModulusToCFT m) := by
  let hker := rayPrimeToIdealQuotientHom_ker m
  exact (QuotientGroup.quotientMulEquivOfEq hker).symm.trans
    (QuotientGroup.quotientKerEquivOfSurjective
      (rayPrimeToIdealQuotientHom m)
      (rayPrimeToIdealQuotientHom_surjective m))

theorem rayClassGroup_finite_viaCFT [IsTotallyComplex K]
    (m : RayClassModulus K) : Finite (ClassFieldTheory.RayClassGroup m) := by
  let m' := rayModulusToCFT m
  haveI : Finite (RayClass.RayClassGroup m') := inferInstance
  haveI : Finite (RayClass.IdealRayClassGroup m') :=
    Finite.of_equiv (RayClass.RayClassGroup m')
      (RayClass.rayClassGroupEquivIdealRayClassGroup m').toEquiv
  exact Finite.of_equiv _ (rayClassGroupEquivCFTIdealRayClassGroup m).symm.toEquiv

theorem finite_rayPrincipalFieldUnitClassQuotient [IsTotallyComplex K]
    (m : RayClassModulus K) :
    Finite (rayPrimeToPrincipalFieldUnits m ⧸ (rayPrincipalFieldUnitClassHom m).ker) := by
  let f := rayPrincipalFieldUnitClassHom m
  haveI : Finite (ClassFieldTheory.RayClassGroup m) := rayClassGroup_finite_viaCFT m
  haveI : Finite f.range :=
    Finite.of_injective (fun x => (x : ClassFieldTheory.RayClassGroup m)) Subtype.val_injective
  exact Finite.of_equiv f.range (QuotientGroup.quotientKerEquivRange f).symm.toEquiv

end ArtinPrimitiveRoots.Hecke

end
