import ArtinPrimitiveRoots.Spec.Interface

/-!
Shared concrete objects for the internal P-SPEC nodes.  The interface remains the frozen
consumer API; this file names the row, cusp, and energy objects used by the node statements.
-/

set_option autoImplicit false

open NumberField Matrix MeasureTheory
open scoped MatrixGroups ContDiff BoundedContinuousFunction nonZeroDivisors

noncomputable section

namespace ArtinPrimitiveRoots.A1.Spec

variable (F : Type) [Field F] [NumberField F]

/-- The number of complex places, viewed as a real scalar. -/
def placeCount : ℝ := Fintype.card (InfinitePlace F)

/-- The absolute field norm in the complex-place normalization of P-SPEC. -/
def absFieldNorm (a : F) : ℝ := ∏ w : InfinitePlace F, ‖w.embedding a‖ ^ 2

/-- The norm of a bottom row at an infinite place. -/
def rowNorm (v : F × F) (w : InfinitePlace F) : ℝ :=
  Real.sqrt (Complex.normSq (w.embedding v.1) + Complex.normSq (w.embedding v.2))

/-- Bottom row of a determinant-one matrix over the field. -/
def bottomRow (g : SL(2,F)) : F × F := (g 1 0, g 1 1)

/-- Fractional ideal generated by the two entries of the bottom row. -/
def bottomRowFractionalIdeal (g : SL(2,F)) : FractionalIdeal (𝓞 F)⁰ F :=
  FractionalIdeal.spanFinset (𝓞 F) Finset.univ
    (fun i : Fin 2 => if i = 0 then (bottomRow F g).1 else (bottomRow F g).2)

/-- Ideal class of the bottom row, used to describe the fibres of the cusp map. -/
noncomputable def bottomRowClass (g : SL(2,F)) : ClassGroup (𝓞 F) :=
  by
    classical
    exact if h : bottomRowFractionalIdeal F g ≠ 0 then
      ClassGroup.mk F (Units.mk0 (bottomRowFractionalIdeal F g) h)
    else 1

/-- Two rows are in the same algebraic-integer unit orbit. -/
def unitAssociatedRows (v v' : F × F) : Prop :=
  ∃ ε : (𝓞 F)ˣ,
    v = ((algebraMap (𝓞 F) F (ε : 𝓞 F)) * v'.1,
      (algebraMap (𝓞 F) F (ε : 𝓞 F)) * v'.2)

/-- The positive Hermitian form attached to a row and a point in `X`. -/
def rowHeightForm (v : F × F) (z : X F) (w : InfinitePlace F) : ℝ :=
  let p := coordsX F z w
  (Complex.normSq (w.embedding v.1 * p.1 + w.embedding v.2) +
    Complex.normSq (w.embedding v.1) * p.2 ^ 2) / p.2

/-- A field element has denominator dividing the positive integer `D` in `O_F`. -/
def HasDenominatorBound (D : ℕ) (a : F) : Prop :=
  ∃ b : 𝓞 F, (D : F) * a = algebraMap (𝓞 F) F b

/-- The upper triangular determinant-one matrix with diagonal unit `ε`. -/
def cuspUnitMatrix (ε : (𝓞 F)ˣ) (μ : F) : SL(2,F) :=
  ⟨!![algebraMap (𝓞 F) F (ε : 𝓞 F), μ; 0,
      (algebraMap (𝓞 F) F (ε : 𝓞 F))⁻¹], by
    rw [Matrix.det_fin_two_of]
    simp⟩

/-- The signed upper triangular matrix used for the extended translation group. -/
def signedCuspTranslationMatrix (ε : (𝓞 F)ˣ) (μ : F)
    (hε : (algebraMap (𝓞 F) F (ε : 𝓞 F)) ^ 2 = 1) : SL(2,F) :=
  ⟨!![algebraMap (𝓞 F) F (ε : 𝓞 F),
      algebraMap (𝓞 F) F (ε : 𝓞 F) * μ; 0,
      algebraMap (𝓞 F) F (ε : 𝓞 F)], by
    rw [Matrix.det_fin_two_of]
    simpa [pow_two] using hε⟩

/-- Units that occur as diagonal entries of elements of the cusp stabilizer. -/
def cuspUnitSet (Γ : Subgroup SL(2, 𝓞 F)) (σ : SL(2,F)) : Set ((𝓞 F)ˣ) :=
  {ε | ∃ μ : F, ∃ γ : Γ,
    σ⁻¹ * toSLF F (γ : SL(2, 𝓞 F)) * σ = cuspUnitMatrix F ε μ}

/-- The subgroup of cusp diagonal units, defined as the subgroup generated by the occurring units. -/
def cuspUnits (Γ : Subgroup SL(2, 𝓞 F)) (σ : SL(2,F)) : Subgroup ((𝓞 F)ˣ) :=
  Subgroup.closure (cuspUnitSet F Γ σ)

/-- Signed translations that conjugate into `Γ` at the cusp. -/
def signedCuspTranslations (Γ : Subgroup SL(2, 𝓞 F)) (σ : SL(2,F)) : Set F :=
  {μ | ∃ ε : (𝓞 F)ˣ,
    ∃ hε : (algebraMap (𝓞 F) F (ε : 𝓞 F)) ^ 2 = 1,
    ∃ γ : Γ, σ⁻¹ * toSLF F (γ : SL(2, 𝓞 F)) * σ =
      signedCuspTranslationMatrix F ε μ hε}

/-- The additive subgroup generated by the signed cusp translations. -/
def cuspTranslationExtension (Γ : Subgroup SL(2, 𝓞 F)) (σ : SL(2,F)) : AddSubgroup F :=
  AddSubgroup.closure (signedCuspTranslations F Γ σ)

/-- The embedded complex translation extension used for the cusp-strip integral. -/
def cuspTranslationExtensionComplex (Γ : Subgroup SL(2, 𝓞 F)) (σ : SL(2,F)) :
    AddSubgroup (InfinitePlace F → ℂ) :=
  (cuspTranslationExtension F Γ σ).map (infEmb F).toAddMonoidHom

/-- The `ℤ`-submodule generated by the embedded cusp translation lattice. -/
def cuspTranslationsZ (Γ : Subgroup SL(2, 𝓞 F)) (σ : SL(2,F)) :
    Submodule ℤ (InfinitePlace F → ℂ) :=
  Submodule.span ℤ (cuspTranslations F Γ σ : Set (InfinitePlace F → ℂ))

/-- A full lattice, including the discreteness condition required by `IsZLattice`. -/
def IsFullZLattice {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (L : Submodule ℤ E) : Prop :=
  ∃ hdisc : DiscreteTopology L, @IsZLattice ℝ _ E _ _ L hdisc

/-- The absolute norm of the image of an algebraic integer unit at the complex places. -/
def absUnitNorm (ε : (𝓞 F)ˣ) : ℝ :=
  absFieldNorm F (algebraMap (𝓞 F) F (ε : 𝓞 F))

/-- The full product action of the complex special linear groups on `X`. -/
def actAtPlaces (g : InfinitePlace F → SL(2,ℂ)) (z : X F) : X F :=
  fun w => g w • z w

/-- Hyperbolic volume on one factor, in upper-half-space coordinates. -/
def volH3 : Measure H3 :=
  Measure.map (fun p : ℂ × ℝ => pt p.1 p.2)
    ((volume.restrict {p : ℂ × ℝ | 0 < p.2}).withDensity
      fun p => ENNReal.ofReal ((p.2 ^ 3)⁻¹))

/-- Point-pair invariant `cosh d` on `H3`, defined by the coordinate formula. -/
def ppi (z z' : H3) : ℝ :=
  let y := height z
  let y' := height z'
  (Complex.normSq (horiz z - horiz z') + y ^ 2 + y' ^ 2) / (2 * y * y')

/-- Coordinate version of the point-pair invariant on the positive-coordinate locus. -/
def ppiCoord (p q : Coord F) : ℝ :=
  ∏ w : InfinitePlace F, (Complex.normSq ((p w).1 - (q w).1) + (p w).2 ^ 2 + (q w).2 ^ 2) /
    (2 * (p w).2 * (q w).2)

/-- The place-`w` point-pair invariant expressed in product coordinates. -/
def ppiCoordAt (w : InfinitePlace F) (pq : Coord F × Coord F) : ℝ :=
  (Complex.normSq ((pq.1 w).1 - (pq.2 w).1) + (pq.1 w).2 ^ 2 + (pq.2 w).2 ^ 2) /
    (2 * (pq.1 w).2 * (pq.2 w).2)

/-- The smooth cutoff used to truncate cusp heights at scale `A`. -/
def IsCuspCutoff (A : ℝ) (τ : ℝ → ℝ) : Prop :=
  ContDiff ℝ ∞ τ ∧ Monotone τ ∧ (∀ t ≤ A, τ t = 0) ∧ (∀ t, 2 * A ≤ t → τ t = 1)

/-- The logarithmic balance region for a vector of positive heights. -/
def IsBalancedHeights (B : ℝ) (y : InfinitePlace F → ℝ) : Prop :=
  (∀ w, 0 < y w) ∧
    ∀ w, |Real.log (y w) -
      (Fintype.card (InfinitePlace F) : ℝ)⁻¹ * ∑ w' : InfinitePlace F, Real.log (y w')| ≤ B

/-- The Siegel set at one cusp, with bounded translation coordinate and balanced heights. -/
def siegelSet (P : Set (InfinitePlace F → ℂ)) (B c : ℝ) : Set (X F) :=
  {z | ∃ x y, z = ptX' F x y ∧ x ∈ P ∧ IsBalancedHeights F B y ∧
    c ≤ normHeight F (ptX' F x y)}

/-- The orbit saturation of a subset of `X`. -/
def orbitSaturation (Γ : Subgroup SL(2, 𝓞 F)) (K : Set (X F)) : Set (X F) :=
  {z | ∃ γ : Γ, ∃ x ∈ K, (γ : SL(2, 𝓞 F)) • x = z}

/-- The total Laplacian, the sum of all partial hyperbolic Laplacians. -/
def totalLap (f : X F → ℂ) (z : X F) : ℂ :=
  ∑ w : InfinitePlace F, partialLap F w f z

/-- The spectral parameter for the sum Laplacian. -/
def spectralParameter (s : ℂ) : ℂ :=
  (placeCount F : ℂ) * (1 - 4 * s ^ 2)

/-- The cutoff seed for the Eisenstein series at a cusp. -/
def seedTerm (Γ : Subgroup SL(2, 𝓞 F)) (σ : SL(2,F)) (τ : ℝ → ℝ)
    (s : ℂ) (z : X F) (q : CuspCosets F Γ σ) : ℂ :=
  let h := normHeight F (σ⁻¹ • (((q.out : Γ) : SL(2, 𝓞 F)) • z))
  (τ h : ℂ) * (h : ℂ) ^ (1 + 2 * s)

/-- The truncated Eisenstein seed, summed over the cusp cosets. -/
def eisSeed (Γ : Subgroup SL(2, 𝓞 F)) (σ : SL(2,F)) (τ : ℝ → ℝ)
    (s : ℂ) (z : X F) : ℂ :=
  ∑' q : CuspCosets F Γ σ, seedTerm F Γ σ τ s z q

/-- The defect of the seed under the sum Laplacian. -/
def eisSeedDefect (Γ : Subgroup SL(2, 𝓞 F)) (σ : SL(2,F)) (τ : ℝ → ℝ)
    (s : ℂ) (z : X F) : ℂ :=
  totalLap F (eisSeed F Γ σ τ s) z - spectralParameter F s * eisSeed F Γ σ τ s z

/-- An energy graph over a Hilbert mass space and a Hilbert gradient space. -/
structure FAEnergySpace (H G : Type*)
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [NormedAddCommGroup G] [InnerProductSpace ℂ G] [CompleteSpace G] where
  V : Submodule ℂ (WithLp 2 (H × G))
  closedV : IsClosed (V : Set (WithLp 2 (H × G)))

namespace FAEnergySpace

variable {H G : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [NormedAddCommGroup G] [InnerProductSpace ℂ G] [CompleteSpace G]

/-- A closed energy graph inherits completeness from its Hilbert product. -/
instance instCompleteSpace (D : FAEnergySpace H G) : CompleteSpace D.V :=
  D.closedV.completeSpace_coe

/-- Mass projection on the closed energy graph. -/
def M (D : FAEnergySpace H G) : D.V →L[ℂ] H :=
  (WithLp.fstL 2 ℂ H G).comp D.V.subtypeL

/-- Gradient projection on the closed energy graph. -/
def Gr (D : FAEnergySpace H G) : D.V →L[ℂ] G :=
  (WithLp.sndL 2 ℂ H G).comp D.V.subtypeL

/-- The positive mass form `T = M* M` on the energy graph. -/
noncomputable def T (D : FAEnergySpace H G) : D.V →L[ℂ] D.V := by
  letI : CompleteSpace D.V := D.closedV.completeSpace_coe
  exact (D.M).adjoint.comp D.M

/-- The spectral pencil `A(z) = 1 - (z+1)T`. -/
noncomputable def A (D : FAEnergySpace H G) (z : ℂ) : D.V →L[ℂ] D.V := by
  letI : CompleteSpace D.V := D.closedV.completeSpace_coe
  exact ContinuousLinearMap.id ℂ D.V - (z + 1) • D.T

end FAEnergySpace

/-- The coordinate directions for the three real variables at an infinite place. -/
noncomputable def placeDirection (w : InfinitePlace F) : Fin 3 → Coord F := by
  classical
  exact fun
    | 0 => Pi.single w ((1 : ℂ), (0 : ℝ))
    | 1 => Pi.single w (Complex.I, (0 : ℝ))
    | 2 => Pi.single w ((0 : ℂ), (1 : ℝ))

/-- Hyperbolic gradient at one place, in the orthonormal frame `y ∂x₁,y ∂x₂,y ∂y`. -/
def placeGradient (w : InfinitePlace F) (f : X F → ℂ) (z : X F) : Fin 3 → ℂ :=
  fun j => ((coordsX F z w).2 : ℂ) *
    fderiv ℝ (f ∘ ptX F) (coordsX F z) (placeDirection F w j)

/-- The sesquilinear pointwise inner product of two place gradients. -/
def placeGradInner (w : InfinitePlace F) (f g : X F → ℂ) (z : X F) : ℂ :=
  ∑ j : Fin 3, star (placeGradient F w f z j) * placeGradient F w g z j

/-- The bilinear pointwise pairing of two place gradients. -/
def placeGradBilinear (w : InfinitePlace F) (f g : X F → ℂ) (z : X F) : ℂ :=
  ∑ j : Fin 3, placeGradient F w f z j * placeGradient F w g z j

/-- Squared norm of one place gradient. -/
def placeGradNormSq (w : InfinitePlace F) (f : X F → ℂ) (z : X F) : ℝ :=
  ∑ j : Fin 3, Complex.normSq (placeGradient F w f z j)

/-- Smoothness of a function on the positive product-coordinate chart. -/
def IsSmoothX (f : X F → ℂ) : Prop :=
  ContDiffOn ℝ ∞ (fun p => f (ptX F p)) (posSet F)

/-- Real-valued smoothness on the positive product-coordinate chart. -/
def IsSmoothRealX (f : X F → ℝ) : Prop :=
  ContDiffOn ℝ ∞ (fun p => f (ptX F p)) (posSet F)

/-- Compact support as a subset of the product hyperbolic space. -/
def HasCompactSupportX (f : X F → ℂ) : Prop :=
  ∃ K : Set (X F), IsCompact K ∧ {z | f z ≠ 0} ⊆ K

/-- Energy density of a function, summed over all complex places. -/
def totalGradNormSq (f : X F → ℂ) (z : X F) : ℝ :=
  ∑ w : InfinitePlace F, placeGradNormSq F w f z

/-- Logarithm of the product height, as a complex-valued function. -/
def logNormHeight (z : X F) : ℂ := Real.log (normHeight F z)

/-- Invariance under the arithmetic subgroup. -/
def IsGammaInvariant (Γ : Subgroup SL(2,𝓞 F)) (f : X F → ℂ) : Prop :=
  ∀ γ ∈ Γ, ∀ z, f ((γ : SL(2,𝓞 F)) • z) = f z

/-- Compact support modulo `Γ`. -/
def HasCompactSupportModulo (Γ : Subgroup SL(2,𝓞 F)) (f : X F → ℂ) : Prop :=
  ∃ K : Set (X F), IsCompact K ∧ {z | f z ≠ 0} ⊆ orbitSaturation F Γ K

/-- A smooth, invariant test function with compact support modulo `Γ`. -/
def IsGammaTest (Γ : Subgroup SL(2,𝓞 F)) (f : X F → ℂ) : Prop :=
  IsGammaInvariant F Γ f ∧ IsSmoothX F f ∧ HasCompactSupportModulo F Γ f

/-- The test-function submodule from the route-C construction. -/
def testSubmodule (Γ : Subgroup SL(2,𝓞 F)) : Submodule ℂ (X F → ℂ) :=
  Submodule.span ℂ {f | IsGammaTest F Γ f}

/-- The quotient `L²` space on a chosen fundamental domain. -/
abbrev L2Space (D : Set (X F)) := Lp ℂ 2 ((volX F).restrict D)

/-- The value space for all place gradients. -/
abbrev GradientField := EuclideanSpace ℂ (InfinitePlace F × Fin 3)

/-- The quotient `L²` space of gradients on a chosen fundamental domain. -/
abbrev GradientL2Space (D : Set (X F)) :=
  Lp (GradientField F) 2 ((volX F).restrict D)

/-- Extension of an `L²(D)` representative to the product by summing over `Γ`. -/
noncomputable def l2Lift (Γ : Subgroup SL(2,𝓞 F)) (D : Set (X F))
    (u : L2Space F D) (z : X F) : ℂ := by
  classical
  exact ∑' γ : Γ,
    if (γ : SL(2,𝓞 F)) • z ∈ D then u ((γ : SL(2,𝓞 F)) • z) else 0

/-- Pointwise representative of the mass component restricted to an orbit of a compact set. -/
noncomputable def orbitRestrictedMass (Dset : Set (X F)) {G : Type*}
    [NormedAddCommGroup G] [InnerProductSpace ℂ G] [CompleteSpace G]
    (D : FAEnergySpace (L2Space F Dset) G) (Γ : Subgroup SL(2,𝓞 F)) (K : Set (X F))
    (x : D.V) (z : X F) : ℂ := by
  classical
  exact if z ∈ orbitSaturation F Γ K then D.M x z else 0

/-- The full gradient assembled from the place gradients. -/
def fullGradient (f : X F → ℂ) (z : X F) : GradientField F :=
  WithLp.toLp 2 (fun wj => placeGradient F wj.1 f z wj.2)

/-- The Hilbert graph map of the mass and gradient maps on test functions. -/
def energyGraphMap {T : Type*} [AddCommGroup T] [Module ℂ T]
    {H G : Type*} [AddCommGroup H] [Module ℂ H] [AddCommGroup G] [Module ℂ G]
    (toL2 : T →ₗ[ℂ] H) (gradL2 : T →ₗ[ℂ] G) :
    T →ₗ[ℂ] WithLp 2 (H × G) where
  toFun f := WithLp.toLp 2 (toL2 f, gradL2 f)
  map_add' f g := by
    simp only [toL2.map_add, gradL2.map_add]
    change WithLp.toLp 2 ((toL2 f, gradL2 f) + (toL2 g, gradL2 g)) = _
    exact WithLp.toLp_add 2 _ _
  map_smul' c f := by
    simp only [toL2.map_smul, gradL2.map_smul]
    change WithLp.toLp 2 (c • (toL2 f, gradL2 f)) = _
    exact WithLp.toLp_smul 2 c _

/-- Closure of the range of the test graph map, as in the Friedrichs energy space. -/
def energyGraph {T : Type*} [AddCommGroup T] [Module ℂ T]
    {H G : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [NormedAddCommGroup G] [InnerProductSpace ℂ G] [CompleteSpace G]
    (toL2 : T →ₗ[ℂ] H) (gradL2 : T →ₗ[ℂ] G) :
    Submodule ℂ (WithLp 2 (H × G)) :=
  (energyGraphMap toL2 gradL2).range.topologicalClosure

/-- Data identifying a closed energy graph with the closure of the test graph. -/
structure EnergyContext {T H G : Type*} [AddCommGroup T] [Module ℂ T]
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [NormedAddCommGroup G] [InnerProductSpace ℂ G] [CompleteSpace G]
    (D : FAEnergySpace H G) where
  toL2 : T →ₗ[ℂ] H
  gradL2 : T →ₗ[ℂ] G
  graph_eq : D.V = energyGraph toL2 gradL2

/-- The overlap set of two subsets under the `Γ` action. -/
def overlapSet (Γ : Subgroup SL(2,𝓞 F)) (K K' : Set (X F)) : Set Γ :=
  {γ | ∃ z ∈ K, (γ : SL(2,𝓞 F)) • z ∈ K'}

/-- The local overlap multiplicity in a compact set. -/
def overlapMultiplicity (Γ : Subgroup SL(2,𝓞 F)) (K : Set (X F)) : ℕ :=
  Nat.card (overlapSet F Γ K K)

/-- The invariant family of real coordinates used for lexicographic representatives. -/
noncomputable def realCoordList (p : Coord F) : List ℝ :=
  (Finset.univ : Finset (InfinitePlace F)).toList.flatMap fun w =>
    [(p w).1.re, (p w).1.im, (p w).2]

/-- Lexicographic order on the real coordinate list. -/
def coordLexLE (p q : Coord F) : Prop :=
  realCoordList F p = realCoordList F q ∨
    List.Lex (fun x y : ℝ => x < y) (realCoordList F p) (realCoordList F q)

/-- The measurable-candidate set from the lexicographic fundamental-domain construction. -/
def fundamentalDomainCandidate (Γ : Subgroup SL(2,𝓞 F)) (S : Set (X F)) : Set (X F) :=
  {z | z ∈ S ∧ ∀ γ : Γ,
    (γ : SL(2,𝓞 F)) • z ∈ S → coordLexLE F (coordsX F z)
      (coordsX F ((γ : SL(2,𝓞 F)) • z))}

/-- The high-height cusp tail for a fixed cusp. -/
def cuspTail (Γ : Subgroup SL(2,𝓞 F)) (σ : SL(2,F)) (A : ℝ) : Set (X F) :=
  {z | ∃ γ : Γ, A < normHeight F (σ⁻¹ • ((γ : SL(2,𝓞 F)) • z))}

/-- Height action of a unit on positive vectors. -/
def unitHeightAction (ε : (𝓞 F)ˣ) (y : InfinitePlace F → ℝ) : InfinitePlace F → ℝ :=
  fun w => Complex.normSq (w.embedding (algebraMap (𝓞 F) F (ε : 𝓞 F))) * y w

/-- The reduction data supplied by cusp representatives, unit balance, and Minkowski. -/
structure SiegelData (Γ : Subgroup SL(2,𝓞 F)) [Γ.FiniteIndex] where
  ι : Type
  fintype : Fintype ι
  σ : ι → SL(2,F)
  P : ι → Set (InfinitePlace F → ℂ)
  B : ι → ℝ
  C_M : ℝ
  C_M_pos : 0 < C_M
  P_fundamental : ∀ i, IsAddFundamentalDomain (cuspTranslations F Γ (σ i)) (P i)
  P_bounded : ∀ i, Bornology.IsBounded (P i)
  P_measurable : ∀ i, MeasurableSet (P i)
  balanced : ∀ i (t : InfinitePlace F → ℝ), (∀ w, 0 < t w) →
    ∃ ε : (𝓞 F)ˣ, ε ∈ cuspUnits F Γ (σ i) ∧ ∀ w,
      |Real.log (‖w.embedding (algebraMap (𝓞 F) F (ε : 𝓞 F))‖ * t w) -
        (placeCount F)⁻¹ * ∑ w' : InfinitePlace F, Real.log (t w')| ≤ B i
  reps_bijective : Function.Bijective (fun p : (Σ i, CuspCosets F Γ (σ i)) =>
    Quotient.mk (QuotientGroup.rightRel (borelSL F))
      ((σ p.1)⁻¹ * toSLF F ((p.2.out : Γ) : SL(2,𝓞 F))))

namespace SiegelData

variable {Γ : Subgroup SL(2,𝓞 F)} [Γ.FiniteIndex] (d : SiegelData F Γ)

/-- The lower-height constant `(N(aᵢ) C_M)⁻¹` for cusp `i`. -/
noncomputable def lowerHeight (i : d.ι) : ℝ :=
  ((((FractionalIdeal.absNorm (bottomRowFractionalIdeal F ((d.σ i)⁻¹))) : ℚ) : ℝ) * d.C_M)⁻¹

/-- The Siegel set at cusp `i`. -/
def setAt (i : d.ι) : Set (X F) :=
  siegelSet F (d.P i) (d.B i) (lowerHeight F d i)

/-- The union of the cusp Siegel sets after scaling. -/
def unionSet : Set (X F) :=
  {z | ∃ i, ∃ x ∈ setAt F d i, (d.σ i) • x = z}

/-- The compact cusp box at scale `A`. -/
def compactBox (i : d.ι) (A : ℝ) : Set (X F) :=
  {z | ∃ x y, z = (d.σ i) • ptX' F x y ∧
    x ∈ closure (d.P i) ∧ IsBalancedHeights F (2 * d.B i) y ∧
    lowerHeight F d i ≤ normHeight F (ptX' F x y) ∧ normHeight F (ptX' F x y) ≤ A}

/-- The orbit saturation of all compact cusp boxes at scale `A`. -/
def compactOrbit (A : ℝ) : Set (X F) :=
  {z | ∃ i, z ∈ orbitSaturation F Γ (compactBox F d i A)}

end SiegelData

/-- Kernel on the product space from a compactly supported radial kernel on `H3`. -/
def radialKernel (k₀ : ℝ → ℝ) (z w : X F) : ℂ :=
  ∏ v : InfinitePlace F, (k₀ (ppi (z v) (w v)) : ℂ)

/-- Point-pair-invariant smoothing operator. -/
def smoothingOperator (k₀ : ℝ → ℝ) (f : X F → ℂ) (z : X F) : ℂ :=
  ∫ w, radialKernel F k₀ z w * f w ∂(volX F)

/-- The one-factor transform of a radial kernel. -/
def radialTransform₀ (k₀ : ℝ → ℝ) (a : ℂ) : ℂ :=
  ∫ z : H3, (k₀ (ppi (pt 0 1) z) : ℂ) * (height z : ℂ) ^ a ∂volH3

/-- Product transform of the radial kernel. -/
def radialTransform (k₀ : ℝ → ℝ) (a : ℂ) : ℂ :=
  ∏ _w : InfinitePlace F, radialTransform₀ k₀ a

/-- Pointwise Eisenstein continuation produced by smoothing the seed and its `L²` correction. -/
def pointwiseEisContinuation (Γ : Subgroup SL(2,𝓞 F)) (σ : SL(2,F))
    (D : Set (X F)) (k₀ τ : ℝ → ℝ)
    (u : ℂ → L2Space F D) (s : ℂ) (z : X F) : ℂ :=
  (radialTransform F k₀ (1 + 2 * s))⁻¹ *
    smoothingOperator F k₀
      (fun w => eisSeed F Γ σ τ s w + l2Lift F Γ D (u s) w) z

end ArtinPrimitiveRoots.A1.Spec
