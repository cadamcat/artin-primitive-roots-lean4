    simp [ghostOrderedKernelTerm, hgood]
  have hGoodSet : DGood =
      (Finset.univ : Finset DVec).filter
        (fun D => ∀ i, D i ∈ (hitIndices (s.2.2 i) s.1).powerset) := by
    rfl
  have hDsum :
