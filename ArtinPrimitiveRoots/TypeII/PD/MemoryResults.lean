private theorem ghost_all_group_choices_le_exp {x : ℝ} {K : ℕ}
    (F : PDFix K) (hF : F.Valid) (s : MemPoint x K) (B j : ℕ)
    (ρ : ℝ) (hρ : IsMemoryRho F.q_d ρ) (v : ℝ) (hv : 0 < v)
    (hvlarge : 2 / (ρ * (1 - Real.sqrt F.q_d / ρ ^ 2)) ≤ v)
    (hV : ∀ i : Fin K, 0 < bandMass x (F.a i))
    (hbp : ∀ p ∈ markedPrimes x K F.a,
      (1 / 2 : ℝ) ≤ memoryBPrime x F.q_d p) :
    (∑ choices : (i : Fin K) → GhostGroupChoice F s B i,
      ∏ i : Fin K, ghostGroupFiniteWeight F s B j ρ v i (choices i)) ≤
      ∏ i : Fin K,
        Real.exp (2 * memoryEta x F.q_d j * bandMass x (F.a i) * v / ρ) := by
  have hρpos := hρ.1
  have hρsq : ρ ^ 2 < 1 := by nlinarith [hρ.1, hρ.2.1]
  have hrootltone : Real.sqrt F.q_d < 1 := lt_trans hρ.2.2 hρsq
  have hqjlt : memoryQ x F.q_d j < 1 := by
    unfold memoryQ
    split_ifs <;> [exact hrootltone; exact hF.2.2.1]
  have hη : 0 ≤ memoryEta x F.q_d j := by
    unfold memoryEta
    linarith
  have hqnonneg : 0 ≤ memoryQ x F.q_d j := by
    unfold memoryQ
    split_ifs
    · exact Real.sqrt_nonneg _
    · exact hF.2.1.le
  have hρv : 0 < ρ * v := mul_pos hρpos hv
  have ha : 0 ≤ memoryEta x F.q_d j / (ρ * v) := div_nonneg hη hρv.le
  have hb : 0 ≤ memoryQ x F.q_d j / ρ ^ 2 :=
    div_nonneg hqnonneg (sq_nonneg ρ)
  have hc (i : Fin K) :
      0 ≤ memoryEta x F.q_d j * bandMass x (F.a i) / ρ * v := by
    exact mul_nonneg
      (div_nonneg (mul_nonneg hη (hV i).le) hρpos.le) hv.le
  have hν (i : Fin K) (p : GhostPrimeChoice (x := x) F i) :
      0 ≤ memoryNu x K F.a F.q_d i p.1 := by
    have hbp' : 0 < memoryBPrime x F.q_d p.1 :=
      lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2)
        (hbp p.1 (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i, p.2⟩))
    have hden : 0 < bandMass x (F.a i) * ((p.1 : ℝ) + 1) *
        memoryBPrime x F.q_d p.1 :=
      mul_pos (mul_pos (hV i) (by positivity)) hbp'
    unfold memoryNu
    exact div_nonneg (by norm_num) hden.le
  have hlocalNonneg (i : Fin K) :
      0 ≤ ∑ c : GhostGroupChoice F s B i,
        ghostGroupFiniteWeight F s B j ρ v i c := by
    rw [ghost_group_choice_sum_eq]
    apply Finset.sum_nonneg
    intro D hD
    apply Finset.sum_nonneg
    intro m hm
    apply Finset.sum_nonneg
    intro batch hbatch
    have hdel :
        0 ≤ (memoryEta x F.q_d j / (ρ * v)) ^ D.card *
          (memoryQ x F.q_d j / ρ ^ 2) ^
            ((hitIndices (s.2.2 i) s.1).card - D.card) :=
      mul_nonneg (pow_nonneg ha _) (pow_nonneg hb _)
    have hbth : 0 ≤
        (memoryEta x F.q_d j * bandMass x (F.a i) / ρ * v) ^ m /
          (m.factorial : ℝ) *
          ∏ k : Fin m, memoryNu x K F.a F.q_d i (batch k).1 := by
      apply mul_nonneg
      · exact div_nonneg (pow_nonneg (hc i) _) (Nat.cast_nonneg _)
      · exact Finset.prod_nonneg fun k hk => hν i (batch k)
    exact mul_nonneg hdel hbth
  have hlocalBound (i : Fin K) :
      (∑ c : GhostGroupChoice F s B i,
        ghostGroupFiniteWeight F s B j ρ v i c) ≤
        Real.exp (2 * memoryEta x F.q_d j * bandMass x (F.a i) * v / ρ) := by
    rw [ghost_group_choice_sum_eq]
    exact ghost_group_finite_choice_le_exp F hF i ρ hρ v hv hvlarge
      (hV i) hbp j (s.2.2 i) s.1 B
  calc
    _ = ∏ i : Fin K,
        ∑ c : GhostGroupChoice F s B i,
          ghostGroupFiniteWeight F s B j ρ v i c :=
      finite_pi_sum_prod (fun i => GhostGroupChoice F s B i)
        (fun i c => ghostGroupFiniteWeight F s B j ρ v i c)
    _ ≤ _ := by
      apply Finset.prod_le_prod₀
      · intro i hi
        exact hlocalNonneg i
      · intro i hi
        exact hlocalBound i

private theorem ghost_group_column_choice_sum_le_exp {K : ℕ}
    (F : PDFix K) (hF : F.Valid) (S : PDScale) (s : MemPoint S.x K)
    (ρ : ℝ) (hρ : IsMemoryRho F.q_d ρ) (i : Fin K) (j B : ℕ) (v : ℝ)
    (hv : 0 < v)
    (hvlarge : 2 * bandMass S.x (F.a i) /
      (ρ * (1 - Real.sqrt F.q_d / ρ ^ 2)) ≤ v)
    (hV : 0 < bandMass S.x (F.a i))
    (hbp : ∀ p ∈ markedPrimes S.x K F.a,
      (1 / 2 : ℝ) ≤ memoryBPrime S.x F.q_d p) :
    (∑ c : GhostGroupChoice F s B i,
      ghostGroupColumnFiniteWeight F S s B j ρ v i c) ≤
      Real.exp (2 * memoryEta S.x F.q_d j * v / ρ) := by
  classical
  let V := bandMass S.x (F.a i)
  let v' := v / V
  have hv' : 0 < v' := div_pos hv hV
  have hg : 0 < 1 - Real.sqrt F.q_d / ρ ^ 2 := by
    have hsq : 0 < ρ ^ 2 := sq_pos_of_pos hρ.1
    apply sub_pos.mpr
    exact (div_lt_one₀ hsq).2 hρ.2.2
  have hv'large : 2 / (ρ * (1 - Real.sqrt F.q_d / ρ ^ 2)) ≤ v' := by
    change 2 / (ρ * (1 - Real.sqrt F.q_d / ρ ^ 2)) ≤
      v / bandMass S.x (F.a i)
    rw [le_div_iff₀ hV]
    have hmul :
        (2 / (ρ * (1 - Real.sqrt F.q_d / ρ ^ 2))) * V =
          2 * V / (ρ * (1 - Real.sqrt F.q_d / ρ ^ 2)) := by ring
    rw [hmul]
    exact hvlarge
  have hbase :
      (∑ c : GhostGroupChoice F s B i,
        ghostGroupFiniteWeight F s B j ρ v' i c) ≤
        Real.exp (2 * memoryEta S.x F.q_d j * V * v' / ρ) := by
    rw [ghost_group_choice_sum_eq]
    exact ghost_group_finite_choice_le_exp F hF i ρ hρ v' hv' hv'large
      hV hbp j (s.2.2 i) s.1 B
  change (∑ c : GhostGroupChoice F s B i,
      ghostGroupFiniteWeight F s B j ρ v' i c) ≤ _
  calc
    _ ≤ Real.exp (2 * memoryEta S.x F.q_d j * V * v' / ρ) := hbase
    _ = Real.exp (2 * memoryEta S.x F.q_d j * v / ρ) := by
      congr 1
      dsimp [v', V]
      field_simp [ne_of_gt hV, ne_of_gt hρ.1]
      <;> ring

private theorem ghost_all_group_column_choices_le_exp {K : ℕ}
    (F : PDFix K) (hF : F.Valid) (S : PDScale) (s : MemPoint S.x K)
    (B j : ℕ) (ρ : ℝ) (hρ : IsMemoryRho F.q_d ρ) (v : ℝ) (hv : 0 < v)
    (hvlarge : ∀ i : Fin K,
      2 * bandMass S.x (F.a i) /
        (ρ * (1 - Real.sqrt F.q_d / ρ ^ 2)) ≤ v)
    (hV : ∀ i : Fin K, 0 < bandMass S.x (F.a i))
    (hbp : ∀ p ∈ markedPrimes S.x K F.a,
      (1 / 2 : ℝ) ≤ memoryBPrime S.x F.q_d p) :
    (∑ choices : (i : Fin K) → GhostGroupChoice F s B i,
      ∏ i : Fin K, ghostGroupColumnFiniteWeight F S s B j ρ v i (choices i)) ≤
      ∏ i : Fin K, Real.exp (2 * memoryEta S.x F.q_d j * v / ρ) := by
  classical
  have hρpos := hρ.1
  have hρsq : ρ ^ 2 < 1 := by nlinarith [hρ.1, hρ.2.1]
  have hrootltone : Real.sqrt F.q_d < 1 := lt_trans hρ.2.2 hρsq
  have hqjlt : memoryQ S.x F.q_d j < 1 := by
    unfold memoryQ
    split_ifs <;> [exact hrootltone; exact hF.2.2.1]
  have hη : 0 ≤ memoryEta S.x F.q_d j := by
    unfold memoryEta
    linarith [hqjlt]
  have hq : 0 ≤ memoryQ S.x F.q_d j := by
    unfold memoryQ
    split_ifs
    · exact Real.sqrt_nonneg _
    · exact hF.2.1.le
  have hν (i : Fin K) (p : GhostPrimeChoice (x := S.x) F i) :
      0 ≤ memoryNu S.x K F.a F.q_d i p.1 := by
    have hbp' : 0 < memoryBPrime S.x F.q_d p.1 :=
      lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2)
        (hbp p.1 (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i, p.2⟩))
    have hden : 0 < bandMass S.x (F.a i) * ((p.1 : ℝ) + 1) *
        memoryBPrime S.x F.q_d p.1 :=
      mul_pos (mul_pos (hV i) (by positivity)) hbp'
    unfold memoryNu
    exact div_nonneg (by norm_num) hden.le
  have hlocalNonneg (i : Fin K) :
      0 ≤ ∑ c : GhostGroupChoice F s B i,
        ghostGroupColumnFiniteWeight F S s B j ρ v i c := by
    change 0 ≤ ∑ c : GhostGroupChoice F s B i,
      ghostGroupFiniteWeight F s B j ρ (v / bandMass S.x (F.a i)) i c
    rw [ghost_group_choice_sum_eq]
    let vi := v / bandMass S.x (F.a i)
    have hρvi : 0 < ρ * vi := mul_pos hρpos (div_pos hv (hV i))
    have ha : 0 ≤ memoryEta S.x F.q_d j / (ρ * vi) :=
      div_nonneg hη hρvi.le
    have hb : 0 ≤ memoryQ S.x F.q_d j / ρ ^ 2 :=
      div_nonneg hq (sq_nonneg ρ)
    have hc : 0 ≤ memoryEta S.x F.q_d j * bandMass S.x (F.a i) / ρ * vi := by
      exact mul_nonneg
        (div_nonneg (mul_nonneg hη (hV i).le) hρpos.le) (div_pos hv (hV i)).le
    apply Finset.sum_nonneg
    intro D hD
    apply Finset.sum_nonneg
    intro m hm
    apply Finset.sum_nonneg
    intro batch hbatch
    have hdel :
        0 ≤ (memoryEta S.x F.q_d j / (ρ * vi)) ^ D.card *
          (memoryQ S.x F.q_d j / ρ ^ 2) ^
            ((hitIndices (s.2.2 i) s.1).card - D.card) :=
      mul_nonneg (pow_nonneg ha _) (pow_nonneg hb _)
    have hbth : 0 ≤
        (memoryEta S.x F.q_d j * bandMass S.x (F.a i) / ρ * vi) ^ m /
          (m.factorial : ℝ) *
          ∏ k : Fin m, memoryNu S.x K F.a F.q_d i (batch k).1 := by
      apply mul_nonneg
      · exact div_nonneg (pow_nonneg hc _) (Nat.cast_nonneg _)
      · exact Finset.prod_nonneg fun k hk => hν i (batch k)
    exact mul_nonneg hdel hbth
  have hlocalBound (i : Fin K) :
      (∑ c : GhostGroupChoice F s B i,
        ghostGroupColumnFiniteWeight F S s B j ρ v i c) ≤
        Real.exp (2 * memoryEta S.x F.q_d j * v / ρ) :=
    ghost_group_column_choice_sum_le_exp F hF S s ρ hρ i j B v hv
      (hvlarge i) (hV i) hbp
  calc
    _ = ∏ i : Fin K,
        ∑ c : GhostGroupChoice F s B i,
          ghostGroupColumnFiniteWeight F S s B j ρ v i c :=
      finite_pi_sum_prod (fun i => GhostGroupChoice F s B i)
        (fun i c => ghostGroupColumnFiniteWeight F S s B j ρ v i c)
    _ ≤ _ := by
      apply Finset.prod_le_prod₀
      · intro i hi
        exact hlocalNonneg i
      · intro i hi
        exact hlocalBound i

private theorem ghostChoiceCoeff_norm_mul_outputWeight_eq {K : ℕ}
    (F : PDFix K) (S : PDScale) (s : MemPoint S.x K) (B j : ℕ)
    (ρ v : ℝ) (choices : (i : Fin K) → GhostGroupChoice F s B i)
    (hη : 0 ≤ memoryEta S.x F.q_d j) (hq : 0 ≤ memoryQ S.x F.q_d j)
    (hV : ∀ i : Fin K, 0 ≤ bandMass S.x (F.a i)) (hρ : 0 < ρ) (hv : 0 < v)
    (hν : ∀ (i : Fin K) (k : Fin (choices i).2.1.1),
      0 ≤ memoryNu S.x K F.a F.q_d i ((choices i).2.2 k).1) :
    ‖((ghostChoiceCoeffReal F S s ρ j B choices : ℝ) : ℂ)‖ *
        v ^ memSize (ghostChoicesOutput F s B choices) =
      v ^ memSize s * ∏ i : Fin K, ghostGroupFiniteWeight F s B j ρ v i (choices i) := by
  classical
  let d (i : Fin K) := (choices i).1.1.card
  let l (i : Fin K) := (choices i).2.1.1
  let base := ∑ i : Fin K, ((s.2.2 i).length - d i)
  let ds := ∑ i : Fin K, d i
  let ls := ∑ i : Fin K, l i
  let rawNorm (i : Fin K) :=
    ‖((ghostGroupCoeff F S ρ j i (hitCount (s.2.2 i) s.1) (d i) (l i)
      (List.ofFn fun k => ((choices i).2.2 k).1) : ℝ) : ℂ)‖
  let weight (i : Fin K) := ghostGroupFiniteWeight F s B j ρ v i (choices i)
  have hd (i : Fin K) : d i ≤ (s.2.2 i).length := by
    dsimp [d]
    simpa using Finset.card_le_univ (choices i).1.1
  have hsource : memSize s = base + ds := by
    simp only [memSize]
    dsimp [base, ds]
    calc
      (∑ i : Fin K, (s.2.2 i).length) =
          ∑ i : Fin K, ((s.2.2 i).length - d i + d i) := by
        apply Finset.sum_congr rfl
        intro i hi
        exact (Nat.sub_add_cancel (hd i)).symm
      _ = _ := by rw [Finset.sum_add_distrib]
  have htarget : memSize (ghostChoicesOutput F s B choices) = base + ls := by
    rw [ghostChoicesOutput_memSize]
    dsimp [base, ls, d, l]
    rw [Finset.sum_add_distrib]
  have hpowD : (∏ i : Fin K, v ^ d i) = v ^ ds := by
    simpa [ds] using
      (Finset.prod_pow_eq_pow_sum (Finset.univ : Finset (Fin K)) d v)
  have hpowL : (∏ i : Fin K, v ^ l i) = v ^ ls := by
    simpa [ls] using
      (Finset.prod_pow_eq_pow_sum (Finset.univ : Finset (Fin K)) l v)
  have hnorm :
      ‖((ghostChoiceCoeffReal F S s ρ j B choices : ℝ) : ℂ)‖ =
        ∏ i : Fin K, rawNorm i := by
    simp [ghostChoiceCoeffReal, rawNorm, Complex.norm_real, Real.norm_eq_abs,
      Finset.abs_prod, d, l]
  have hlocal (i : Fin K) : weight i * v ^ d i = rawNorm i * v ^ l i := by
    dsimp [weight, rawNorm, d, l]
    apply ghostGroupFiniteWeight_mul_pow_eq_normCoeff_mul_pow
      F S s B j ρ v i (choices i) hη hq (hV i) hρ hv
    intro k
    exact hν i k
  have hweighted :
      (∏ i : Fin K, weight i) * v ^ ds =
        (∏ i : Fin K, rawNorm i) * v ^ ls := by
    calc
      _ = ∏ i : Fin K, weight i * v ^ d i := by
        rw [← hpowD, ← Finset.prod_mul_distrib]
      _ = ∏ i : Fin K, rawNorm i * v ^ l i := by
        apply Finset.prod_congr rfl
        intro i hi
        exact hlocal i
      _ = _ := by rw [Finset.prod_mul_distrib, hpowL]
  calc
    _ = (∏ i : Fin K, rawNorm i) * v ^ (base + ls) := by rw [hnorm, htarget]
    _ = v ^ base * ((∏ i : Fin K, rawNorm i) * v ^ ls) := by rw [pow_add]; ring
    _ = v ^ base * ((∏ i : Fin K, weight i) * v ^ ds) := by rw [← hweighted]
    _ = v ^ (base + ds) * ∏ i : Fin K, weight i := by rw [pow_add]; ring
    _ = _ := by rw [← hsource]

set_option maxHeartbeats 1000000 in
/-- The raw ordered column separates over groups after enlarging the finite
source set to the product of its group projections. -/
private theorem ghost_ordered_column_choice_bound {K : ℕ}
    (F : PDFix K) (hF : F.Valid) (S : PDScale)
    (ρ : ℝ) (hρ : IsMemoryRho F.q_d ρ) (j B : ℕ) (v : ℝ) (hv : 0 < v)
    (hV : ∀ i, 0 < bandMass S.x (F.a i))
    (hbp : ∀ p ∈ markedPrimes S.x K F.a,
      (1 / 2 : ℝ) ≤ memoryBPrime S.x F.q_d p)
    (t : MemPoint S.x K) (ht : MemValid F S t) (htB : memSize t ≤ B)
    (T : Finset (MemPoint S.x K)) (hT : ∀ s ∈ T, memSize s ≤ B) :
    (∑ s ∈ T, memMeasure F S s * ‖memKernel (memGhost F S ρ j) s t‖ *
      v ^ memSize s) ≤
      memMeasure F S t * v ^ memSize t *
        ∏ i : Fin K,
          (Real.exp (2 * memoryEta S.x F.q_d j * v / ρ) *
            ∑ m ∈ Finset.range ((t.2.2 i).length + 1),
              if ∀ e ∈ (t.2.2 i).drop ((t.2.2 i).length - m), particleHits e t.1 then
                (Nat.choose (t.2.2 i).length m : ℝ) *
                  (memoryEta S.x F.q_d j * bandMass S.x (F.a i) / (ρ * v)) ^ m *
                  (memoryQ S.x F.q_d j / ρ ^ 2) ^ (hitCount (t.2.2 i) t.1 - m)
              else 0) := by
  classical
  let ν (i : Fin K) (p : ℕ) := memoryNu S.x K F.a F.q_d i p
  let r := memoryEta S.x F.q_d j / ρ
  let b := memoryQ S.x F.q_d j / ρ ^ 2
  let c (i : Fin K) := memoryEta S.x F.q_d j * bandMass S.x (F.a i) / ρ
  have hρsq : ρ ^ 2 < 1 := by nlinarith [hρ.1, hρ.2.1]
  have hqLt : memoryQ S.x F.q_d j < 1 := by
    unfold memoryQ
    split_ifs <;> [exact lt_trans hρ.2.2 hρsq; exact hF.2.2.1]
  have hη : 0 ≤ memoryEta S.x F.q_d j := by unfold memoryEta; linarith
  have hq : 0 ≤ memoryQ S.x F.q_d j := by
    unfold memoryQ
    split_ifs <;> [exact Real.sqrt_nonneg _; exact hF.2.1.le]
  have hr : 0 ≤ r := div_nonneg hη hρ.1.le
  have hb : 0 ≤ b := div_nonneg hq (sq_nonneg ρ)
  have hc (i : Fin K) : 0 ≤ c i := div_nonneg (mul_nonneg hη (hV i).le) hρ.1.le
  have hν (i : Fin K) (p : ℕ) (hp : p ∈ primeBand S.x (F.a i)) : 0 ≤ ν i p := by
    have hbpPos : 0 < memoryBPrime S.x F.q_d p :=
      lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2)
        (hbp p (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i, hp⟩))
    have hden : 0 < bandMass S.x (F.a i) * ((p : ℝ) + 1) *
        memoryBPrime S.x F.q_d p :=
      mul_pos (mul_pos (hV i) (by positivity)) hbpPos
    exact div_nonneg (by norm_num) hden.le
  let W (i : Fin K) (l : List Particle) :=
    (l.map fun e => ν i e.1).prod / (l.length.factorial : ℝ) * v ^ l.length
  let H (i : Fin K) (l : List Particle) (D : Finset (Fin l.length))
      (m : ℕ) (batch : Fin m → primeBand S.x (F.a i)) :=
    if removeIndices l D ++ List.ofFn (fun k => anchorAt (batch k).1 t.1) = t.2.2 i then
      r ^ D.card * b ^ (hitCount l t.1 - D.card) *
        (c i ^ m / (m.factorial : ℝ)) * ∏ k : Fin m, ν i (batch k).1 else 0
  let G (i : Fin K) (l : List Particle) :=
    ∑ D ∈ (hitIndices l t.1).powerset,
      ∑ m ∈ Finset.range (2 * B + 1), ∑ batch : Fin m → primeBand S.x (F.a i),
        H i l D m batch
  let Q (i : Fin K) :=
    ∑ m ∈ Finset.range ((t.2.2 i).length + 1),
      if ∀ e ∈ (t.2.2 i).drop ((t.2.2 i).length - m), particleHits e t.1 then
        (Nat.choose (t.2.2 i).length m : ℝ) * (c i / v) ^ m *
          b ^ (hitCount (t.2.2 i) t.1 - m) else 0
  let E := Real.exp (2 * memoryEta S.x F.q_d j * v / ρ)
  have hH (i : Fin K) (l : List Particle) (D : Finset (Fin l.length))
      (m : ℕ) (batch : Fin m → primeBand S.x (F.a i)) : 0 ≤ H i l D m batch := by
    dsimp [H]
    split_ifs
    · exact mul_nonneg
        (mul_nonneg (mul_nonneg (pow_nonneg hr _) (pow_nonneg hb _))
          (div_nonneg (pow_nonneg (hc i) _) (Nat.cast_nonneg _)))
        (Finset.prod_nonneg fun k hk => hν i (batch k).1 (batch k).2)
    · exact le_rfl
  have hG (i : Fin K) (l : List Particle) : 0 ≤ G i l := by
    exact Finset.sum_nonneg fun D hD => Finset.sum_nonneg fun m hm =>
      Finset.sum_nonneg fun batch hbatch => hH i l D m batch
  have hW (i : Fin K) (l : List Particle)
      (hl : ∀ e ∈ l, e.1 ∈ primeBand S.x (F.a i)) : 0 ≤ W i l := by
    apply mul_nonneg
    · apply div_nonneg
      · exact List.prod_nonneg fun x hx => by
          rcases List.mem_map.mp hx with ⟨e, he, rfl⟩
          exact hν i e.1 (hl e he)
      · exact Nat.cast_nonneg _
    · exact pow_nonneg hv.le _
  have hQ (i : Fin K) : 0 ≤ Q i := by
    apply Finset.sum_nonneg
    intro m hm
    split_ifs
    · exact mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (pow_nonneg (div_nonneg (hc i) hv.le) _))
        (pow_nonneg hb _)
    · exact le_rfl
  have hnormGroup (s : MemPoint S.x K) (i : Fin K)
      (a : GhostGroupChoice F s (2 * B) i) :
      ‖((ghostGroupCoeff F S ρ j i (hitCount (s.2.2 i) s.1) a.1.1.card a.2.1.1
        (List.ofFn fun k => (a.2.2 k).1) : ℝ) : ℂ)‖ =
        r ^ a.1.1.card * b ^ (hitCount (s.2.2 i) s.1 - a.1.1.card) *
          (c i ^ a.2.1.1 / (a.2.1.1.factorial : ℝ)) *
            ∏ k : Fin a.2.1.1, ν i (a.2.2 k).1 := by
    have hn := ghostGroupFiniteWeight_mul_pow_eq_normCoeff_mul_pow F S s (2 * B) j
      ρ 1 i a hη hq (hV i).le hρ.1 (by norm_num)
      (fun k => hν i (a.2.2 k).1 (a.2.2 k).2)
    simpa only [ghostGroupFiniteWeight, one_pow, mul_one, r, b, c, ν, hitCount,
      mul_assoc] using hn.symm
  have hchoiceSum (s : MemPoint S.x K) (hs : s.1 = t.1) (i : Fin K) :
      (∑ a : GhostGroupChoice F s (2 * B) i,
        H i (s.2.2 i) a.1.1 a.2.1.1 a.2.2) = G i (s.2.2 i) := by
    change (∑ a : Σ D : {D // D ∈ (hitIndices (s.2.2 i) s.1).powerset},
      Σ m : {m // m ∈ Finset.range (2 * B + 1)}, Fin m.1 → primeBand S.x (F.a i),
        H i (s.2.2 i) a.1.1 a.2.1.1 a.2.2) = _
    simp only [Fintype.sum_sigma]
    calc
      _ = ∑ D : {D // D ∈ (hitIndices (s.2.2 i) s.1).powerset},
          ∑ m ∈ Finset.range (2 * B + 1), ∑ batch : Fin m → primeBand S.x (F.a i),
            H i (s.2.2 i) D.1 m batch := by
        apply Finset.sum_congr rfl
        intro D hD
        exact sum_subtype_eq_sum_finset (Finset.range (2 * B + 1))
          (fun m => ∑ batch : Fin m → primeBand S.x (F.a i), H i (s.2.2 i) D.1 m batch)
      _ = ∑ D ∈ (hitIndices (s.2.2 i) s.1).powerset,
          ∑ m ∈ Finset.range (2 * B + 1), ∑ batch : Fin m → primeBand S.x (F.a i),
            H i (s.2.2 i) D m batch :=
        sum_subtype_eq_sum_finset (hitIndices (s.2.2 i) s.1).powerset
          (fun D => ∑ m ∈ Finset.range (2 * B + 1),
            ∑ batch : Fin m → primeBand S.x (F.a i), H i (s.2.2 i) D m batch)
      _ = _ := by simp only [hs, G]
  have hkernel (s : MemPoint S.x K) (hs : memSize s ≤ B) (hpos : s.1 = t.1) :
      ‖memKernel (memGhost F S ρ j) s t‖ ≤ ∏ i : Fin K, G i (s.2.2 i) := by
    rw [memGhostOrderedKernel_choiceSum F S ρ j s t B hs htB]
    calc
      _ ≤ ∑ choices : (i : Fin K) → GhostGroupChoice F s (2 * B) i,
          ‖ghostOrderedChoiceKernelTerm F S s t ρ j B choices‖ := norm_sum_le _ _
      _ ≤ ∑ choices : (i : Fin K) → GhostGroupChoice F s (2 * B) i,
          ∏ i : Fin K, H i (s.2.2 i) (choices i).1.1 (choices i).2.1.1 (choices i).2.2 := by
        apply Finset.sum_le_sum
        intro choices hchoices
        have hD : ∀ i, (choices i).1.1 ⊆ hitIndices (s.2.2 i) s.1 :=
          fun i => Finset.mem_powerset.mp (choices i).1.2
        let τ := ghostOutputState F s (fun i => (choices i).1.1)
          (fun i => (choices i).2.1.1) (fun i k => (choices i).2.2 k)
        by_cases hout : τ = t
        · have hcomp := ghostOutputState_eq_components F s t _ _ _ hout
          have hhit (i : Fin K) :
              removeIndices (s.2.2 i) (choices i).1.1 ++
                List.ofFn (fun k => anchorAt ((choices i).2.2 k).1 t.1) = t.2.2 i := by
            simpa only [hpos] using hcomp.2.2 i
          have hn :
              ‖ghostOrderedChoiceKernelTerm F S s t ρ j B choices‖ =
              ∏ i : Fin K,
                ‖((ghostGroupCoeff F S ρ j i (hitCount (s.2.2 i) s.1)
                  (choices i).1.1.card (choices i).2.1.1
                  (List.ofFn fun k => ((choices i).2.2 k).1) : ℝ) : ℂ)‖ := by
            simp [ghostOrderedChoiceKernelTerm, ghostOrderedKernelTerm, hD,
              show ghostOutputState F s (fun i => (choices i).1.1)
                (fun i => (choices i).2.1.1) (fun i k => (choices i).2.2 k) = t from hout,
              Complex.norm_real, Real.norm_eq_abs]
          rw [hn]
          apply le_of_eq
          apply Finset.prod_congr rfl
          intro i hi
          rw [hnormGroup]
          simp only [H, if_pos (hhit i), hpos]
        · have hz : ghostOrderedChoiceKernelTerm F S s t ρ j B choices = 0 := by
            simp [ghostOrderedChoiceKernelTerm, ghostOrderedKernelTerm, hD,
              show ghostOutputState F s (fun i => (choices i).1.1)
                (fun i => (choices i).2.1.1) (fun i k => (choices i).2.2 k) ≠ t from hout]
          rw [hz, norm_zero]
          exact Finset.prod_nonneg fun i hi => hH i _ _ _ _
      _ = ∏ i : Fin K,
          ∑ a : GhostGroupChoice F s (2 * B) i, H i (s.2.2 i) a.1.1 a.2.1.1 a.2.2 :=
        finite_pi_sum_prod (fun i => GhostGroupChoice F s (2 * B) i)
          (fun i a => H i (s.2.2 i) a.1.1 a.2.1.1 a.2.2)
      _ = _ := by
        apply Finset.prod_congr rfl
        intro i hi
        exact hchoiceSum s hpos i
  let T₀ := T.filter fun s => MemValid F S s ∧ s.1 = t.1 ∧ s.2.1 = t.2.1
  have hzero (s : MemPoint S.x K) (hs : s ∈ T) (hbad : s ∉ T₀) :
      memMeasure F S s * ‖memKernel (memGhost F S ρ j) s t‖ * v ^ memSize s = 0 := by
    by_cases hvalid : MemValid F S s
    · have hnot : ¬ (s.1 = t.1 ∧ s.2.1 = t.2.1) := by
        intro h
        exact hbad (Finset.mem_filter.mpr ⟨hs, hvalid, h⟩)
      have hk : memKernel (memGhost F S ρ j) s t = 0 := by
        rw [memGhostOrderedKernel_choiceSum F S ρ j s t B (hT s hs) htB]
        apply Finset.sum_eq_zero
        intro choices hchoices
        have hne : ghostOutputState F s (fun i => (choices i).1.1)
            (fun i => (choices i).2.1.1) (fun i k => (choices i).2.2 k) ≠ t := by
          intro heq
          have hcpt := ghostOutputState_eq_components F s t _ _ _ heq
          exact hnot ⟨hcpt.1, hcpt.2.1⟩
        simp [ghostOrderedChoiceKernelTerm, ghostOrderedKernelTerm, hne]
      simp [hk]
    · simp [memMeasure, hvalid]
  let A := ∏ i : Fin K, ∏ k : Fin (slotCount S.x), ν i (t.2.1 i k)
  have hA : 0 ≤ A := Finset.prod_nonneg fun i hi =>
    Finset.prod_nonneg fun k hk => hν i (t.2.1 i k) (ht.2.1 i k)
  have hmeasure (s : MemPoint S.x K) (hs : MemValid F S s) (ha : s.2.1 = t.2.1) :
      memMeasure F S s * v ^ memSize s = A * ∏ i : Fin K, W i (s.2.2 i) := by
    simp only [memMeasure, if_pos hs, ha, W, Finset.prod_mul_distrib]
    rw [Finset.prod_pow_eq_pow_sum]
    simp only [A, ν, memSize, mul_assoc]
  have hμ (s : MemPoint S.x K) (hs : MemValid F S s) : 0 ≤ memMeasure F S s := by
    rw [memMeasure, if_pos hs]
    apply mul_nonneg
    · exact Finset.prod_nonneg fun i hi =>
        Finset.prod_nonneg fun k hk => hν i _ (hs.2.1 i k)
    · apply Finset.prod_nonneg
      intro i hi
      apply div_nonneg
      · exact List.prod_nonneg fun x hx => by
          rcases List.mem_map.mp hx with ⟨e, he, rfl⟩
          exact hν i e.1 (hs.2.2 i e he).1
      · exact Nat.cast_nonneg _
  let Tᵢ (i : Fin K) : Finset (List Particle) := T₀.image fun s => s.2.2 i
  have hprime (i : Fin K) (l : List Particle) (hl : l ∈ Tᵢ i) :
      ∀ e ∈ l, e.1 ∈ primeBand S.x (F.a i) := by
    rcases Finset.mem_image.mp hl with ⟨s, hs, rfl⟩
    exact fun e he => ((Finset.mem_filter.mp hs).2.1.2.2 i e he).1
  have hlength (s : MemPoint S.x K) (i : Fin K) : (s.2.2 i).length ≤ memSize s :=
    Finset.single_le_sum (s := Finset.univ) (f := fun k : Fin K => (s.2.2 k).length)
      (fun k hk => Nat.zero_le _) (Finset.mem_univ i)
  have hgroup (i : Fin K) :
      (∑ l ∈ Tᵢ i, W i l * G i l) ≤ W i (t.2.2 i) * (E * Q i) := by
    have hg := ghost_group_ordered_column_le (primeBand S.x (F.a i)) (ν i) (hν i)
      (t.2.2 i) (fun e he => (ht.2.2 i e he).1) t.1 r b (c i) v hr hb (hc i) hv
      (Tᵢ i) B (2 * B)
      (by intro l hl; rcases Finset.mem_image.mp hl with ⟨s, hs, rfl⟩
          exact (hlength s i).trans (hT s (Finset.mem_filter.mp hs).1))
      (hprime i) (by have := hlength t i; omega)
    have hmass := memoryNu_band_mass_le_two F i (hV i) hbp
    have hExp : Real.exp (r * v * ∑ p ∈ primeBand S.x (F.a i), ν i p) ≤ E := by
      apply Real.exp_le_exp.mpr
      calc
        _ ≤ r * v * 2 := mul_le_mul_of_nonneg_left hmass (mul_nonneg hr hv.le)
        _ = _ := by dsimp [r]; ring
    calc
      _ = ∑ l ∈ Tᵢ i, ∑ D ∈ (hitIndices l t.1).powerset,
          ∑ m ∈ Finset.range (2 * B + 1), ∑ batch : Fin m → primeBand S.x (F.a i),
            if removeIndices l D ++ List.ofFn (fun k => anchorAt (batch k).1 t.1) = t.2.2 i then
              W i l * r ^ D.card * b ^ (hitCount l t.1 - D.card) *
                (c i ^ m / (m.factorial : ℝ)) * ∏ k : Fin m, ν i (batch k).1 else 0 := by
        simp only [G, Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro l hl
        apply Finset.sum_congr rfl
        intro D hD
        apply Finset.sum_congr rfl
        intro m hm
        apply Finset.sum_congr rfl
        intro batch hbatch
        dsimp [H]
        split_ifs <;> ring
      _ ≤ W i (t.2.2 i) * Real.exp (r * v * ∑ p ∈ primeBand S.x (F.a i), ν i p) * Q i := hg
      _ ≤ W i (t.2.2 i) * E * Q i :=
        mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_left hExp (hW i _ (fun e he => (ht.2.2 i e he).1))) (hQ i)
      _ = _ := by ring
  let α (i : Fin K) := {l : List Particle // l ∈ Tᵢ i}
  let toLists : {s // s ∈ T₀} → (i : Fin K) → α i :=
    fun s i => ⟨s.1.2.2 i, Finset.mem_image.mpr ⟨s.1, s.2, rfl⟩⟩
  have hinj : Function.Injective toLists := by
    intro s u hsu
    have hmem : s.1.2.2 = u.1.2.2 := by
      funext i
      exact congrArg Subtype.val (congrFun hsu i)
    have hs := (Finset.mem_filter.mp s.2).2
    have hu := (Finset.mem_filter.mp u.2).2
    apply Subtype.ext
    exact Prod.ext (hs.2.1.trans hu.2.1.symm)
      (Prod.ext (hs.2.2.trans hu.2.2.symm) hmem)
  let f (ls : (i : Fin K) → α i) := ∏ i : Fin K, W i (ls i).1 * G i (ls i).1
  have hf (ls : (i : Fin K) → α i) : 0 ≤ f ls := Finset.prod_nonneg fun i hi =>
    mul_nonneg (hW i _ (hprime i _ (ls i).2)) (hG i _)
  have hprodSum :
      (∑ s ∈ T₀, ∏ i : Fin K, W i (s.2.2 i) * G i (s.2.2 i)) ≤
        ∏ i : Fin K, ∑ l ∈ Tᵢ i, W i l * G i l := by
    calc
      _ = ∑ s : {s // s ∈ T₀}, f (toLists s) :=
        (sum_subtype_eq_sum_finset T₀
          (fun s => ∏ i : Fin K, W i (s.2.2 i) * G i (s.2.2 i))).symm
      _ = ∑ ls ∈ Finset.univ.image toLists, f ls := by
        exact (Finset.sum_image (fun s hs u hu h => hinj h)).symm
      _ ≤ ∑ ls : (i : Fin K) → α i, f ls := by
        exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
          (fun ls hls hnot => hf ls)
      _ = ∏ i : Fin K, ∑ l : α i, W i l.1 * G i l.1 :=
        finite_pi_sum_prod α (fun i l => W i l.1 * G i l.1)
      _ = _ := by
        apply Finset.prod_congr rfl
        intro i hi
        exact sum_subtype_eq_sum_finset (Tᵢ i) (fun l => W i l * G i l)
  have hfinal :
      (∑ s ∈ T, memMeasure F S s * ‖memKernel (memGhost F S ρ j) s t‖ * v ^ memSize s) ≤
        memMeasure F S t * v ^ memSize t * ∏ i : Fin K, E * Q i := by
    calc
      _ = ∑ s ∈ T₀, memMeasure F S s * ‖memKernel (memGhost F S ρ j) s t‖ *
          v ^ memSize s := by
        symm
        apply Finset.sum_subset (Finset.filter_subset _ _)
        exact hzero
      _ ≤ ∑ s ∈ T₀, A * ∏ i : Fin K, W i (s.2.2 i) * G i (s.2.2 i) := by
        apply Finset.sum_le_sum
        intro s hs
        have hparts := (Finset.mem_filter.mp hs).2
        calc
          _ ≤ memMeasure F S s * (∏ i : Fin K, G i (s.2.2 i)) * v ^ memSize s :=
            mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_left (hkernel s (hT s (Finset.mem_filter.mp hs).1) hparts.2.1)
                (hμ s hparts.1)) (pow_nonneg hv.le _)
          _ = _ := by
            rw [show memMeasure F S s * (∏ i : Fin K, G i (s.2.2 i)) * v ^ memSize s =
              (memMeasure F S s * v ^ memSize s) * ∏ i : Fin K, G i (s.2.2 i) by ring,
              hmeasure s hparts.1 hparts.2.2, mul_assoc, ← Finset.prod_mul_distrib]
      _ = A * ∑ s ∈ T₀, ∏ i : Fin K, W i (s.2.2 i) * G i (s.2.2 i) := by rw [Finset.mul_sum]
      _ ≤ A * ∏ i : Fin K, ∑ l ∈ Tᵢ i, W i l * G i l := mul_le_mul_of_nonneg_left hprodSum hA
      _ ≤ A * ∏ i : Fin K, W i (t.2.2 i) * (E * Q i) := by
        apply mul_le_mul_of_nonneg_left _ hA
        apply Finset.prod_le_prod₀
        · intro i hi
          exact Finset.sum_nonneg fun l hl => mul_nonneg (hW i l (hprime i l hl)) (hG i l)
        · intro i hi
          exact hgroup i
      _ = _ := by rw [Finset.prod_mul_distrib, ← mul_assoc, ← hmeasure t ht rfl]
  have hcdiv (i : Fin K) : c i / v = memoryEta S.x F.q_d j * bandMass S.x (F.a i) / (ρ * v) := by
    dsimp [c]
    ring
  simpa only [E, Q, b, hcdiv] using hfinal

set_option maxHeartbeats 1000000 in
/-- Averaging the ordered column over target permutations cancels its
suffix multiplicities and gives the symmetric-memory column Schur bound. -/
private theorem memGhostProjected_colSchur_le_of_params {K : ℕ}
    (F : PDFix K) (hF : F.Valid) (S : PDScale)
    (ρ : ℝ) (hρ : IsMemoryRho F.q_d ρ) (j B : ℕ) (v : ℝ) (hv : 0 < v)
    (hvlarge : ∀ i, 2 * bandMass S.x (F.a i) /
      (ρ * (1 - Real.sqrt F.q_d / ρ ^ 2)) ≤ v)
    (hV : ∀ i, 0 < bandMass S.x (F.a i))
    (hbp : ∀ p ∈ markedPrimes S.x K F.a,
      (1 / 2 : ℝ) ≤ memoryBPrime S.x F.q_d p) :
    MemColSchurLE_sym F S B (memGhost F S ρ j) v
      (∏ i : Fin K, Real.exp (2 * memoryEta S.x F.q_d j * v / ρ)) := by
  classical
  have hρsq : ρ ^ 2 < 1 := by nlinarith [hρ.1, hρ.2.1]
  have hqLt : memoryQ S.x F.q_d j < 1 := by
    unfold memoryQ
    split_ifs <;> [exact lt_trans hρ.2.2 hρsq; exact hF.2.2.1]
  have hη : 0 ≤ memoryEta S.x F.q_d j := by unfold memoryEta; linarith
  have hq : 0 ≤ memoryQ S.x F.q_d j := by
    unfold memoryQ
    split_ifs <;> [exact Real.sqrt_nonneg _; exact hF.2.1.le]
  have hν (i : Fin K) (p : ℕ) (hp : p ∈ primeBand S.x (F.a i)) :
      0 ≤ memoryNu S.x K F.a F.q_d i p := by
    have hbpPos : 0 < memoryBPrime S.x F.q_d p :=
      lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2)
        (hbp p (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i, hp⟩))
    have hden : 0 < bandMass S.x (F.a i) * ((p : ℝ) + 1) *
        memoryBPrime S.x F.q_d p :=
      mul_pos (mul_pos (hV i) (by positivity)) hbpPos
    exact div_nonneg (by norm_num) hden.le
  have hμ (s : MemPoint S.x K) : 0 ≤ memMeasure F S s := by
    by_cases hs : MemValid F S s
    · rw [memMeasure, if_pos hs]
      apply mul_nonneg
      · exact Finset.prod_nonneg fun i hi =>
          Finset.prod_nonneg fun k hk => hν i _ (hs.2.1 i k)
      · apply Finset.prod_nonneg
        intro i hi
        apply div_nonneg
        · exact List.prod_nonneg fun x hx => by
            rcases List.mem_map.mp hx with ⟨e, he, rfl⟩
            exact hν i e.1 (hs.2.2 i e he).1
        · exact Nat.cast_nonneg _
    · simp [memMeasure, hs]
  let a (i : Fin K) := memoryEta S.x F.q_d j * bandMass S.x (F.a i) / (ρ * v)
  let b := memoryQ S.x F.q_d j / ρ ^ 2
  let E := Real.exp (2 * memoryEta S.x F.q_d j * v / ρ)
  have ha (i : Fin K) : 0 ≤ a i :=
    div_nonneg (mul_nonneg hη (hV i).le) (mul_nonneg hρ.1.le hv.le)
  have hb : 0 ≤ b := div_nonneg hq (sq_nonneg ρ)
  have hab (i : Fin K) : a i + b ≤ 1 := by
    have hv' : 2 / (ρ * (1 - Real.sqrt F.q_d / ρ ^ 2)) ≤
        v / bandMass S.x (F.a i) := by
      rw [le_div_iff₀ (hV i)]
      have h := hvlarge i
      convert h using 1 <;> ring
    have h := ghost_parenthesis_le_one F hF ρ hρ (v / bandMass S.x (F.a i)) hv'
      (x := S.x) j
    have hcancel : memoryEta S.x F.q_d j / (ρ * (v / bandMass S.x (F.a i))) = a i := by
      dsimp [a]
      field_simp [ne_of_gt (hV i), ne_of_gt hρ.1, ne_of_gt hv]
    rw [hcancel] at h
    dsimp [b]
    linarith
  change MemColSchurLE F S B (fun f => memGhost F S ρ j (memorySym f)) v _
  intro t ht htB T hT
  have hperm (σ : MemoryPermutation t) (i : Fin K) :
      ((memoryPermute t σ).2.2 i).Perm (t.2.2 i) := by
    simpa only [memoryPermute, Function.comp_def, List.ofFn_get] using
      (σ i).ofFn_comp_perm (t.2.2 i).get
  have hvalid (σ : MemoryPermutation t) : MemValid F S (memoryPermute t σ) := by
    refine ⟨ht.1, ht.2.1, ?_⟩
    intro i e he
    exact ht.2.2 i e ((hperm σ i).mem_iff.mp he)
  have hmeasure (σ : MemoryPermutation t) :
      memMeasure F S (memoryPermute t σ) = memMeasure F S t := by
    simp only [memMeasure, if_pos (hvalid σ), if_pos ht]
    change _ * (∏ i : Fin K,
      (((memoryPermute t σ).2.2 i).map fun e => memoryNu S.x K F.a F.q_d i e.1).prod /
        (((memoryPermute t σ).2.2 i).length.factorial : ℝ)) = _
    congr 1
    apply Finset.prod_congr rfl
    intro i hi
    rw [(hperm σ i).length_eq,
      ((hperm σ i).map (fun e => memoryNu S.x K F.a F.q_d i e.1)).prod_eq]
  have hcount (l : List Particle) :
      hitCount l t.1 = l.countP (fun e => decide (particleHits e t.1)) := by
    have huniv : (List.finRange l.length).toFinset =
        (Finset.univ : Finset (Fin l.length)) := by ext k; simp
    calc
      _ = ((List.finRange l.length).toFinset.filter
          fun k => particleHits (l.get k) t.1).card := by simp [huniv, hitCount, hitIndices]
      _ = (List.finRange l.length).countP (fun k => decide (particleHits (l.get k) t.1)) :=
        (List.nodup_finRange _).card_eq_countP
      _ = ((List.finRange l.length).map l.get).countP
          (fun e => decide (particleHits e t.1)) := by
            simp only [List.countP_map, Function.comp_def]
      _ = _ := by rw [List.map_get_finRange]
  have hhit (i : Fin K) (σ : Equiv.Perm (Fin (t.2.2 i).length)) :
      hitCount (List.ofFn fun k => (t.2.2 i).get (σ k)) t.1 = hitCount (t.2.2 i) t.1 := by
    rw [hcount, hcount]
    have hp : (List.ofFn fun k => (t.2.2 i).get (σ k)).Perm (t.2.2 i) := by
      simpa only [Function.comp_def, List.ofFn_get] using σ.ofFn_comp_perm (t.2.2 i).get
    exact hp.countP_eq _
  let Q (i : Fin K) (σ : Equiv.Perm (Fin (t.2.2 i).length)) :=
    ∑ m ∈ Finset.range ((t.2.2 i).length + 1),
      if ∀ e ∈ (List.ofFn fun k => (t.2.2 i).get (σ k)).drop ((t.2.2 i).length - m),
          particleHits e t.1 then
        (Nat.choose (t.2.2 i).length m : ℝ) * a i ^ m * b ^ (hitCount (t.2.2 i) t.1 - m)
      else 0
  let d := (Fintype.card (MemoryPermutation t) : ℝ)
  have hd : 0 ≤ d⁻¹ := inv_nonneg.mpr (Nat.cast_nonneg _)
  have hcard : d = ∏ i : Fin K, (Fintype.card (Equiv.Perm (Fin (t.2.2 i).length)) : ℝ) := by
    simp [d, MemoryPermutation, Fintype.card_pi, Nat.cast_prod]
  have haverage :
      d⁻¹ * (∑ σ : MemoryPermutation t, ∏ i : Fin K, E * Q i (σ i)) ≤
        ∏ i : Fin K, E := by
    calc
      _ = ∏ i : Fin K, E *
          ((Fintype.card (Equiv.Perm (Fin (t.2.2 i).length)) : ℝ)⁻¹ *
            ∑ σ : Equiv.Perm (Fin (t.2.2 i).length), Q i σ) := by
        rw [finite_pi_sum_prod (fun i => Equiv.Perm (Fin (t.2.2 i).length))
          (fun i σ => E * Q i σ), hcard, ← Finset.prod_inv_distrib, ← Finset.prod_mul_distrib]
        apply Finset.prod_congr rfl
        intro i hi
        rw [← Finset.mul_sum]
        ring
      _ = ∏ i : Fin K, E * (a i + b) ^ hitCount (t.2.2 i) t.1 := by
        apply Finset.prod_congr rfl
        intro i hi
        rw [show (Fintype.card (Equiv.Perm (Fin (t.2.2 i).length)) : ℝ)⁻¹ *
          (∑ σ : Equiv.Perm (Fin (t.2.2 i).length), Q i σ) =
            (a i + b) ^ hitCount (t.2.2 i) t.1 from
              ghost_suffix_average_polynomial (t.2.2 i) t.1 (a i) b]
      _ ≤ _ := by
        apply Finset.prod_le_prod₀
        · intro i hi
          exact mul_nonneg (Real.exp_pos _).le (pow_nonneg (add_nonneg (ha i) hb) _)
        · intro i hi
          simpa only [mul_one] using mul_le_mul_of_nonneg_left
            (pow_le_one₀ (add_nonneg (ha i) hb) (hab i)) (Real.exp_pos _).le
  have hordered (σ : MemoryPermutation t) :
      (∑ s ∈ T, memMeasure F S s *
        ‖memKernel (memGhost F S ρ j) s (memoryPermute t σ)‖ * v ^ memSize s) ≤
        memMeasure F S t * v ^ memSize t * ∏ i : Fin K, E * Q i (σ i) := by
    have h := ghost_ordered_column_choice_bound F hF S ρ hρ j B v hv hV hbp
      (memoryPermute t σ) (hvalid σ)
      (by simpa only [memSize_memoryPermute] using htB) T hT
    rw [hmeasure σ, memSize_memoryPermute] at h
    simpa only [memoryPermute, List.length_ofFn, hhit, E, Q, a, b] using h
  have hkernel (s : MemPoint S.x K) (hs : s ∈ T) :
      ‖memKernel (fun f => memGhost F S ρ j (memorySym f)) s t‖ ≤
        d⁻¹ * ∑ σ : MemoryPermutation t,
          ‖memKernel (memGhost F S ρ j) s (memoryPermute t σ)‖ := by
    rw [memGhostProjectedKernel_target_perm_sum F S ρ j s t B (hT s hs) htB]
    calc
      _ ≤ ‖(Fintype.card (MemoryPermutation t) : ℂ)⁻¹‖ *
          ∑ σ : MemoryPermutation t,
            ‖memKernel (memGhost F S ρ j) s (memoryPermute t σ)‖ :=
        (norm_mul_le _ _).trans (mul_le_mul_of_nonneg_left (norm_sum_le _ _) (norm_nonneg _))
      _ = _ := by simp [norm_inv, d]
  calc
    _ ≤ ∑ s ∈ T, memMeasure F S s *
        (d⁻¹ * ∑ σ : MemoryPermutation t,
          ‖memKernel (memGhost F S ρ j) s (memoryPermute t σ)‖) * v ^ memSize s := by
      apply Finset.sum_le_sum
      intro s hs
      exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (hkernel s hs) (hμ s)) (pow_nonneg hv.le _)
    _ = ∑ s ∈ T, ∑ σ : MemoryPermutation t,
        d⁻¹ * (memMeasure F S s *
          ‖memKernel (memGhost F S ρ j) s (memoryPermute t σ)‖ * v ^ memSize s) := by
      apply Finset.sum_congr rfl
      intro s hs
      rw [Finset.mul_sum, Finset.mul_sum, Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro σ hσ
      ring
    _ = d⁻¹ * ∑ σ : MemoryPermutation t, ∑ s ∈ T,
        memMeasure F S s *
          ‖memKernel (memGhost F S ρ j) s (memoryPermute t σ)‖ * v ^ memSize s := by
      rw [Finset.sum_comm, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro σ hσ
      rw [Finset.mul_sum]
    _ ≤ d⁻¹ * ∑ σ : MemoryPermutation t,
        memMeasure F S t * v ^ memSize t * ∏ i : Fin K, E * Q i (σ i) := by
      apply mul_le_mul_of_nonneg_left _ hd
      apply Finset.sum_le_sum
      intro σ hσ
      exact hordered σ
    _ = (memMeasure F S t * v ^ memSize t) *
        (d⁻¹ * ∑ σ : MemoryPermutation t, ∏ i : Fin K, E * Q i (σ i)) := by
      rw [← Finset.mul_sum]
      ring
    _ ≤ (memMeasure F S t * v ^ memSize t) * ∏ i : Fin K, E :=
      mul_le_mul_of_nonneg_left haverage (mul_nonneg (hμ t) (pow_nonneg hv.le _))
    _ = _ := by dsimp [E]; ring

set_option maxHeartbeats 1000000 in
/-- On finite support below the memory cutoff, the projected ghost operator
is exactly its finite kernel sum. -/
private theorem memGhostProjected_finite_kernel {K : ℕ}
    (F : PDFix K) (S : PDScale) (ρ : ℝ) (j B : ℕ)
    (s : MemPoint S.x K) (hsB : memSize s ≤ B)
    (T : Finset (MemPoint S.x K)) (f : MemPoint S.x K → ℂ)
    (hsupp : ∀ t, t ∉ T → f t = 0) (hT : ∀ t ∈ T, memSize t ≤ B) :
    memGhost F S ρ j (memorySym f) s =
      ∑ t ∈ T,
        memKernel (fun g => memGhost F S ρ j (memorySym g)) s t * f t := by
  classical
  have hdecomp (u : MemPoint S.x K) :
      (∑ t ∈ T, (if u = t then (1 : ℂ) else 0) * f t) = f u := by
    by_cases hu : u ∈ T
    · simp [eq_comm, hu]
    · simp [eq_comm, hu, hsupp u hu]
  have hsym (u : MemPoint S.x K) :
      memorySym f u = ∑ t ∈ T, memorySym (fun u' => if u' = t then (1 : ℂ) else 0) u * f t := by
    simp only [memorySym]
    calc
      _ = (Fintype.card (MemoryPermutation u) : ℂ)⁻¹ *
          ∑ σ : MemoryPermutation u, ∑ t ∈ T,
            (if memoryPermute u σ = t then (1 : ℂ) else 0) * f t := by
        congr 1
        apply Finset.sum_congr rfl
        intro σ hσ
        exact (hdecomp (memoryPermute u σ)).symm
      _ = _ := by
        rw [Finset.sum_comm, Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro t ht
        rw [← Finset.sum_mul]
        ring
  have hlarge (u : MemPoint S.x K) (hu : B < memSize u) : memorySym f u = 0 := by
    have hf (σ : MemoryPermutation u) : f (memoryPermute u σ) = 0 := by
      apply hsupp
      intro hmem
      have hsize := hT (memoryPermute u σ) hmem
      rw [memSize_memoryPermute] at hsize
      omega
    simp [memorySym, hf]
  let H (D : (i : Fin K) → Finset (Fin (s.2.2 i).length)) (m : Fin K → ℕ)
      (new : (i : Fin K) → Fin (m i) → {p // p ∈ primeBand S.x (F.a i)}) : ℂ :=
    if hD : ∀ i, D i ⊆ hitIndices (s.2.2 i) s.1 then
      ((∏ i : Fin K,
        ghostGroupCoeff F S ρ j i (hitCount (s.2.2 i) s.1) (D i).card (m i)
          (List.ofFn fun k => (new i k).1) : ℝ) : ℂ) *
        memorySym f (ghostOutputState F s D m new)
    else 0
  have hfinite : memGhost F S ρ j (memorySym f) s =
      ∑ D : (i : Fin K) → Finset (Fin (s.2.2 i).length),
        ∑ m ∈ GhostBatchLengths K B,
          ∑ new : (i : Fin K) → Fin (m i) → {p // p ∈ primeBand S.x (F.a i)},
            H D m new := by
    change logGhost F S ρ j (fun σL => memorySym f σL.1) (s, []) = _
    unfold logGhost
    change (∑ D : (i : Fin K) → Finset (Fin (s.2.2 i).length),
      ∑' m : Fin K → ℕ,
        ∑ new : (i : Fin K) → Fin (m i) → {p // p ∈ primeBand S.x (F.a i)},
          H D m new) = _
    apply Finset.sum_congr rfl
    intro D hD
    apply tsum_eq_sum
    intro m hm
    apply Finset.sum_eq_zero
    intro new hnew
    have hnot : ¬ ∀ i : Fin K, m i ≤ 2 * B := by
      intro h
      apply hm
      simpa only [GhostBatchLengths, Fintype.mem_piFinset, Finset.mem_range] using
        (fun i => by have := h i; omega : ∀ i : Fin K, m i < 2 * B + 1)
    rcases not_forall.mp hnot with ⟨i, hi⟩
    have hout := ghostOutputState_memSize_gt_of_large_batch F s B D m new hsB i
      (by omega : 2 * B < m i)
    by_cases hg : ∀ i, D i ⊆ hitIndices (s.2.2 i) s.1
    · simp only [H, dif_pos hg, hlarge _ hout, mul_zero]
    · simp only [H, dif_neg hg]
  have hterm (D : (i : Fin K) → Finset (Fin (s.2.2 i).length)) (m : Fin K → ℕ)
      (new : (i : Fin K) → Fin (m i) → {p // p ∈ primeBand S.x (F.a i)}) :
      H D m new = ∑ t ∈ T, ghostKernelTerm F S s ρ j t D m new * f t := by
    by_cases hg : ∀ i, D i ⊆ hitIndices (s.2.2 i) s.1
    · simp only [H, ghostKernelTerm, dif_pos hg]
      rw [hsym, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro t ht
      ring
    · simp [H, ghostKernelTerm, hg]
  have hswap (D : (i : Fin K) → Finset (Fin (s.2.2 i).length)) :
      (∑ m ∈ GhostBatchLengths K B,
        ∑ new : (i : Fin K) → Fin (m i) → {p // p ∈ primeBand S.x (F.a i)},
          ∑ t ∈ T, ghostKernelTerm F S s ρ j t D m new * f t) =
        ∑ t ∈ T, ∑ m ∈ GhostBatchLengths K B,
          ∑ new : (i : Fin K) → Fin (m i) → {p // p ∈ primeBand S.x (F.a i)},
            ghostKernelTerm F S s ρ j t D m new * f t := by
    calc
      _ = ∑ m ∈ GhostBatchLengths K B, ∑ t ∈ T,
          ∑ new : (i : Fin K) → Fin (m i) → {p // p ∈ primeBand S.x (F.a i)},
            ghostKernelTerm F S s ρ j t D m new * f t := by
        apply Finset.sum_congr rfl
        intro m hm
        exact Finset.sum_comm
      _ = _ := Finset.sum_comm
  calc
    _ = ∑ D : (i : Fin K) → Finset (Fin (s.2.2 i).length),
        ∑ m ∈ GhostBatchLengths K B,
          ∑ new : (i : Fin K) → Fin (m i) → {p // p ∈ primeBand S.x (F.a i)},
            ∑ t ∈ T, ghostKernelTerm F S s ρ j t D m new * f t := by
      rw [hfinite]
      apply Finset.sum_congr rfl
      intro D hD
      apply Finset.sum_congr rfl
      intro m hm
      apply Finset.sum_congr rfl
      intro new hnew
      exact hterm D m new
    _ = ∑ D : (i : Fin K) → Finset (Fin (s.2.2 i).length), ∑ t ∈ T,
        ∑ m ∈ GhostBatchLengths K B,
          ∑ new : (i : Fin K) → Fin (m i) → {p // p ∈ primeBand S.x (F.a i)},
            ghostKernelTerm F S s ρ j t D m new * f t := by
      apply Finset.sum_congr rfl
      intro D hD
      exact hswap D
    _ = ∑ t ∈ T, ∑ D : (i : Fin K) → Finset (Fin (s.2.2 i).length),
        ∑ m ∈ GhostBatchLengths K B,
          ∑ new : (i : Fin K) → Fin (m i) → {p // p ∈ primeBand S.x (F.a i)},
            ghostKernelTerm F S s ρ j t D m new * f t := Finset.sum_comm
    _ = ∑ t ∈ T,
        (∑ D : (i : Fin K) → Finset (Fin (s.2.2 i).length),
          ∑ m ∈ GhostBatchLengths K B,
            ∑ new : (i : Fin K) → Fin (m i) → {p // p ∈ primeBand S.x (F.a i)},
              ghostKernelTerm F S s ρ j t D m new) * f t := by
      simp only [Finset.sum_mul]
    _ = _ := by
      apply Finset.sum_congr rfl
      intro t ht
      rw [memGhostProjectedKernel_finite F S ρ j s t B hsB (hT t ht)]

set_option maxHeartbeats 1000000 in
/-- Finite weighted Schur bounds the projected ghost norm, including finite
supports containing invalid states of zero measure. -/
private theorem memGhostProjected_norm_of_schur {K : ℕ}
    (F : PDFix K) (S : PDScale) (ρ : ℝ) (j B : ℕ) (v C : ℝ)
    (hv : 0 < v) (hC : 0 ≤ C) (hμ : ∀ s, 0 ≤ memMeasure F S s)
    (hrow : MemRowSchurLE_sym F S B (memGhost F S ρ j) v C)
    (hcol : MemColSchurLE_sym F S B (memGhost F S ρ j) v C) :
    MemOpNormLE_sym F S B (memGhost F S ρ j) C := by
  classical
  have hSchur
      (μ v : MemPoint S.x K → ℝ) (k : MemPoint S.x K → MemPoint S.x K → ℂ) (f : MemPoint S.x K → ℂ) (T T' : Finset (MemPoint S.x K)) (a b : ℝ)
      (hμ : ∀ s, 0 ≤ μ s) (hv : ∀ s, 0 < v s) (ha : 0 ≤ a) (hb : 0 ≤ b)
      (hrow : ∀ s ∈ T', ∑ t ∈ T, ‖k s t‖ * v t ≤ a * v s)
      (hcol : ∀ t ∈ T, ∑ s ∈ T', μ s * ‖k s t‖ * v s ≤ b * μ t * v t) :
      (∑ s ∈ T', μ s * ‖∑ t ∈ T, k s t * f t‖ ^ 2) ≤
        a * b * (∑ t ∈ T, μ t * ‖f t‖ ^ 2) := by
    classical
    have hpoint (s : MemPoint S.x K) :
        ‖∑ t ∈ T, k s t * f t‖ ^ 2 ≤
          (∑ t ∈ T, ‖k s t‖ * v t) *
            ∑ t ∈ T, ‖k s t‖ * ‖f t‖ ^ 2 / v t := by
      have hCS := Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul (s := T)
        (r := fun t => ‖k s t‖ * ‖f t‖)
        (f := fun t => ‖k s t‖ * v t)
        (g := fun t => ‖k s t‖ * ‖f t‖ ^ 2 / v t)
        (fun t ht => mul_nonneg (norm_nonneg _) (hv t).le)
        (fun t ht => div_nonneg (mul_nonneg (norm_nonneg _) (sq_nonneg _)) (hv t).le)
        (fun t ht => by
          have hvt := hv t
          have heq : (‖k s t‖ * ‖f t‖) ^ 2 =
              (‖k s t‖ * v t) * (‖k s t‖ * ‖f t‖ ^ 2 / v t) := by
            field_simp [hvt.ne']
          exact heq.le)
      have htri :
          ‖∑ t ∈ T, k s t * f t‖ ≤ ∑ t ∈ T, ‖k s t‖ * ‖f t‖ := by
        calc
          ‖∑ t ∈ T, k s t * f t‖ ≤ ∑ t ∈ T, ‖k s t * f t‖ := norm_sum_le _ _
          _ = ∑ t ∈ T, ‖k s t‖ * ‖f t‖ := by simp [norm_mul]
      have hsumNonneg : 0 ≤ ∑ t ∈ T, ‖k s t‖ * ‖f t‖ :=
        Finset.sum_nonneg fun t ht => mul_nonneg (norm_nonneg _) (norm_nonneg _)
      have hsq : ‖∑ t ∈ T, k s t * f t‖ ^ 2 ≤
          (∑ t ∈ T, ‖k s t‖ * ‖f t‖) ^ 2 := by
        have hprod := mul_nonneg (sub_nonneg.mpr htri)
          (add_nonneg (norm_nonneg (∑ t ∈ T, k s t * f t)) hsumNonneg)
        nlinarith [hprod]
      exact hsq.trans hCS
    have hinnerNonneg (s : MemPoint S.x K) :
        0 ≤ ∑ t ∈ T, ‖k s t‖ * ‖f t‖ ^ 2 / v t :=
      Finset.sum_nonneg fun t ht =>
        div_nonneg (mul_nonneg (norm_nonneg _) (sq_nonneg _)) (hv t).le
    have hrowAll (s : MemPoint S.x K) (hs : s ∈ T') :
        0 ≤ ∑ t ∈ T, ‖k s t‖ * v t :=
      Finset.sum_nonneg fun t ht => mul_nonneg (norm_nonneg _) (hv t).le
    have hswap :
        (∑ s ∈ T', μ s * v s *
          (∑ t ∈ T, ‖k s t‖ * ‖f t‖ ^ 2 / v t)) =
          ∑ t ∈ T, (‖f t‖ ^ 2 / v t) *
            (∑ s ∈ T', μ s * ‖k s t‖ * v s) := by
      simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro t ht
      apply Finset.sum_congr rfl
      intro s hs
      ring
    calc
      (∑ s ∈ T', μ s * ‖∑ t ∈ T, k s t * f t‖ ^ 2)
          ≤ ∑ s ∈ T', μ s *
            ((∑ t ∈ T, ‖k s t‖ * v t) *
              ∑ t ∈ T, ‖k s t‖ * ‖f t‖ ^ 2 / v t) := by
            apply Finset.sum_le_sum
            intro s hs
            exact mul_le_mul_of_nonneg_left (hpoint s) (hμ s)
      _ ≤ ∑ s ∈ T', μ s * ((a * v s) *
            ∑ t ∈ T, ‖k s t‖ * ‖f t‖ ^ 2 / v t) := by
            apply Finset.sum_le_sum
            intro s hs
            exact mul_le_mul_of_nonneg_left
              (mul_le_mul_of_nonneg_right (hrow s hs) (hinnerNonneg s)) (hμ s)
      _ = a * (∑ s ∈ T', μ s * v s *
            (∑ t ∈ T, ‖k s t‖ * ‖f t‖ ^ 2 / v t)) := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro s hs
            ring
      _ = a * (∑ t ∈ T, (‖f t‖ ^ 2 / v t) *
            (∑ s ∈ T', μ s * ‖k s t‖ * v s)) := by rw [hswap]
      _ ≤ a * (∑ t ∈ T, (‖f t‖ ^ 2 / v t) * (b * μ t * v t)) := by
            apply mul_le_mul_of_nonneg_left
            · apply Finset.sum_le_sum
              intro t ht
              exact mul_le_mul_of_nonneg_left (hcol t ht)
                (div_nonneg (sq_nonneg _) (hv t).le)
            · exact ha
      _ = a * b * (∑ t ∈ T, μ t * ‖f t‖ ^ 2) := by
            rw [Finset.mul_sum, Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro t ht
            have hvt := hv t
            field_simp [hvt.ne']
  have hvalidPerm (u : MemPoint S.x K) (hu : MemValid F S u)
      (σ : MemoryPermutation u) : MemValid F S (memoryPermute u σ) := by
    refine ⟨hu.1, hu.2.1, ?_⟩
    intro i e he
    have hp : ((memoryPermute u σ).2.2 i).Perm (u.2.2 i) := by
      simpa only [memoryPermute, Function.comp_def, List.ofFn_get] using
        (σ i).ofFn_comp_perm (u.2.2 i).get
    exact hu.2.2 i e (hp.mem_iff.mp he)
  have hvalidOutput (s : MemPoint S.x K) (hs : MemValid F S s)
      (D : (i : Fin K) → Finset (Fin (s.2.2 i).length)) (m : Fin K → ℕ)
      (new : (i : Fin K) → Fin (m i) → {p // p ∈ primeBand S.x (F.a i)}) :
      MemValid F S (ghostOutputState F s D m new) := by
    refine ⟨hs.1, hs.2.1, ?_⟩
    intro i e he
    change e ∈ removeIndices (s.2.2 i) (D i) ++
      List.ofFn (fun k => anchorAt (new i k).1 s.1) at he
    rcases List.mem_append.mp he with hkeep | hborn
    · have he' : e ∈ removeIndices (s.2.2 i) (D i) ++ selectIndices (s.2.2 i) (D i) :=
        List.mem_append.mpr (Or.inl hkeep)
      exact hs.2.2 i e ((remove_select_perm (s.2.2 i) (D i)).mem_iff.mp he')
    · rcases List.mem_ofFn.mp hborn with ⟨k, rfl⟩
      refine ⟨(new i k).2, ?_⟩
      exact Nat.le_of_lt_succ (projLine (new i k).1 s.1).isLt
  have hsymzero (u : MemPoint S.x K) (hu : MemValid F S u)
      (t : MemPoint S.x K) (ht : ¬ MemValid F S t) :
      memorySym (fun u' => if u' = t then (1 : ℂ) else 0) u = 0 := by
    have hne (σ : MemoryPermutation u) : memoryPermute u σ ≠ t := by
      intro heq
      apply ht
      simpa only [heq] using hvalidPerm u hu σ
    simp [memorySym, hne]
  have hzero (s : MemPoint S.x K) (hs : MemValid F S s)
      (t : MemPoint S.x K) (ht : ¬ MemValid F S t) :
      memKernel (fun g => memGhost F S ρ j (memorySym g)) s t = 0 := by
    change logGhost F S ρ j
      (fun σL => memorySym (fun u => if u = t then (1 : ℂ) else 0) σL.1) (s, []) = 0
    unfold logGhost
    apply Finset.sum_eq_zero
    intro D hD
    calc
      _ = ∑' m : Fin K → ℕ, (0 : ℂ) := by
        apply tsum_congr
        intro m
        apply Finset.sum_eq_zero
        intro new hnew
        by_cases hg : ∀ i, D i ⊆ hitIndices (s.2.2 i) s.1
        · simp only [if_pos hg]
          change _ * memorySym (fun u => if u = t then (1 : ℂ) else 0)
            (ghostOutputState F s D m new) = 0
          rw [hsymzero _ (hvalidOutput s hs D m new) t ht, mul_zero]
        · simp only [if_neg hg]
      _ = 0 := by simp
  let kRaw (s t : MemPoint S.x K) :=
    memKernel (fun g => memGhost F S ρ j (memorySym g)) s t
  let k (s t : MemPoint S.x K) := if MemValid F S s ∧ MemValid F S t then kRaw s t else 0
  have hknorm (s t : MemPoint S.x K) : ‖k s t‖ ≤ ‖kRaw s t‖ := by
    dsimp [k]
    split_ifs
    · exact le_rfl
    · simpa only [norm_zero] using norm_nonneg (kRaw s t)
  have hkeq (s : MemPoint S.x K) (hs : MemValid F S s) (t : MemPoint S.x K) :
      kRaw s t = k s t := by
    by_cases ht : MemValid F S t
    · simp [k, hs, ht]
    · have hz : kRaw s t = 0 := hzero s hs t ht
      simp [k, ht, hz]
  change MemOpNormLE F S B (fun g => memGhost F S ρ j (memorySym g)) C
  intro T T' f hsupp hT hT'
  have hrowk (s : MemPoint S.x K) (hsT' : s ∈ T') :
      (∑ t ∈ T, ‖k s t‖ * v ^ memSize t) ≤ C * v ^ memSize s := by
    by_cases hs : MemValid F S s
    · calc
        _ ≤ ∑ t ∈ T, ‖kRaw s t‖ * v ^ memSize t := by
          apply Finset.sum_le_sum
          intro t ht
          exact mul_le_mul_of_nonneg_right (hknorm s t) (pow_nonneg hv.le _)
        _ ≤ _ := hrow s hs (hT' s hsT') T hT
    · have hz : (∑ t ∈ T, ‖k s t‖ * v ^ memSize t) = 0 := by simp [k, hs]
      rw [hz]
      exact mul_nonneg hC (pow_nonneg hv.le _)
  have hcolk (t : MemPoint S.x K) (htT : t ∈ T) :
      (∑ s ∈ T', memMeasure F S s * ‖k s t‖ * v ^ memSize s) ≤
        C * memMeasure F S t * v ^ memSize t := by
    by_cases ht : MemValid F S t
    · calc
        _ ≤ ∑ s ∈ T', memMeasure F S s * ‖kRaw s t‖ * v ^ memSize s := by
          apply Finset.sum_le_sum
          intro s hs
          exact mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_left (hknorm s t) (hμ s)) (pow_nonneg hv.le _)
        _ ≤ _ := hcol t ht (hT t htT) T' hT'
    · have hz : (∑ s ∈ T', memMeasure F S s * ‖k s t‖ * v ^ memSize s) = 0 := by
        simp [k, ht]
      rw [hz]
      exact mul_nonneg (mul_nonneg hC (hμ t)) (pow_nonneg hv.le _)
  have hnorm :
      memNormSqOn F S T' (memGhost F S ρ j (memorySym f)) =
        ∑ s ∈ T', memMeasure F S s * ‖∑ t ∈ T, k s t * f t‖ ^ 2 := by
    unfold memNormSqOn
    apply Finset.sum_congr rfl
    intro s hsT'
    by_cases hs : MemValid F S s
    · have hp : memGhost F S ρ j (memorySym f) s = ∑ t ∈ T, k s t * f t := by
        rw [memGhostProjected_finite_kernel F S ρ j B s (hT' s hsT') T f hsupp hT]
        change (∑ t ∈ T, kRaw s t * f t) = _
        apply Finset.sum_congr rfl
        intro t ht
        rw [hkeq s hs t]
      rw [hp]
    · have hz : memMeasure F S s = 0 := by simp [memMeasure, hs]
      rw [hz]
      simp
  rw [hnorm]
  have h := hSchur (memMeasure F S) (fun s => v ^ memSize s) k f T T' C C hμ
    (fun s => pow_pos hv _) hC hC hrowk hcolk
  simpa only [memNormSqOn, pow_two] using h

private theorem memGhostProjected_rowSchur_le_of_params {K : ℕ}
    (F : PDFix K) (hF : F.Valid) (S : PDScale) (ρ : ℝ) (hρ : IsMemoryRho F.q_d ρ)
    (j B : ℕ) (v : ℝ) (hv : 0 < v)
    (hvlarge : 2 / (ρ * (1 - Real.sqrt F.q_d / ρ ^ 2)) ≤ v)
    (hV : ∀ i : Fin K, 0 < bandMass S.x (F.a i))
    (hbp : ∀ p ∈ markedPrimes S.x K F.a,
      (1 / 2 : ℝ) ≤ memoryBPrime S.x F.q_d p) :
    MemRowSchurLE_sym F S B (memGhost F S ρ j) v
      (∏ i : Fin K,
        Real.exp (2 * memoryEta S.x F.q_d j * bandMass S.x (F.a i) * v / ρ)) := by
  classical
  have hρsq : ρ ^ 2 < 1 := by nlinarith [hρ.1, hρ.2.1]
  have hqLt : memoryQ S.x F.q_d j < 1 := by
    unfold memoryQ
    split_ifs <;> [exact lt_trans hρ.2.2 hρsq; exact hF.2.2.1]
  have hη : 0 ≤ memoryEta S.x F.q_d j := by
    unfold memoryEta
    linarith [hqLt]
  have hq : 0 ≤ memoryQ S.x F.q_d j := by
    unfold memoryQ
    split_ifs
    · exact Real.sqrt_nonneg _
    · exact hF.2.1.le
  change MemRowSchurLE F S B
    (fun f => memGhost F S ρ j (memorySym f)) v
    (∏ i : Fin K,
      Real.exp (2 * memoryEta S.x F.q_d j * bandMass S.x (F.a i) * v / ρ))
  intro s hs hsSize T hT
  let choicesType := (i : Fin K) → GhostGroupChoice F s (2 * B) i
  have hν (choices : choicesType) (i : Fin K) (k : Fin (choices i).2.1.1) :
      0 ≤ memoryNu S.x K F.a F.q_d i ((choices i).2.2 k).1 := by
    let p := (choices i).2.2 k
    have hbpPos : 0 < memoryBPrime S.x F.q_d p.1 :=
      lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2)
        (hbp p.1 (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i, p.2⟩))
    have hden : 0 < bandMass S.x (F.a i) * ((p.1 : ℝ) + 1) *
        memoryBPrime S.x F.q_d p.1 :=
      mul_pos (mul_pos (hV i) (by positivity)) hbpPos
    unfold memoryNu
    exact div_nonneg (by norm_num) hden.le
  have hrepr (t : MemPoint S.x K) (ht : t ∈ T) :
      memKernel (fun f => memGhost F S ρ j (memorySym f)) s t =
        ∑ choices : choicesType,
          ghostChoiceKernelTerm F S s t ρ j B choices := by
    exact memGhostProjectedKernel_choiceSum F S ρ j s t B hsSize
      (hT t ht)
  have hpoint (t : MemPoint S.x K) (ht : t ∈ T) :
      ‖memKernel (fun f => memGhost F S ρ j (memorySym f)) s t‖ ≤
        ∑ choices : choicesType, ‖ghostChoiceKernelTerm F S s t ρ j B choices‖ := by
    rw [hrepr t ht]
    exact norm_sum_le (Finset.univ : Finset choicesType)
      (fun choices => ghostChoiceKernelTerm F S s t ρ j B choices)
  have hrow :
      (∑ t ∈ T,
        ‖memKernel (fun f => memGhost F S ρ j (memorySym f)) s t‖ * v ^ memSize t) ≤
        ∑ choices : choicesType,
          ‖((ghostChoiceCoeffReal F S s ρ j (2 * B) choices : ℝ) : ℂ)‖ *
            v ^ memSize (ghostChoicesOutput F s (2 * B) choices) := by
    calc
      _ ≤ ∑ t ∈ T,
            (∑ choices : choicesType,
              ‖ghostChoiceKernelTerm F S s t ρ j B choices‖) * v ^ memSize t := by
        apply Finset.sum_le_sum
        intro t ht
        exact mul_le_mul_of_nonneg_right (hpoint t ht) (pow_nonneg hv.le _)
      _ = ∑ choices : choicesType,
            ∑ t ∈ T,
              ‖ghostChoiceKernelTerm F S s t ρ j B choices‖ * v ^ memSize t := by
        calc
          _ = ∑ t ∈ T,
                ∑ choices : choicesType,
                  ‖ghostChoiceKernelTerm F S s t ρ j B choices‖ * v ^ memSize t := by
            apply Finset.sum_congr rfl
            intro t ht
            simpa using (Finset.sum_mul (Finset.univ : Finset choicesType)
              (fun choices => ‖ghostChoiceKernelTerm F S s t ρ j B choices‖)
              (v ^ memSize t))
          _ = _ := by
            simpa using (Finset.sum_comm (s := T)
              (t := (Finset.univ : Finset choicesType))
              (f := fun t choices =>
                ‖ghostChoiceKernelTerm F S s t ρ j B choices‖ * v ^ memSize t))
      _ ≤ _ := by
        apply Finset.sum_le_sum
        intro choices hchoices
        exact ghostChoiceKernelTerm_row_sum_le F S s ρ j B choices v hv T
  have hrow' :
      (∑ choices : choicesType,
        ‖((ghostChoiceCoeffReal F S s ρ j (2 * B) choices : ℝ) : ℂ)‖ *
          v ^ memSize (ghostChoicesOutput F s (2 * B) choices)) =
        v ^ memSize s *
          ∑ choices : choicesType,
            ∏ i : Fin K, ghostGroupFiniteWeight F s (2 * B) j ρ v i (choices i) := by
    calc
      _ = ∑ choices : choicesType,
            v ^ memSize s *
              ∏ i : Fin K, ghostGroupFiniteWeight F s (2 * B) j ρ v i (choices i) := by
        apply Finset.sum_congr rfl
        intro choices hc
        exact ghostChoiceCoeff_norm_mul_outputWeight_eq F S s (2 * B) j ρ v choices
          hη hq (fun i => (hV i).le) hρ.1 hv (hν choices)
      _ = _ := by rw [Finset.mul_sum]
  calc
    _ ≤ v ^ memSize s *
          ∑ choices : choicesType,
            ∏ i : Fin K, ghostGroupFiniteWeight F s (2 * B) j ρ v i (choices i) := by
      rw [hrow'] at hrow
      exact hrow
    _ ≤ v ^ memSize s *
          ∏ i : Fin K,
            Real.exp (2 * memoryEta S.x F.q_d j * bandMass S.x (F.a i) * v / ρ) := by
      apply mul_le_mul_of_nonneg_left
        (ghost_all_group_choices_le_exp F hF s (2 * B) j ρ hρ v hv hvlarge hV hbp)
      exact pow_nonneg hv.le _
    _ = _ := by ring

private theorem bandMass_pos_of_large_x {K : ℕ} (F : PDFix K) (hF : F.Valid) :
    ∃ x₀ : ℝ, 2 ≤ x₀ ∧ ∀ x : ℝ, x₀ ≤ x → ∀ i : Fin K,
      0 < bandMass x (F.a i) := by
  classical
  let x_i : Fin K → ℝ := fun i =>
    Classical.choose (band_mass (F.a i)
      (lt_trans (by norm_num : (0 : ℝ) < 1 / 10) (hF.1.2.1 i).1)
      (lt_trans (hF.1.2.1 i).2 (by norm_num))
      (Real.log 2) (Real.log_pos (by norm_num)))
  have hx_i : ∀ i : Fin K,
      2 ≤ x_i i ∧ ∀ x : ℝ, x_i i ≤ x →
        |bandMass x (F.a i) - Real.log 2| ≤ Real.log 2 ∧
          0 < bandMass x (F.a i) := by
    intro i
    exact Classical.choose_spec (band_mass (F.a i)
      (lt_trans (by norm_num : (0 : ℝ) < 1 / 10) (hF.1.2.1 i).1)
      (lt_trans (hF.1.2.1 i).2 (by norm_num))
      (Real.log 2) (Real.log_pos (by norm_num)))
  let x₀ : ℝ := 2 + ∑ i : Fin K, x_i i
  have hx₀ : 2 ≤ x₀ := by
    dsimp [x₀]
    have hsum : 0 ≤ ∑ i : Fin K, x_i i :=
      Finset.sum_nonneg fun i hi => by linarith [(hx_i i).1]
    linarith
  refine ⟨x₀, hx₀, ?_⟩
  intro x hx i
  have hsingle : x_i i ≤ ∑ j : Fin K, x_i j :=
    Finset.single_le_sum (s := Finset.univ) (f := x_i)
      (fun j hj => by linarith [(hx_i j).1]) (Finset.mem_univ i)
  have hxi : x_i i ≤ x₀ := by dsimp [x₀]; linarith
  exact ((hx_i i).2 x (le_trans hxi hx)).2

private theorem bandMass_half_log_two_of_large_x {K : ℕ} (F : PDFix K) (hF : F.Valid) :
    ∃ x₀ : ℝ, 2 ≤ x₀ ∧ ∀ x : ℝ, x₀ ≤ x → ∀ i : Fin K,
      Real.log 2 / 2 ≤ bandMass x (F.a i) := by
  classical
  let x_i : Fin K → ℝ := fun i =>
    Classical.choose (band_mass (F.a i)
      (lt_trans (by norm_num : (0 : ℝ) < 1 / 10) (hF.1.2.1 i).1)
      (lt_trans (hF.1.2.1 i).2 (by norm_num))
      (Real.log 2 / 2) (by positivity))
  have hx_i : ∀ i : Fin K,
      2 ≤ x_i i ∧ ∀ x : ℝ, x_i i ≤ x →
        |bandMass x (F.a i) - Real.log 2| ≤ Real.log 2 / 2 ∧
          0 < bandMass x (F.a i) := by
    intro i
    exact Classical.choose_spec (band_mass (F.a i)
      (lt_trans (by norm_num : (0 : ℝ) < 1 / 10) (hF.1.2.1 i).1)
      (lt_trans (hF.1.2.1 i).2 (by norm_num))
      (Real.log 2 / 2) (by positivity))
  let x₀ : ℝ := 2 + ∑ i : Fin K, x_i i
  have hx₀ : 2 ≤ x₀ := by
    dsimp [x₀]
    have hsum : 0 ≤ ∑ i : Fin K, x_i i :=
      Finset.sum_nonneg fun i hi => by linarith [(hx_i i).1]
    linarith
  refine ⟨x₀, hx₀, ?_⟩
  intro x hx i
  have hsingle : x_i i ≤ ∑ j : Fin K, x_i j :=
    Finset.single_le_sum (s := Finset.univ) (f := x_i)
      (fun j hj => by linarith [(hx_i j).1]) (Finset.mem_univ i)
  have hxi : x_i i ≤ x₀ := by dsimp [x₀]; linarith
  have habs := (abs_le.mp ((hx_i i).2 x (le_trans hxi hx)).1)
  linarith

/-- The positive edge choice row is polynomial in the memory cutoff once the
spatial multiplier sum and the normalized prime masses are bounded. -/
private theorem memEdge_positive_choice_row_le {K : ℕ}
    (F : PDFix K) (S : PDScale) (ρ v H Cgeom : ℝ) (w : ArchRoot)
    (j B : ℕ) (s : MemPoint S.x K) (Z : Finset (ℤ × ℤ))
    (hρ : 0 ≤ ρ ∧ ρ ≤ 1) (hv : 1 ≤ v) (hH : 0 ≤ H)
    (hCgeom : 0 ≤ Cgeom) (hsSize : memSize s ≤ B)
    (hV : ∀ i : Fin K, 0 < bandMass S.x (F.a i))
    (hInv : ∀ i : Fin K, (bandMass S.x (F.a i))⁻¹ ≤ H)
    (hν : ∀ i p, p ∈ primeBand S.x (F.a i) →
      0 ≤ memoryNu S.x K F.a F.q_d i p)
    (hMass : ∀ i : Fin K,
      (∑ p ∈ primeBand S.x (F.a i), memoryNu S.x K F.a F.q_d i p) ≤ 2)
    (hgeom : ∀ c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i,
      (∑ z' ∈ Z, if EdgeAdmissible F S w s c z' then
        ‖edgeMultiplier F S (decide (j % 2 = 0)) true s.2.1
          (edgeTargetLists F S s c) s.1 z'‖ +
        ‖edgeMultiplier F S (decide (j % 2 = 0)) false s.2.1
          (edgeTargetLists F S s c) s.1 z'‖ else 0) ≤ Cgeom) :
    (∑ c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i,
      ∑ z' ∈ Z,
        if EdgeAdmissible F S w s c z' then
          |ρ ^ (∑ i : Fin K, hitCount (s.2.2 i) s.1) *
            (∏ i : Fin K, pd5_edgeChoiceMass F S s c i) *
            ρ ^ (∑ i : Fin K, hitCount (edgeNewMemory F S s c i) z')| *
          (‖edgeMultiplier F S (decide (j % 2 = 0)) true s.2.1
            (edgeTargetLists F S s c) s.1 z'‖ +
          ‖edgeMultiplier F S (decide (j % 2 = 0)) false s.2.1
            (edgeTargetLists F S s c) s.1 z'‖) *
          v ^ memSize (z', edgeTargetLists F S s c, edgeNewMemory F S s c)
        else 0) ≤
      Cgeom * (2 * v * ((B : ℝ) * H + 2)) ^ K * v ^ memSize s := by
  classical
  let choices := (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i
  let a (i : Fin K) (ci : EdgeChoice S.x F.a (s.2.2 i) i) : ℝ :=
    match ci.2 with
    | Sum.inl _ => (bandMass S.x (F.a i))⁻¹
    | Sum.inr p => memoryNu S.x K F.a F.q_d i p
  have ha (i : Fin K) (ci : EdgeChoice S.x F.a (s.2.2 i) i) : 0 ≤ a i ci := by
    rcases ci with ⟨b, k | p⟩
    · exact (inv_pos.mpr (hV i)).le
    · exact hν i p p.2
  have hmassEq (c : choices) (i : Fin K) : pd5_edgeChoiceMass F S s c i = a i (c i) := by
    rfl
  let mass (c : choices) : ℝ := ∏ i : Fin K, a i (c i)
  have hmassNonneg (c : choices) : 0 ≤ mass c := Finset.prod_nonneg fun i _ => ha i (c i)
  have hcoeff (c : choices) (z' : ℤ × ℤ) :
      |ρ ^ (∑ i : Fin K, hitCount (s.2.2 i) s.1) *
        (∏ i : Fin K, pd5_edgeChoiceMass F S s c i) *
        ρ ^ (∑ i : Fin K, hitCount (edgeNewMemory F S s c i) z')| ≤ mass c := by
    simp only [hmassEq]
    change |ρ ^ _ * mass c * ρ ^ _| ≤ mass c
    rw [abs_of_nonneg (mul_nonneg (mul_nonneg (pow_nonneg hρ.1 _) (hmassNonneg c))
      (pow_nonneg hρ.1 _))]
    calc
      _ ≤ 1 * mass c * 1 :=
        mul_le_mul
          (mul_le_mul_of_nonneg_right (pow_le_one₀ hρ.1 hρ.2) (hmassNonneg c))
          (pow_le_one₀ hρ.1 hρ.2) (pow_nonneg hρ.1 _)
          (mul_nonneg (by norm_num) (hmassNonneg c))
      _ = mass c := by ring
  have houtSize (c : choices) (z' : ℤ × ℤ) :
      memSize (z', edgeTargetLists F S s c, edgeNewMemory F S s c) ≤ memSize s + K := by
    have hi (i : Fin K) : (edgeNewMemory F S s c i).length ≤ (s.2.2 i).length + 1 := by
      have hremove (D : Finset (Fin (s.2.2 i).length)) :
          (removeIndices (s.2.2 i) D).length ≤ (s.2.2 i).length := by
        rw [removeIndices_length]
        exact Nat.sub_le _ _
      cases hc : (c i).2 with
      | inl k =>
        have hrem := hremove {k}
        cases hb : (c i).1 <;> simp [edgeNewMemory, hc, hb] <;> omega
      | inr p =>
        have hrem := hremove ∅
        cases hb : (c i).1 <;> simp [edgeNewMemory, hc, hb] <;> omega
    have hsum := Finset.sum_le_sum (s := Finset.univ) (fun i _ => hi i)
    simpa [memSize, Finset.sum_add_distrib] using hsum
  have houtWeight (c : choices) (z' : ℤ × ℤ) :
      v ^ memSize (z', edgeTargetLists F S s c, edgeNewMemory F S s c) ≤
        v ^ memSize s * v ^ K := by
    rw [← pow_add]
    exact pow_le_pow_right₀ hv (houtSize c z')
  let geom (c : choices) (z' : ℤ × ℤ) : ℝ :=
    ‖edgeMultiplier F S (decide (j % 2 = 0)) true s.2.1
      (edgeTargetLists F S s c) s.1 z'‖ +
    ‖edgeMultiplier F S (decide (j % 2 = 0)) false s.2.1
      (edgeTargetLists F S s c) s.1 z'‖
  have hgeomNonneg (c : choices) (z' : ℤ × ℤ) : 0 ≤ geom c z' :=
    add_nonneg (norm_nonneg _) (norm_nonneg _)
  have hrow (c : choices) :
      (∑ z' ∈ Z, if EdgeAdmissible F S w s c z' then
        |ρ ^ (∑ i : Fin K, hitCount (s.2.2 i) s.1) *
          (∏ i : Fin K, pd5_edgeChoiceMass F S s c i) *
          ρ ^ (∑ i : Fin K, hitCount (edgeNewMemory F S s c i) z')| *
        geom c z' * v ^ memSize (z', edgeTargetLists F S s c, edgeNewMemory F S s c)
        else 0) ≤ mass c * (v ^ memSize s * v ^ K) * Cgeom := by
    calc
      _ ≤ ∑ z' ∈ Z, mass c * (v ^ memSize s * v ^ K) *
          (if EdgeAdmissible F S w s c z' then geom c z' else 0) := by
        apply Finset.sum_le_sum
        intro z' hz'
        by_cases hadm : EdgeAdmissible F S w s c z'
        · simp only [if_pos hadm]
          calc
            _ ≤ mass c * geom c z' * (v ^ memSize s * v ^ K) :=
              mul_le_mul (mul_le_mul_of_nonneg_right (hcoeff c z') (hgeomNonneg c z'))
                (houtWeight c z') (pow_nonneg (by linarith) _)
                (mul_nonneg (hmassNonneg c) (hgeomNonneg c z'))
            _ = _ := by ring
        · simp [hadm]
      _ = mass c * (v ^ memSize s * v ^ K) *
          ∑ z' ∈ Z, if EdgeAdmissible F S w s c z' then geom c z' else 0 := by
        rw [Finset.mul_sum]
      _ ≤ _ := mul_le_mul_of_nonneg_left (hgeom c)
        (mul_nonneg (hmassNonneg c) (by positivity))
  have hgroup (i : Fin K) :
      (∑ ci : EdgeChoice S.x F.a (s.2.2 i) i, a i ci) ≤ 2 * ((B : ℝ) * H + 2) := by
    have hlen : (s.2.2 i).length ≤ B :=
      (Finset.single_le_sum (fun k _ => Nat.zero_le ((s.2.2 k).length))
        (Finset.mem_univ i)).trans hsSize
    have hlenR : ((s.2.2 i).length : ℝ) ≤ B := by exact_mod_cast hlen
    have hprime :
        (∑ p : primeBand S.x (F.a i), memoryNu S.x K F.a F.q_d i p) =
          ∑ p ∈ primeBand S.x (F.a i), memoryNu S.x K F.a F.q_d i p := by
      exact Finset.sum_coe_sort (primeBand S.x (F.a i))
        (fun p => memoryNu S.x K F.a F.q_d i p)
    have heq : (∑ ci : EdgeChoice S.x F.a (s.2.2 i) i, a i ci) =
        2 * (((s.2.2 i).length : ℝ) * (bandMass S.x (F.a i))⁻¹ +
          ∑ p ∈ primeBand S.x (F.a i), memoryNu S.x K F.a F.q_d i p) := by
      simp [EdgeChoice, a, Fintype.sum_prod_type, Fintype.sum_sum_type,
        hprime, two_mul, mul_add]
    rw [heq]
    have hprom := mul_le_mul hlenR (hInv i) (inv_nonneg.mpr (hV i).le) (by positivity)
    linarith [hMass i]
  have hchoices : (∑ c : choices, mass c) ≤ (2 * ((B : ℝ) * H + 2)) ^ K := by
    dsimp [mass, choices]
    rw [← Fintype.prod_sum a]
    calc
      _ ≤ ∏ i : Fin K, 2 * ((B : ℝ) * H + 2) := by
        apply Finset.prod_le_prod₀
        · intro i _
          exact Finset.sum_nonneg fun ci _ => ha i ci
        · intro i _
          exact hgroup i
      _ = _ := by simp
  calc
    _ ≤ ∑ c : choices, mass c * (v ^ memSize s * v ^ K) * Cgeom :=
      Finset.sum_le_sum fun c _ => hrow c
    _ = (∑ c : choices, mass c) * (v ^ memSize s * v ^ K) * Cgeom := by
      rw [Finset.sum_mul, Finset.sum_mul]
    _ ≤ (2 * ((B : ℝ) * H + 2)) ^ K * (v ^ memSize s * v ^ K) * Cgeom := by
      gcongr
    _ = _ := by rw [mul_pow, mul_pow]; ring

set_option maxHeartbeats 1000000 in
/-- The projected edge row grows polynomially in the memory cutoff, uniformly
in the visit number and the archimedean root. -/
private theorem memEdgeProjected_rowSchur_crude (δ c₁ c₂ : ℝ)
    (hδ : 0 < δ) (hc₁ : 0 < c₁) (K : ℕ) (F : PDFix K) (hF : F.Valid)
    (ρ : ℝ) (hρ : IsMemoryRho F.q_d ρ) (v : ℝ) (hv : 1 < v) :
    ∃ Cedge x₀ : ℝ, 0 < Cedge ∧ 2 ≤ x₀ ∧
      ∀ S : PDScale, S.Valid K δ c₁ c₂ → x₀ ≤ S.x →
        ∀ w : ArchRoot, w.InRegion S → ∀ j : ℕ,
          MemRowSchurLE_sym F S (memoryCutoff S)
            (memEdge F S ρ w EdgeKind.full j) v
            (Cedge * ((memoryCutoff S + 1 : ℕ) : ℝ) ^ K *
              Real.rpow S.L (3 * F.A₀)) := by
  classical
  obtain ⟨Cgeom, xG, hCgeom, hxG, hGeom⟩ :=
    pd5_edge_position_mass_le δ c₁ c₂ hδ hc₁ K F hF
  obtain ⟨xS, hxS, hScale⟩ := pd5_scale_facts K F hF
  let H : ℝ := 2 / Real.log 2
  let Q : ℝ := Fintype.card (Finset (Fin K))
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hH : 0 < H := by dsimp [H]; positivity
  have hQ : 0 < Q := by
    dsimp [Q]
    exact_mod_cast (Fintype.card_pos_iff.mpr ⟨(∅ : Finset (Fin K))⟩)
  let A : ℝ := 2 * v * (H + 2)
  let Cedge : ℝ := 2 * Q ^ 2 * Cgeom * A ^ K
  have hvpos : 0 < v := by linarith
  have hA : 0 < A := by dsimp [A]; positivity
  have hCedge : 0 < Cedge := by dsimp [Cedge]; positivity
  refine ⟨Cedge, max xG xS, hCedge, hxG.trans (le_max_left _ _), ?_⟩
  intro S hS hx w hw j
  have hxG' : xG ≤ S.x := (le_max_left _ _).trans hx
  have hxS' : xS ≤ S.x := (le_max_right _ _).trans hx
  obtain ⟨hL, _, _, _, _, _, _, hBands⟩ := hScale S hxS'
  have hV (i : Fin K) : 0 < bandMass S.x (F.a i) :=
    lt_of_lt_of_le (by positivity : 0 < Real.log 2 / 2) (hBands i).1
  have hInv (i : Fin K) : (bandMass S.x (F.a i))⁻¹ ≤ H := by
    have h := mul_le_mul_of_nonneg_left (hBands i).1 hH.le
    have heq : H * (Real.log 2 / 2) = 1 := by
      dsimp [H]
      field_simp
    apply (inv_le_iff_one_le_mul₀ (hV i)).2
    exact heq.symm.le.trans h
  have hν (i : Fin K) (p : ℕ) (hp : p ∈ primeBand S.x (F.a i)) :
      0 ≤ memoryNu S.x K F.a F.q_d i p := ((hBands i).2.2.2 p hp).1
  have hMass (i : Fin K) :
      (∑ p ∈ primeBand S.x (F.a i), memoryNu S.x K F.a F.q_d i p) ≤ 2 :=
    (hBands i).2.2.1
  let B := memoryCutoff S
  let Lgeom : ℝ := Cgeom * Real.rpow S.L (3 * F.A₀)
  let R : ℝ := Lgeom * (2 * v * ((B : ℝ) * H + 2)) ^ K
  have hLgeom : 0 ≤ Lgeom := by dsimp [Lgeom]; positivity
  have hR : 0 ≤ R := by dsimp [R]; positivity
  have hRbound : R ≤ Cgeom * A ^ K * ((B + 1 : ℕ) : ℝ) ^ K *
      Real.rpow S.L (3 * F.A₀) := by
    have hbase : 2 * v * ((B : ℝ) * H + 2) ≤ A * ((B + 1 : ℕ) : ℝ) := by
      have hsmall : (B : ℝ) * H + 2 ≤ (H + 2) * ((B + 1 : ℕ) : ℝ) := by
        push_cast
        nlinarith only [hH.le, (Nat.cast_nonneg B : (0 : ℝ) ≤ (B : ℝ))]
      calc
        _ ≤ 2 * v * ((H + 2) * ((B + 1 : ℕ) : ℝ)) :=
          mul_le_mul_of_nonneg_left hsmall (by positivity)
        _ = _ := by dsimp [A]; ring
    have hpow := pow_le_pow_left₀ (by positivity : 0 ≤ 2 * v * ((B : ℝ) * H + 2)) hbase K
    calc
      R ≤ Lgeom * (A * ((B + 1 : ℕ) : ℝ)) ^ K :=
        mul_le_mul_of_nonneg_left hpow hLgeom
      _ = _ := by dsimp [Lgeom]; rw [mul_pow]; ring
  let Perms := Fin K → Equiv.Perm (Fin (slotCount S.x))
  let d := permCount S.x K
  have hdpos : 0 < d := by
    dsimp [d, permCount]
    exact Fintype.card_pos_iff.mpr ⟨fun i => Equiv.refl _⟩
  have hdne : (d : ℝ) ≠ 0 := by exact_mod_cast hdpos.ne'
  have hdcard : Fintype.card Perms = d := rfl
  have hnormInv : ‖(d : ℂ)⁻¹‖ = (d : ℝ)⁻¹ := by simp
  change MemRowSchurLE F S B (fun f => memEdge F S ρ w EdgeKind.full j (memorySym f)) v _
  intro s hs hsSize T hT
  let δt (t : MemPoint S.x K) : MemPoint S.x K → ℂ := fun u => if u = t then 1 else 0
  have hSumRow {ι : Type} (U : Finset ι) (k : ι → MemPoint S.x K → ℂ)
      (b : ι → ℝ)
      (hb : ∀ a ∈ U, (∑ t ∈ T, ‖k a t‖ * v ^ memSize t) ≤ b a) :
      (∑ t ∈ T, ‖∑ a ∈ U, k a t‖ * v ^ memSize t) ≤ ∑ a ∈ U, b a := by
    calc
      _ ≤ ∑ t ∈ T, (∑ a ∈ U, ‖k a t‖) * v ^ memSize t := by
        apply Finset.sum_le_sum
        intro t ht
        exact mul_le_mul_of_nonneg_right (norm_sum_le _ _) (pow_nonneg hvpos.le _)
      _ = ∑ a ∈ U, ∑ t ∈ T, ‖k a t‖ * v ^ memSize t := by
        simp_rw [Finset.sum_mul]
        rw [Finset.sum_comm]
      _ ≤ _ := Finset.sum_le_sum hb
  have hAverage (k : Perms → MemPoint S.x K → ℂ) (b : ℝ)
      (hk : ∀ σ : Perms, (∑ t ∈ T, ‖k σ t‖ * v ^ memSize t) ≤ b) :
      (∑ t ∈ T, ‖(d : ℂ)⁻¹ * ∑ σ : Perms, k σ t‖ * v ^ memSize t) ≤ b := by
    calc
      _ = (d : ℝ)⁻¹ * ∑ t ∈ T, ‖∑ σ : Perms, k σ t‖ * v ^ memSize t := by
        simp_rw [norm_mul, hnormInv]
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro t ht
        ring
      _ ≤ (d : ℝ)⁻¹ * ∑ σ : Perms, b := by
        have hsum : (∑ t ∈ T, ‖∑ σ : Perms, k σ t‖ * v ^ memSize t) ≤
            ∑ σ : Perms, b :=
          hSumRow (ι := Perms) (Finset.univ : Finset Perms) k
            (fun _ : Perms => b) (fun σ _ => hk σ)
        exact mul_le_mul_of_nonneg_left hsum (inv_nonneg.mpr (Nat.cast_nonneg d))
      _ = b := by
        simp only [Finset.sum_const, Finset.card_univ, hdcard, nsmul_eq_mul]
        rw [← mul_assoc, inv_mul_cancel₀ hdne, one_mul]
  have hMemoryRow (u : MemPoint S.x K) :
      (∑ t ∈ T, ‖memorySym (δt t) u‖ * v ^ memSize t) ≤ v ^ memSize u := by
    calc
      _ = ∑ t ∈ T, ‖memorySym (δt t) u‖ * v ^ memSize u := by
        apply Finset.sum_congr rfl
        intro t ht
        by_cases hsize : memSize u = memSize t
        · rw [hsize]
        · have hz := memorySym_delta_zero_of_memSize_ne u t hsize
          simp [δt, hz]
      _ = (∑ t ∈ T, ‖memorySym (δt t) u‖) * v ^ memSize u := by rw [Finset.sum_mul]
      _ ≤ 1 * v ^ memSize u :=
        mul_le_mul_of_nonneg_right (memorySym_delta_row_le u T) (pow_nonneg hvpos.le _)
      _ = _ := one_mul _
  let g (t : MemPoint S.x K) : LogPoint S.x K → ℂ :=
    logSym F S (fun uL => memorySym (δt t) uL.1)
  have hgRow (uL : LogPoint S.x K) :
      (∑ t ∈ T, ‖g t uL‖ * v ^ memSize t) ≤ v ^ memSize uL.1 := by
    change (∑ t ∈ T, ‖(d : ℂ)⁻¹ * ∑ σ : Perms,
      memorySym (δt t) (uL.1.1, permuteLists σ uL.1.2.1, uL.1.2.2)‖ * v ^ memSize t) ≤ _
    apply hAverage
    intro σ
    exact hMemoryRow (uL.1.1, permuteLists σ uL.1.2.1, uL.1.2.2)
  have hbox := pd5_envBox_finite_of_valid hS hw
  let Z := hbox.toFinset
  have hPieceRow (r : MemPoint S.x K) (hr : Int.gcd r.1.1 r.1.2 = 1)
      (hrSize : memSize r ≤ B) (raw : Bool) (St Pr : Finset (Fin K)) :
      (∑ t ∈ T, ‖logEdgePiece F S ρ w j raw St Pr (g t) (r, [])‖ * v ^ memSize t) ≤
        R * v ^ memSize r := by
    let Choices := (i : Fin K) → EdgeChoice S.x F.a (r.2.2 i) i
    let out (c : Choices) (z' : ℤ × ℤ) : MemPoint S.x K :=
      (z', edgeTargetLists F S r c, edgeNewMemory F S r c)
    let coeff (c : Choices) (z' : ℤ × ℤ) : ℝ :=
      ρ ^ (∑ i : Fin K, hitCount (r.2.2 i) r.1) *
        (∏ i : Fin K, pd5_edgeChoiceMass F S r c i) *
        ρ ^ (∑ i : Fin K, hitCount (edgeNewMemory F S r c i) z')
    let geom (c : Choices) (z' : ℤ × ℤ) : ℝ :=
      ‖edgeMultiplier F S (decide (j % 2 = 0)) true r.2.1
        (edgeTargetLists F S r c) r.1 z'‖ +
      ‖edgeMultiplier F S (decide (j % 2 = 0)) false r.2.1
        (edgeTargetLists F S r c) r.1 z'‖
    let pos (c : Choices) (z' : ℤ × ℤ) : ℝ :=
      if EdgeAdmissible F S w r c z' then
        |coeff c z'| * geom c z' * v ^ memSize (out c z') else 0
    let term (c : Choices) (z' : ℤ × ℤ) (t : MemPoint S.x K) : ℂ :=
      if edgeStoredSet c = St ∧ edgePromotedSet c = Pr ∧ EdgeAdmissible F S w r c z' then
        (coeff c z' : ℂ) * edgeMultiplier F S (decide (j % 2 = 0)) raw
          r.2.1 (edgeTargetLists F S r c) r.1 z' *
          g t (out c z', edgeBirths F S j r c)
      else 0
    have hpoint (c : Choices) (z' : ℤ × ℤ) :
        (∑ t ∈ T, ‖term c z' t‖ * v ^ memSize t) ≤ pos c z' := by
      by_cases hc : edgeStoredSet c = St ∧ edgePromotedSet c = Pr ∧ EdgeAdmissible F S w r c z'
      · have hmul : ‖edgeMultiplier F S (decide (j % 2 = 0)) raw
            r.2.1 (edgeTargetLists F S r c) r.1 z'‖ ≤ geom c z' := by
          cases raw <;> dsimp [geom] <;> linarith [norm_nonneg
            (edgeMultiplier F S (decide (j % 2 = 0)) true r.2.1
              (edgeTargetLists F S r c) r.1 z'), norm_nonneg
            (edgeMultiplier F S (decide (j % 2 = 0)) false r.2.1
              (edgeTargetLists F S r c) r.1 z')]
        dsimp [term, pos]
        simp only [if_pos hc, if_pos hc.2.2, norm_mul, Complex.norm_real, Real.norm_eq_abs]
        calc
          _ = |coeff c z'| * ‖edgeMultiplier F S (decide (j % 2 = 0)) raw
                r.2.1 (edgeTargetLists F S r c) r.1 z'‖ *
                ∑ t ∈ T, ‖g t (out c z', edgeBirths F S j r c)‖ * v ^ memSize t := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro t ht
            ring
          _ ≤ |coeff c z'| * ‖edgeMultiplier F S (decide (j % 2 = 0)) raw
                r.2.1 (edgeTargetLists F S r c) r.1 z'‖ * v ^ memSize (out c z') :=
            mul_le_mul_of_nonneg_left (hgRow _) (mul_nonneg (abs_nonneg _) (norm_nonneg _))
          _ ≤ _ := mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_left hmul (abs_nonneg _)) (pow_nonneg hvpos.le _)
      · have hzero : (∑ t ∈ T, ‖term c z' t‖ * v ^ memSize t) = 0 := by simp [term, hc]
        rw [hzero]
        dsimp [pos, geom]
        split_ifs <;> positivity
    have hgeomChoice (c : Choices) :
        (∑ z' ∈ Z, if EdgeAdmissible F S w r c z' then geom c z' else 0) ≤ Lgeom := by
      by_cases hex : ∃ z' ∈ Z, EdgeAdmissible F S w r c z'
      · obtain ⟨z', hz', he⟩ := hex
        rcases he with ⟨_, _, _, _, hpad, _, hrBox, _, _, _⟩
        have hD : S.d₀ ≤ sharedProduct r.2.1 := by exact_mod_cast hpad.1
        calc
          _ ≤ ∑ z' ∈ Z, if envBox S w z' ∧ (sharedProduct r.2.1 : ℤ) ∣ det2 r.1 z'
              then geom c z' else 0 := by
            apply Finset.sum_le_sum
            intro z' hz'
            by_cases he : EdgeAdmissible F S w r c z'
            · have hData := he
              rcases hData with ⟨_, _, _, _, hp, _, _, hb, _, _⟩
              simp only [if_pos he, if_pos (And.intro hb hp.2.2)]
              exact le_rfl
            · simp only [if_neg he]
              split_ifs
              · exact add_nonneg (norm_nonneg _) (norm_nonneg _)
              · exact le_rfl
          _ ≤ Lgeom := hGeom S hS hxG' w hw r.1 hr hrBox r.2.1
            (edgeTargetLists F S r c) hD (decide (j % 2 = 0)) Z
      · have hzero : (∑ z' ∈ Z, if EdgeAdmissible F S w r c z' then geom c z' else 0) = 0 := by
          apply Finset.sum_eq_zero
          intro z' hz'
          have he : ¬ EdgeAdmissible F S w r c z' := fun h => hex ⟨z', hz', h⟩
          simp [he]
        rw [hzero]
        exact hLgeom
    calc
      _ = ∑ t ∈ T, ‖∑ c : Choices, ∑ z' ∈ Z, term c z' t‖ * v ^ memSize t := by
        apply Finset.sum_congr rfl
        intro t ht
        rw [pd5_logEdgePiece_finite F S ρ w j raw St Pr (g t) (r, []) hbox]
        rfl
      _ ≤ ∑ c : Choices, ∑ z' ∈ Z, pos c z' :=
        hSumRow (ι := Choices) (Finset.univ : Finset Choices)
          (fun c t => ∑ z' ∈ Z, term c z' t)
          (fun c => ∑ z' ∈ Z, pos c z')
          (fun c _ => hSumRow Z (term c) (pos c) (fun z' _ => hpoint c z'))
      _ ≤ R * v ^ memSize r :=
        memEdge_positive_choice_row_le F S ρ v H Lgeom w j B r Z
          ⟨hρ.1.le, hρ.2.1.le⟩ hv.le hH.le hLgeom hrSize hV hInv hν hMass hgeomChoice
  let pieceSum (r : MemPoint S.x K) (t : MemPoint S.x K) : ℂ :=
    ∑ St : Finset (Fin K), ∑ Pr : Finset (Fin K),
      (logEdgePiece F S ρ w j true St Pr (g t) (r, []) -
        logEdgePiece F S ρ w j false St Pr (g t) (r, []))
  have hPiecesRow (r : MemPoint S.x K) (hr : Int.gcd r.1.1 r.1.2 = 1)
      (hrSize : memSize r ≤ B) :
      (∑ t ∈ T, ‖pieceSum r t‖ * v ^ memSize t) ≤ 2 * Q ^ 2 * R * v ^ memSize r := by
    have hpair (St Pr : Finset (Fin K)) :
        (∑ t ∈ T, ‖logEdgePiece F S ρ w j true St Pr (g t) (r, []) -
          logEdgePiece F S ρ w j false St Pr (g t) (r, [])‖ * v ^ memSize t) ≤
            2 * R * v ^ memSize r := by
      calc
        _ ≤ ∑ t ∈ T, (‖logEdgePiece F S ρ w j true St Pr (g t) (r, [])‖ +
              ‖logEdgePiece F S ρ w j false St Pr (g t) (r, [])‖) * v ^ memSize t := by
          apply Finset.sum_le_sum
          intro t ht
          exact mul_le_mul_of_nonneg_right (norm_sub_le _ _) (pow_nonneg hvpos.le _)
        _ = (∑ t ∈ T, ‖logEdgePiece F S ρ w j true St Pr (g t) (r, [])‖ * v ^ memSize t) +
            ∑ t ∈ T, ‖logEdgePiece F S ρ w j false St Pr (g t) (r, [])‖ * v ^ memSize t := by
          simp_rw [add_mul, Finset.sum_add_distrib]
        _ ≤ R * v ^ memSize r + R * v ^ memSize r :=
          add_le_add (hPieceRow r hr hrSize true St Pr) (hPieceRow r hr hrSize false St Pr)
        _ = _ := by ring
    calc
      _ ≤ ∑ St : Finset (Fin K), ∑ Pr : Finset (Fin K), 2 * R * v ^ memSize r := by
        change (∑ t ∈ T, ‖∑ St : Finset (Fin K), ∑ Pr : Finset (Fin K),
          (logEdgePiece F S ρ w j true St Pr (g t) (r, []) -
            logEdgePiece F S ρ w j false St Pr (g t) (r, []))‖ * v ^ memSize t) ≤ _
        apply hSumRow (ι := Finset (Fin K)) (Finset.univ : Finset (Finset (Fin K)))
        intro St hSt
        exact hSumRow (ι := Finset (Fin K)) (Finset.univ : Finset (Finset (Fin K)))
          (fun Pr t => logEdgePiece F S ρ w j true St Pr (g t) (r, []) -
            logEdgePiece F S ρ w j false St Pr (g t) (r, []))
          (fun _ => 2 * R * v ^ memSize r) (fun Pr _ => hpair St Pr)
      _ = _ := by simp [Q, pow_two]; ring
  have hrowR : (∑ t ∈ T,
      ‖memKernel (fun f => memEdge F S ρ w EdgeKind.full j (memorySym f)) s t‖ * v ^ memSize t) ≤
      2 * Q ^ 2 * R * v ^ memSize s := by
    change (∑ t ∈ T, ‖(d : ℂ)⁻¹ * ∑ σ : Perms,
      pieceSum (s.1, permuteLists σ s.2.1, s.2.2) t‖ * v ^ memSize t) ≤ _
    apply hAverage
    intro σ
    exact hPiecesRow (s.1, permuteLists σ s.2.1, s.2.2) hs.1 hsSize
  calc
    _ ≤ 2 * Q ^ 2 * R * v ^ memSize s := hrowR
    _ ≤ (2 * Q ^ 2 * (Cgeom * A ^ K * ((B + 1 : ℕ) : ℝ) ^ K *
        Real.rpow S.L (3 * F.A₀))) * v ^ memSize s := by
      exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left hRbound (by positivity)) (pow_nonneg hvpos.le _)
    _ = _ := by dsimp [Cedge]; ring

/-- The constant birth twist specializes the frozen edge estimates to the plain edge. -/
private theorem memEdgeProjected_crude_schur (δ c₁ c₂ : ℝ)
    (hδ : 0 < δ) (hc₁ : 0 < c₁) (K : ℕ) (F : PDFix K) (hF : F.Valid)
    (ρ : ℝ) (hρ : IsMemoryRho F.q_d ρ) (v : ℝ) (hv : 1 < v) :
    ∃ Cexp x₀ : ℝ, 0 < Cexp ∧ 2 ≤ x₀ ∧
      ∀ S : PDScale, S.Valid K δ c₁ c₂ → x₀ ≤ S.x →
        ∀ w : ArchRoot, w.InRegion S → ∀ j : ℕ, j < S.N →
          MemRowSchurLE_sym F S (memoryCutoff S)
            (memEdge F S ρ w EdgeKind.full j) v (Real.rpow S.L Cexp) ∧
          MemColSchurLE_sym F S (memoryCutoff S)
            (memEdge F S ρ w EdgeKind.full j) v (Real.rpow S.L Cexp) := by
  obtain ⟨Cexp, x₀, hCexp, hx₀, hEdge⟩ :=
    pd5_twisted_edge_schur δ c₁ c₂ hδ hc₁ K F hF ρ hρ v hv
  refine ⟨Cexp, x₀, hCexp, hx₀, ?_⟩
  intro S hS hx w hw j hj
  have hOp : pd5_edgeBirthTwist F S ρ w j (fun _ => (1 : ℂ)) =
      memEdge F S ρ w EdgeKind.full j := by
    funext f s
    exact congrArg (fun g => logEdge F S ρ w EdgeKind.full j g (s, []))
      (funext fun tL => one_mul (f tL.1))
  rw [← hOp]
  exact hEdge S hS hx w hw j hj (fun _ => (1 : ℂ)) (by intro log; simp)

/-- `t2:pd.ghost-edge-crude` — PD 04:365-435.  REPLACES the frozen `ghost_edge_crude`.  On
`ℋ_B`, with the Schur weight `v₀^{k_tot}`: ghost row and column sums (mem:ghost-row),
(mem:ghost-column) are `≤ C_K` once `v₀` makes both parentheses `≤ 1` (uses `ρ² > √q_d`), so
`‖𝒢_j‖ ≤ C_K` (mem:ghost-norm); edge rows and columns are `≤ C_K B^K (1+L^{3A₀}) ≤ L^{C}`
(mem:edge-crude; columns via the adjoint rules, PD 04:310-348). Correction from refutation lane
`sol-gate-b` states these bounds after symmetric-memory projection. -/
theorem ghost_edge_crude (δ c₁ c₂ : ℝ) (hδ : 0 < δ) (hc₁ : 0 < c₁) :
    ∀ (K : ℕ) (F : PDFix K), F.Valid → ∀ ρ : ℝ, IsMemoryRho F.q_d ρ →
      ∃ v₀ C_K Cexp x₀ : ℝ, 1 < v₀ ∧ 0 < C_K ∧ 0 < Cexp ∧ 2 ≤ x₀ ∧
        ∀ S : PDScale, S.Valid K δ c₁ c₂ → x₀ ≤ S.x →
          ∀ w : ArchRoot, w.InRegion S → ∀ j : ℕ, j ≤ S.N →
            MemRowSchurLE_sym F S (memoryCutoff S) (memGhost F S ρ j) v₀ C_K ∧
            MemColSchurLE_sym F S (memoryCutoff S) (memGhost F S ρ j) v₀ C_K ∧
            MemOpNormLE_sym F S (memoryCutoff S) (memGhost F S ρ j) C_K ∧
            (j < S.N →
              MemRowSchurLE_sym F S (memoryCutoff S) (memEdge F S ρ w EdgeKind.full j) v₀
                (Real.rpow S.L Cexp) ∧
              MemColSchurLE_sym F S (memoryCutoff S) (memEdge F S ρ w EdgeKind.full j) v₀
                  (Real.rpow S.L Cexp)) := by
  intro K F hF ρ hρ
  obtain ⟨xB, hxB, hBPrime⟩ := memoryBPrime_half_of_large_x F hF
  obtain ⟨xV, hxV, hBandMass⟩ := bandMass_le_two_log_two_of_large_x F hF
  obtain ⟨xPos, hxPos, hBandMassPos⟩ := bandMass_pos_of_large_x F hF
  obtain ⟨xMass, hxMass, hBandMassLower⟩ := bandMass_half_log_two_of_large_x F hF
  let g := 1 - Real.sqrt F.q_d / ρ ^ 2
  have hρsqpos : 0 < ρ ^ 2 := sq_pos_of_pos hρ.1
  have hratio : Real.sqrt F.q_d / ρ ^ 2 < 1 :=
    (div_lt_one₀ hρsqpos).2 hρ.2.2
  have hg : 0 < g := by dsimp [g]; linarith
  let vbase := max 2 (2 / (ρ * g))
  let vscale := max 2 (2 * Real.log 2)
  let v₀ := vbase * vscale
  have hvbase2 : 2 ≤ vbase := le_max_left _ _
  have hvscale2 : 2 ≤ vscale := le_max_left _ _
  have hvbasepos : 0 ≤ vbase := by linarith
  have hvscale1 : 1 ≤ vscale := by linarith
  have hv₀ : 1 < v₀ := by
    have hproduct : 4 ≤ vbase * vscale := by
      calc
        4 = (2 : ℝ) * 2 := by norm_num
        _ ≤ vbase * 2 := mul_le_mul_of_nonneg_right hvbase2 (by norm_num)
        _ ≤ vbase * vscale := mul_le_mul_of_nonneg_left hvscale2 hvbasepos
    dsimp [v₀]
    linarith
  have hv₀pos : 0 < v₀ := by linarith
  have hv₀large : 2 / (ρ * (1 - Real.sqrt F.q_d / ρ ^ 2)) ≤ v₀ := by
    calc
      2 / (ρ * (1 - Real.sqrt F.q_d / ρ ^ 2)) = 2 / (ρ * g) := by rfl
      _ ≤ vbase := le_max_right _ _
      _ = vbase * 1 := by ring
      _ ≤ vbase * vscale := mul_le_mul_of_nonneg_left hvscale1 hvbasepos
      _ = v₀ := rfl
  obtain ⟨Cexp, xEdge, hCexp, hxEdge, hEdge⟩ :=
    memEdgeProjected_crude_schur δ c₁ c₂ hδ hc₁ K F hF ρ hρ v₀ hv₀
  let C_K := (Real.exp ((2 + 4 * Real.log 2) * v₀ / ρ)) ^ K
  let x₀ := max (max xB xV) (max xPos (max xMass xEdge))
  have hC_K : 0 < C_K := by
    dsimp [C_K]
    exact pow_pos (Real.exp_pos _) _
  have hx₀ : 2 ≤ x₀ := by
    dsimp [x₀]
    exact le_trans hxB (le_trans (le_max_left _ _) (le_max_left _ _))
  have hxB₀ : xB ≤ x₀ := by
    dsimp [x₀]
    exact le_trans (le_max_left _ _) (le_max_left _ _)
  have hxV₀ : xV ≤ x₀ := by
    dsimp [x₀]
    exact le_trans (le_max_right _ _) (le_max_left _ _)
  have hxPos₀ : xPos ≤ x₀ := by
    dsimp [x₀]
    exact le_trans (le_max_left _ _) (le_max_right _ _)
  have hxMass₀ : xMass ≤ x₀ := by
    dsimp [x₀]
    exact le_trans (le_max_left _ _)
      (le_trans (le_max_right _ _) (le_max_right _ _))
  have hxEdge₀ : xEdge ≤ x₀ := by
    dsimp [x₀]
    exact le_trans (le_max_right _ _)
      (le_trans (le_max_right _ _) (le_max_right _ _))
  have hlogtwo : 0 ≤ Real.log 2 := (Real.log_pos (by norm_num : (1 : ℝ) < 2)).le
  have hηone (x : ℝ) (j : ℕ) : memoryEta x F.q_d j ≤ 1 := by
    have hqj : 0 ≤ memoryQ x F.q_d j := by
      unfold memoryQ
      split_ifs
      · exact Real.sqrt_nonneg _
      · exact hF.2.1.le
    unfold memoryEta
    linarith
  have hExpBound (S : PDScale) (hS : S.Valid K δ c₁ c₂) (hx : x₀ ≤ S.x)
      (j : ℕ) :
      (∏ i : Fin K,
        Real.exp (2 * memoryEta S.x F.q_d j * bandMass S.x (F.a i) * v₀ / ρ)) ≤ C_K := by
    have hxB' : xB ≤ S.x := hxB₀.trans hx
    have hxV' : xV ≤ S.x := hxV₀.trans hx
    have hxPos' : xPos ≤ S.x := hxPos₀.trans hx
    have hmassPos (i : Fin K) : 0 < bandMass S.x (F.a i) :=
      hBandMassPos S.x hxPos' i
    have hmassLe (i : Fin K) : bandMass S.x (F.a i) ≤ 2 * Real.log 2 := by
      exact hBandMass S.x hxV' i
    have heta : memoryEta S.x F.q_d j ≤ 1 := hηone S.x j
    have hfac : 0 ≤ 2 * v₀ / ρ := div_nonneg (by positivity) hρ.1.le
    have hexpArg (i : Fin K) :
        2 * memoryEta S.x F.q_d j * bandMass S.x (F.a i) * v₀ / ρ ≤
          (2 + 4 * Real.log 2) * v₀ / ρ := by
      have hηVraw := mul_le_mul_of_nonneg_right heta (hmassPos i).le
      have hηV : memoryEta S.x F.q_d j * bandMass S.x (F.a i) ≤
          bandMass S.x (F.a i) := by simpa using hηVraw
      have hV := mul_le_mul_of_nonneg_left (hmassLe i) hfac
      calc
        2 * memoryEta S.x F.q_d j * bandMass S.x (F.a i) * v₀ / ρ =
            (2 * v₀ / ρ) *
              (memoryEta S.x F.q_d j * bandMass S.x (F.a i)) := by ring
        _ ≤ (2 * v₀ / ρ) * bandMass S.x (F.a i) :=
          mul_le_mul_of_nonneg_left hηV hfac
        _ ≤ (2 * v₀ / ρ) * (2 * Real.log 2) := hV
        _ = 4 * Real.log 2 * v₀ / ρ := by ring
        _ ≤ 4 * Real.log 2 * v₀ / ρ + 2 * v₀ / ρ :=
          le_add_of_nonneg_right hfac
        _ = (2 + 4 * Real.log 2) * v₀ / ρ := by ring
    calc
      _ ≤ ∏ i : Fin K, Real.exp ((2 + 4 * Real.log 2) * v₀ / ρ) := by
        apply Finset.prod_le_prod₀
        · intro i hi
          exact (Real.exp_pos _).le
        · intro i hi
          exact Real.exp_le_exp.mpr (hexpArg i)
      _ = C_K := by simp [C_K]
  have hmeasure (S : PDScale) (hx : x₀ ≤ S.x) (s : MemPoint S.x K) :
      0 ≤ memMeasure F S s := by
    have hν (i : Fin K) (p : ℕ) (hp : p ∈ primeBand S.x (F.a i)) :
        0 ≤ memoryNu S.x K F.a F.q_d i p := by
      have hbpPos : 0 < memoryBPrime S.x F.q_d p :=
        lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2)
          (hBPrime S.x (hxB₀.trans hx) p
            (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i, hp⟩))
      have hden : 0 < bandMass S.x (F.a i) * ((p : ℝ) + 1) *
          memoryBPrime S.x F.q_d p :=
        mul_pos (mul_pos (hBandMassPos S.x (hxPos₀.trans hx) i) (by positivity)) hbpPos
      exact div_nonneg (by norm_num) hden.le
    by_cases hs : MemValid F S s
    · rw [memMeasure, if_pos hs]
      apply mul_nonneg
      · exact Finset.prod_nonneg fun i hi =>
          Finset.prod_nonneg fun k hk => hν i _ (hs.2.1 i k)
      · apply Finset.prod_nonneg
        intro i hi
        apply div_nonneg
        · exact List.prod_nonneg fun x hx => by
            rcases List.mem_map.mp hx with ⟨e, he, rfl⟩
            exact hν i e.1 (hs.2.2 i e he).1
        · exact Nat.cast_nonneg _
    · simp [memMeasure, hs]
  have hrow (S : PDScale) (hS : S.Valid K δ c₁ c₂) (hx : x₀ ≤ S.x)
      (j : ℕ) :
      MemRowSchurLE_sym F S (memoryCutoff S) (memGhost F S ρ j) v₀ C_K := by
    have hxB' : xB ≤ S.x := hxB₀.trans hx
    have hxPos' : xPos ≤ S.x := hxPos₀.trans hx
    have hmass (i : Fin K) : 0 < bandMass S.x (F.a i) :=
      hBandMassPos S.x hxPos' i
    have hbp (p : ℕ) (hp : p ∈ markedPrimes S.x K F.a) :
        (1 / 2 : ℝ) ≤ memoryBPrime S.x F.q_d p := hBPrime S.x hxB' p hp
    have hparam := memGhostProjected_rowSchur_le_of_params F hF S ρ hρ j
      (memoryCutoff S) v₀ hv₀pos hv₀large hmass hbp
    change MemRowSchurLE F S (memoryCutoff S)
      (fun f => memGhost F S ρ j (memorySym f)) v₀ C_K
    intro s hs hsSize T hT
    calc
      _ ≤ (∏ i : Fin K,
          Real.exp (2 * memoryEta S.x F.q_d j * bandMass S.x (F.a i) * v₀ / ρ)) *
            v₀ ^ memSize s := hparam s hs hsSize T hT
      _ ≤ C_K * v₀ ^ memSize s :=
        mul_le_mul_of_nonneg_right (hExpBound S hS hx j) (pow_nonneg hv₀pos.le _)
  have hcol (S : PDScale) (hS : S.Valid K δ c₁ c₂) (hx : x₀ ≤ S.x)
      (j : ℕ) :
      MemColSchurLE_sym F S (memoryCutoff S) (memGhost F S ρ j) v₀ C_K := by
    have hmass (i : Fin K) : 0 < bandMass S.x (F.a i) :=
      hBandMassPos S.x (hxPos₀.trans hx) i
    have hbp (p : ℕ) (hp : p ∈ markedPrimes S.x K F.a) :
        (1 / 2 : ℝ) ≤ memoryBPrime S.x F.q_d p :=
      hBPrime S.x (hxB₀.trans hx) p hp
    have hvlarge (i : Fin K) :
        2 * bandMass S.x (F.a i) /
          (ρ * (1 - Real.sqrt F.q_d / ρ ^ 2)) ≤ v₀ := by
      have hV : bandMass S.x (F.a i) ≤ vscale :=
        (hBandMass S.x (hxV₀.trans hx) i).trans (le_max_right _ _)
      calc
        _ = (2 / (ρ * g)) * bandMass S.x (F.a i) := by dsimp [g]; ring
        _ ≤ vbase * vscale :=
          mul_le_mul (le_max_right _ _) hV (hmass i).le hvbasepos
        _ = v₀ := rfl
    have hparam := memGhostProjected_colSchur_le_of_params F hF S ρ hρ j
      (memoryCutoff S) v₀ hv₀pos hvlarge hmass hbp
    have hfac : 0 ≤ 2 * v₀ / ρ := div_nonneg (by positivity) hρ.1.le
    have hexpArg : 2 * memoryEta S.x F.q_d j * v₀ / ρ ≤
        (2 + 4 * Real.log 2) * v₀ / ρ := by
      calc
        _ = (2 * v₀ / ρ) * memoryEta S.x F.q_d j := by ring
        _ ≤ 2 * v₀ / ρ := by
          simpa using mul_le_mul_of_nonneg_left (hηone S.x j) hfac
        _ ≤ 2 * v₀ / ρ + 4 * Real.log 2 * v₀ / ρ :=
          le_add_of_nonneg_right
            (div_nonneg (mul_nonneg (mul_nonneg (by norm_num) hlogtwo) hv₀pos.le) hρ.1.le)
        _ = (2 + 4 * Real.log 2) * v₀ / ρ := by ring
    have hExpCol :
        (∏ i : Fin K, Real.exp (2 * memoryEta S.x F.q_d j * v₀ / ρ)) ≤ C_K := by
      calc
        _ ≤ ∏ i : Fin K, Real.exp ((2 + 4 * Real.log 2) * v₀ / ρ) := by
          apply Finset.prod_le_prod₀
          · intro i hi
            exact (Real.exp_pos _).le
          · intro i hi
            exact Real.exp_le_exp.mpr hexpArg
        _ = C_K := by simp [C_K]
    change MemColSchurLE F S (memoryCutoff S)
      (fun f => memGhost F S ρ j (memorySym f)) v₀ C_K
    intro t ht htSize T hT
    calc
      _ ≤ (∏ i : Fin K, Real.exp (2 * memoryEta S.x F.q_d j * v₀ / ρ)) *
          memMeasure F S t * v₀ ^ memSize t := hparam t ht htSize T hT
      _ ≤ C_K * memMeasure F S t * v₀ ^ memSize t :=
        mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_right hExpCol (hmeasure S hx t))
          (pow_nonneg hv₀pos.le _)
  refine ⟨v₀, C_K, Cexp, x₀, hv₀, hC_K, hCexp, hx₀, ?_⟩
  intro S hS hx w hw j hj
  have hrow' := hrow S hS hx j
  have hcol' := hcol S hS hx j
  refine ⟨hrow', hcol', ?_, ?_⟩
  · exact memGhostProjected_norm_of_schur F S ρ j (memoryCutoff S) v₀ C_K
      hv₀pos hC_K.le (hmeasure S hx) hrow' hcol'
  · intro hjlt
    exact hEdge S hS (hxEdge₀.trans hx) w hw j hjlt

/-- `t2:pd.lattice-clean` (a) — PD 04:439-497.  Lattice box at a source passing good test (i):
in the coordinates `(h,l)` of `z' = h z + l D w_z`, the region `|l| ≤ C₁ Y`, `|h + lα| ≤ C₁`
(`α = D τ(w_z)/τ(z)`, from cell separation and the box) is covered, after a unimodular change of
coordinates, by a centered box with sides `A', B'`, `A'B' ≪ Y`, `Y^{0.1} ≤ A',B' ≤ Y^{0.9}`
(mem:lattice-shape).  Pure geometry of numbers: shortest vector `≥ Y^{-0.8}` by test (i),
`≪ Y^{-1/2}` by Dirichlet. -/
private def shearX (α : ℝ) (z : ℤ × ℤ) : ℝ := (z.1 : ℝ) + (z.2 : ℝ) * α

private def shearY (Y : ℝ) (z : ℤ × ℤ) : ℝ := (z.2 : ℝ) / Y

private def shearSize (Y α : ℝ) (z : ℤ × ℤ) : ℝ :=
  max |shearX α z| |shearY Y z|

private theorem circleDistance_le_abs_sub_int (t : ℝ) (z : ℤ) :
    circleDistance t ≤ |t - (z : ℝ)| := by
  unfold circleDistance
  apply csInf_le
  · refine ⟨0, ?_⟩
    rintro y ⟨k, rfl⟩
    exact abs_nonneg _
  · exact ⟨z, rfl⟩

private theorem exists_primitive_shear_vector (Y α : ℝ) (hY : 1 < Y)
    (hbad : ∀ l : ℕ, 1 ≤ l → (l : ℝ) ≤ Real.rpow Y (1 / 5 : ℝ) →
      Real.rpow Y (-(7 / 10 : ℝ)) < circleDistance ((l : ℝ) * α)) :
    ∃ h l : ℤ, Int.gcd h l = 1 ∧
      Real.rpow Y (-(4 / 5 : ℝ)) ≤ shearSize Y α (h, l) ∧
      shearSize Y α (h, l) ≤ 2 / Real.sqrt Y := by
  classical
  have hYpos : 0 < Y := lt_trans zero_lt_one hY
  have hYone : 1 ≤ Y := hY.le
  let s : ℝ := Real.sqrt Y
  have hspos : 0 < s := by dsimp [s]; positivity
  have hsone : 1 ≤ s := by
    dsimp [s]
    exact (Real.one_le_sqrt).2 hYone
  let n : ℕ := ⌈s⌉₊
  have hsle : s ≤ (n : ℝ) := by
    dsimp [n]
    exact Nat.le_ceil _
  have hnpos : 0 < n := by
    have hcast : (1 : ℝ) ≤ (n : ℝ) := le_trans hsone hsle
    exact_mod_cast hcast
  obtain ⟨j, k, hkpos, hkn, happrox⟩ :=
    Real.exists_int_int_abs_mul_sub_le α (n := n) hnpos
  let h : ℤ := -j
  let l : ℤ := k
  have hlpos : 0 < l := by simpa [l] using hkpos
  have hfirst : |shearX α (h, l)| ≤ 1 / s := by
    have hnplus : s ≤ (n : ℝ) + 1 := by linarith [hsle]
    have hrecip : 1 / ((n : ℝ) + 1) ≤ 1 / s := by
      rw [div_le_div_iff₀ (by positivity) hspos]
      linarith
    have happrox' : |(k : ℝ) * α - j| ≤ 1 / ((n : ℝ) + 1) := by
      simpa only [Nat.cast_add, Nat.cast_one] using happrox
    calc
      |shearX α (h, l)| = |(k : ℝ) * α - j| := by
        simp [shearX, h, l, sub_eq_add_neg, add_comm]
      _ ≤ 1 / ((n : ℝ) + 1) := happrox'
      _ ≤ 1 / s := hrecip
  have hknCast : (k : ℝ) ≤ (n : ℝ) := by exact_mod_cast hkn
  have hsquare : s ^ 2 = Y := by dsimp [s]; exact Real.sq_sqrt hYpos.le
  have hsqrtLeY : s ≤ Y := by
    have hYsq : Y ≤ Y ^ 2 := by nlinarith [hY]
    dsimp [s]
    exact Real.sqrt_le_iff.mpr ⟨hYpos.le, hYsq⟩
  have hsecond : |shearY Y (h, l)| ≤ 2 / s := by
    have hkY : (k : ℝ) * s ≤ 2 * Y := by
      have hkn' : (k : ℝ) ≤ s + 1 := hknCast.trans_lt (Nat.ceil_lt_add_one (by positivity)) |>.le
      have hprod := mul_le_mul_of_nonneg_right hkn' hspos.le
      nlinarith [hprod, hsquare, hsqrtLeY]
    have hquot : (k : ℝ) / Y ≤ 2 / s := by
      rw [div_le_div_iff₀ hYpos hspos]
      exact hkY
    simpa [shearY, h, l, abs_of_pos (by positivity : 0 < (k : ℝ) / Y)] using hquot
  have hgpos : 0 < Int.gcd h l := Int.gcd_pos_of_ne_zero_right h hlpos.ne'
  obtain ⟨g, h', l', hg, hgcd, hh, hl⟩ := Int.exists_gcd_one' hgpos
  have hgcast : (1 : ℝ) ≤ (g : ℝ) := by exact_mod_cast (Nat.succ_le_of_lt hg)
  have hscaleX : shearX α (h, l) = (g : ℝ) * shearX α (h', l') := by
    dsimp [shearX]
    rw [hh, hl]
    push_cast
    ring
  have hscaleY : shearY Y (h, l) = (g : ℝ) * shearY Y (h', l') := by
    dsimp [shearY]
    rw [hl]
    push_cast
    ring
  have hgAbs : |(g : ℝ)| = (g : ℝ) := abs_of_nonneg (by positivity)
  have hxnorm : |shearX α (h', l')| ≤ |shearX α (h, l)| := by
    rw [hscaleX, abs_mul, hgAbs]
    nlinarith [mul_nonneg (sub_nonneg.mpr hgcast) (abs_nonneg (shearX α (h', l')))]
  have hynorm : |shearY Y (h', l')| ≤ |shearY Y (h, l)| := by
    rw [hscaleY, abs_mul, hgAbs]
    nlinarith [mul_nonneg (sub_nonneg.mpr hgcast) (abs_nonneg (shearY Y (h', l')))]
  refine ⟨h', l', hgcd, ?_, ?_⟩
  · by_contra hnot
    have hsmall : shearSize Y α (h', l') < Real.rpow Y (-(4 / 5 : ℝ)) := lt_of_not_ge hnot
    have hpowle : Real.rpow Y (-(4 / 5 : ℝ)) ≤ 1 :=
      Real.rpow_le_one_of_one_le_of_nonpos hYone (by norm_num)
    have hsizeone : shearSize Y α (h', l') < 1 := hsmall.trans_le hpowle
    by_cases hlzero : l' = 0
    · have hhsmall : |(h' : ℝ)| < 1 := by
        have hxle : |shearX α (h', l')| ≤ shearSize Y α (h', l') := le_max_left _ _
        simpa [shearX, hlzero] using lt_of_le_of_lt hxle hsizeone
      have hzcast : -1 < (h' : ℝ) ∧ (h' : ℝ) < 1 := abs_lt.mp hhsmall
      have hz : -1 < h' ∧ h' < 1 := by exact_mod_cast hzcast
      have hhzero : h' = 0 := by omega
      simp [hlzero, hhzero] at hgcd
    · have hmpos : 0 < l'.natAbs := Int.natAbs_pos.mpr hlzero
      have hmcast : (l'.natAbs : ℝ) = |(l' : ℝ)| := by
        have h := congrArg (fun z : ℤ => (z : ℝ)) (Int.natCast_natAbs l')
        simpa using h
      have hcoord : |(l' : ℝ)| / Y ≤ shearSize Y α (h', l') := by
        calc
          |(l' : ℝ)| / Y = |shearY Y (h', l')| := by
            simp [shearY, abs_div, abs_of_pos hYpos]
          _ ≤ shearSize Y α (h', l') := le_max_right _ _
      have hsmallcoord : (l'.natAbs : ℝ) / Y < Real.rpow Y (-(4 / 5 : ℝ)) := by
        rw [hmcast]
        exact lt_of_le_of_lt hcoord hsmall
      have hprod : (l'.natAbs : ℝ) ≤ Real.rpow Y (-(4 / 5 : ℝ)) * Y :=
        (div_le_iff₀ hYpos).mp hsmallcoord.le
      have hpowmul : Real.rpow Y (-(4 / 5 : ℝ)) * Y = Real.rpow Y (1 / 5 : ℝ) := by
        calc
          Real.rpow Y (-(4 / 5 : ℝ)) * Y =
              Real.rpow Y (-(4 / 5 : ℝ)) * Real.rpow Y 1 := by
                exact congrArg (fun q : ℝ => Real.rpow Y (-(4 / 5 : ℝ)) * q)
                  (Real.rpow_one Y).symm
          _ = Real.rpow Y (-(4 / 5 : ℝ) + 1) :=
            (Real.rpow_add hYpos (-(4 / 5 : ℝ)) 1).symm
          _ = Real.rpow Y (1 / 5 : ℝ) := by congr 1 <;> norm_num
      have hmBound : (l'.natAbs : ℝ) ≤ Real.rpow Y (1 / 5 : ℝ) := by
        rw [hpowmul] at hprod
        exact hprod
      have hmone : 1 ≤ l'.natAbs := Nat.one_le_iff_ne_zero.mpr (by omega)
      have hdist : circleDistance ((l'.natAbs : ℝ) * α) ≤ |shearX α (h', l')| := by
        have hmcast' : (l'.natAbs : ℝ) = |(l' : ℝ)| := hmcast
        by_cases hlnonneg : 0 ≤ l'
        · have hmcast'' : (l'.natAbs : ℝ) = (l' : ℝ) := by
            rw [hmcast', abs_of_nonneg (by exact_mod_cast hlnonneg)]
          have heq : (l'.natAbs : ℝ) * α - (-(h' : ℝ)) = shearX α (h', l') := by
            simp [shearX, hmcast'']
            ring
          calc
            circleDistance ((l'.natAbs : ℝ) * α) ≤
                |(l'.natAbs : ℝ) * α - (-(h' : ℝ))| :=
                  by simpa only [Int.cast_neg] using circleDistance_le_abs_sub_int _ (-h')
            _ = |shearX α (h', l')| := by rw [heq]
        · have hlneg : (l' : ℝ) < 0 := by exact_mod_cast (lt_of_not_ge hlnonneg)
          have hmcast'' : (l'.natAbs : ℝ) = -(l' : ℝ) := by
            rw [hmcast', abs_of_neg hlneg]
          have heq : (l'.natAbs : ℝ) * α - (h' : ℝ) = -shearX α (h', l') := by
            simp [shearX, hmcast'']
            ring
          calc
            circleDistance ((l'.natAbs : ℝ) * α) ≤
                |(l'.natAbs : ℝ) * α - (h' : ℝ)| := circleDistance_le_abs_sub_int _ h'
            _ = |shearX α (h', l')| := by rw [heq, abs_neg]
      have htest := hbad l'.natAbs hmone hmBound
      have hxle : |shearX α (h', l')| ≤ shearSize Y α (h', l') := le_max_left _ _
      have hpowlt : Real.rpow Y (-(4 / 5 : ℝ)) < Real.rpow Y (-(7 / 10 : ℝ)) :=
        Real.rpow_lt_rpow_of_exponent_lt hY (by norm_num)
      linarith
  · apply max_le
    · exact hxnorm.trans <| hfirst.trans <| by
        have hsplus : 1 / s ≤ 2 / s :=
          div_le_div_of_nonneg_right (by norm_num : (1 : ℝ) ≤ 2) hspos.le
        exact hsplus
    · exact hynorm.trans hsecond

private def intDet (z z' : ℤ × ℤ) : ℤ := z.1 * z'.2 - z.2 * z'.1

private theorem shear_det (Y α : ℝ) (hY : 0 < Y) (z z' : ℤ × ℤ) :
    shearX α z * shearY Y z' - shearY Y z * shearX α z' =
      (intDet z z' : ℝ) / Y := by
  rcases z with ⟨h, l⟩
  rcases z' with ⟨h', l'⟩
  simp only [shearX, shearY, intDet]
  field_simp [hY.ne']
  push_cast
  ring

private theorem bound_det_second (Y lam x₁ y₁ x₂ y₂ : ℝ) (hY : 0 < Y) (hlam : 0 < lam)
    (hdet : x₁ * y₂ - y₁ * x₂ = 1 / Y) (hx₁ : |x₁| = lam) (hy₁ : |y₁| ≤ lam)
    (hx₂ : |x₂| ≤ lam / 2) (hlamsq : lam ^ 2 ≤ 4 / Y) :
    |y₂| ≤ 3 / (Y * lam) := by
  have hlamYsq : lam ^ 2 * Y ≤ 4 := by
    calc
      lam ^ 2 * Y ≤ (4 / Y) * Y := mul_le_mul_of_nonneg_right hlamsq hY.le
      _ = 4 := by field_simp [hY.ne']
  have hrel : x₁ * y₂ = 1 / Y + y₁ * x₂ := by linarith [hdet]
  have hprod : |x₁ * y₂| ≤ 3 / Y := by
    calc
      |x₁ * y₂| = |1 / Y + y₁ * x₂| := by rw [hrel]
      _ ≤ |1 / Y| + |y₁ * x₂| := abs_add_le _ _
      _ = 1 / Y + |y₁| * |x₂| := by rw [abs_of_pos (div_pos one_pos hY), abs_mul]
      _ ≤ 1 / Y + lam * (lam / 2) := by
        gcongr
      _ ≤ 3 / Y := by
        have hsum : 1 / Y + lam ^ 2 / 2 ≤ 3 / Y := by
          rw [le_div_iff₀ hY]
          field_simp [hY.ne']
          nlinarith [hlamYsq]
        nlinarith
  have habs : |y₂| = |x₁ * y₂| / lam := by
    rw [abs_mul, hx₁]
    field_simp [hlam.ne']
  rw [habs]
  calc
    |x₁ * y₂| / lam ≤ (3 / Y) / lam := div_le_div_of_nonneg_right hprod hlam.le
    _ = 3 / (Y * lam) := by field_simp [hY.ne', hlam.ne']

private theorem exists_shear_complement (Y α : ℝ) (z : ℤ × ℤ) (hY : 0 < Y)
    (hprim : Int.gcd z.1 z.2 = 1) (hlampos : 0 < shearSize Y α z)
    (hlamsq : shearSize Y α z ^ 2 ≤ 4 / Y) :
    ∃ z' : ℤ × ℤ, intDet z z' = 1 ∧
      shearSize Y α z' ≤ 3 / (Y * shearSize Y α z) := by
  classical
  let lam : ℝ := shearSize Y α z
  let zbase : ℤ × ℤ := (-Int.gcdB z.1 z.2, Int.gcdA z.1 z.2)
  have hlam : 0 < lam := hlampos
  have hlamsq' : lam ^ 2 ≤ 4 / Y := hlamsq
  have hlamYsq : lam ^ 2 * Y ≤ 4 := by
    calc
      lam ^ 2 * Y ≤ (4 / Y) * Y := mul_le_mul_of_nonneg_right hlamsq' hY.le
      _ = 4 := by field_simp [hY.ne']
  have hlamhalf : lam / 2 ≤ 3 / (Y * lam) := by
    rw [le_div_iff₀ (mul_pos hY hlam)]
    field_simp [hY.ne', hlam.ne']
    nlinarith [hlamYsq]
  have hBez : (Int.gcd z.1 z.2 : ℤ) = z.1 * Int.gcdA z.1 z.2 +
      z.2 * Int.gcdB z.1 z.2 := Int.gcd_eq_gcd_ab _ _
  have hzbase : intDet z zbase = 1 := by
    dsimp [intDet, zbase]
    rw [hprim] at hBez
    calc
      z.1 * Int.gcdA z.1 z.2 - z.2 * -Int.gcdB z.1 z.2 =
          z.1 * Int.gcdA z.1 z.2 + z.2 * Int.gcdB z.1 z.2 := by ring
      _ = 1 := hBez.symm
  let x₁ : ℝ := shearX α z
  let y₁ : ℝ := shearY Y z
  let x₂ : ℝ := shearX α zbase
  let y₂ : ℝ := shearY Y zbase
  by_cases hdom : |x₁| ≥ |y₁|
  · have hx₁ : |x₁| = lam := by
      dsimp [lam, shearSize, x₁, y₁]
      rw [max_eq_left hdom]
    have hy₁ : |y₁| ≤ lam := by
      dsimp [lam, shearSize, x₁, y₁]
      exact le_max_right _ _
    have hx₁ne : x₁ ≠ 0 := abs_ne_zero.mp (by rw [hx₁]; exact hlam.ne')
    let n : ℤ := round (x₂ / x₁)
    let z' : ℤ × ℤ := (zbase.1 - n * z.1, zbase.2 - n * z.2)
    have hz' : intDet z z' = 1 := by
      have hshift : intDet z (zbase.1 - n * z.1, zbase.2 - n * z.2) = intDet z zbase := by
        dsimp [intDet]
        ring
      simpa [z'] using hshift.trans hzbase
    have hx₂' : shearX α z' = x₂ - (n : ℝ) * x₁ := by
      dsimp [shearX, z', x₁, x₂]
      push_cast
      ring
    have hy₂' : shearY Y z' = y₂ - (n : ℝ) * y₁ := by
      dsimp [shearY, z', y₁, y₂]
      push_cast
      ring
    have hround : |x₂ / x₁ - (n : ℝ)| ≤ 1 / 2 := by
      dsimp [n]
      exact abs_sub_round _
    have hrel : x₂ - (n : ℝ) * x₁ = x₁ * (x₂ / x₁ - (n : ℝ)) := by
      field_simp [hx₁ne]
    have hround' : |x₂ / x₁ - (n : ℝ)| ≤ (2 : ℝ)⁻¹ := by
      convert hround using 1 <;> norm_num
    have hx₂small : |shearX α z'| ≤ lam / 2 := by
      rw [hx₂', hrel, abs_mul, hx₁]
      exact mul_le_mul_of_nonneg_left hround' hlam.le
    have hdet : x₁ * y₂ - y₁ * x₂ = 1 / Y := by
      have h := shear_det Y α hY z zbase
      have hdetCast : (intDet z zbase : ℝ) = 1 := by exact_mod_cast hzbase
      change x₁ * y₂ - y₁ * x₂ = (intDet z zbase : ℝ) / Y at h
      rw [hdetCast] at h
      simpa [x₁, y₁, x₂, y₂] using h
    have hdet' : x₁ * shearY Y z' - y₁ * shearX α z' = 1 / Y := by
      have h := shear_det Y α hY z z'
      have hdetCast : (intDet z z' : ℝ) = 1 := by exact_mod_cast hz'
      change x₁ * shearY Y z' - y₁ * shearX α z' = (intDet z z' : ℝ) / Y at h
      rw [hdetCast] at h
      simpa using h
    have hy₂bound := bound_det_second Y lam x₁ y₁ (shearX α z') (shearY Y z')
      hY hlam hdet' hx₁ hy₁ hx₂small hlamsq'
    refine ⟨z', hz', ?_⟩
    dsimp [shearSize]
    exact max_le (hx₂small.trans hlamhalf) hy₂bound
  · have hdom' : |y₁| ≥ |x₁| := le_of_not_ge hdom
    have hy₁eq : |y₁| = lam := by
      dsimp [lam, shearSize, x₁, y₁]
      rw [max_eq_right hdom']
    have hx₁le : |x₁| ≤ lam := by
      dsimp [lam, shearSize, x₁, y₁]
      exact le_max_left _ _
    have hy₁ne : y₁ ≠ 0 := abs_ne_zero.mp (by rw [hy₁eq]; exact hlam.ne')
    let n : ℤ := round (y₂ / y₁)
    let z' : ℤ × ℤ := (zbase.1 - n * z.1, zbase.2 - n * z.2)
    have hz' : intDet z z' = 1 := by
      have hshift : intDet z (zbase.1 - n * z.1, zbase.2 - n * z.2) = intDet z zbase := by
        dsimp [intDet]
        ring
      simpa [z'] using hshift.trans hzbase
    have hx₂' : shearX α z' = x₂ - (n : ℝ) * x₁ := by
      dsimp [shearX, z', x₁, x₂]
      push_cast
      ring
    have hy₂' : shearY Y z' = y₂ - (n : ℝ) * y₁ := by
      dsimp [shearY, z', y₁, y₂]
      push_cast
      ring
    have hround : |y₂ / y₁ - (n : ℝ)| ≤ 1 / 2 := by
      dsimp [n]
      exact abs_sub_round _
    have hrel : y₂ - (n : ℝ) * y₁ = y₁ * (y₂ / y₁ - (n : ℝ)) := by
      field_simp [hy₁ne]
    have hround' : |y₂ / y₁ - (n : ℝ)| ≤ (2 : ℝ)⁻¹ := by
      convert hround using 1 <;> norm_num
    have hy₂small : |shearY Y z'| ≤ lam / 2 := by
      rw [hy₂', hrel, abs_mul, hy₁eq]
      exact mul_le_mul_of_nonneg_left hround' hlam.le
    have hdet : x₁ * y₂ - y₁ * x₂ = 1 / Y := by
      have h := shear_det Y α hY z zbase
      have hdetCast : (intDet z zbase : ℝ) = 1 := by exact_mod_cast hzbase
      change x₁ * y₂ - y₁ * x₂ = (intDet z zbase : ℝ) / Y at h
      rw [hdetCast] at h
      simpa [x₁, y₁, x₂, y₂] using h
    have hdet' : y₁ * (-shearX α z') - x₁ * (-shearY Y z') = 1 / Y := by
      have h := shear_det Y α hY z z'
      have hdetCast : (intDet z z' : ℝ) = 1 := by exact_mod_cast hz'
      change x₁ * shearY Y z' - y₁ * shearX α z' = (intDet z z' : ℝ) / Y at h
      rw [hdetCast] at h
      nlinarith [h]
    have hx₂bound := bound_det_second Y lam y₁ x₁ (-shearY Y z') (-shearX α z')
      hY hlam hdet' hy₁eq hx₁le (by simpa [abs_neg] using hy₂small) hlamsq'
    refine ⟨z', hz', ?_⟩
    dsimp [shearSize]
    have hx₂small : |shearX α z'| ≤ 3 / (Y * lam) := by simpa [abs_neg] using hx₂bound
    have hy₂bound : |shearY Y z'| ≤ 3 / (Y * lam) := hy₂small.trans hlamhalf
    exact max_le hx₂small hy₂bound

set_option maxHeartbeats 500000 in
theorem lattice_shape (C₁ : ℝ) (hC₁ : 1 ≤ C₁) :
    ∃ C₂ Y₀ : ℝ, 0 < C₂ ∧ 1 ≤ Y₀ ∧ ∀ Y : ℝ, Y₀ ≤ Y → ∀ α : ℝ,
      (∀ l : ℕ, 1 ≤ l → (l : ℝ) ≤ Real.rpow Y (1 / 5 : ℝ) →
        Real.rpow Y (-(7 / 10 : ℝ)) < circleDistance ((l : ℝ) * α)) →
      ∃ (a₀ b₀ c₀ d₀ : ℤ) (A' B' : ℝ), a₀ * d₀ - b₀ * c₀ = 1 ∧ A' * B' ≤ C₂ * Y ∧
        Real.rpow Y (1 / 10 : ℝ) ≤ A' ∧ A' ≤ Real.rpow Y (9 / 10 : ℝ) ∧
        Real.rpow Y (1 / 10 : ℝ) ≤ B' ∧ B' ≤ Real.rpow Y (9 / 10 : ℝ) ∧
        ∀ h l : ℤ, |(l : ℝ)| ≤ C₁ * Y → |(h : ℝ) + (l : ℝ) * α| ≤ C₁ →
          |((d₀ * h - b₀ * l : ℤ) : ℝ)| ≤ A' ∧ |((a₀ * l - c₀ * h : ℤ) : ℝ)| ≤ B' := by
  let C₂ : ℝ := 12 * C₁ ^ 2
  let Y₀ : ℝ := (8 * C₁) ^ 10
  have hC₂pos : 0 < C₂ := by dsimp [C₂]; positivity
  have h8C : 1 ≤ 8 * C₁ := by nlinarith [hC₁]
  have hY₀one : 1 ≤ Y₀ := by dsimp [Y₀]; exact one_le_pow₀ h8C
  refine ⟨C₂, Y₀, hC₂pos, hY₀one, ?_⟩
  intro Y hY α hbad
  have h8Cgt : 1 < 8 * C₁ := by nlinarith [hC₁]
  have hY₀gt : 1 < Y₀ := by
    dsimp [Y₀]
    have hpow : (1 : ℝ) ^ 10 < (8 * C₁) ^ 10 := by gcongr
    simpa using hpow
  have hYgt : 1 < Y := lt_of_lt_of_le hY₀gt hY
  have hYpos : 0 < Y := lt_trans zero_lt_one hYgt
  have hYone : 1 ≤ Y := hYgt.le
  have hBasePow : (8 * C₁) ^ 10 ≤ Y := by simpa [Y₀] using hY
  have hRootEq : Real.rpow ((8 * C₁) ^ 10) (1 / 10 : ℝ) = 8 * C₁ := by
    simpa [one_div] using
      (Real.pow_rpow_inv_natCast (by positivity : 0 ≤ 8 * C₁) (by norm_num : 10 ≠ 0))
  have hRoot : 8 * C₁ ≤ Real.rpow Y (1 / 10 : ℝ) := by
    calc
      8 * C₁ = Real.rpow ((8 * C₁) ^ 10) (1 / 10 : ℝ) := hRootEq.symm
      _ ≤ Real.rpow Y (1 / 10 : ℝ) :=
        Real.rpow_le_rpow (by positivity) hBasePow (by norm_num)
  have hRoot4 : 8 * C₁ ≤ Real.rpow Y (2 / 5 : ℝ) := by
    exact hRoot.trans <| Real.rpow_le_rpow_of_exponent_le hYone (by norm_num)
  obtain ⟨a, c, hprim, hLamLow, hLamUp⟩ := exists_primitive_shear_vector Y α hYgt hbad
  let z₁ : ℤ × ℤ := (a, c)
  let lam : ℝ := shearSize Y α z₁
  have hLamPos : 0 < lam := by
    dsimp [lam, z₁]
    exact lt_of_lt_of_le (Real.rpow_pos_of_pos hYpos _) hLamLow
  have hLamsq : lam ^ 2 ≤ 4 / Y := by
    have hdiff : 0 ≤ 2 / Real.sqrt Y - lam := sub_nonneg.mpr (by simpa [lam, z₁] using hLamUp)
    have hsum : 0 ≤ 2 / Real.sqrt Y + lam := by positivity
    have hsq : lam ^ 2 ≤ (2 / Real.sqrt Y) ^ 2 := by
      nlinarith [mul_nonneg hdiff hsum]
    have hsquare : (Real.sqrt Y) ^ 2 = Y := Real.sq_sqrt hYpos.le
    have hsqrtNe : Real.sqrt Y ≠ 0 := (Real.sqrt_ne_zero').2 hYpos
    have hdiv : (2 / Real.sqrt Y) ^ 2 = 4 / Y := by
      field_simp [hsqrtNe, hYpos.ne']
      rw [hsquare]
      ring
    rw [hdiv] at hsq
    exact hsq
  obtain ⟨z₂, hdetZ, hZ₂size⟩ := exists_shear_complement Y α z₁ hYpos hprim
    (by simpa [lam] using hLamPos) (by simpa [lam] using hLamsq)
  have hZ₂coords : |shearX α z₂| ≤ 3 / (Y * lam) ∧
      |shearY Y z₂| ≤ 3 / (Y * lam) := by
    simpa [shearSize, lam] using hZ₂size
  let a₀ : ℤ := z₁.1
  let c₀ : ℤ := z₁.2
  let b₀ : ℤ := z₂.1
  let d₀ : ℤ := z₂.2
  let A' : ℝ := 6 * C₁ / lam
  let B' : ℝ := 2 * C₁ * Y * lam
  have hdetFinal : a₀ * d₀ - b₀ * c₀ = 1 := by
    have h := hdetZ
    simpa [intDet, a₀, b₀, c₀, d₀, z₁, mul_comm] using h
  have hProductEq : A' * B' = C₂ * Y := by
    dsimp [A', B', C₂]
    field_simp [hLamPos.ne']
    ring
  have hSqrtEq : Real.sqrt Y = Real.rpow Y (1 / 2 : ℝ) := Real.sqrt_eq_rpow Y
  have hNegSqrt : (Real.sqrt Y)⁻¹ = Real.rpow Y (-(1 / 2 : ℝ)) := by
    calc
      (Real.sqrt Y)⁻¹ = (Real.rpow Y (1 / 2 : ℝ))⁻¹ := by rw [hSqrtEq]
      _ = Real.rpow Y (-(1 / 2 : ℝ)) := (Real.rpow_neg hYpos.le (1 / 2 : ℝ)).symm
  have hLamUpper : lam ≤ 2 * Real.rpow Y (-(1 / 2 : ℝ)) := by
    calc
      lam ≤ 2 / Real.sqrt Y := by simpa [lam, z₁] using hLamUp
      _ = 2 * (Real.sqrt Y)⁻¹ := by ring
      _ = 2 * Real.rpow Y (-(1 / 2 : ℝ)) := by rw [hNegSqrt]
  have hPowMul (u v : ℝ) :
      Real.rpow Y u * Real.rpow Y v = Real.rpow Y (u + v) :=
    (Real.rpow_add hYpos u v).symm
  have hPowA : Real.rpow Y (9 / 10 : ℝ) * Real.rpow Y (-(4 / 5 : ℝ)) =
      Real.rpow Y (1 / 10 : ℝ) := by
    convert hPowMul (9 / 10 : ℝ) (-(4 / 5 : ℝ)) using 1 <;> norm_num
  have hPowTiny : Real.rpow Y (1 / 10 : ℝ) * Real.rpow Y (-(1 / 2 : ℝ)) =
      Real.rpow Y (-(2 / 5 : ℝ)) := by
    convert hPowMul (1 / 10 : ℝ) (-(1 / 2 : ℝ)) using 1 <;> norm_num
  have hPowB : Real.rpow Y (1 : ℝ) * Real.rpow Y (-(4 / 5 : ℝ)) =
      Real.rpow Y (1 / 5 : ℝ) := by
    convert hPowMul (1 : ℝ) (-(4 / 5 : ℝ)) using 1 <;> norm_num
  have hPowS : Real.rpow Y (2 / 5 : ℝ) * Real.rpow Y (1 / 2 : ℝ) =
      Real.rpow Y (9 / 10 : ℝ) := by
    convert hPowMul (2 / 5 : ℝ) (1 / 2 : ℝ) using 1 <;> norm_num
  have hNegLeOne : Real.rpow Y (-(2 / 5 : ℝ)) ≤ 1 :=
    Real.rpow_le_one_of_one_le_of_nonpos hYone (by norm_num)
  have hAUpper : A' ≤ Real.rpow Y (9 / 10 : ℝ) := by
    dsimp [A']
    apply (div_le_iff₀ hLamPos).2
    calc
      6 * C₁ ≤ Real.rpow Y (1 / 10 : ℝ) := by nlinarith [hRoot]
      _ = Real.rpow Y (9 / 10 : ℝ) * Real.rpow Y (-(4 / 5 : ℝ)) := hPowA.symm
      _ ≤ Real.rpow Y (9 / 10 : ℝ) * lam :=
        mul_le_mul_of_nonneg_left hLamLow (Real.rpow_pos_of_pos hYpos _).le
  have hALower : Real.rpow Y (1 / 10 : ℝ) ≤ A' := by
    dsimp [A']
    apply (le_div_iff₀ hLamPos).2
    have hprod : Real.rpow Y (1 / 10 : ℝ) * lam ≤ 2 := by
      calc
        Real.rpow Y (1 / 10 : ℝ) * lam ≤
            Real.rpow Y (1 / 10 : ℝ) * (2 * Real.rpow Y (-(1 / 2 : ℝ))) :=
          mul_le_mul_of_nonneg_left hLamUpper (Real.rpow_pos_of_pos hYpos _).le
        _ = 2 * Real.rpow Y (-(2 / 5 : ℝ)) := by
          calc
            _ = 2 * (Real.rpow Y (1 / 10 : ℝ) * Real.rpow Y (-(1 / 2 : ℝ))) := by ring
            _ = 2 * Real.rpow Y (-(2 / 5 : ℝ)) := by rw [hPowTiny]
        _ ≤ 2 := by nlinarith [hNegLeOne]
    have hsmall : 2 ≤ 6 * C₁ := by nlinarith [hC₁]
    exact hprod.trans hsmall
  have hYlam : Real.rpow Y (1 / 5 : ℝ) ≤ Y * lam := by
    calc
      Real.rpow Y (1 / 5 : ℝ) = Real.rpow Y 1 * Real.rpow Y (-(4 / 5 : ℝ)) := hPowB.symm
      _ = Y * Real.rpow Y (-(4 / 5 : ℝ)) := by
        exact congrArg (fun x : ℝ => x * Real.rpow Y (-(4 / 5 : ℝ))) (Real.rpow_one Y)
      _ ≤ Y * lam := mul_le_mul_of_nonneg_left hLamLow hYpos.le
  have hBLower : Real.rpow Y (1 / 10 : ℝ) ≤ B' := by
    dsimp [B']
    calc
      Real.rpow Y (1 / 10 : ℝ) ≤ Real.rpow Y (1 / 5 : ℝ) :=
        Real.rpow_le_rpow_of_exponent_le hYone (by norm_num)
      _ ≤ 2 * C₁ * Real.rpow Y (1 / 5 : ℝ) := by
        have hcoef : 0 ≤ 2 * C₁ - 1 := by nlinarith [hC₁]
        have hpow : 0 ≤ Real.rpow Y (1 / 5 : ℝ) :=
          (Real.rpow_pos_of_pos hYpos (1 / 5 : ℝ)).le
        have hmul : 0 ≤ (2 * C₁ - 1) * Real.rpow Y (1 / 5 : ℝ) := mul_nonneg hcoef hpow
        nlinarith [hmul]
      _ ≤ 2 * C₁ * (Y * lam) :=
        mul_le_mul_of_nonneg_left hYlam (by positivity)
      _ = 2 * C₁ * Y * lam := by ring
  have hBUpper : B' ≤ Real.rpow Y (9 / 10 : ℝ) := by
    dsimp [B']
    have hYmulNeg : Y * Real.rpow Y (-(1 / 2 : ℝ)) = Real.rpow Y (1 / 2 : ℝ) := by
      calc
      Y * Real.rpow Y (-(1 / 2 : ℝ)) =
            Real.rpow Y 1 * Real.rpow Y (-(1 / 2 : ℝ)) := by
              exact congrArg (fun x : ℝ => x * Real.rpow Y (-(1 / 2 : ℝ))) (Real.rpow_one Y).symm
        _ = Real.rpow Y (1 / 2 : ℝ) := by
          convert hPowMul (1 : ℝ) (-(1 / 2 : ℝ)) using 1 <;> norm_num
    calc
      2 * C₁ * Y * lam ≤ 2 * C₁ * Y * (2 * Real.rpow Y (-(1 / 2 : ℝ))) := by
        have hmul := mul_le_mul_of_nonneg_left hLamUpper (by positivity : 0 ≤ 2 * C₁ * Y)
        calc
          2 * C₁ * Y * lam = (2 * C₁ * Y) * lam := by ring
          _ ≤ (2 * C₁ * Y) * (2 * Real.rpow Y (-(1 / 2 : ℝ))) := hmul
          _ = 2 * C₁ * Y * (2 * Real.rpow Y (-(1 / 2 : ℝ))) := by ring
      _ = 4 * C₁ * Real.rpow Y (1 / 2 : ℝ) := by
        calc
          2 * C₁ * Y * (2 * Real.rpow Y (-(1 / 2 : ℝ))) =
              4 * C₁ * (Y * Real.rpow Y (-(1 / 2 : ℝ))) := by ring
          _ = 4 * C₁ * Real.rpow Y (1 / 2 : ℝ) := by rw [hYmulNeg]
      _ ≤ Real.rpow Y (2 / 5 : ℝ) * Real.rpow Y (1 / 2 : ℝ) := by
        have h4C : 4 * C₁ ≤ Real.rpow Y (2 / 5 : ℝ) := by linarith [hRoot4, hC₁]
        exact mul_le_mul_of_nonneg_right h4C (Real.rpow_pos_of_pos hYpos (1 / 2 : ℝ)).le
      _ = Real.rpow Y (9 / 10 : ℝ) := hPowS
  have hdetShear : shearX α z₁ * shearY Y z₂ - shearY Y z₁ * shearX α z₂ = 1 / Y := by
    have h := shear_det Y α hYpos z₁ z₂
    have hdetCast : (intDet z₁ z₂ : ℝ) = 1 := by exact_mod_cast hdetZ
    change shearX α z₁ * shearY Y z₂ - shearY Y z₁ * shearX α z₂ =
      (intDet z₁ z₂ : ℝ) / Y at h
    rw [hdetCast] at h
    exact h
  have hZ₁coords : |shearX α z₁| ≤ lam ∧ |shearY Y z₁| ≤ lam := by
    dsimp [lam, shearSize]
    exact ⟨le_max_left _ _, le_max_right _ _⟩
  have hBox : ∀ h l : ℤ, |(l : ℝ)| ≤ C₁ * Y →
      |(h : ℝ) + (l : ℝ) * α| ≤ C₁ →
        |((d₀ * h - b₀ * l : ℤ) : ℝ)| ≤ A' ∧
          |((a₀ * l - c₀ * h : ℤ) : ℝ)| ≤ B' := by
    intro h l hlBound hhBound
    let ξ : ℤ := d₀ * h - b₀ * l
    let η : ℤ := a₀ * l - c₀ * h
    have hcoordH : a₀ * ξ + b₀ * η = h := by
      dsimp [ξ, η]
      linear_combination h * hdetFinal
    have hcoordL : c₀ * ξ + d₀ * η = l := by
      dsimp [ξ, η]
      linear_combination l * hdetFinal
    have hcoordH' : (a₀ : ℝ) * (ξ : ℝ) + (b₀ : ℝ) * (η : ℝ) = (h : ℝ) := by
      exact_mod_cast hcoordH
    have hcoordL' : (c₀ : ℝ) * (ξ : ℝ) + (d₀ : ℝ) * (η : ℝ) = (l : ℝ) := by
      exact_mod_cast hcoordL
    have hXdecomp : shearX α (h, l) =
        (ξ : ℝ) * shearX α z₁ + (η : ℝ) * shearX α z₂ := by
      change (h : ℝ) + (l : ℝ) * α =
        (ξ : ℝ) * ((a₀ : ℝ) + (c₀ : ℝ) * α) +
          (η : ℝ) * ((b₀ : ℝ) + (d₀ : ℝ) * α)
      rw [← hcoordH', ← hcoordL']
      ring
    have hYdecomp : shearY Y (h, l) =
        (ξ : ℝ) * shearY Y z₁ + (η : ℝ) * shearY Y z₂ := by
      change (l : ℝ) / Y =
        (ξ : ℝ) * ((c₀ : ℝ) / Y) + (η : ℝ) * ((d₀ : ℝ) / Y)
      rw [← hcoordL']
      ring
    have hξFormula : (ξ : ℝ) = Y *
        (shearX α (h, l) * shearY Y z₂ - shearY Y (h, l) * shearX α z₂) := by
      rw [hXdecomp, hYdecomp]
      have hlin :
          ((ξ : ℝ) * shearX α z₁ + (η : ℝ) * shearX α z₂) * shearY Y z₂ -
          ((ξ : ℝ) * shearY Y z₁ + (η : ℝ) * shearY Y z₂) * shearX α z₂ =
            (ξ : ℝ) * (shearX α z₁ * shearY Y z₂ - shearY Y z₁ * shearX α z₂) := by ring
      rw [hlin, hdetShear]
      field_simp [hYpos.ne']
    have hηFormula : (η : ℝ) = Y *
        (shearX α z₁ * shearY Y (h, l) - shearY Y z₁ * shearX α (h, l)) := by
      rw [hXdecomp, hYdecomp]
      have hlin :
          shearX α z₁ * ((ξ : ℝ) * shearY Y z₁ + (η : ℝ) * shearY Y z₂) -
          shearY Y z₁ * ((ξ : ℝ) * shearX α z₁ + (η : ℝ) * shearX α z₂) =
            (η : ℝ) * (shearX α z₁ * shearY Y z₂ - shearY Y z₁ * shearX α z₂) := by ring
      rw [hlin, hdetShear]
      field_simp [hYpos.ne']
    have hTargetX : |shearX α (h, l)| ≤ C₁ := by simpa [shearX] using hhBound
    have hC₁nonneg : 0 ≤ C₁ := le_trans (by norm_num : (0 : ℝ) ≤ 1) hC₁
    have hTargetY : |shearY Y (h, l)| ≤ C₁ := by
      change |(l : ℝ) / Y| ≤ C₁
      rw [abs_div, abs_of_pos hYpos]
      exact (div_le_iff₀ hYpos).2 hlBound
    have hDetX : |shearX α (h, l) * shearY Y z₂ -
        shearY Y (h, l) * shearX α z₂| ≤
          C₁ * |shearY Y z₂| + C₁ * |shearX α z₂| := by
      calc
        _ ≤ |shearX α (h, l) * shearY Y z₂| +
            |shearY Y (h, l) * shearX α z₂| := by
          simpa using abs_sub_le (shearX α (h, l) * shearY Y z₂) 0
            (shearY Y (h, l) * shearX α z₂)
        _ = |shearX α (h, l)| * |shearY Y z₂| +
            |shearY Y (h, l)| * |shearX α z₂| := by rw [abs_mul, abs_mul]
        _ ≤ C₁ * |shearY Y z₂| + C₁ * |shearX α z₂| := by
            gcongr
    have hDetY : |shearX α z₁ * shearY Y (h, l) -
        shearY Y z₁ * shearX α (h, l)| ≤
          |shearX α z₁| * C₁ + |shearY Y z₁| * C₁ := by
      calc
        _ ≤ |shearX α z₁ * shearY Y (h, l)| +
            |shearY Y z₁ * shearX α (h, l)| := by
          simpa using abs_sub_le (shearX α z₁ * shearY Y (h, l)) 0
            (shearY Y z₁ * shearX α (h, l))
        _ = |shearX α z₁| * |shearY Y (h, l)| +
            |shearY Y z₁| * |shearX α (h, l)| := by rw [abs_mul, abs_mul]
        _ ≤ |shearX α z₁| * C₁ + |shearY Y z₁| * C₁ := by
            gcongr
    have hξBound : |(ξ : ℝ)| ≤ A' := by
      rw [hξFormula, abs_mul, abs_of_pos hYpos]
      calc
        Y * |shearX α (h, l) * shearY Y z₂ -
            shearY Y (h, l) * shearX α z₂| ≤
            Y * (C₁ * |shearY Y z₂| + C₁ * |shearX α z₂|) :=
          mul_le_mul_of_nonneg_left hDetX hYpos.le
        _ ≤ Y * (C₁ * (3 / (Y * lam)) + C₁ * (3 / (Y * lam))) := by
          apply mul_le_mul_of_nonneg_left
          · exact add_le_add
              (mul_le_mul_of_nonneg_left hZ₂coords.2 hC₁nonneg)
              (mul_le_mul_of_nonneg_left hZ₂coords.1 hC₁nonneg)
          · exact hYpos.le
        _ = A' := by dsimp [A']; field_simp [hYpos.ne', hLamPos.ne']; ring
    have hηBound : |(η : ℝ)| ≤ B' := by
      rw [hηFormula, abs_mul, abs_of_pos hYpos]
      calc
        Y * |shearX α z₁ * shearY Y (h, l) -
            shearY Y z₁ * shearX α (h, l)| ≤
            Y * (|shearX α z₁| * C₁ + |shearY Y z₁| * C₁) :=
          mul_le_mul_of_nonneg_left hDetY hYpos.le
        _ ≤ Y * (lam * C₁ + lam * C₁) := by
          apply mul_le_mul_of_nonneg_left
          · exact add_le_add
              (mul_le_mul_of_nonneg_right hZ₁coords.1 hC₁nonneg)
              (mul_le_mul_of_nonneg_right hZ₁coords.2 hC₁nonneg)
          · exact hYpos.le
        _ = B' := by dsimp [B']; ring
    exact ⟨by simpa [ξ] using hξBound, by simpa [η] using hηBound⟩
  have hproduct : A' * B' ≤ C₂ * Y := by
    exact hProductEq.le
  exact ⟨a₀, b₀, c₀, d₀, A', B', hdetFinal, hproduct,
    hALower, hAUpper, hBLower, hBUpper, hBox⟩

private theorem permuteLists_valid {K : ℕ} (x : ℝ) (a : Fin K → ℝ)
    (p : PrimeLists x K) (σ : Fin K → Equiv.Perm (Fin (slotCount x)))
    (hp : ValidPrimeLists x K a p) : ValidPrimeLists x K a (permuteLists σ p) := by
  constructor
  · intro i j
    exact hp.1 i (σ i j)
  · intro i j j' hj
    exact hp.2 i (σ i j) (σ i j') (fun h => hj ((σ i).injective h))

private theorem removeIndices_mem_source {l : List Particle}
    {D : Finset (Fin l.length)} {e : Particle} (he : e ∈ removeIndices l D) : e ∈ l := by
  unfold removeIndices at he
  rw [List.mem_filterMap] at he
  obtain ⟨k, hk, hmap⟩ := he
  have hklt : k.val < l.length := by simpa using List.mem_finRange.mp hk
  have hknot : k ∉ D := by
    intro hD
    simp [hD] at hmap
  have hget : l.get k = e := by simpa [hknot] using hmap
  rw [← hget]
  exact List.get_mem l k

private theorem anchorAt_valid {K : ℕ} (F : PDFix K) (S : PDScale)
    (i : Fin K) (p : ℕ) (z : ℤ × ℤ)
    (hp : p ∈ primeBand S.x (F.a i)) :
    (anchorAt p z).1 ∈ primeBand S.x (F.a i) ∧
      (anchorAt p z).2 ≤ (anchorAt p z).1 := by
  exact ⟨hp, Nat.le_of_lt_succ (projLine p z).isLt⟩

private theorem edgeNewMemory_preserves_valid {K : ℕ} (F : PDFix K) (S : PDScale)
    (s : MemPoint S.x K) (c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i)
    (w : ArchRoot) (z' : ℤ × ℤ) (hs : MemValid F S s)
    (hadm : EdgeAdmissible F S w s c z') :
    MemValid F S (z', (edgeTargetLists F S s c, edgeNewMemory F S s c)) := by
  rcases hs with ⟨_, _, hsourceMemory⟩
  rcases hadm with ⟨_, hsourceLists, htargetLists, _, _, hprimitive, _, _, _, _⟩
  refine ⟨hprimitive, ?_, ?_⟩
  · intro i j
    exact (htargetLists.1 i j).2
  · intro i e he
    change e ∈ removeIndices (s.2.2 i)
      (match (c i).2 with
        | Sum.inl k => {k}
        | Sum.inr _ => ∅) ++
        (if (c i).1 then [anchorAt (s.2.1 i (lastSlot S.x)) s.1] else []) at he
    rw [List.mem_append] at he
    rcases he with hold | hnew
    · exact hsourceMemory i e (removeIndices_mem_source hold)
    · by_cases hstore : (c i).1
      · simp only [if_pos hstore, List.mem_singleton] at hnew
        subst e
        refine ⟨(hsourceLists.1 i (lastSlot S.x)).2, ?_⟩
        exact Nat.le_of_lt_succ (projLine _ _).isLt
      · simp [hstore] at hnew

private theorem ghostMemory_preserves_valid {K : ℕ} (F : PDFix K) (S : PDScale)
    (s : MemPoint S.x K) (hs : MemValid F S s)
    (D : (i : Fin K) → Finset (Fin (s.2.2 i).length)) (l : Fin K → ℕ)
    (new : (i : Fin K) → Fin (l i) → primeBand S.x (F.a i)) :
    MemValid F S
      (s.1, (s.2.1, fun i => removeIndices (s.2.2 i) (D i) ++
        List.ofFn fun k => anchorAt (new i k) s.1)) := by
  rcases hs with ⟨hprimitive, hlists, hmemory⟩
  refine ⟨hprimitive, hlists, ?_⟩
  intro i e he
  change e ∈ removeIndices (s.2.2 i) (D i) ++
    List.ofFn fun k => anchorAt (new i k) s.1 at he
  rw [List.mem_append] at he
  rcases he with hold | hnew
  · exact hmemory i e (removeIndices_mem_source hold)
  · obtain ⟨k, hk⟩ := List.mem_ofFn.mp hnew
    rw [← hk]
    exact anchorAt_valid F S i (new i k) s.1 (new i k).property

private theorem memPoint_permute_valid {K : ℕ} (F : PDFix K) (S : PDScale)
    (σ : Fin K → Equiv.Perm (Fin (slotCount S.x))) (s : MemPoint S.x K)
    (hs : MemValid F S s) :
    MemValid F S (s.1, (permuteLists σ s.2.1, s.2.2)) := by
  rcases hs with ⟨hprimitive, hlists, hmemory⟩
  refine ⟨hprimitive, ?_, hmemory⟩
  intro i j
  exact hlists i (σ i j)

private theorem logSym_eqOnMemValid {K : ℕ} (F : PDFix K) (S : PDScale)
    (f g : LogPoint S.x K → ℂ)
    (hfg : ∀ σL, MemValid F S σL.1 → f σL = g σL)
    (σL : LogPoint S.x K) (hσL : MemValid F S σL.1) :
    logSym F S f σL = logSym F S g σL := by
  unfold logSym
  congr 1
  apply Finset.sum_congr rfl
  intro σ hσ
  exact hfg ((σL.1.1, (permuteLists σ σL.1.2.1, σL.1.2.2)), σL.2)
    (memPoint_permute_valid F S σ σL.1 hσL)

private theorem logGhost_eqOnMemValid {K : ℕ} (F : PDFix K) (S : PDScale)
    (ρ : ℝ) (j : ℕ) (f g : LogPoint S.x K → ℂ)
    (hfg : ∀ σL, MemValid F S σL.1 → f σL = g σL)
    (σL : LogPoint S.x K) (hσL : MemValid F S σL.1) :
    logGhost F S ρ j f σL = logGhost F S ρ j g σL := by
  classical
  simp only [logGhost]
  apply Finset.sum_congr rfl
  intro D hD
  apply tsum_congr
  intro l
  apply Finset.sum_congr rfl
  intro new hnew
  by_cases hsubset : ∀ i, D i ⊆ hitIndices (σL.1.2.2 i) σL.1.1
  · have hout := ghostMemory_preserves_valid F S σL.1 hσL D l new
    simp only [if_pos hsubset]
    rw [hfg ((σL.1.1, (σL.1.2.1, fun i =>
      removeIndices (σL.1.2.2 i) (D i) ++
        List.ofFn fun k => anchorAt (new i k) σL.1.1)),
      σL.2 ++ (List.finRange K).flatMap fun i =>
        List.ofFn fun k : Fin (l i) =>
          (BirthAddress.ghost j i k.val, ((new i k : ℕ)))) hout]
  · simp [hsubset]

private theorem logEdgePiece_eqOnMemValid {K : ℕ} (F : PDFix K) (S : PDScale)
    (ρ : ℝ) (w : ArchRoot) (step : ℕ) (raw : Bool) (St Pr : Finset (Fin K))
    (f g : LogPoint S.x K → ℂ)
    (hfg : ∀ σL, MemValid F S σL.1 → f σL = g σL)
    (σL : LogPoint S.x K) (hσL : MemValid F S σL.1) :
    logEdgePiece F S ρ w step raw St Pr f σL =
      logEdgePiece F S ρ w step raw St Pr g σL := by
  classical
  dsimp only [logEdgePiece]
  apply Finset.sum_congr rfl
  intro c hc
  apply tsum_congr
  intro z'
  by_cases hcond : edgeStoredSet c = St ∧ edgePromotedSet c = Pr ∧
      EdgeAdmissible F S w σL.1 c z'
  · simp only [if_pos hcond]
    have hout := edgeNewMemory_preserves_valid F S σL.1 c w z' hσL hcond.2.2
    rw [hfg ((z', (edgeTargetLists F S σL.1 c, edgeNewMemory F S σL.1 c)),
      σL.2 ++ edgeBirths F S step σL.1 c) hout]
  · simp [hcond]

private theorem logEdge_eqOnMemValid {K : ℕ} (F : PDFix K) (S : PDScale)
    (ρ : ℝ) (w : ArchRoot) (kind : EdgeKind) (step : ℕ)
    (f g : LogPoint S.x K → ℂ)
    (hfg : ∀ σL, MemValid F S σL.1 → f σL = g σL)
    (σL : LogPoint S.x K) (hσL : MemValid F S σL.1) :
    logEdge F S ρ w kind step f σL = logEdge F S ρ w kind step g σL := by
  classical
  cases kind with
  | full =>
      dsimp only [logEdge]
      apply logSym_eqOnMemValid F S _ _ ?_ σL hσL
      intro τ hτ
      have hsym (u : LogPoint S.x K) (hu : MemValid F S u.1) :
          logSym F S f u = logSym F S g u :=
        logSym_eqOnMemValid F S f g hfg u hu
      apply Finset.sum_congr rfl
      intro St hSt
      apply Finset.sum_congr rfl
      intro Pr hPr
      rw [logEdgePiece_eqOnMemValid F S ρ w step true St Pr
            (logSym F S f) (logSym F S g) hsym τ hτ,
          logEdgePiece_eqOnMemValid F S ρ w step false St Pr
            (logSym F S f) (logSym F S g) hsym τ hτ]
  | clean =>
      dsimp only [logEdge]
      apply logSym_eqOnMemValid F S _ _ ?_ σL hσL
      intro τ hτ
      have hsym (u : LogPoint S.x K) (hu : MemValid F S u.1) :
          logSym F S f u = logSym F S g u :=
        logSym_eqOnMemValid F S f g hfg u hu
      rw [logEdgePiece_eqOnMemValid F S ρ w step true ∅ ∅
            (logSym F S f) (logSym F S g) hsym τ hτ,
          logEdgePiece_eqOnMemValid F S ρ w step false ∅ ∅
            (logSym F S f) (logSym F S g) hsym τ hτ]
  | dirtyRaw =>
      dsimp only [logEdge]
      apply logSym_eqOnMemValid F S _ _ ?_ σL hσL
      intro τ hτ
      have hsym (u : LogPoint S.x K) (hu : MemValid F S u.1) :
          logSym F S f u = logSym F S g u :=
        logSym_eqOnMemValid F S f g hfg u hu
      apply Finset.sum_congr rfl
      intro St hSt
      apply Finset.sum_congr rfl
      intro Pr hPr
      by_cases hempty : St = ∅ ∧ Pr = ∅
      · simp [hempty]
      · simp [hempty, logEdgePiece_eqOnMemValid F S ρ w step true St Pr
          (logSym F S f) (logSym F S g) hsym τ hτ]
  | dirtyCmp =>
      dsimp only [logEdge]
      apply logSym_eqOnMemValid F S _ _ ?_ σL hσL
      intro τ hτ
      have hsym (u : LogPoint S.x K) (hu : MemValid F S u.1) :
          logSym F S f u = logSym F S g u :=
        logSym_eqOnMemValid F S f g hfg u hu
      apply Finset.sum_congr rfl
      intro St hSt
      apply Finset.sum_congr rfl
      intro Pr hPr
      by_cases hempty : St = ∅ ∧ Pr = ∅
      · simp [hempty]
      · simp [hempty, logEdgePiece_eqOnMemValid F S ρ w step false St Pr
          (logSym F S f) (logSym F S g) hsym τ hτ]

private theorem memGhost_eqOnMemValid {K : ℕ} (F : PDFix K) (S : PDScale)
    (ρ : ℝ) (j : ℕ) (f g : MemPoint S.x K → ℂ)
    (hfg : ∀ s, MemValid F S s → f s = g s)
    (s : MemPoint S.x K) (hs : MemValid F S s) :
    memGhost F S ρ j f s = memGhost F S ρ j g s := by
  unfold memGhost plainOp
  exact logGhost_eqOnMemValid F S ρ j (fun σL => f σL.1) (fun σL => g σL.1)
    (fun σL hσL => hfg σL.1 hσL) (s, []) hs

private theorem memEdgePiece_eqOnMemValid {K : ℕ} (F : PDFix K) (S : PDScale)
    (ρ : ℝ) (w : ArchRoot) (raw : Bool) (St Pr : Finset (Fin K)) (j : ℕ)
    (f g : MemPoint S.x K → ℂ)
    (hfg : ∀ s, MemValid F S s → f s = g s)
    (s : MemPoint S.x K) (hs : MemValid F S s) :
    memEdgePiece F S ρ w raw St Pr j f s = memEdgePiece F S ρ w raw St Pr j g s := by
  unfold memEdgePiece plainOp
  apply logSym_eqOnMemValid F S _ _ ?_ (s, []) hs
  intro σL hσL
  apply logEdgePiece_eqOnMemValid F S ρ w j raw St Pr _ _ ?_ σL hσL
  intro τ hτ
  exact logSym_eqOnMemValid F S _ _ (fun u hu => hfg u.1 hu) τ hτ

private theorem memEdge_eqOnMemValid {K : ℕ} (F : PDFix K) (S : PDScale)
    (ρ : ℝ) (w : ArchRoot) (kind : EdgeKind) (j : ℕ)
    (f g : MemPoint S.x K → ℂ)
    (hfg : ∀ s, MemValid F S s → f s = g s)
    (s : MemPoint S.x K) (hs : MemValid F S s) :
    memEdge F S ρ w kind j f s = memEdge F S ρ w kind j g s := by
  unfold memEdge plainOp
  exact logEdge_eqOnMemValid F S ρ w kind j (fun σL => f σL.1) (fun σL => g σL.1)
    (fun σL hσL => hfg σL.1 hσL) (s, []) hs

private theorem memMeasure_eq_zero_of_invalid {K : ℕ} (F : PDFix K) (S : PDScale)
    (s : MemPoint S.x K) (hs : ¬ MemValid F S s) : memMeasure F S s = 0 := by
  simp [memMeasure, hs]

private theorem memEdge_zero_for_valid_supported_input {K : ℕ} (F : PDFix K) (S : PDScale)
    (ρ : ℝ) (w : ArchRoot) (kind : EdgeKind) (j : ℕ)
    (f : MemPoint S.x K → ℂ)
    (hf : ∀ s, MemValid F S s → f s = 0)
    (s : MemPoint S.x K) (hs : MemValid F S s) :
    memEdge F S ρ w kind j f s = 0 := by
  have heq := memEdge_eqOnMemValid F S ρ w kind j f (fun _ => 0) hf s hs
  rw [heq]
  cases kind <;> simp [memEdge, plainOp, logEdge, logSym, logEdgePiece]

private theorem memEdgePiece_zero_for_valid_supported_input {K : ℕ} (F : PDFix K)
    (S : PDScale) (ρ : ℝ) (w : ArchRoot) (raw : Bool) (St Pr : Finset (Fin K))
    (j : ℕ) (f : MemPoint S.x K → ℂ)
    (hf : ∀ s, MemValid F S s → f s = 0)
    (s : MemPoint S.x K) (hs : MemValid F S s) :
    memEdgePiece F S ρ w raw St Pr j f s = 0 := by
  have heq := memEdgePiece_eqOnMemValid F S ρ w raw St Pr j f (fun _ => 0) hf s hs
  rw [heq]
  simp [memEdgePiece, plainOp, logSym, logEdgePiece]

private theorem memGhost_zero_for_valid_supported_input {K : ℕ} (F : PDFix K) (S : PDScale)
    (ρ : ℝ) (j : ℕ) (f : MemPoint S.x K → ℂ)
    (hf : ∀ s, MemValid F S s → f s = 0)
    (s : MemPoint S.x K) (hs : MemValid F S s) :
    memGhost F S ρ j f s = 0 := by
  have heq := memGhost_eqOnMemValid F S ρ j f (fun _ => 0) hf s hs
  rw [heq]
  simp [memGhost, plainOp, logGhost]

private theorem memEdge_delta_invalid_source_zero {K : ℕ} (F : PDFix K) (S : PDScale)
    (ρ : ℝ) (w : ArchRoot) (kind : EdgeKind) (j : ℕ)
    (s t : MemPoint S.x K) (hs : ¬ MemValid F S s) (ht : MemValid F S t) :
    memEdge F S ρ w kind j (fun u => if u = s then 1 else 0) t = 0 := by
  apply memEdge_zero_for_valid_supported_input F S ρ w kind j _ _ t ht
  intro u hu
  by_cases heq : u = s
  · subst u
    exact (hs hu).elim
  · simp [heq]

private theorem memEdgePiece_delta_invalid_source_zero {K : ℕ} (F : PDFix K)
    (S : PDScale) (ρ : ℝ) (w : ArchRoot) (raw : Bool) (St Pr : Finset (Fin K))
    (j : ℕ) (s t : MemPoint S.x K)
    (hs : ¬ MemValid F S s) (ht : MemValid F S t) :
    memEdgePiece F S ρ w raw St Pr j (fun u => if u = s then 1 else 0) t = 0 := by
  apply memEdgePiece_zero_for_valid_supported_input F S ρ w raw St Pr j _ _ t ht
  intro u hu
  by_cases heq : u = s
  · subst u
    exact (hs hu).elim
  · simp [heq]

private theorem memGhost_delta_invalid_source_zero {K : ℕ} (F : PDFix K) (S : PDScale)
    (ρ : ℝ) (j : ℕ) (s t : MemPoint S.x K)
    (hs : ¬ MemValid F S s) (ht : MemValid F S t) :
    memGhost F S ρ j (fun u => if u = s then 1 else 0) t = 0 := by
  apply memGhost_zero_for_valid_supported_input F S ρ j _ _ t ht
  intro u hu
  by_cases heq : u = s
  · subst u
    exact (hs hu).elim
  · simp [heq]

set_option maxHeartbeats 500000 in
private theorem envBox_coordinate_bounds {K : ℕ} (δ c₁ c₂ : ℝ)
    (S : PDScale) (w : ArchRoot) (z : ℤ × ℤ)
    (hS : S.Valid K δ c₁ c₂) (hw : w.InRegion S) (hz : envBox S w z) :
    |(z.1 : ℝ)| ≤ 16 + 544 * S.U * S.V ∧
      |(z.2 : ℝ)| ≤ 544 * S.U * S.V := by
  rcases hS with ⟨hx, hHm, hHn, hprodL, hprodU, hY, hd₀⟩
  rcases hw with ⟨huL, huU, hvL, hvU, hrL, hrU⟩
  rcases hz with ⟨hz₁L, hz₁U, hz₂L, hz₂U⟩
  have hxpos : 0 < S.x := by linarith
  have hHmpos : 0 < S.Hm := lt_of_lt_of_le (Real.rpow_pos_of_pos hxpos _) hHm
  have hHnpos : 0 < S.Hn := lt_of_lt_of_le (Real.rpow_pos_of_pos hxpos _) hHn
  rcases Finset.mem_filter.mp hY with ⟨hYimg, hYbounds⟩
  obtain ⟨kY, hkY, hYeq⟩ := Finset.mem_image.mp hYimg
  have hYpos : 0 < S.Y := by rw [← hYeq]; positivity
  obtain ⟨kd, hkd, hd₀eq⟩ := Finset.mem_image.mp hd₀
  have hd₀pos : 0 < (S.d₀ : ℝ) := by rw [← hd₀eq]; positivity
  have hUpos : 0 < S.U := by
    dsimp [PDScale.U, PDScale.H]
    positivity
  have hVpos : 0 < S.V := by simpa [PDScale.V] using hHnpos
  have huPos : 0 < w.u := lt_of_lt_of_le hUpos huL
  let τ := w.tau z
  have hτpos : 0 < τ := by
    have hmul : 0 < w.u * τ := lt_of_lt_of_le hUpos hz₁L
    exact (mul_pos_iff_of_pos_left huPos).mp hmul
  have hτL : (1 / 16 : ℝ) ≤ τ := by
    have hmul := mul_le_mul_of_nonneg_right huU hτpos.le
    have htotal : S.U ≤ (16 * S.U) * τ := by nlinarith [hz₁L, hmul]
    have hdiv : S.U / (16 * S.U) ≤ τ :=
      (div_le_iff₀ (by positivity : 0 < 16 * S.U)).2 (by nlinarith [htotal])
    have hfrac : S.U / (16 * S.U) = (1 / 16 : ℝ) := by
      field_simp [hUpos.ne']
    rw [hfrac] at hdiv
    exact hdiv
  have hτU : τ ≤ 16 := by
    have hmul := mul_le_mul_of_nonneg_right huL hτpos.le
    have htotal : S.U * τ ≤ 16 * S.U := by nlinarith [hz₁U, hmul]
    have hdiv : τ ≤ (16 * S.U) / S.U :=
      (le_div_iff₀ hUpos).2 (by nlinarith [htotal])
    have hratio : (16 * S.U) / S.U = 16 := by
      field_simp [hUpos.ne']
    rw [hratio] at hdiv
    exact hdiv
  let vτ := w.v * τ
  have hvPos : 0 < w.v := lt_of_lt_of_le hVpos hvL
  have hvτnonneg : 0 ≤ vτ := mul_nonneg hvPos.le hτpos.le
  have hvτupper : vτ ≤ 32 * S.V := by
    calc
      _ ≤ (2 * S.V) * τ := mul_le_mul_of_nonneg_right hvU hτpos.le
      _ ≤ (2 * S.V) * 16 := mul_le_mul_of_nonneg_left hτU (by positivity)
      _ = 32 * S.V := by ring
  have hz₂divLo : -31 * S.V ≤ (z.2 : ℝ) / w.u := by
    nlinarith [hz₂L, hvτupper]
  have hz₂divHi : (z.2 : ℝ) / w.u ≤ 2 * S.V := by
    nlinarith [hz₂U, hvτnonneg]
  have hmulz : (z.2 : ℝ) = w.u * ((z.2 : ℝ) / w.u) := by
    field_simp [huPos.ne']
  have hz₂hi : (z.2 : ℝ) ≤ 32 * S.U * S.V := by
    rw [hmulz]
    calc
      _ ≤ w.u * (2 * S.V) := mul_le_mul_of_nonneg_left hz₂divHi huPos.le
      _ ≤ (16 * S.U) * (2 * S.V) :=
        mul_le_mul_of_nonneg_right huU (by positivity)
      _ = 32 * S.U * S.V := by ring
  have hlowScale : -496 * S.U * S.V ≤ w.u * (-31 * S.V) := by
    have hcoeff : -31 * S.V ≤ 0 := by nlinarith [hVpos]
    have h := mul_le_mul_of_nonpos_left huU hcoeff
    nlinarith
  have hz₂lo : -496 * S.U * S.V ≤ (z.2 : ℝ) := by
    rw [hmulz]
    exact le_trans hlowScale (mul_le_mul_of_nonneg_left hz₂divLo huPos.le)
  have hz₂abs : |(z.2 : ℝ)| ≤ 544 * S.U * S.V := by
    apply abs_le.mpr
    constructor <;> nlinarith [hz₂lo, hz₂hi, mul_nonneg hUpos.le hVpos.le]
  have hτabs : |τ| ≤ 16 := by
    apply abs_le.mpr
    constructor <;> linarith [hτL, hτU]
  have hrabs : |w.r| ≤ 1 := abs_le.mpr ⟨by linarith, hrU⟩
  have hrzabs : |w.r * (z.2 : ℝ)| ≤ 544 * S.U * S.V := by
    rw [abs_mul]
    calc
      |w.r| * |(z.2 : ℝ)| ≤ 1 * (544 * S.U * S.V) :=
        mul_le_mul hrabs hz₂abs (abs_nonneg _) (by positivity)
      _ = 544 * S.U * S.V := by ring
  have hτeq : (z.1 : ℝ) = τ - w.r * (z.2 : ℝ) := by
    dsimp [τ, ArchRoot.tau]
    ring
  refine ⟨?_, hz₂abs⟩
  rw [hτeq]
  apply abs_le.mpr
  have hτLo : -16 ≤ τ := (abs_le.mp hτabs).1
  have hτHi : τ ≤ 16 := (abs_le.mp hτabs).2
  have hrzLo : -(544 * S.U * S.V) ≤ w.r * (z.2 : ℝ) := (abs_le.mp hrzabs).1
  have hrzHi : w.r * (z.2 : ℝ) ≤ 544 * S.U * S.V := (abs_le.mp hrzabs).2
  constructor <;> nlinarith [hτLo, hτHi, hrzLo, hrzHi]

private theorem envBox_finite {K : ℕ} (δ c₁ c₂ : ℝ)
    (S : PDScale) (w : ArchRoot)
    (hS : S.Valid K δ c₁ c₂) (hw : w.InRegion S) :
    {z : ℤ × ℤ | envBox S w z}.Finite := by
  classical
  let b₁ : ℝ := 16 + 544 * S.U * S.V
  let b₂ : ℝ := 544 * S.U * S.V
  let m₁ : ℤ := ⌈b₁⌉
  let m₂ : ℤ := ⌈b₂⌉
  let box : Set (ℤ × ℤ) := Set.Icc (-m₁) m₁ ×ˢ Set.Icc (-m₂) m₂
  have hm₁ : b₁ ≤ (m₁ : ℝ) := by
    exact Int.le_ceil b₁
  have hm₂ : b₂ ≤ (m₂ : ℝ) := by
    exact Int.le_ceil b₂
  have hboxFinite : box.Finite := by
    dsimp [box]
    exact (Set.finite_Icc _ _).prod (Set.finite_Icc _ _)
  apply hboxFinite.subset
  intro z hz
  have hb := envBox_coordinate_bounds δ c₁ c₂ S w z hS hw hz
  change z.1 ∈ Set.Icc (-m₁) m₁ ∧ z.2 ∈ Set.Icc (-m₂) m₂
  constructor
  · constructor
    · have hreal : (-(m₁ : ℤ) : ℝ) ≤ (z.1 : ℝ) := by
        have h := (abs_le.mp hb.1).1
        change -(b₁) ≤ (z.1 : ℝ) at h
        have hcast : (-(m₁ : ℤ) : ℝ) = -(m₁ : ℝ) := by simp
        rw [hcast]
        nlinarith
      exact_mod_cast hreal
    · have hreal : (z.1 : ℝ) ≤ (m₁ : ℝ) := by
        have h := (abs_le.mp hb.1).2
        change (z.1 : ℝ) ≤ b₁ at h
        linarith
      exact_mod_cast hreal
  · constructor
    · have hreal : (-(m₂ : ℤ) : ℝ) ≤ (z.2 : ℝ) := by
        have h := (abs_le.mp hb.2).1
        change -(b₂) ≤ (z.2 : ℝ) at h
        have hcast : (-(m₂ : ℤ) : ℝ) = -(m₂ : ℝ) := by simp
        rw [hcast]
        nlinarith
      exact_mod_cast hreal
    · have hreal : (z.2 : ℝ) ≤ (m₂ : ℝ) := by
        have h := (abs_le.mp hb.2).2
        change (z.2 : ℝ) ≤ b₂ at h
        linarith
      exact_mod_cast hreal

private theorem edgeAdmissible_supported_summable {K : ℕ} (δ c₁ c₂ : ℝ)
    (F : PDFix K) (S : PDScale) (w : ArchRoot) (s : MemPoint S.x K)
    (c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i)
    (g : ℤ × ℤ → ℂ) (hS : S.Valid K δ c₁ c₂) (hw : w.InRegion S)
    (hg : ∀ z', ¬ EdgeAdmissible F S w s c z' → g z' = 0) : Summable g := by
  classical
  have hbox := envBox_finite δ c₁ c₂ S w hS hw
  have hsupport : Function.support g ⊆ {z' : ℤ × ℤ | envBox S w z'} := by
    intro z' hz'
    change g z' ≠ 0 at hz'
    by_contra hnotBox
    apply hz'
    apply hg
    intro hadm
    rcases hadm with ⟨_, _, _, _, _, _, _, htargetBox, _, _⟩
    exact hnotBox htargetBox
  exact summable_of_hasFiniteSupport (hbox.subset hsupport)

private theorem comparisonMultiplier_norm_le {K : ℕ} (F : PDFix K) (S : PDScale)
    (D aa bb : ℕ) (t : ℤ) (Ceta Cpsi : ℝ)
    (hL : 1 ≤ Real.log S.x) (hA₀ : 0 ≤ F.A₀) (hY : 0 < S.Y)
    (det : ℤ) (hPad : IsPadAdmissible S.d₀ D det) (hd₀ : 0 < (S.d₀ : ℝ))
    (hEtaA : ‖(F.eta ((aa : ℝ) / S.Y) : ℂ)‖ ≤ Ceta)
    (hEtaB : ‖(F.eta ((bb : ℝ) / S.Y) : ℂ)‖ ≤ Ceta)
    (hPsi : ‖(F.psi ((t : ℝ) / S.Y) : ℂ)‖ ≤ Cpsi)
    (hCeta : 0 ≤ Ceta) (hCpsi : 0 ≤ Cpsi) :
    ‖comparisonMultiplier F S D aa bb t‖ ≤
      Ceta ^ 2 * Cpsi * (32 * Real.rpow (Real.log S.x) F.A₀ ^ 3 / S.Y) := by
  have hMK := majorKernel_norm_le_scaled S.x S.Y F.A₀ (t : ℝ) aa bb F.psi hL hA₀ hY
  have hLpos : 0 < Real.log S.x := by linarith
  have hPpos : 0 < Real.rpow (Real.log S.x) F.A₀ :=
    Real.rpow_pos_of_pos hLpos _
  have hfacNonneg : 0 ≤ 32 * Real.rpow (Real.log S.x) F.A₀ ^ 3 / S.Y := by
    exact div_nonneg (mul_nonneg (by norm_num) (pow_nonneg hPpos.le 3)) hY.le
  have hDpos : 0 < (D : ℝ) := lt_of_lt_of_le hd₀ hPad.1
  have hRatio :
      ‖((((S.d₀ : ℝ) / (D : ℝ)) : ℝ) : ℂ)‖ ≤ 1 := by
    have hnonneg : 0 ≤ (S.d₀ : ℝ) / (D : ℝ) := div_nonneg hd₀.le hDpos.le
    have hle : (S.d₀ : ℝ) / (D : ℝ) ≤ 1 :=
      (div_le_iff₀ hDpos).2 (by simpa using hPad.1)
    simpa [Complex.norm_real, abs_of_nonneg hnonneg] using hle
  have hMK' :
      ‖majorKernel S.x S.Y F.A₀ (t : ℝ) aa bb F.psi‖ ≤
        Cpsi * (32 * Real.rpow (Real.log S.x) F.A₀ ^ 3 / S.Y) := by
    calc
      _ ≤ ‖(F.psi ((t : ℝ) / S.Y) : ℂ)‖ *
          (32 * Real.rpow (Real.log S.x) F.A₀ ^ 3 / S.Y) := hMK
      _ ≤ Cpsi * (32 * Real.rpow (Real.log S.x) F.A₀ ^ 3 / S.Y) :=
        mul_le_mul_of_nonneg_right hPsi hfacNonneg
  have hprod :
      ‖((((S.d₀ : ℝ) / (D : ℝ)) : ℝ) : ℂ)‖ *
          ‖(F.eta ((bb : ℝ) / S.Y) : ℂ)‖ *
          ‖(F.eta ((aa : ℝ) / S.Y) : ℂ)‖ *
          ‖majorKernel S.x S.Y F.A₀ (t : ℝ) aa bb F.psi‖ ≤
        1 * Ceta * Ceta *
          (Cpsi * (32 * Real.rpow (Real.log S.x) F.A₀ ^ 3 / S.Y)) := by
    gcongr
  calc
    ‖comparisonMultiplier F S D aa bb t‖ =
        ‖((((S.d₀ : ℝ) / (D : ℝ)) : ℝ) : ℂ)‖ *
          ‖(F.eta ((bb : ℝ) / S.Y) : ℂ)‖ *
          ‖(F.eta ((aa : ℝ) / S.Y) : ℂ)‖ *
          ‖majorKernel S.x S.Y F.A₀ (t : ℝ) aa bb F.psi‖ := by
            simp [comparisonMultiplier, norm_mul]
    _ ≤ 1 * Ceta * Ceta *
          (Cpsi * (32 * Real.rpow (Real.log S.x) F.A₀ ^ 3 / S.Y)) := hprod
    _ = Ceta ^ 2 * Cpsi *
          (32 * Real.rpow (Real.log S.x) F.A₀ ^ 3 / S.Y) := by ring

private theorem exists_psi_norm_bound {K : ℕ} (F : PDFix K) (hF : F.Valid) :
    ∃ Cpsi : ℝ, 0 ≤ Cpsi ∧ ∀ t, ‖(F.psi t : ℂ)‖ ≤ Cpsi := by
  rcases hF with ⟨_, _, _, _, _, hArc⟩
  rcases hArc with ⟨hCont, hCompact, _⟩
  exact exists_compact_psi_norm_bound F.psi hCont.continuous hCompact

private theorem exists_eta_norm_bound {K : ℕ} (F : PDFix K) (hF : F.Valid) :
    ∃ Ceta : ℝ, 0 ≤ Ceta ∧ ∀ t, ‖(F.eta t : ℂ)‖ ≤ Ceta := by
  rcases hF with ⟨_, _, _, _, hEta, _⟩
  rcases hEta with ⟨hCont, hSupport, _, _⟩
  exact exists_support_Icc_norm_bound F.eta hCont.continuous hSupport

private theorem pd4c_logSym_mul {K : ℕ} (F : PDFix K) (S : PDScale)
    (a : ℂ) (f : LogPoint S.x K → ℂ) :
    logSym F S (fun t => a * f t) = fun t => a * logSym F S f t := by
  classical
  funext t
  simp only [logSym, ← Finset.mul_sum]
  ring

private theorem pd4c_logEdgePiece_mul {K : ℕ} (F : PDFix K) (S : PDScale)
    (ρ : ℝ) (w : ArchRoot) (j : ℕ) (raw : Bool) (St Pr : Finset (Fin K))
    (a : ℂ) (f : LogPoint S.x K → ℂ) :
    logEdgePiece F S ρ w j raw St Pr (fun t => a * f t) =
      fun t => a * logEdgePiece F S ρ w j raw St Pr f t := by
  classical
  funext t
  unfold logEdgePiece
  dsimp only
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro c hc
  rw [← tsum_mul_left]
  apply tsum_congr
  intro z
  split_ifs <;> ring

private theorem pd4c_memorySym_sum {x : ℝ} {K : ℕ} {ι : Type*}
    (R : Finset ι) (f : ι → MemPoint x K → ℂ) :
    memorySym (fun t => ∑ i ∈ R, f i t) =
      fun t => ∑ i ∈ R, memorySym (f i) t := by
  classical
  funext t
  unfold memorySym
  rw [Finset.sum_comm, Finset.mul_sum]

private theorem pd4c_memorySym_mul {x : ℝ} {K : ℕ}
    (a : ℂ) (f : MemPoint x K → ℂ) :
    memorySym (fun t => a * f t) = fun t => a * memorySym f t := by
  classical
  funext t
  simp only [memorySym, ← Finset.mul_sum]
  ring

private theorem pd4c_finite_kernel_of_linear {α : Type*} [DecidableEq α]
    (op : (α → ℂ) → α → ℂ)
    (hSum : ∀ (T : Finset α) (g : α → α → ℂ),
      op (fun u => ∑ s ∈ T, g s u) = fun u => ∑ s ∈ T, op (g s) u)
    (hMul : ∀ (a : ℂ) (g : α → ℂ),
      op (fun u => a * g u) = fun u => a * op g u)
    (T : Finset α) (f : α → ℂ) (hf : ∀ s, s ∉ T → f s = 0) (u : α) :
    op f u = ∑ s ∈ T, op (fun t => if t = s then 1 else 0) u * f s := by
  have hExpand : f = fun t => ∑ s ∈ T, f s * (if t = s then 1 else 0) := by
    funext t
    by_cases ht : t ∈ T
    · simp [ht]
    · simp [ht, hf t ht]
  conv_lhs => rw [hExpand]
  rw [hSum]
  apply Finset.sum_congr rfl
  intro s hs
  rw [hMul]
  exact mul_comm _ _

private theorem pd4c_scale_pos {K : ℕ} (δ c₁ c₂ : ℝ) (S : PDScale)
    (hS : S.Valid K δ c₁ c₂) : 0 < S.U ∧ 0 < S.V := by
  rcases hS with ⟨hx, hHm, hHn, _, _, hY, hd⟩
  have hxpos : 0 < S.x := by linarith
  have hHmpos := lt_of_lt_of_le (Real.rpow_pos_of_pos hxpos δ) hHm
  have hHnpos := lt_of_lt_of_le (Real.rpow_pos_of_pos hxpos δ) hHn
  have hYpos : 0 < S.Y := by
    rcases Finset.mem_filter.mp hY with ⟨hY, _⟩
    rcases Finset.mem_image.mp hY with ⟨n, _, hn⟩
    rw [← hn]
    positivity
  have hdpos : 0 < (S.d₀ : ℝ) := by
    rcases Finset.mem_image.mp hd with ⟨n, _, hn⟩
    rw [← hn]
    positivity
  exact ⟨by simpa [PDScale.U, PDScale.H] using mul_pos (mul_pos hdpos hYpos) hHmpos,
    by simpa [PDScale.V] using hHnpos⟩

private theorem pd4c_memEdgePiece_sum {K : ℕ} (δ c₁ c₂ : ℝ)
    (F : PDFix K) (S : PDScale) (ρ : ℝ) (w : ArchRoot)
    (raw : Bool) (St Pr : Finset (Fin K)) (j : ℕ)
    (hS : S.Valid K δ c₁ c₂) (hw : w.InRegion S)
    {ι : Type*} (R : Finset ι) (f : ι → MemPoint S.x K → ℂ) :
    memEdgePiece F S ρ w raw St Pr j (fun t => ∑ i ∈ R, f i t) =
      fun t => ∑ i ∈ R, memEdgePiece F S ρ w raw St Pr j (f i) t := by
  classical
  obtain ⟨hU, hV⟩ := pd4c_scale_pos δ c₁ c₂ S hS
  let P := (envPoint_valid_box_finite F S w hU hV hw).toFinset
  have hP : ∀ t, t ∈ P ↔ EnvValid F S t ∧ envBox S w t.1 := by
    intro t
    simp [P]
  have h := fun t => logEdgePiece_sum F S ρ w j raw St Pr R
    (fun i => logSym F S (fun u => f i u.1)) P hP t
  have hfun : logEdgePiece F S ρ w j raw St Pr
      (fun t => ∑ i ∈ R, logSym F S (fun u => f i u.1) t) =
      fun t => ∑ i ∈ R,
        logEdgePiece F S ρ w j raw St Pr (logSym F S (fun u => f i u.1)) t := by
    funext t
    exact h t
  funext s
  unfold memEdgePiece plainOp
  dsimp only
  rw [logSym_sum, hfun, logSym_sum]

private theorem pd4c_memEdgePiece_mul {K : ℕ} (F : PDFix K) (S : PDScale)
    (ρ : ℝ) (w : ArchRoot) (raw : Bool) (St Pr : Finset (Fin K)) (j : ℕ)
    (a : ℂ) (f : MemPoint S.x K → ℂ) :
    memEdgePiece F S ρ w raw St Pr j (fun t => a * f t) =
      fun t => a * memEdgePiece F S ρ w raw St Pr j f t := by
  funext s
  unfold memEdgePiece plainOp
  dsimp only
  rw [pd4c_logSym_mul, pd4c_logEdgePiece_mul, pd4c_logSym_mul]

private theorem pd4c_memEdgePiece_finite_kernel {K : ℕ} (δ c₁ c₂ : ℝ)
    (F : PDFix K) (S : PDScale) (ρ : ℝ) (w : ArchRoot)
    (raw : Bool) (St Pr : Finset (Fin K)) (j : ℕ)
    (hS : S.Valid K δ c₁ c₂) (hw : w.InRegion S)
    (T : Finset (MemPoint S.x K)) (f : MemPoint S.x K → ℂ)
    (hf : ∀ s, s ∉ T → f s = 0) (s : MemPoint S.x K) :
    memEdgePiece F S ρ w raw St Pr j f s =
      ∑ t ∈ T, memKernel (memEdgePiece F S ρ w raw St Pr j) s t * f t := by
  exact pd4c_finite_kernel_of_linear _
    (pd4c_memEdgePiece_sum δ c₁ c₂ F S ρ w raw St Pr j hS hw)
    (pd4c_memEdgePiece_mul F S ρ w raw St Pr j) T f hf s

private theorem pd4c_memEdgePiece_sym_finite_kernel {K : ℕ} (δ c₁ c₂ : ℝ)
    (F : PDFix K) (S : PDScale) (ρ : ℝ) (w : ArchRoot)
    (raw : Bool) (St Pr : Finset (Fin K)) (j : ℕ)
    (hS : S.Valid K δ c₁ c₂) (hw : w.InRegion S)
    (T : Finset (MemPoint S.x K)) (f : MemPoint S.x K → ℂ)
    (hf : ∀ s, s ∉ T → f s = 0) (s : MemPoint S.x K) :
    memEdgePiece F S ρ w raw St Pr j (memorySym f) s =
      ∑ t ∈ T, memKernel (fun g => memEdgePiece F S ρ w raw St Pr j (memorySym g))
        s t * f t := by
  apply pd4c_finite_kernel_of_linear _ _ _ T f hf s
  · intro T g
    rw [pd4c_memorySym_sum, pd4c_memEdgePiece_sum δ c₁ c₂ F S ρ w raw St Pr j hS hw]
  · intro a g
    rw [pd4c_memorySym_mul, pd4c_memEdgePiece_mul]

private theorem pd4c_strip_line_count (C₁ : ℝ) (hC₁ : 1 ≤ C₁) :
    ∃ C₂ Y₀ : ℝ, 0 < C₂ ∧ 1 ≤ Y₀ ∧ ∀ Y : ℝ, Y₀ ≤ Y → ∀ α : ℝ,
      (∀ l : ℕ, 1 ≤ l → (l : ℝ) ≤ Real.rpow Y (1 / 5 : ℝ) →
        Real.rpow Y (-(7 / 10 : ℝ)) < circleDistance ((l : ℝ) * α)) →
      ∀ p : ℕ, p.Prime → ∀ a b : ZMod p, a ≠ 0 ∨ b ≠ 0 →
        {q : ℤ × ℤ | |(q.2 : ℝ)| ≤ C₁ * Y ∧
          |(q.1 : ℝ) + (q.2 : ℝ) * α| ≤ C₁ ∧
          a * (q.1 : ZMod p) + b * (q.2 : ZMod p) = 0}.Finite ∧
        (({q : ℤ × ℤ | |(q.2 : ℝ)| ≤ C₁ * Y ∧
          |(q.1 : ℝ) + (q.2 : ℝ) * α| ≤ C₁ ∧
          a * (q.1 : ZMod p) + b * (q.2 : ZMod p) = 0}.ncard : ℝ)) ≤
            12 * C₂ * Y * (1 / (p : ℝ) + Real.rpow Y (-(1 / 10 : ℝ))) := by
  classical
  obtain ⟨C₂, Y₀, hC₂, hY₀, hShape⟩ := lattice_shape C₁ hC₁
  refine ⟨C₂, Y₀, hC₂, hY₀, ?_⟩
  intro Y hY α hα p hp a b hab
  obtain ⟨a₀, b₀, c₀, d₀, A, D, hdet, hAD, hA, _, hD, _, hcoords⟩ :=
    hShape Y hY α hα
  let trans : ℤ × ℤ → ℤ × ℤ :=
    fun q => (d₀ * q.1 - b₀ * q.2, a₀ * q.2 - c₀ * q.1)
  let inv : ℤ × ℤ → ℤ × ℤ :=
    fun q => (a₀ * q.1 + b₀ * q.2, c₀ * q.1 + d₀ * q.2)
  have hleft : Function.LeftInverse inv trans := by
    intro q
    apply Prod.ext
    · change a₀ * (d₀ * q.1 - b₀ * q.2) + b₀ * (a₀ * q.2 - c₀ * q.1) = q.1
      calc
        _ = (a₀ * d₀ - b₀ * c₀) * q.1 := by ring
        _ = q.1 := by rw [hdet, one_mul]
    · change c₀ * (d₀ * q.1 - b₀ * q.2) + d₀ * (a₀ * q.2 - c₀ * q.1) = q.2
      calc
        _ = (a₀ * d₀ - b₀ * c₀) * q.2 := by ring
        _ = q.2 := by rw [hdet, one_mul]
  have hdetp : (a₀ : ZMod p) * (d₀ : ZMod p) - (b₀ : ZMod p) * (c₀ : ZMod p) = 1 := by
    have h := congrArg (fun n : ℤ => (n : ZMod p)) hdet
    simpa only [Int.cast_sub, Int.cast_mul, Int.cast_one] using h
  let a' : ZMod p := a * a₀ + b * c₀
  let b' : ZMod p := a * b₀ + b * d₀
  have hnonzero : a' ≠ 0 ∨ b' ≠ 0 := by
    by_contra h
    push_neg at h
    have hrecA : a' * d₀ - b' * c₀ = a := by
      dsimp [a', b']
      calc
        _ = a * ((a₀ : ZMod p) * d₀ - (b₀ : ZMod p) * c₀) := by ring
        _ = a := by rw [hdetp, mul_one]
    have hrecB : b' * a₀ - a' * b₀ = b := by
      dsimp [a', b']
      calc
        _ = b * ((a₀ : ZMod p) * d₀ - (b₀ : ZMod p) * c₀) := by ring
        _ = b := by rw [hdetp, mul_one]
    rw [h.1, h.2, zero_mul, zero_mul, sub_zero] at hrecA hrecB
    exact hab.elim (fun ha => ha hrecA.symm) (fun hb => hb hrecB.symm)
  let T : Set (ℤ × ℤ) := {q | |(q.1 : ℝ)| ≤ A ∧ |(q.2 : ℝ)| ≤ D ∧
    a' * (q.1 : ZMod p) + b' * (q.2 : ZMod p) = 0}
  have hTfin : T.Finite := by
    apply ((Set.finite_Icc (-⌈A⌉) ⌈A⌉).prod (Set.finite_Icc (-⌈D⌉) ⌈D⌉)).subset
    intro q hq
    rcases hq with ⟨hqA, hqD, _⟩
    rcases abs_le.mp hqA with ⟨hAlo, hAhi⟩
    rcases abs_le.mp hqD with ⟨hDlo, hDhi⟩
    have hAc := Int.le_ceil A
    have hDc := Int.le_ceil D
    constructor <;> constructor
    · exact_mod_cast (show -(⌈A⌉ : ℝ) ≤ (q.1 : ℝ) by linarith)
    · exact_mod_cast (show (q.1 : ℝ) ≤ (⌈A⌉ : ℝ) by linarith)
    · exact_mod_cast (show -(⌈D⌉ : ℝ) ≤ (q.2 : ℝ) by linarith)
    · exact_mod_cast (show (q.2 : ℝ) ≤ (⌈D⌉ : ℝ) by linarith)
  have hmap : ∀ q ∈ {q : ℤ × ℤ | |(q.2 : ℝ)| ≤ C₁ * Y ∧
      |(q.1 : ℝ) + (q.2 : ℝ) * α| ≤ C₁ ∧
      a * (q.1 : ZMod p) + b * (q.2 : ZMod p) = 0}, trans q ∈ T := by
    intro q hq
    obtain ⟨hl, ht, hline⟩ := hq
    obtain ⟨hx, hy⟩ := hcoords q.1 q.2 hl ht
    refine ⟨hx, hy, ?_⟩
    change a' * ((d₀ * q.1 - b₀ * q.2 : ℤ) : ZMod p) +
      b' * ((a₀ * q.2 - c₀ * q.1 : ℤ) : ZMod p) = 0
    push_cast
    dsimp [a', b']
    calc
      _ = ((a₀ : ZMod p) * d₀ - (b₀ : ZMod p) * c₀) *
          (a * (q.1 : ZMod p) + b * (q.2 : ZMod p)) := by ring
      _ = 0 := by rw [hline, mul_zero]
  refine ⟨Set.Finite.of_injOn hmap hleft.injective.injOn hTfin, ?_⟩
  have hcard := Set.ncard_le_ncard_of_injOn trans hmap hleft.injective.injOn hTfin
  calc
    _ ≤ (T.ncard : ℝ) := by exact_mod_cast hcard
    _ ≤ _ := box_line_count_le_balanced p hp Y C₂ A D (1 / 10 : ℝ)
      (le_trans hY₀ hY) (by norm_num) hAD hA hD a' b' hnonzero

private theorem pd4c_particleHits_line (e : Particle) (he : e.1.Prime) :
    ∃ a b : ZMod e.1, (a ≠ 0 ∨ b ≠ 0) ∧
      ∀ z : ℤ × ℤ, particleHits e z →
        a * (z.1 : ZMod e.1) + b * (z.2 : ZMod e.1) = 0 := by
  classical
  letI : Fact e.1.Prime := ⟨he⟩
  letI : NeZero e.1 := ⟨he.ne_zero⟩
  by_cases hinfty : e.2 = e.1
  · refine ⟨0, 1, Or.inr one_ne_zero, ?_⟩
    intro z hh
    by_cases hz2 : (z.2 : ZMod e.1) = 0
    · simp [hz2]
    · have hval : ((z.1 : ZMod e.1) * (z.2 : ZMod e.1)⁻¹).val < e.1 := ZMod.val_lt _
      have hmod : ((z.1 : ZMod e.1) * (z.2 : ZMod e.1)⁻¹).val % (e.1 + 1) =
          ((z.1 : ZMod e.1) * (z.2 : ZMod e.1)⁻¹).val :=
        Nat.mod_eq_of_lt (by omega)
      have hhit : e.2 = ((z.1 : ZMod e.1) * (z.2 : ZMod e.1)⁻¹).val := by
        simpa [particleHits, projLine, hz2, hmod] using hh
      omega
  · refine ⟨1, -(e.2 : ZMod e.1), Or.inl one_ne_zero, ?_⟩
    intro z hh
    by_cases hz2 : (z.2 : ZMod e.1) = 0
    · have hhit : e.2 = e.1 := by simpa [particleHits, projLine, hz2] using hh
      exact (hinfty hhit).elim
    · have hval : ((z.1 : ZMod e.1) * (z.2 : ZMod e.1)⁻¹).val < e.1 := ZMod.val_lt _
      have hmod : ((z.1 : ZMod e.1) * (z.2 : ZMod e.1)⁻¹).val % (e.1 + 1) =
          ((z.1 : ZMod e.1) * (z.2 : ZMod e.1)⁻¹).val :=
        Nat.mod_eq_of_lt (by omega)
      have hhit : e.2 = ((z.1 : ZMod e.1) * (z.2 : ZMod e.1)⁻¹).val := by
        simpa [particleHits, projLine, hz2, hmod] using hh
      have hcast : (e.2 : ZMod e.1) = (z.1 : ZMod e.1) * (z.2 : ZMod e.1)⁻¹ := by
        rw [hhit, ZMod.natCast_zmod_val]
      rw [hcast]
      field_simp [hz2]
      ring

private theorem pd4c_memorySym_delta_zero_of_size_ne {x : ℝ} {K : ℕ}
    (s t : MemPoint x K) (hsize : memSize s ≠ memSize t) :
    memorySym (fun u => if u = t then (1 : ℂ) else 0) s = 0 := by
  unfold memorySym
  have hzero : (∑ σ : MemoryPermutation s,
      if memoryPermute s σ = t then (1 : ℂ) else 0) = 0 := by
    apply Finset.sum_eq_zero
    intro σ hσ
    have hne : memoryPermute s σ ≠ t := by
      intro heq
      have h := congrArg memSize heq
      apply hsize
      simpa [memSize, memoryPermute] using h
    simp [hne]
  rw [hzero, mul_zero]

private theorem pd4c_memorySym_delta_weight_row {x : ℝ} {K : ℕ}
    (s : MemPoint x K) (T : Finset (MemPoint x K)) (v : ℝ) (hv : 0 ≤ v) :
    (∑ t ∈ T, ‖memorySym (fun u => if u = t then (1 : ℂ) else 0) s‖ *
      v ^ memSize t) ≤ v ^ memSize s := by
  have hpoint (t : MemPoint x K) :
      ‖memorySym (fun u => if u = t then (1 : ℂ) else 0) s‖ * v ^ memSize t =
        ‖memorySym (fun u => if u = t then (1 : ℂ) else 0) s‖ * v ^ memSize s := by
    by_cases hsize : memSize s = memSize t
    · rw [hsize]
    · rw [pd4c_memorySym_delta_zero_of_size_ne s t hsize]
      simp
  simp_rw [hpoint]
  rw [← Finset.sum_mul]
  simpa using mul_le_mul_of_nonneg_right (memorySym_delta_row_le s T) (pow_nonneg hv _)

private theorem pd4c_logSym_projected_delta_weight_row {K : ℕ}
    (F : PDFix K) (S : PDScale) (s : MemPoint S.x K)
    (T : Finset (MemPoint S.x K)) (v : ℝ) (hv : 0 ≤ v) :
    (∑ t ∈ T,
      ‖plainOp (logSym F S) (memorySym (fun u => if u = t then (1 : ℂ) else 0)) s‖ *
        v ^ memSize t) ≤ v ^ memSize s := by
  let G := Fin K → Equiv.Perm (Fin (slotCount S.x))
  let d := permCount S.x K
  have hdpos : 0 < d := by
    exact Fintype.card_pos_iff.mpr ⟨fun i => Equiv.refl _⟩
  have hdne : (d : ℝ) ≠ 0 := by exact_mod_cast hdpos.ne'
  have hnorm : ‖(d : ℂ)⁻¹‖ = (d : ℝ)⁻¹ := by simp
  let out (σ : G) : MemPoint S.x K := (s.1, permuteLists σ s.2.1, s.2.2)
  let delta (t : MemPoint S.x K) := fun u => if u = t then (1 : ℂ) else 0
  have hpoint (t : MemPoint S.x K) :
      ‖plainOp (logSym F S) (memorySym (delta t)) s‖ * v ^ memSize t ≤
        (d : ℝ)⁻¹ * ∑ σ : G, ‖memorySym (delta t) (out σ)‖ * v ^ memSize t := by
    change ‖(d : ℂ)⁻¹ * ∑ σ : G, memorySym (delta t) (out σ)‖ * v ^ memSize t ≤ _
    calc
      _ = (d : ℝ)⁻¹ * ‖∑ σ : G, memorySym (delta t) (out σ)‖ * v ^ memSize t := by
        rw [norm_mul, hnorm]
      _ ≤ (d : ℝ)⁻¹ * (∑ σ : G, ‖memorySym (delta t) (out σ)‖) * v ^ memSize t := by
        apply mul_le_mul_of_nonneg_right _ (pow_nonneg hv _)
        exact mul_le_mul_of_nonneg_left (norm_sum_le _ _) (by positivity)
      _ = _ := by rw [← Finset.sum_mul]; ring
  calc
    _ ≤ ∑ t ∈ T, (d : ℝ)⁻¹ *
        ∑ σ : G, ‖memorySym (delta t) (out σ)‖ * v ^ memSize t :=
      Finset.sum_le_sum fun t ht => hpoint t
    _ = (d : ℝ)⁻¹ * ∑ σ : G, ∑ t ∈ T,
        ‖memorySym (delta t) (out σ)‖ * v ^ memSize t := by
      rw [← Finset.mul_sum, Finset.sum_comm]
    _ ≤ (d : ℝ)⁻¹ * ∑ σ : G, v ^ memSize s := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      apply Finset.sum_le_sum
      intro σ hσ
      exact pd4c_memorySym_delta_weight_row (out σ) T v hv
    _ = _ := by
      rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
      change (d : ℝ)⁻¹ * ((d : ℝ) * v ^ memSize s) = v ^ memSize s
      field_simp

private theorem pd4c_last_omission_eq_shared {x : ℝ} {K : ℕ}
    (p : PrimeLists x K) : omissionProduct p (fun _ => lastSlot x) = sharedProduct p := by
  unfold omissionProduct sharedProduct
  apply Finset.prod_congr rfl
  intro i hi
  apply Finset.prod_congr rfl
  intro j hj
  have heq : (j ≠ lastSlot x) ↔ j.val < momentJ x := by
    rw [ne_eq, Fin.ext_iff]
    have hlt := j.isLt
    dsimp [slotCount] at hlt
    dsimp [lastSlot]
    omega
  simp only [heq]

private theorem pd4c_promoted_target_count (C₁ : ℝ) (hC₁ : 16 ≤ C₁) :
    ∃ C₂ Y₀ : ℝ, 0 < C₂ ∧ 1 ≤ Y₀ ∧
      ∀ (K : ℕ) (F : PDFix K) (S : PDScale) (w : ArchRoot)
        (δ c₁ c₂ : ℝ), S.Valid K δ c₁ c₂ → w.InRegion S → Y₀ ≤ S.Y →
      ∀ (s : MemPoint S.x K)
        (c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i)
        (i : Fin K) (k : Fin (s.2.2 i).length),
        MemValid F S s → ValidPrimeLists S.x K F.a s.2.1 →
        envBox S w s.1 → envGood F S w (s.1, s.2.1) →
        (S.d₀ : ℝ) ≤ (sharedProduct s.2.1 : ℝ) →
        (sharedProduct s.2.1 : ℝ) < 2 * (S.d₀ : ℝ) →
        (c i).2 = Sum.inl k →
        (∀ i' j, ((s.2.2 i).get k).1 ≠ s.2.1 i' j) →
        (({z' : ℤ × ℤ | EdgeAdmissible F S w s c z' ∧
          |((det2 s.1 z' / (sharedProduct s.2.1 : ℤ) : ℤ) : ℝ)| ≤ C₁ * S.Y}.ncard : ℝ)) ≤
            12 * C₂ * S.Y * (1 / (((s.2.2 i).get k).1 : ℝ) +
              Real.rpow S.Y (-(1 / 10 : ℝ))) := by
  classical
  obtain ⟨C₂, Y₀, hC₂, hY₀, hStrip⟩ := pd4c_strip_line_count C₁ (by linarith)
  refine ⟨C₂, Y₀, hC₂, hY₀, ?_⟩
  intro K F S w δ c₁ c₂ hS hw hY s c i k hs hLists hbox hgood hDlo hDhi hc hban
  let D := sharedProduct s.2.1
  let z := s.1
  let v := complementVec z
  let e := (s.2.2 i).get k
  let p := e.1
  let α := (D : ℝ) * transportedRatio w z
  have hPrime : p.Prime := by
    have hBand := (hs.2.2 i e (List.get_mem _ k)).1
    exact (Finset.mem_filter.mp hBand).2.1
  have hND : ¬ p ∣ D :=
    pd4c_prime_not_dvd_sharedProduct s.2.1 (fun i j => (hLists.1 i j).1) p hPrime hban
  have hα : ∀ l : ℕ, 1 ≤ l → (l : ℝ) ≤ Real.rpow S.Y (1 / 5 : ℝ) →
      Real.rpow S.Y (-(7 / 10 : ℝ)) < circleDistance ((l : ℝ) * α) := by
    intro l hl hly
    have h := hgood.1 (fun _ => lastSlot S.x)
      (by simpa [pd4c_last_omission_eq_shared] using hDlo)
      (by simpa [pd4c_last_omission_eq_shared] using hDhi) l hl hly
    simpa only [pd4c_last_omission_eq_shared, α, D, z, mul_assoc] using h
  obtain ⟨a, b, hab, hline⟩ := pd4c_particleHits_line e hPrime
  have hdet : det2 z v = 1 := by
    have h := Int.gcd_eq_gcd_ab z.1 z.2
    rw [hs.1] at h
    simpa [det2, v, complementVec, sub_neg_eq_add] using h.symm
  have hdetp : (z.1 : ZMod p) * (((D : ℤ) * v.2 : ℤ) : ZMod p) -
      (z.2 : ZMod p) * (((D : ℤ) * v.1 : ℤ) : ZMod p) ≠ 0 := by
    have hcast : (z.1 : ZMod p) * (v.2 : ZMod p) -
        (z.2 : ZMod p) * (v.1 : ZMod p) = 1 := by
      have h := congrArg (fun n : ℤ => (n : ZMod p)) hdet
      simpa [det2] using h
    have hd : (D : ZMod p) ≠ 0 := fun hd => hND ((ZMod.natCast_eq_zero_iff D p).mp hd)
    push_cast
    have heq : (z.1 : ZMod p) * ((D : ZMod p) * (v.2 : ZMod p)) -
        (z.2 : ZMod p) * ((D : ZMod p) * (v.1 : ZMod p)) = (D : ZMod p) := by
      calc
        _ = (D : ZMod p) * ((z.1 : ZMod p) * v.2 - (z.2 : ZMod p) * v.1) := by ring
        _ = _ := by rw [hcast, mul_one]
    rw [heq]
    exact hd
  let a' : ZMod p := a * z.1 + b * z.2
  let b' : ZMod p := a * ((D : ℤ) * v.1) + b * ((D : ℤ) * v.2)
  have hab' : a' ≠ 0 ∨ b' ≠ 0 := by
    simpa only [a', b', Int.cast_mul] using
      pd4c_line_coefficients_nonzero p hPrime z.1 z.2 ((D : ℤ) * v.1)
        ((D : ℤ) * v.2) hdetp a b hab
  let T : Set (ℤ × ℤ) := {q | |(q.2 : ℝ)| ≤ C₁ * S.Y ∧
    |(q.1 : ℝ) + (q.2 : ℝ) * α| ≤ C₁ ∧ a' * (q.1 : ZMod p) + b' * (q.2 : ZMod p) = 0}
  obtain ⟨hTfin, hTcard⟩ := hStrip S.Y hY α hα p hPrime a' b' hab'
  let φ : ℤ × ℤ → ℤ × ℤ := fun q =>
    (q.1 * z.1 + (D : ℤ) * q.2 * v.1, q.1 * z.2 + (D : ℤ) * q.2 * v.2)
  have hsubset : {z' : ℤ × ℤ | EdgeAdmissible F S w s c z' ∧
      |((det2 s.1 z' / (sharedProduct s.2.1 : ℤ) : ℤ) : ℝ)| ≤ C₁ * S.Y} ⊆ φ '' T := by
    intro z' hz'
    obtain ⟨hadm, hbound⟩ := hz'
    obtain ⟨hU, _⟩ := pd4c_scale_pos δ c₁ c₂ S hS
    obtain ⟨h, l, hrepr, hl, ht⟩ := pd4c_env_target_strip_coordinates S w z z' D C₁
      hU hw hs.1 hbox hadm.2.2.2.2.2.2.2.1 hadm.2.2.2.2.1.2.2 hbound
    have hzline := hline z' (hadm.1 i k hc)
    refine ⟨(h, l), ⟨hl, le_trans ht hC₁, ?_⟩, hrepr.symm⟩
    change a' * (h : ZMod p) + b' * (l : ZMod p) = 0
    rw [hrepr] at hzline
    push_cast at hzline
    dsimp [a', b']
    push_cast
    linear_combination hzline
  have hcard :
      {z' : ℤ × ℤ | EdgeAdmissible F S w s c z' ∧
        |((det2 s.1 z' / (sharedProduct s.2.1 : ℤ) : ℤ) : ℝ)| ≤ C₁ * S.Y}.ncard ≤ T.ncard :=
    (Set.ncard_le_ncard hsubset (hTfin.image φ)).trans (Set.ncard_image_le hTfin)
  exact (show (_ : ℝ) ≤ (T.ncard : ℝ) by exact_mod_cast hcard).trans hTcard

private theorem pd4c_finite_row_mass {α β : Type*} [DecidableEq β]
    (R : Finset β) (T : Finset α) (coef : β → ℂ) (out : β → α)
    (d : α → α → ℂ) (v w : α → ℝ)
    (hv : ∀ t ∈ T, 0 ≤ v t)
    (hd : ∀ r ∈ R, (∑ t ∈ T, ‖d t (out r)‖ * v t) ≤ w (out r)) :
    (∑ t ∈ T, ‖∑ r ∈ R, coef r * d t (out r)‖ * v t) ≤
      ∑ r ∈ R, ‖coef r‖ * w (out r) := by
  calc
    _ ≤ ∑ t ∈ T, (∑ r ∈ R, ‖coef r‖ * ‖d t (out r)‖) * v t := by
      apply Finset.sum_le_sum
      intro t ht
      apply mul_le_mul_of_nonneg_right _ (hv t ht)
      simpa only [norm_mul] using norm_sum_le R (fun r => coef r * d t (out r))
    _ = ∑ r ∈ R, ‖coef r‖ * (∑ t ∈ T, ‖d t (out r)‖ * v t) := by
      simp_rw [Finset.sum_mul]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro r hr
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro t ht
      ring
    _ ≤ _ := Finset.sum_le_sum fun r hr => mul_le_mul_of_nonneg_left (hd r hr) (norm_nonneg _)

private def pd4c_edgeChoiceCoeff {K : ℕ} (F : PDFix K) (S : PDScale) (ρ : ℝ)
    (j : ℕ) (raw : Bool) (s : MemPoint S.x K)
    (c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i) (z' : ℤ × ℤ) : ℂ :=
  ((ρ ^ (∑ i : Fin K, hitCount (s.2.2 i) s.1) *
    (∏ i : Fin K, match (c i).2 with
      | Sum.inl _ => (bandMass S.x (F.a i))⁻¹
      | Sum.inr p => memoryNu S.x K F.a F.q_d i p) *
    ρ ^ (∑ i : Fin K, hitCount (edgeNewMemory F S s c i) z') : ℝ) : ℂ) *
    edgeMultiplier F S (decide (j % 2 = 0)) raw s.2.1
      (edgeTargetLists F S s c) s.1 z'

private def pd4c_edgeRowMass {K : ℕ} (F : PDFix K) (S : PDScale) (ρ : ℝ) (w : ArchRoot)
    (j : ℕ) (raw : Bool) (St Pr : Finset (Fin K)) (v : ℝ) (s : MemPoint S.x K) : ℝ :=
  ∑ c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i,
    ∑' z' : ℤ × ℤ,
      if edgeStoredSet c = St ∧ edgePromotedSet c = Pr ∧ EdgeAdmissible F S w s c z' then
        ‖pd4c_edgeChoiceCoeff F S ρ j raw s c z'‖ *
          v ^ memSize (z', edgeTargetLists F S s c, edgeNewMemory F S s c)
      else 0

private theorem pd4c_memEdgePiece_projected_row_mass {K : ℕ} (δ c₁ c₂ : ℝ)
    (F : PDFix K) (S : PDScale) (ρ : ℝ) (w : ArchRoot)
    (raw : Bool) (St Pr : Finset (Fin K)) (j : ℕ)
    (hS : S.Valid K δ c₁ c₂) (hw : w.InRegion S)
    (s : MemPoint S.x K) (T : Finset (MemPoint S.x K)) (v : ℝ) (hv : 0 ≤ v) :
    (∑ t ∈ T, ‖memKernel (fun f => memEdgePiece F S ρ w raw St Pr j (memorySym f)) s t‖ *
      v ^ memSize t) ≤
        (permCount S.x K : ℝ)⁻¹ *
          ∑ σ : Fin K → Equiv.Perm (Fin (slotCount S.x)),
            pd4c_edgeRowMass F S ρ w j raw St Pr v (s.1, permuteLists σ s.2.1, s.2.2) := by
  classical
  let G := Fin K → Equiv.Perm (Fin (slotCount S.x))
  let C := (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i
  let Z := (envBox_finite δ c₁ c₂ S w hS hw).toFinset
  let R : Finset (G × C × (ℤ × ℤ)) := Finset.univ ×ˢ (Finset.univ ×ˢ Z)
  let source (σ : G) : MemPoint S.x K := (s.1, permuteLists σ s.2.1, s.2.2)
  let good (σ : G) (c : C) (z' : ℤ × ℤ) : Prop :=
    edgeStoredSet c = St ∧ edgePromotedSet c = Pr ∧ EdgeAdmissible F S w (source σ) c z'
  let target (σ : G) (c : C) (z' : ℤ × ℤ) : MemPoint S.x K :=
    (z', edgeTargetLists F S (source σ) c, edgeNewMemory F S (source σ) c)
  let d := permCount S.x K
  let delta (t u : MemPoint S.x K) : ℂ :=
    plainOp (logSym F S) (memorySym (fun a => if a = t then (1 : ℂ) else 0)) u
  let out (r : G × C × (ℤ × ℤ)) := target r.1 r.2.1 r.2.2
  let coef (r : G × C × (ℤ × ℤ)) : ℂ :=
    (d : ℂ)⁻¹ * (if good r.1 r.2.1 r.2.2 then
      pd4c_edgeChoiceCoeff F S ρ j raw (source r.1) r.2.1 r.2.2 else 0)
  have hpos : ∀ σ c z', good σ c z' → z' ∈ Z := by
    intro σ c z' hg
    have hzbox := hg.2.2.2.2.2.2.2.2.2.1
    simpa [Z] using hzbox
  have hKernelFin (σ : G) (c : C) (t : MemPoint S.x K) :
      (∑' z', if good σ c z' then pd4c_edgeChoiceCoeff F S ρ j raw (source σ) c z' *
          delta t (target σ c z') else 0) =
        ∑ z' ∈ Z, if good σ c z' then pd4c_edgeChoiceCoeff F S ρ j raw (source σ) c z' *
          delta t (target σ c z') else 0 := by
    apply tsum_eq_sum
    intro z' hz'
    have hnot : ¬ good σ c z' := fun hg => hz' (hpos σ c z' hg)
    simp [hnot]
  have hMassFin (σ : G) (c : C) :
      (∑' z', if good σ c z' then ‖pd4c_edgeChoiceCoeff F S ρ j raw (source σ) c z'‖ *
          v ^ memSize (target σ c z') else 0) =
        ∑ z' ∈ Z, if good σ c z' then ‖pd4c_edgeChoiceCoeff F S ρ j raw (source σ) c z'‖ *
          v ^ memSize (target σ c z') else 0 := by
    apply tsum_eq_sum
    intro z' hz'
    have hnot : ¬ good σ c z' := fun hg => hz' (hpos σ c z' hg)
    simp [hnot]
  have hKernel (t : MemPoint S.x K) :
      memKernel (fun f => memEdgePiece F S ρ w raw St Pr j (memorySym f)) s t =
        ∑ r ∈ R, coef r * delta t (out r) := by
    change ((d : ℂ)⁻¹ * ∑ σ : G, ∑ c : C,
        ∑' z', if good σ c z' then pd4c_edgeChoiceCoeff F S ρ j raw (source σ) c z' *
          delta t (target σ c z') else 0) = _
    simp_rw [hKernelFin]
    simp only [R, Finset.sum_product]
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro σ hσ
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro c hc
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro z' hz'
    by_cases hg : good σ c z' <;> simp [coef, out, hg, mul_assoc]
  have hdpos : 0 < d := by exact Fintype.card_pos_iff.mpr ⟨fun i => Equiv.refl _⟩
  have hnorm : ‖(d : ℂ)⁻¹‖ = (d : ℝ)⁻¹ := by simp
  have hRow : (∑ t ∈ T, ‖∑ r ∈ R, coef r * delta t (out r)‖ * v ^ memSize t) ≤
      ∑ r ∈ R, ‖coef r‖ * v ^ memSize (out r) := by
    apply pd4c_finite_row_mass R T coef out delta
      (fun t => v ^ memSize t) (fun t => v ^ memSize t)
    · intro t ht
      exact pow_nonneg hv _
    · intro r hr
      exact pd4c_logSym_projected_delta_weight_row F S (out r) T v hv
  have hMass : (∑ r ∈ R, ‖coef r‖ * v ^ memSize (out r)) =
      (d : ℝ)⁻¹ * ∑ σ : G, pd4c_edgeRowMass F S ρ w j raw St Pr v (source σ) := by
    simp only [R, Finset.sum_product]
    change (∑ σ : G, ∑ c : C, ∑ z' ∈ Z, ‖coef (σ, c, z')‖ *
      v ^ memSize (out (σ, c, z'))) = _
    change (∑ σ : G, ∑ c : C, ∑ z' ∈ Z, ‖coef (σ, c, z')‖ *
      v ^ memSize (out (σ, c, z'))) =
        (d : ℝ)⁻¹ * ∑ σ : G, ∑ c : C,
          ∑' z', if good σ c z' then ‖pd4c_edgeChoiceCoeff F S ρ j raw (source σ) c z'‖ *
            v ^ memSize (target σ c z') else 0
    simp_rw [hMassFin]
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro σ hσ
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro c hc
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro z' hz'
    by_cases hg : good σ c z' <;> simp [coef, out, hg, norm_mul, hnorm, mul_assoc]
  simp_rw [hKernel]
  exact hRow.trans_eq hMass

private theorem pd4c_memorySym_delta_invalid_zero {K : ℕ} (F : PDFix K) (S : PDScale)
    (s t : MemPoint S.x K) (hs : MemValid F S s) (ht : ¬ MemValid F S t) :
    memorySym (fun u => if u = t then (1 : ℂ) else 0) s = 0 := by
  classical
  unfold memorySym
  have hzero : (∑ σ : MemoryPermutation s, if memoryPermute s σ = t then (1 : ℂ) else 0) = 0 := by
    apply Finset.sum_eq_zero
    intro σ hσ
    have hvalid := (pd4c_memValid_memoryPermute_iff F S s σ).mpr hs
    have hne : memoryPermute s σ ≠ t := fun h => ht (h ▸ hvalid)
    simp [hne]
  rw [hzero, mul_zero]

private theorem pd4c_memEdgePiece_sym_kernel_invalid {K : ℕ} (F : PDFix K) (S : PDScale)
    (ρ : ℝ) (w : ArchRoot) (raw : Bool) (St Pr : Finset (Fin K)) (j : ℕ)
    (s t : MemPoint S.x K) (hs : MemValid F S s) (ht : ¬ MemValid F S t) :
    memKernel (fun f => memEdgePiece F S ρ w raw St Pr j (memorySym f)) s t = 0 := by
  apply memEdgePiece_zero_for_valid_supported_input F S ρ w raw St Pr j
    (memorySym (fun u => if u = t then (1 : ℂ) else 0)) _ s hs
  intro u hu
  exact pd4c_memorySym_delta_invalid_zero F S u t hu ht

private theorem pd4c_memEdgePiece_sym_schur {K : ℕ} (δ c₁ c₂ : ℝ)
    (F : PDFix K) (S : PDScale) (ρ : ℝ) (w : ArchRoot)
    (raw : Bool) (St Pr : Finset (Fin K)) (j B : ℕ) (v R C : ℝ)
    (hS : S.Valid K δ c₁ c₂) (hw : w.InRegion S)
    (hμ : ∀ s, 0 ≤ memMeasure F S s) (hv : 0 < v) (hR : 0 ≤ R) (hC : 0 ≤ C)
    (hrow : MemRowSchurLE_sym F S B (memEdgePiece F S ρ w raw St Pr j) v R)
    (hcol : MemColSchurLE_sym F S B (memEdgePiece F S ρ w raw St Pr j) v C) :
    MemOpNormLE_sym F S B (memEdgePiece F S ρ w raw St Pr j) (Real.sqrt (R * C)) := by
  apply pd4c_memOpNormLE_of_weighted_schur F S B
    (fun f => memEdgePiece F S ρ w raw St Pr j (memorySym f)) v R C hμ
    (fun s hs => memMeasure_eq_zero_of_invalid F S s hs)
    (fun s => pow_pos hv _) hR hC hrow hcol
    (pd4c_memEdgePiece_sym_kernel_invalid F S ρ w raw St Pr j)
  intro T T' f hf hT hT' s hs hsvalid
  rw [pd4c_memEdgePiece_sym_finite_kernel δ c₁ c₂ F S ρ w raw St Pr j hS hw T f hf s]
  apply Finset.sum_congr rfl
  intro t ht
  by_cases htvalid : MemValid F S t
  · simp [hsvalid, htvalid]
  · simp [hsvalid, htvalid, pd4c_memEdgePiece_sym_kernel_invalid F S ρ w raw St Pr j s t hsvalid htvalid]

private theorem pd4c_edge_memory_size_le {K : ℕ} (F : PDFix K) (S : PDScale)
    (s : MemPoint S.x K) (c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i) (z' : ℤ × ℤ) :
    memSize (z', edgeTargetLists F S s c, edgeNewMemory F S s c) ≤ memSize s + K := by
  have hlen (i : Fin K) : (edgeNewMemory F S s c i).length ≤ (s.2.2 i).length + 1 := by
    have hrem (D : Finset (Fin (s.2.2 i).length)) :
        (removeIndices (s.2.2 i) D).length ≤ (s.2.2 i).length := by
      unfold removeIndices
      exact (List.length_filterMap_le _ _).trans_eq (List.length_finRange)
    unfold edgeNewMemory
    rw [List.length_append]
    split_ifs <;> simp only [List.length_singleton, List.length_nil]
    · exact Nat.add_le_add_right (hrem _) 1
    · exact (hrem _).trans (Nat.le_add_right _ _)
  unfold memSize
  calc
    _ ≤ ∑ i : Fin K, ((s.2.2 i).length + 1) := Finset.sum_le_sum fun i hi => hlen i
    _ = _ := by simp [Finset.sum_add_distrib]

private theorem pd4c_edgeChoiceCoeff_norm_le {K : ℕ} (F : PDFix K) (S : PDScale)
    (ρ : ℝ) (j : ℕ) (raw : Bool) (s : MemPoint S.x K)
    (c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i) (z' : ℤ × ℤ) (C : ℝ)
    (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1)
    (hweight : ∀ i, 0 ≤ pd4c_choicePrimeWeight F S s i (c i))
    (hC : 0 ≤ C)
    (hgeom : ‖edgeMultiplier F S (decide (j % 2 = 0)) raw s.2.1
      (edgeTargetLists F S s c) s.1 z'‖ ≤ C) :
    ‖pd4c_edgeChoiceCoeff F S ρ j raw s c z'‖ ≤
      C * ∏ i : Fin K, pd4c_choicePrimeWeight F S s i (c i) := by
  let P := ∏ i : Fin K, pd4c_choicePrimeWeight F S s i (c i)
  let hs := ∑ i : Fin K, hitCount (s.2.2 i) s.1
  let ht := ∑ i : Fin K, hitCount (edgeNewMemory F S s c i) z'
  have hP : 0 ≤ P := Finset.prod_nonneg fun i hi => hweight i
  have hρs : 0 ≤ ρ ^ hs := pow_nonneg hρ0 _
  have hρt : 0 ≤ ρ ^ ht := pow_nonneg hρ0 _
  have hρs1 : ρ ^ hs ≤ 1 := pow_le_one₀ hρ0 hρ1
  have hρt1 : ρ ^ ht ≤ 1 := pow_le_one₀ hρ0 hρ1
  have hnorm : ‖(((ρ ^ hs * P * ρ ^ ht : ℝ) : ℂ))‖ = ρ ^ hs * P * ρ ^ ht := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (mul_nonneg hρs hP) hρt)]
  change ‖(((ρ ^ hs * P * ρ ^ ht : ℝ) : ℂ)) *
    edgeMultiplier F S (decide (j % 2 = 0)) raw s.2.1 (edgeTargetLists F S s c) s.1 z'‖ ≤ _
  rw [norm_mul, hnorm]
  have hfactor : ρ ^ hs * P * ρ ^ ht ≤ P := by
    calc
      _ ≤ 1 * P * 1 := mul_le_mul (mul_le_mul_of_nonneg_right hρs1 hP) hρt1 hρt (by positivity)
      _ = P := by ring
  calc
    _ ≤ P * C := mul_le_mul hfactor hgeom (norm_nonneg _) hP
    _ = _ := mul_comm _ _

private theorem pd4c_edge_target_weight_le {K : ℕ} (F : PDFix K) (S : PDScale)
    (s : MemPoint S.x K) (c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i) (z' : ℤ × ℤ)
    (v : ℝ) (hv : 1 ≤ v) :
    v ^ memSize (z', edgeTargetLists F S s c, edgeNewMemory F S s c) ≤ v ^ K * v ^ memSize s := by
  calc
    _ ≤ v ^ (memSize s + K) := pow_le_pow_right₀ hv (pd4c_edge_memory_size_le F S s c z')
    _ = _ := by rw [pow_add]; ring

private theorem pd4c_edgeRowMass_le_of_count {K : ℕ} (δ c₁ c₂ : ℝ)
    (F : PDFix K) (S : PDScale) (ρ : ℝ) (w : ArchRoot) (raw : Bool)
    (St Pr : Finset (Fin K)) (j : ℕ) (v C R : ℝ) (s : MemPoint S.x K)
    (hS : S.Valid K δ c₁ c₂) (hw : w.InRegion S)
    (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1) (hv : 1 ≤ v) (hC : 0 ≤ C) (hR : 0 ≤ R)
    (hweight : ∀ c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i,
      ∀ i, 0 ≤ pd4c_choicePrimeWeight F S s i (c i))
    (hgeom : ∀ c z', EdgeAdmissible F S w s c z' →
      ‖edgeMultiplier F S (decide (j % 2 = 0)) raw s.2.1
        (edgeTargetLists F S s c) s.1 z'‖ ≤ C)
    (hcount : ∀ c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i, edgePromotedSet c = Pr →
      ({z' : ℤ × ℤ | EdgeAdmissible F S w s c z' ∧
        pd4c_edgeChoiceCoeff F S ρ j raw s c z' ≠ 0}.ncard : ℝ) ≤ R) :
    pd4c_edgeRowMass F S ρ w j raw St Pr v s ≤
      C * v ^ K * v ^ memSize s * R *
        (∑ c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i,
          if edgePromotedSet c = Pr then ∏ i : Fin K, pd4c_choicePrimeWeight F S s i (c i) else 0) := by
  classical
  let Z := (envBox_finite δ c₁ c₂ S w hS hw).toFinset
  let good (c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i) (z' : ℤ × ℤ) : Prop :=
    edgeStoredSet c = St ∧ edgePromotedSet c = Pr ∧ EdgeAdmissible F S w s c z'
  let P (c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i) : ℝ :=
    ∏ i : Fin K, pd4c_choicePrimeWeight F S s i (c i)
  have hv0 : 0 ≤ v := by linarith
  have hP (c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i) : 0 ≤ P c :=
    Finset.prod_nonneg fun i hi => hweight c i
  have hrow (c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i) :
      (∑' z', if good c z' then ‖pd4c_edgeChoiceCoeff F S ρ j raw s c z'‖ *
        v ^ memSize (z', edgeTargetLists F S s c, edgeNewMemory F S s c) else 0) ≤
          if edgePromotedSet c = Pr then C * v ^ K * v ^ memSize s * R * P c else 0 := by
    by_cases hc : edgePromotedSet c = Pr
    · rw [if_pos hc]
      let U := Z.filter fun z' => good c z' ∧ pd4c_edgeChoiceCoeff F S ρ j raw s c z' ≠ 0
      have hsupport :
          (∑' z', if good c z' then ‖pd4c_edgeChoiceCoeff F S ρ j raw s c z'‖ *
            v ^ memSize (z', edgeTargetLists F S s c, edgeNewMemory F S s c) else 0) =
          ∑ z' ∈ U, ‖pd4c_edgeChoiceCoeff F S ρ j raw s c z'‖ *
            v ^ memSize (z', edgeTargetLists F S s c, edgeNewMemory F S s c) := by
        rw [tsum_eq_sum (s := U)]
        · apply Finset.sum_congr rfl
          intro z' hz'
          have hg := (Finset.mem_filter.mp hz').2.1
          simp only [if_pos hg]
        · intro z' hz'
          by_cases hg : good c z'
          · have hzbox : envBox S w z' := hg.2.2.2.2.2.2.2.2.2.1
            have hzZ : z' ∈ Z := by simpa [Z] using hzbox
            have hzero : pd4c_edgeChoiceCoeff F S ρ j raw s c z' = 0 := by
              by_contra hn
              exact hz' (Finset.mem_filter.mpr ⟨hzZ, hg, hn⟩)
            simp [hg, hzero]
          · simp [hg]
      have hUcard : (U.card : ℝ) ≤ R := by
        have hsub : (U : Set (ℤ × ℤ)) ⊆ {z' | EdgeAdmissible F S w s c z' ∧
            pd4c_edgeChoiceCoeff F S ρ j raw s c z' ≠ 0} := by
          intro z' hz'
          exact ⟨(Finset.mem_filter.mp hz').2.1.2.2, (Finset.mem_filter.mp hz').2.2⟩
        have hfinite : {z' | EdgeAdmissible F S w s c z' ∧
            pd4c_edgeChoiceCoeff F S ρ j raw s c z' ≠ 0}.Finite := by
          apply (envBox_finite δ c₁ c₂ S w hS hw).subset
          intro z' hz'
          exact hz'.1.2.2.2.2.2.2.2.1
        have hcard := Set.ncard_le_ncard hsub hfinite
        exact (show (U.card : ℝ) ≤ _ by exact_mod_cast (by simpa using hcard)).trans (hcount c hc)
      have hterm (z' : ℤ × ℤ) (hz' : z' ∈ U) :
          ‖pd4c_edgeChoiceCoeff F S ρ j raw s c z'‖ *
            v ^ memSize (z', edgeTargetLists F S s c, edgeNewMemory F S s c) ≤
          C * P c * (v ^ K * v ^ memSize s) := by
        have hg := (Finset.mem_filter.mp hz').2.1.2.2
        exact mul_le_mul
          (pd4c_edgeChoiceCoeff_norm_le F S ρ j raw s c z' C hρ0 hρ1 (hweight c) hC (hgeom c z' hg))
          (pd4c_edge_target_weight_le F S s c z' v hv)
          (pow_nonneg hv0 _) (mul_nonneg hC (hP c))
      rw [hsupport]
      calc
        _ ≤ ∑ z' ∈ U, C * P c * (v ^ K * v ^ memSize s) := Finset.sum_le_sum fun z' hz' => hterm z' hz'
        _ = (U.card : ℝ) * (C * P c * (v ^ K * v ^ memSize s)) := by simp
        _ ≤ R * (C * P c * (v ^ K * v ^ memSize s)) :=
          mul_le_mul_of_nonneg_right hUcard
            (mul_nonneg (mul_nonneg hC (hP c)) (mul_nonneg (pow_nonneg hv0 _) (pow_nonneg hv0 _)))
        _ = _ := by ring
    · rw [if_neg hc]
      have hzero : (∑' z', if good c z' then ‖pd4c_edgeChoiceCoeff F S ρ j raw s c z'‖ *
          v ^ memSize (z', edgeTargetLists F S s c, edgeNewMemory F S s c) else 0) = 0 := by
        have hfun : (fun z' => if good c z' then ‖pd4c_edgeChoiceCoeff F S ρ j raw s c z'‖ *
            v ^ memSize (z', edgeTargetLists F S s c, edgeNewMemory F S s c) else 0) = fun _ => (0 : ℝ) := by
          funext z'
          have hn : ¬ good c z' := fun h => hc h.2.1
          simp [hn]
        rw [hfun]
        exact tsum_zero
      simpa only [hzero] using (le_rfl : (0 : ℝ) ≤ 0)
  unfold pd4c_edgeRowMass
  calc
    _ ≤ ∑ c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i,
        if edgePromotedSet c = Pr then C * v ^ K * v ^ memSize s * R * P c else 0 :=
      Finset.sum_le_sum fun c hc => hrow c
    _ = _ := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro c hc
      by_cases heq : edgePromotedSet c = Pr <;> simp [heq, P]
private theorem pd4c_exists_psi_radius {K : ℕ} (F : PDFix K) (hF : F.Valid) :
    ∃ R : ℝ, 16 ≤ R ∧ ∀ t : ℝ, F.psi t ≠ 0 → |t| ≤ R := by
  have hc : IsCompact (tsupport F.psi) := hF.2.2.2.2.2.2.1
  obtain ⟨R, hR⟩ := hc.isBounded.exists_norm_le
  refine ⟨max 16 R, le_max_left _ _, ?_⟩
  intro t ht
  have hmem : t ∈ tsupport F.psi := subset_closure ht
  exact (show |t| ≤ R by simpa only [Real.norm_eq_abs] using hR t hmem).trans (le_max_right _ _)

private theorem pd4c_comparison_edge_support {K : ℕ} (F : PDFix K) (S : PDScale)
    (forward : Bool) (p q : PrimeLists S.x K) (z z' : ℤ × ℤ) (R : ℝ)
    (hY : 0 < S.Y) (hdiv : (sharedProduct p : ℤ) ∣ det2 z z')
    (hR : ∀ t : ℝ, F.psi t ≠ 0 → |t| ≤ R)
    (h : edgeMultiplier F S forward false p q z z' ≠ 0) :
    |((det2 z z' / (sharedProduct p : ℤ) : ℤ) : ℝ)| ≤ R * S.Y := by
  have hsupport (a b : ℕ) (t : ℤ) (ht : comparisonMultiplier F S (sharedProduct p) a b t ≠ 0) :
      |(t : ℝ)| ≤ R * S.Y := by
    have hψ : F.psi ((t : ℝ) / S.Y) ≠ 0 := by
      intro hz
      apply ht
      simp [comparisonMultiplier, majorKernel, hz]
    have hb := hR ((t : ℝ) / S.Y) hψ
    rw [abs_div, abs_of_pos hY] at hb
    exact (div_le_iff₀ hY).mp hb
  cases forward with
  | true =>
    apply hsupport (lastProduct q) (lastProduct p) _
    intro hz
    apply h
    simp [edgeMultiplier, hz]
  | false =>
    have hr : comparisonMultiplier F S (sharedProduct p) (lastProduct p) (lastProduct q)
        (det2 z' z / (sharedProduct p : ℤ)) ≠ 0 := by
      intro hz
      apply h
      simp [edgeMultiplier, hz]
    have hswap : det2 z' z = -det2 z z' := by dsimp [det2]; ring
    have hb := hsupport (lastProduct p) (lastProduct q) _ hr
    rw [hswap, Int.neg_ediv_of_dvd hdiv, Int.cast_neg, abs_neg] at hb
    exact hb

private theorem pd4c_memEdge_dirtyCmp_eq_piece_sum {K : ℕ} (F : PDFix K) (S : PDScale)
    (ρ : ℝ) (w : ArchRoot) (j : ℕ) :
    memEdge F S ρ w EdgeKind.dirtyCmp j =
      (fun f s => ∑ St : Finset (Fin K), ∑ Pr : Finset (Fin K),
        (if St = ∅ ∧ Pr = ∅ then 0 else
          memEdgePiece F S ρ w false St Pr j f s)) := by
  funext f s
  simp only [memEdge, plainOp, logEdge, memEdgePiece]
  dsimp [logSym]
  simp_rw [Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro St hSt
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro Pr hPr
  by_cases hempty : St = ∅ ∧ Pr = ∅ <;> simp [hempty]

private theorem pd4c_scale_Y_pad_pos {K : ℕ} (δ c₁ c₂ : ℝ) (S : PDScale)
    (hS : S.Valid K δ c₁ c₂) : 0 < S.Y ∧ 0 < (S.d₀ : ℝ) := by
  rcases Finset.mem_filter.mp hS.2.2.2.2.2.1 with ⟨hY, _⟩
  rcases Finset.mem_image.mp hY with ⟨n, hn, hEq⟩
  have hYpos : 0 < S.Y := by rw [← hEq]; positivity
  rcases Finset.mem_image.mp hS.2.2.2.2.2.2 with ⟨m, hm, hEq'⟩
  have hdpos : 0 < (S.d₀ : ℝ) := by rw [← hEq']; positivity
  exact ⟨hYpos, hdpos⟩

private theorem pd4c_edge_comparison_norm_le {K : ℕ} (F : PDFix K) (S : PDScale)
    (forward : Bool) (p q : PrimeLists S.x K) (z z' : ℤ × ℤ) (Ceta Cpsi : ℝ)
    (hL : 1 ≤ S.L) (hA : 0 ≤ F.A₀) (hY : 0 < S.Y) (hd : 0 < (S.d₀ : ℝ))
    (hPad : IsPadAdmissible S.d₀ (sharedProduct p) (det2 z z'))
    (hEta : ∀ t, ‖(F.eta t : ℂ)‖ ≤ Ceta) (hPsi : ∀ t, ‖(F.psi t : ℂ)‖ ≤ Cpsi)
    (hCeta : 0 ≤ Ceta) (hCpsi : 0 ≤ Cpsi) :
    ‖edgeMultiplier F S forward false p q z z'‖ ≤
      Ceta ^ 2 * Cpsi * (32 * Real.rpow S.L F.A₀ ^ 3 / S.Y) := by
  cases forward with
  | true =>
    exact comparisonMultiplier_norm_le F S (sharedProduct p) (lastProduct q) (lastProduct p)
      _ Ceta Cpsi hL hA hY (det2 z z') hPad hd (hEta _) (hEta _) (hPsi _) hCeta hCpsi
  | false =>
    change ‖star (comparisonMultiplier F S (sharedProduct p) (lastProduct p) (lastProduct q)
      (det2 z' z / (sharedProduct p : ℤ)))‖ ≤ _
    rw [norm_star]
    exact comparisonMultiplier_norm_le F S (sharedProduct p) (lastProduct p) (lastProduct q)
      _ Ceta Cpsi hL hA hY (det2 z z') hPad hd (hEta _) (hEta _) (hPsi _) hCeta hCpsi

private theorem pd4c_band_prime_inverse_le {K : ℕ} (F : PDFix K) (S : PDScale)
    (hF : F.Valid) (hL : 1 ≤ S.L) (i : Fin K) (p : ℕ) (hp : p ∈ primeBand S.x (F.a i)) :
    1 / (p : ℝ) ≤ Real.exp (-Real.rpow S.L (1 / 10 : ℝ)) := by
  have hpband := (Finset.mem_filter.mp hp).2
  have hpow : Real.rpow S.L (1 / 10 : ℝ) ≤ Real.rpow S.L (F.a i) :=
    Real.rpow_le_rpow_of_exponent_le hL (hF.1.2.1 i).1.le
  have hlower : Real.exp (Real.rpow S.L (1 / 10 : ℝ)) ≤ (p : ℝ) :=
    (Real.exp_le_exp.mpr hpow).trans hpband.2.1
  calc
    _ ≤ 1 / Real.exp (Real.rpow S.L (1 / 10 : ℝ)) :=
      one_div_le_one_div_of_le (Real.exp_pos _) hlower
    _ = _ := by rw [one_div, Real.exp_neg]

private theorem pd4c_comparison_support_count (Rψ : ℝ) (hRψ : 16 ≤ Rψ) :
    ∃ C₂ Y₀ : ℝ, 0 < C₂ ∧ 1 ≤ Y₀ ∧
      ∀ (K : ℕ) (F : PDFix K) (S : PDScale) (w : ArchRoot) (δ c₁ c₂ : ℝ),
      F.Valid → S.Valid K δ c₁ c₂ → w.InRegion S → Y₀ ≤ S.Y → 1 ≤ S.L →
      (∀ t : ℝ, F.psi t ≠ 0 → |t| ≤ Rψ) →
      ∀ (ρ : ℝ) (j : ℕ) (s : MemPoint S.x K)
        (c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i),
      MemValid F S s → (edgePromotedSet c).Nonempty →
        ({z' : ℤ × ℤ | EdgeAdmissible F S w s c z' ∧
          pd4c_edgeChoiceCoeff F S ρ j false s c z' ≠ 0}.ncard : ℝ) ≤
            12 * C₂ * S.Y * (Real.exp (-Real.rpow S.L (1 / 10 : ℝ)) +
              Real.rpow S.Y (-(1 / 10 : ℝ))) := by
  classical
  obtain ⟨C₂, Y₀, hC₂, hY₀, hcount⟩ := pd4c_promoted_target_count Rψ hRψ
  refine ⟨C₂, Y₀, hC₂, hY₀, ?_⟩
  intro K F S w δ c₁ c₂ hF hS hw hY hL hRadius ρ j s c hs hPr
  let A : Set (ℤ × ℤ) := {z' | EdgeAdmissible F S w s c z' ∧
    pd4c_edgeChoiceCoeff F S ρ j false s c z' ≠ 0}
  obtain ⟨hYpos, _⟩ := pd4c_scale_Y_pad_pos δ c₁ c₂ S hS
  by_cases hA : A.Nonempty
  · obtain ⟨z₀, hadm, hcoef⟩ := hA
    obtain ⟨i, hi⟩ := hPr
    have hleft : (c i).2.isLeft = true := (Finset.mem_filter.mp hi).2
    obtain ⟨k, hk⟩ : ∃ k, (c i).2 = Sum.inl k := by
      cases he : (c i).2 with
      | inl k => exact ⟨k, rfl⟩
      | inr p => simp [he] at hleft
    have hlabel : edgeTargetLists F S s c i (lastSlot S.x) = ((s.2.2 i).get k).1 := by
      simp [edgeTargetLists, lastSlot, edgeNewLabel, hk]
    have hban : ∀ i' j', ((s.2.2 i).get k).1 ≠ s.2.1 i' j' := by
      intro i' j'
      simpa only [hlabel] using hadm.2.2.2.1.2 i i' j'
    have hBound := hcount K F S w δ c₁ c₂ hS hw hY s c i k hs hadm.2.1
      hadm.2.2.2.2.2.2.1 hadm.2.2.2.2.2.2.2.2.1
      hadm.2.2.2.2.1.1 hadm.2.2.2.2.1.2.1 hk hban
    let T : Set (ℤ × ℤ) := {z' | EdgeAdmissible F S w s c z' ∧
      |((det2 s.1 z' / (sharedProduct s.2.1 : ℤ) : ℤ) : ℝ)| ≤ Rψ * S.Y}
    have hTfinite : T.Finite := by
      apply (envBox_finite δ c₁ c₂ S w hS hw).subset
      intro z' hz'
      exact hz'.1.2.2.2.2.2.2.2.1
    have hsub : A ⊆ T := by
      intro z' hz'
      refine ⟨hz'.1, ?_⟩
      have hgeom : edgeMultiplier F S (decide (j % 2 = 0)) false s.2.1
          (edgeTargetLists F S s c) s.1 z' ≠ 0 := by
        intro hzero
        exact hz'.2 (by simp [pd4c_edgeChoiceCoeff, hzero])
      exact pd4c_comparison_edge_support F S _ _ _ _ _ Rψ hYpos
        hz'.1.2.2.2.2.1.2.2 hRadius hgeom
    have hprime := (hs.2.2 i _ (List.get_mem _ k)).1
    have hinv := pd4c_band_prime_inverse_le F S hF hL i _ hprime
    calc
      _ ≤ (T.ncard : ℝ) := by exact_mod_cast Set.ncard_le_ncard hsub hTfinite
      _ ≤ 12 * C₂ * S.Y * (1 / (((s.2.2 i).get k).1 : ℝ) + Real.rpow S.Y (-(1 / 10 : ℝ))) := hBound
      _ ≤ _ := mul_le_mul_of_nonneg_left (add_le_add hinv le_rfl) (by positivity)
  · have hEmpty : A = ∅ := Set.not_nonempty_iff_eq_empty.mp hA
    change (A.ncard : ℝ) ≤ _
    rw [hEmpty]
    simp only [Set.ncard_empty, Nat.cast_zero]
    exact mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hC₂.le) hYpos.le)
      (add_nonneg (Real.exp_pos _).le (Real.rpow_nonneg hYpos.le _))

private theorem pd4c_comparison_small_row (Rψ : ℝ) (hRψ : 16 ≤ Rψ) :
    ∃ C₂ Y₀ : ℝ, 0 < C₂ ∧ 1 ≤ Y₀ ∧
      ∀ (K : ℕ) (F : PDFix K) (S : PDScale) (w : ArchRoot) (δ c₁ c₂ : ℝ),
      F.Valid → S.Valid K δ c₁ c₂ → w.InRegion S → Y₀ ≤ S.Y → 1 ≤ S.L →
      (∀ t : ℝ, F.psi t ≠ 0 → |t| ≤ Rψ) →
      ∀ (ρ v Ceta Cpsi Cmass : ℝ) (B j : ℕ) (St Pr : Finset (Fin K)),
      0 ≤ ρ → ρ ≤ 1 → 1 ≤ v → 0 ≤ Ceta → 0 ≤ Cpsi → 2 ≤ Cmass → 1 ≤ B → Pr.Nonempty →
      (∀ t, ‖(F.eta t : ℂ)‖ ≤ Ceta) → (∀ t, ‖(F.psi t : ℂ)‖ ≤ Cpsi) →
      (∀ i, 0 < bandMass S.x (F.a i)) → (∀ i, (bandMass S.x (F.a i))⁻¹ ≤ Cmass) →
      (∀ i, ∀ p : primeBand S.x (F.a i), 0 ≤ memoryNu S.x K F.a F.q_d i p) →
      (∀ i, (∑ p : primeBand S.x (F.a i), memoryNu S.x K F.a F.q_d i p) ≤ 2) →
      MemRowSchurLE_sym F S B (memEdgePiece F S ρ w false St Pr j) v
        (Ceta ^ 2 * Cpsi * (32 * Real.rpow S.L F.A₀ ^ 3 / S.Y) * v ^ K *
          (12 * C₂ * S.Y * (Real.exp (-Real.rpow S.L (1 / 10 : ℝ)) + Real.rpow S.Y (-(1 / 10 : ℝ)))) *
          (2 * Cmass * (B : ℝ)) ^ K) := by
  obtain ⟨C₂, Y₀, hC₂, hY₀, hcount⟩ := pd4c_comparison_support_count Rψ hRψ
  refine ⟨C₂, Y₀, hC₂, hY₀, ?_⟩
  intro K F S w δ c₁ c₂ hF hS hw hY hL hRadius ρ v Ceta Cpsi Cmass B j St Pr
    hρ0 hρ1 hv hEta0 hPsi0 hMass hB hPr hEta hPsi hV hVinv hν hνsum
  let Cgeo := Ceta ^ 2 * Cpsi * (32 * Real.rpow S.L F.A₀ ^ 3 / S.Y)
  let Rcount := 12 * C₂ * S.Y *
    (Real.exp (-Real.rpow S.L (1 / 10 : ℝ)) + Real.rpow S.Y (-(1 / 10 : ℝ)))
  obtain ⟨hYpos, hdpos⟩ := pd4c_scale_Y_pad_pos δ c₁ c₂ S hS
  have hLpos : 0 < S.L := by linarith
  have hv0 : 0 ≤ v := by linarith
  have hCgeo : 0 ≤ Cgeo := by
    exact mul_nonneg (mul_nonneg (sq_nonneg _) hPsi0)
      (div_nonneg (mul_nonneg (by norm_num) (pow_nonneg (Real.rpow_pos_of_pos hLpos _).le _)) hYpos.le)
  have hRcount : 0 ≤ Rcount := by
    exact mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hC₂.le) hYpos.le)
      (add_nonneg (Real.exp_pos _).le (Real.rpow_nonneg hYpos.le _))
  intro s hs hsize T hT
  have hmass (σ : Fin K → Equiv.Perm (Fin (slotCount S.x))) :
      pd4c_edgeRowMass F S ρ w j false St Pr v (s.1, permuteLists σ s.2.1, s.2.2) ≤
        Cgeo * v ^ K * v ^ memSize s * Rcount * (2 * Cmass * (B : ℝ)) ^ K := by
    let t : MemPoint S.x K := (s.1, permuteLists σ s.2.1, s.2.2)
    have ht : MemValid F S t := memPoint_permute_valid F S σ s hs
    have hweight (c : (i : Fin K) → EdgeChoice S.x F.a (t.2.2 i) i) (i : Fin K) :
        0 ≤ pd4c_choicePrimeWeight F S t i (c i) := by
      cases he : (c i).2 with
      | inl k => simpa only [pd4c_choicePrimeWeight, he] using inv_nonneg.mpr (hV i).le
      | inr p => simpa only [pd4c_choicePrimeWeight, he] using hν i p
    have hgeom (c : (i : Fin K) → EdgeChoice S.x F.a (t.2.2 i) i) (z' : ℤ × ℤ)
        (hadm : EdgeAdmissible F S w t c z') :
        ‖edgeMultiplier F S (decide (j % 2 = 0)) false t.2.1 (edgeTargetLists F S t c) t.1 z'‖ ≤ Cgeo :=
      pd4c_edge_comparison_norm_le F S _ _ _ _ _ Ceta Cpsi hL hF.2.2.2.1.le hYpos hdpos
        hadm.2.2.2.2.1 hEta hPsi hEta0 hPsi0
    have htargets (c : (i : Fin K) → EdgeChoice S.x F.a (t.2.2 i) i) (hc : edgePromotedSet c = Pr) :
        ({z' | EdgeAdmissible F S w t c z' ∧ pd4c_edgeChoiceCoeff F S ρ j false t c z' ≠ 0}.ncard : ℝ) ≤ Rcount :=
      hcount K F S w δ c₁ c₂ hF hS hw hY hL hRadius ρ j t c ht (hc.symm ▸ hPr)
    have hrow := pd4c_edgeRowMass_le_of_count δ c₁ c₂ F S ρ w false St Pr j v Cgeo Rcount t
      hS hw hρ0 hρ1 hv hCgeo hRcount hweight hgeom htargets
    have hlen (i : Fin K) : ((t.2.2 i).length : ℝ) ≤ (B : ℝ) := by
      have hle : (s.2.2 i).length ≤ memSize s :=
        Finset.single_le_sum (s := Finset.univ) (f := fun j : Fin K => (s.2.2 j).length)
          (fun j hj => Nat.zero_le _) (Finset.mem_univ i)
      exact_mod_cast le_trans hle hsize
    have hchoices := pd4c_promoted_choice_mass_le F S t Pr (B : ℝ) Cmass
      (by exact_mod_cast hB) hMass hlen hV hVinv hν hνsum
    exact hrow.trans (mul_le_mul_of_nonneg_left hchoices
      (mul_nonneg (mul_nonneg (mul_nonneg hCgeo (pow_nonneg hv0 _)) (pow_nonneg hv0 _)) hRcount))
  have hrow := pd4c_memEdgePiece_projected_row_mass δ c₁ c₂ F S ρ w false St Pr j hS hw s T v hv0
  have hd : (permCount S.x K : ℝ) ≠ 0 := by
    exact_mod_cast (show permCount S.x K ≠ 0 from Fintype.card_ne_zero)
  calc
    _ ≤ (permCount S.x K : ℝ)⁻¹ *
        ∑ σ : Fin K → Equiv.Perm (Fin (slotCount S.x)),
          pd4c_edgeRowMass F S ρ w j false St Pr v (s.1, permuteLists σ s.2.1, s.2.2) := hrow
    _ ≤ (permCount S.x K : ℝ)⁻¹ *
        ∑ _ : Fin K → Equiv.Perm (Fin (slotCount S.x)),
          Cgeo * v ^ K * v ^ memSize s * Rcount * (2 * Cmass * (B : ℝ)) ^ K := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      exact Finset.sum_le_sum fun σ hσ => hmass σ
    _ = _ := by
      simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
      change (permCount S.x K : ℝ)⁻¹ * ((permCount S.x K : ℝ) * _) = _
      field_simp [hd] <;> dsimp [Cgeo, Rcount] <;> field_simp [hYpos.ne'] <;> ring

private theorem pd4c_bandMass_large_bounds {K : ℕ} (F : PDFix K) (hF : F.Valid) :
    ∃ x₀ : ℝ, 2 ≤ x₀ ∧ ∀ x : ℝ, x₀ ≤ x → ∀ i : Fin K,
      Real.log 2 / 2 ≤ bandMass x (F.a i) ∧ bandMass x (F.a i) ≤ 2 * Real.log 2 := by
  classical
  have heps : 0 < Real.log 2 / 2 := div_pos (Real.log_pos (by norm_num)) (by norm_num)
  have hmass (i : Fin K) := band_mass (F.a i)
    (lt_trans (by norm_num : (0 : ℝ) < 1 / 10) (hF.1.2.1 i).1)
    (lt_trans (hF.1.2.1 i).2 (by norm_num)) (Real.log 2 / 2) heps
  let x_i : Fin K → ℝ := fun i => Classical.choose (hmass i)
  have hx_i (i : Fin K) : 2 ≤ x_i i ∧ ∀ x : ℝ, x_i i ≤ x →
      |bandMass x (F.a i) - Real.log 2| ≤ Real.log 2 / 2 ∧ 0 < bandMass x (F.a i) :=
    Classical.choose_spec (hmass i)
  let x₀ := 2 + ∑ i : Fin K, x_i i
  have hx₀ : 2 ≤ x₀ := by
    have hsum := Finset.sum_nonneg (fun i (_ : i ∈ (Finset.univ : Finset (Fin K))) =>
      (show 0 ≤ x_i i by linarith [(hx_i i).1]))
    dsimp [x₀]
    linarith
  refine ⟨x₀, hx₀, ?_⟩
  intro x hx i
  have hi : x_i i ≤ ∑ j : Fin K, x_i j :=
    Finset.single_le_sum (fun j hj => by linarith [(hx_i j).1]) (Finset.mem_univ i)
  have hxi : x_i i ≤ x := by dsimp [x₀] at hx; linarith
  have ha := (hx_i i).2 x hxi
  have hlow := (abs_le.mp ha.1).1
  have hhigh := (abs_le.mp ha.1).2
  constructor <;> linarith [Real.log_pos (by norm_num : (1 : ℝ) < 2)]

private theorem pd4c_memMeasure_nonneg_eventually {K : ℕ} (F : PDFix K) (hF : F.Valid) :
    ∃ x₀ : ℝ, 2 ≤ x₀ ∧ ∀ S : PDScale, x₀ ≤ S.x → ∀ s, 0 ≤ memMeasure F S s := by
  obtain ⟨xV, hxV, hV⟩ := pd4c_bandMass_large_bounds F hF
  obtain ⟨xB, hxB, hB⟩ := memoryBPrime_half_of_large_x F hF
  refine ⟨max xV xB, le_trans hxV (le_max_left _ _), ?_⟩
  intro S hx
  apply pd4c_memMeasure_nonneg_of_nu F S
  intro i p hp
  have hVlower := (hV S.x (le_trans (le_max_left _ _) hx) i).1
  have hVpos : 0 < bandMass S.x (F.a i) :=
    lt_of_lt_of_le (div_pos (Real.log_pos (by norm_num)) (by norm_num)) hVlower
  have hpmark : p ∈ markedPrimes S.x K F.a :=
    Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i, hp⟩
  exact (pd4c_memoryNu_le_twice_mu F.q_d i p (Finset.mem_filter.mp hp).2.1.pos hVpos
    (hB S.x (le_trans (le_max_right _ _) hx) p hpmark)).1

private theorem pd4c_dirty_piece_norm_of_table {K : ℕ} (δ c₁ c₂ : ℝ)
    (F : PDFix K) (S : PDScale) (ρ : ℝ) (w : ArchRoot) (raw : Bool)
    (St Pr : Finset (Fin K)) (j B : ℕ) (v C D : ℝ)
    (hS : S.Valid K δ c₁ c₂) (hw : w.InRegion S) (hμ : ∀ s, 0 ≤ memMeasure F S s)
    (hv : 0 < v) (hC : 0 ≤ C) (hD : 0 ≤ D) (hD1 : D ≤ 1)
    (hne : St.Nonempty ∨ Pr.Nonempty)
    (hrow : MemRowSchurLE_sym F S B (memEdgePiece F S ρ w raw St Pr j) v
      (if Pr.Nonempty then C * D else C))
    (hcol : MemColSchurLE_sym F S B (memEdgePiece F S ρ w raw St Pr j) v
      (if St.Nonempty then C * D else C)) :
    MemOpNormLE_sym F S B (memEdgePiece F S ρ w raw St Pr j) (C * Real.sqrt D) := by
  let R := if Pr.Nonempty then C * D else C
  let Q := if St.Nonempty then C * D else C
  have hR : 0 ≤ R := by dsimp [R]; split_ifs <;> positivity
  have hQ : 0 ≤ Q := by dsimp [Q]; split_ifs <;> positivity
  have hp : R * Q ≤ C ^ 2 * D := by
    rcases hne with hSt | hPr
    · dsimp [R, Q]
      rw [if_pos hSt]
      by_cases hPr : Pr.Nonempty
      · rw [if_pos hPr]
        have h := mul_nonneg (sq_nonneg C) (mul_nonneg hD (sub_nonneg.mpr hD1))
        nlinarith
      · rw [if_neg hPr]
        nlinarith
    · dsimp [R, Q]
      rw [if_pos hPr]
      by_cases hSt : St.Nonempty
      · rw [if_pos hSt]
        have h := mul_nonneg (sq_nonneg C) (mul_nonneg hD (sub_nonneg.mpr hD1))
        nlinarith
      · rw [if_neg hSt]
        nlinarith
  have hn := pd4c_memEdgePiece_sym_schur δ c₁ c₂ F S ρ w raw St Pr j B v R Q
    hS hw hμ hv hR hQ hrow hcol
  have hbound : Real.sqrt (R * Q) ≤ C * Real.sqrt D := by
    calc
      _ ≤ Real.sqrt (C ^ 2 * D) := Real.sqrt_le_sqrt hp
      _ = C * Real.sqrt D := by rw [Real.sqrt_mul (sq_nonneg C), Real.sqrt_sq hC]
  exact pd4c_memOpNormLE_mono F S B
    (fun f => memEdgePiece F S ρ w raw St Pr j (memorySym f))
    (Real.sqrt (R * Q)) (C * Real.sqrt D) hμ hn (Real.sqrt_nonneg _) hbound

private theorem pd4c_strip_box_count (C₁ : ℝ) (hC₁ : 1 ≤ C₁) :
    ∃ C₂ Y₀ : ℝ, 0 < C₂ ∧ 1 ≤ Y₀ ∧ ∀ Y : ℝ, Y₀ ≤ Y → ∀ α : ℝ,
      (∀ l : ℕ, 1 ≤ l → (l : ℝ) ≤ Real.rpow Y (1 / 5 : ℝ) →
        Real.rpow Y (-(7 / 10 : ℝ)) < circleDistance ((l : ℝ) * α)) →
      {q : ℤ × ℤ | |(q.2 : ℝ)| ≤ C₁ * Y ∧ |(q.1 : ℝ) + (q.2 : ℝ) * α| ≤ C₁}.Finite ∧
      ({q : ℤ × ℤ | |(q.2 : ℝ)| ≤ C₁ * Y ∧ |(q.1 : ℝ) + (q.2 : ℝ) * α| ≤ C₁}.ncard : ℝ) ≤
        9 * C₂ * Y := by
  classical
  obtain ⟨C₂, Y₀, hC₂, hY₀, hShape⟩ := lattice_shape C₁ hC₁
  refine ⟨C₂, Y₀, hC₂, hY₀, ?_⟩
  intro Y hY α hα
  obtain ⟨a₀, b₀, c₀, d₀, A, D, hdet, hAD, hA, _, hD, _, hcoords⟩ := hShape Y hY α hα
  let trans : ℤ × ℤ → ℤ × ℤ := fun q => (d₀ * q.1 - b₀ * q.2, a₀ * q.2 - c₀ * q.1)
  let inv : ℤ × ℤ → ℤ × ℤ := fun q => (a₀ * q.1 + b₀ * q.2, c₀ * q.1 + d₀ * q.2)
  have hleft : Function.LeftInverse inv trans := by
    intro q
    apply Prod.ext
    · change a₀ * (d₀ * q.1 - b₀ * q.2) + b₀ * (a₀ * q.2 - c₀ * q.1) = q.1
      calc
        _ = (a₀ * d₀ - b₀ * c₀) * q.1 := by ring
        _ = _ := by rw [hdet, one_mul]
    · change c₀ * (d₀ * q.1 - b₀ * q.2) + d₀ * (a₀ * q.2 - c₀ * q.1) = q.2
      calc
        _ = (a₀ * d₀ - b₀ * c₀) * q.2 := by ring
        _ = _ := by rw [hdet, one_mul]
  let T : Set (ℤ × ℤ) := {q | |(q.1 : ℝ)| ≤ A ∧ |(q.2 : ℝ)| ≤ D}
  have hTfin : T.Finite := by
    apply ((Set.finite_Icc (-⌈A⌉) ⌈A⌉).prod (Set.finite_Icc (-⌈D⌉) ⌈D⌉)).subset
    intro q hq
    rcases abs_le.mp hq.1 with ⟨hlo, hhi⟩
    rcases abs_le.mp hq.2 with ⟨hlo', hhi'⟩
    have hcA := Int.le_ceil A
    have hcD := Int.le_ceil D
    constructor <;> constructor
    · exact_mod_cast (show -(⌈A⌉ : ℝ) ≤ (q.1 : ℝ) by linarith)
    · exact_mod_cast (show (q.1 : ℝ) ≤ (⌈A⌉ : ℝ) by linarith)
    · exact_mod_cast (show -(⌈D⌉ : ℝ) ≤ (q.2 : ℝ) by linarith)
    · exact_mod_cast (show (q.2 : ℝ) ≤ (⌈D⌉ : ℝ) by linarith)
  have hmap : ∀ q ∈ {q : ℤ × ℤ | |(q.2 : ℝ)| ≤ C₁ * Y ∧ |(q.1 : ℝ) + (q.2 : ℝ) * α| ≤ C₁},
      trans q ∈ T := fun q hq => hcoords q.1 q.2 hq.1 hq.2
  refine ⟨Set.Finite.of_injOn hmap hleft.injective.injOn hTfin, ?_⟩
  have hpowone : 1 ≤ Real.rpow Y (1 / 10 : ℝ) := Real.one_le_rpow (le_trans hY₀ hY) (by norm_num)
  calc
    _ ≤ (T.ncard : ℝ) := by exact_mod_cast Set.ncard_le_ncard_of_injOn trans hmap hleft.injective.injOn hTfin
    _ ≤ 9 * A * D := pd4c_box_count_le A D (le_trans hpowone hA) (le_trans hpowone hD)
    _ ≤ _ := by nlinarith [hAD]

private theorem pd4c_comparison_support_coarse (Rψ : ℝ) (hRψ : 16 ≤ Rψ) :
    ∃ C₂ Y₀ : ℝ, 0 < C₂ ∧ 1 ≤ Y₀ ∧
      ∀ (K : ℕ) (F : PDFix K) (S : PDScale) (w : ArchRoot) (δ c₁ c₂ : ℝ),
      S.Valid K δ c₁ c₂ → w.InRegion S → Y₀ ≤ S.Y →
      (∀ t : ℝ, F.psi t ≠ 0 → |t| ≤ Rψ) →
      ∀ (ρ : ℝ) (j : ℕ) (s : MemPoint S.x K)
        (c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i), MemValid F S s →
        ({z' : ℤ × ℤ | EdgeAdmissible F S w s c z' ∧
          pd4c_edgeChoiceCoeff F S ρ j false s c z' ≠ 0}.ncard : ℝ) ≤ 9 * C₂ * S.Y := by
  classical
  obtain ⟨C₂, Y₀, hC₂, hY₀, hStrip⟩ := pd4c_strip_box_count Rψ (by linarith)
  refine ⟨C₂, Y₀, hC₂, hY₀, ?_⟩
  intro K F S w δ c₁ c₂ hS hw hY hRadius ρ j s c hs
  let A : Set (ℤ × ℤ) := {z' | EdgeAdmissible F S w s c z' ∧
    pd4c_edgeChoiceCoeff F S ρ j false s c z' ≠ 0}
  obtain ⟨hYpos, _⟩ := pd4c_scale_Y_pad_pos δ c₁ c₂ S hS
  by_cases hA : A.Nonempty
  · obtain ⟨z₀, hadm, hcoef⟩ := hA
    let D := sharedProduct s.2.1
    let α := (D : ℝ) * transportedRatio w s.1
    have hα : ∀ l : ℕ, 1 ≤ l → (l : ℝ) ≤ Real.rpow S.Y (1 / 5 : ℝ) →
        Real.rpow S.Y (-(7 / 10 : ℝ)) < circleDistance ((l : ℝ) * α) := by
      intro l hl hly
      have h := hadm.2.2.2.2.2.2.2.2.1.1 (fun _ => lastSlot S.x)
        (by simpa [pd4c_last_omission_eq_shared] using hadm.2.2.2.2.1.1)
        (by simpa [pd4c_last_omission_eq_shared] using hadm.2.2.2.2.1.2.1) l hl hly
      simpa only [pd4c_last_omission_eq_shared, α, D, mul_assoc] using h
    let T : Set (ℤ × ℤ) := {q | |(q.2 : ℝ)| ≤ Rψ * S.Y ∧ |(q.1 : ℝ) + (q.2 : ℝ) * α| ≤ Rψ}
    obtain ⟨hTfin, hTcount⟩ := hStrip S.Y hY α hα
    let φ : ℤ × ℤ → ℤ × ℤ := fun q =>
      (q.1 * s.1.1 + (D : ℤ) * q.2 * (complementVec s.1).1,
        q.1 * s.1.2 + (D : ℤ) * q.2 * (complementVec s.1).2)
    have hsub : A ⊆ φ '' T := by
      intro z' hz'
      have hgeom : edgeMultiplier F S (decide (j % 2 = 0)) false s.2.1
          (edgeTargetLists F S s c) s.1 z' ≠ 0 := by
        intro hzero
        exact hz'.2 (by simp [pd4c_edgeChoiceCoeff, hzero])
      have hsupport := pd4c_comparison_edge_support F S _ _ _ _ _ Rψ hYpos
        hz'.1.2.2.2.2.1.2.2 hRadius hgeom
      obtain ⟨hU, _⟩ := pd4c_scale_pos δ c₁ c₂ S hS
      obtain ⟨h, l, hrepr, hl, ht⟩ := pd4c_env_target_strip_coordinates S w s.1 z' D Rψ
        hU hw hs.1 hadm.2.2.2.2.2.2.1 hz'.1.2.2.2.2.2.2.2.1
        hz'.1.2.2.2.2.1.2.2 hsupport
      exact ⟨(h, l), ⟨hl, le_trans ht hRψ⟩, hrepr.symm⟩
    calc
      _ ≤ ((φ '' T).ncard : ℝ) := by exact_mod_cast Set.ncard_le_ncard hsub (hTfin.image φ)
      _ ≤ (T.ncard : ℝ) := by
        have hcard : (φ '' T).ncard ≤ T.ncard := Set.ncard_image_le (f := φ) hTfin
        exact_mod_cast hcard
      _ ≤ _ := hTcount
  · have hEmpty : A = ∅ := Set.not_nonempty_iff_eq_empty.mp hA
    change (A.ncard : ℝ) ≤ _
    rw [hEmpty]
    simp only [Set.ncard_empty, Nat.cast_zero]
    exact mul_nonneg (mul_nonneg (by norm_num) hC₂.le) hYpos.le

private theorem pd4c_comparison_coarse_row (Rψ : ℝ) (hRψ : 16 ≤ Rψ) :
    ∃ C₂ Y₀ : ℝ, 0 < C₂ ∧ 1 ≤ Y₀ ∧
      ∀ (K : ℕ) (F : PDFix K) (S : PDScale) (w : ArchRoot) (δ c₁ c₂ : ℝ),
      F.Valid → S.Valid K δ c₁ c₂ → w.InRegion S → Y₀ ≤ S.Y → 1 ≤ S.L →
      (∀ t : ℝ, F.psi t ≠ 0 → |t| ≤ Rψ) →
      ∀ (ρ v Ceta Cpsi Cmass : ℝ) (B j : ℕ) (St Pr : Finset (Fin K)),
      0 ≤ ρ → ρ ≤ 1 → 1 ≤ v → 0 ≤ Ceta → 0 ≤ Cpsi → 2 ≤ Cmass → 1 ≤ B →
      (∀ t, ‖(F.eta t : ℂ)‖ ≤ Ceta) → (∀ t, ‖(F.psi t : ℂ)‖ ≤ Cpsi) →
      (∀ i, 0 < bandMass S.x (F.a i)) → (∀ i, (bandMass S.x (F.a i))⁻¹ ≤ Cmass) →
      (∀ i, ∀ p : primeBand S.x (F.a i), 0 ≤ memoryNu S.x K F.a F.q_d i p) →
      (∀ i, (∑ p : primeBand S.x (F.a i), memoryNu S.x K F.a F.q_d i p) ≤ 2) →
      MemRowSchurLE_sym F S B (memEdgePiece F S ρ w false St Pr j) v
        (Ceta ^ 2 * Cpsi * (32 * Real.rpow S.L F.A₀ ^ 3 / S.Y) * v ^ K *
          (9 * C₂ * S.Y) *
          (2 * Cmass * (B : ℝ)) ^ K) := by
  obtain ⟨C₂, Y₀, hC₂, hY₀, hcount⟩ := pd4c_comparison_support_coarse Rψ hRψ
  refine ⟨C₂, Y₀, hC₂, hY₀, ?_⟩
  intro K F S w δ c₁ c₂ hF hS hw hY hL hRadius ρ v Ceta Cpsi Cmass B j St Pr
    hρ0 hρ1 hv hEta0 hPsi0 hMass hB hEta hPsi hV hVinv hν hνsum
  let Cgeo := Ceta ^ 2 * Cpsi * (32 * Real.rpow S.L F.A₀ ^ 3 / S.Y)
  let Rcount := 9 * C₂ * S.Y
  obtain ⟨hYpos, hdpos⟩ := pd4c_scale_Y_pad_pos δ c₁ c₂ S hS
  have hLpos : 0 < S.L := by linarith
  have hv0 : 0 ≤ v := by linarith
  have hCgeo : 0 ≤ Cgeo := by
    exact mul_nonneg (mul_nonneg (sq_nonneg _) hPsi0)
      (div_nonneg (mul_nonneg (by norm_num) (pow_nonneg (Real.rpow_pos_of_pos hLpos _).le _)) hYpos.le)
  have hRcount : 0 ≤ Rcount := by
    exact mul_nonneg (mul_nonneg (by norm_num) hC₂.le) hYpos.le
  intro s hs hsize T hT
  have hmass (σ : Fin K → Equiv.Perm (Fin (slotCount S.x))) :
      pd4c_edgeRowMass F S ρ w j false St Pr v (s.1, permuteLists σ s.2.1, s.2.2) ≤
        Cgeo * v ^ K * v ^ memSize s * Rcount * (2 * Cmass * (B : ℝ)) ^ K := by
    let t : MemPoint S.x K := (s.1, permuteLists σ s.2.1, s.2.2)
    have ht : MemValid F S t := memPoint_permute_valid F S σ s hs
    have hweight (c : (i : Fin K) → EdgeChoice S.x F.a (t.2.2 i) i) (i : Fin K) :
        0 ≤ pd4c_choicePrimeWeight F S t i (c i) := by
      cases he : (c i).2 with
      | inl k => simpa only [pd4c_choicePrimeWeight, he] using inv_nonneg.mpr (hV i).le
      | inr p => simpa only [pd4c_choicePrimeWeight, he] using hν i p
    have hgeom (c : (i : Fin K) → EdgeChoice S.x F.a (t.2.2 i) i) (z' : ℤ × ℤ)
        (hadm : EdgeAdmissible F S w t c z') :
        ‖edgeMultiplier F S (decide (j % 2 = 0)) false t.2.1 (edgeTargetLists F S t c) t.1 z'‖ ≤ Cgeo :=
      pd4c_edge_comparison_norm_le F S _ _ _ _ _ Ceta Cpsi hL hF.2.2.2.1.le hYpos hdpos
        hadm.2.2.2.2.1 hEta hPsi hEta0 hPsi0
    have htargets (c : (i : Fin K) → EdgeChoice S.x F.a (t.2.2 i) i) (hc : edgePromotedSet c = Pr) :
        ({z' | EdgeAdmissible F S w t c z' ∧ pd4c_edgeChoiceCoeff F S ρ j false t c z' ≠ 0}.ncard : ℝ) ≤ Rcount :=
      hcount K F S w δ c₁ c₂ hS hw hY hRadius ρ j t c ht
    have hrow := pd4c_edgeRowMass_le_of_count δ c₁ c₂ F S ρ w false St Pr j v Cgeo Rcount t
      hS hw hρ0 hρ1 hv hCgeo hRcount hweight hgeom htargets
    have hlen (i : Fin K) : ((t.2.2 i).length : ℝ) ≤ (B : ℝ) := by
      have hle : (s.2.2 i).length ≤ memSize s :=
        Finset.single_le_sum (s := Finset.univ) (f := fun j : Fin K => (s.2.2 j).length)
          (fun j hj => Nat.zero_le _) (Finset.mem_univ i)
      exact_mod_cast le_trans hle hsize
    have hchoices := pd4c_promoted_choice_mass_le F S t Pr (B : ℝ) Cmass
      (by exact_mod_cast hB) hMass hlen hV hVinv hν hνsum
    exact hrow.trans (mul_le_mul_of_nonneg_left hchoices
      (mul_nonneg (mul_nonneg (mul_nonneg hCgeo (pow_nonneg hv0 _)) (pow_nonneg hv0 _)) hRcount))
  have hrow := pd4c_memEdgePiece_projected_row_mass δ c₁ c₂ F S ρ w false St Pr j hS hw s T v hv0
  have hd : (permCount S.x K : ℝ) ≠ 0 := by
    exact_mod_cast (show permCount S.x K ≠ 0 from Fintype.card_ne_zero)
  calc
    _ ≤ (permCount S.x K : ℝ)⁻¹ *
        ∑ σ : Fin K → Equiv.Perm (Fin (slotCount S.x)),
          pd4c_edgeRowMass F S ρ w j false St Pr v (s.1, permuteLists σ s.2.1, s.2.2) := hrow
    _ ≤ (permCount S.x K : ℝ)⁻¹ *
        ∑ _ : Fin K → Equiv.Perm (Fin (slotCount S.x)),
          Cgeo * v ^ K * v ^ memSize s * Rcount * (2 * Cmass * (B : ℝ)) ^ K := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      exact Finset.sum_le_sum fun σ hσ => hmass σ
    _ = _ := by
      simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
      change (permCount S.x K : ℝ)⁻¹ * ((permCount S.x K : ℝ) * _) = _
      field_simp [hd] <;> dsimp [Cgeo, Rcount] <;> field_simp [hYpos.ne'] <;> ring

private theorem pd4c_memEdge_dirtyRaw_eq_piece_sum {K : ℕ} (F : PDFix K) (S : PDScale)
    (ρ : ℝ) (w : ArchRoot) (j : ℕ) :
    memEdge F S ρ w EdgeKind.dirtyRaw j =
      (fun f s => ∑ St : Finset (Fin K), ∑ Pr : Finset (Fin K),
        (if St = ∅ ∧ Pr = ∅ then 0 else
          memEdgePiece F S ρ w true St Pr j f s)) := by
  funext f s
  simp only [memEdge, plainOp, logEdge, memEdgePiece]
  dsimp [logSym]
  simp_rw [Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro St hSt
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro Pr hPr
  by_cases hempty : St = ∅ ∧ Pr = ∅ <;> simp [hempty]

/-- Both comparison row entries, with all fixed constants and scale thresholds assembled. -/
private theorem pd4c_comparison_rows_eventually (δ c₁ c₂ : ℝ) {K : ℕ}
    (F : PDFix K) (hF : F.Valid) (ρ : ℝ) (hρ : IsMemoryRho F.q_d ρ) :
    ∃ C P x₀ : ℝ, 0 < C ∧ 0 < P ∧ 2 ≤ x₀ ∧
      ∀ S : PDScale, S.Valid K δ c₁ c₂ → x₀ ≤ S.x →
        ∀ w : ArchRoot, w.InRegion S → ∀ j : ℕ, ∀ St Pr : Finset (Fin K),
          MemRowSchurLE_sym F S (memoryCutoff S) (memEdgePiece F S ρ w false St Pr j) 1
            (if Pr.Nonempty then C * Real.rpow S.L P *
              Real.exp (-(1 / 200 : ℝ) * Real.rpow S.L (1 / 10 : ℝ))
             else C * Real.rpow S.L P) := by
  obtain ⟨Ceta, hCeta, hEta⟩ := exists_eta_norm_bound F hF
  obtain ⟨Cpsi, hCpsi, hPsi⟩ := exists_psi_norm_bound F hF
  obtain ⟨Rψ, hRψ, hRadius⟩ := pd4c_exists_psi_radius F hF
  obtain ⟨Cs, Ys, hCs, hYs, hSmall⟩ := pd4c_comparison_small_row Rψ hRψ
  obtain ⟨Cc, Yc, hCc, hYc, hCoarse⟩ := pd4c_comparison_coarse_row Rψ hRψ
  obtain ⟨xV, hxV, hVbounds⟩ := pd4c_bandMass_large_bounds F hF
  obtain ⟨xB, hxB, hBbounds⟩ := memoryBPrime_half_of_large_x F hF
  let Cmass := max 2 (2 / Real.log 2)
  let Ds := 384 * Ceta ^ 2 * Cpsi * Cs * (2 * Cmass) ^ K
  let Dc := 288 * Ceta ^ 2 * Cpsi * Cc * (2 * Cmass) ^ K
  let C := 1 + 2 * Ds * (2 : ℝ) ^ K + Dc * (2 : ℝ) ^ K
  let P := 3 * F.A₀ + 2 * (K : ℝ)
  have hCM : 2 ≤ Cmass := le_max_left _ _
  have hDs : 0 ≤ Ds := by dsimp [Ds]; positivity
  have hDc : 0 ≤ Dc := by dsimp [Dc]; positivity
  have hC : 0 < C := by dsimp [C]; positivity
  have hP : 0 < P := by dsimp [P]; linarith [hF.2.2.2.1, (show (0 : ℝ) ≤ K from Nat.cast_nonneg K)]
  let Ymin := max Ys Yc
  have hYmin : 0 < Ymin := lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1)
    (le_trans hYs (le_max_left _ _))
  obtain ⟨Ly, hLy⟩ := Filter.eventually_atTop.1
    ((tendsto_rpow_atTop (by norm_num : (0 : ℝ) < 1 / 10)).eventually_ge_atTop
      (20 * Real.log Ymin))
  let L₀ := max 1 Ly
  let x₀ := max 2 (max xV (max xB (Real.exp L₀)))
  refine ⟨C, P, x₀, hC, hP, le_max_left _ _, ?_⟩
  intro S hS hx w hw j St Pr
  have hxV' : xV ≤ S.x := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hx
  have hxB' : xB ≤ S.x := le_trans
    (le_trans (le_max_left _ _) (le_trans (le_max_right _ _) (le_max_right _ _))) hx
  have hxL : Real.exp L₀ ≤ S.x := le_trans
    (le_trans (le_max_right _ _) (le_trans (le_max_right _ _) (le_max_right _ _))) hx
  have hL₀ : L₀ ≤ S.L := by
    have h := Real.log_le_log (Real.exp_pos L₀) hxL
    simpa only [Real.log_exp, PDScale.L] using h
  have hL : 1 ≤ S.L := le_trans (le_max_left _ _) hL₀
  have hLpos : 0 < S.L := by linarith
  obtain ⟨hYpos, _⟩ := pd4c_scale_Y_pad_pos δ c₁ c₂ S hS
  have hYbound : Ymin ≤ S.Y := by
    have hlarge := hLy S.L (le_trans (le_max_right _ _) hL₀)
    change 20 * Real.log Ymin ≤ Real.rpow S.L (1 / 10 : ℝ) at hlarge
    have hlogY := (Finset.mem_filter.mp hS.2.2.2.2.2.1).2.1
    change (1 / 20 : ℝ) * Real.rpow S.L (1 / 10 : ℝ) ≤ Real.log S.Y at hlogY
    have hlog : Real.log Ymin ≤ Real.log S.Y := by linarith
    exact (Real.log_le_log_iff hYmin hYpos).mp hlog
  have hV (i : Fin K) : 0 < bandMass S.x (F.a i) :=
    lt_of_lt_of_le (div_pos (Real.log_pos (by norm_num)) (by norm_num))
      (hVbounds S.x hxV' i).1
  have hVinv (i : Fin K) : (bandMass S.x (F.a i))⁻¹ ≤ Cmass := by
    calc
      _ ≤ (Real.log 2 / 2)⁻¹ := by
        simpa only [one_div] using one_div_le_one_div_of_le
          (div_pos (Real.log_pos (by norm_num)) (by norm_num)) (hVbounds S.x hxV' i).1
      _ = 2 / Real.log 2 := by simp only [inv_div, one_div]
      _ ≤ _ := le_max_right _ _
  have hbp := hBbounds S.x hxB'
  have hν (i : Fin K) (p : primeBand S.x (F.a i)) :
      0 ≤ memoryNu S.x K F.a F.q_d i p :=
    (pd4c_memoryNu_le_twice_mu F.q_d i p (Finset.mem_filter.mp p.property).2.1.pos (hV i)
      (hbp p (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i, p.property⟩))).1
  have hνsum (i : Fin K) :
      (∑ p : primeBand S.x (F.a i), memoryNu S.x K F.a F.q_d i p) ≤ 2 := by
    have hAttach : (primeBand S.x (F.a i)).attach =
        (Finset.univ : Finset (primeBand S.x (F.a i))) := by ext p; simp
    rw [← hAttach, Finset.sum_attach]
    exact memoryNu_band_mass_le_two F i (hV i) hbp
  have hB : 1 ≤ memoryCutoff S := by
    have hceil : (1 : ℝ) ≤ (memoryCutoff S : ℝ) :=
      le_trans (Real.one_le_rpow hL (by norm_num)) (Nat.le_ceil _)
    exact_mod_cast hceil
  have hpow : Real.rpow S.L F.A₀ ^ 3 * Real.rpow S.L (2 * (K : ℝ)) = Real.rpow S.L P := by
    have hcube : Real.rpow S.L F.A₀ ^ 3 = Real.rpow S.L (3 * F.A₀) := by
      calc
        _ = Real.rpow (Real.rpow S.L F.A₀) (3 : ℝ) := (Real.rpow_natCast _ 3).symm
        _ = Real.rpow S.L (F.A₀ * 3) := (Real.rpow_mul hLpos.le _ _).symm
        _ = _ := by congr 1; ring
    rw [hcube]
    exact (Real.rpow_add hLpos _ _).symm
  have hCsC : 2 * Ds * (2 : ℝ) ^ K ≤ C := by
    dsimp [C]
    linarith [mul_nonneg hDc (pow_nonneg (by norm_num : (0 : ℝ) ≤ 2) K)]
  have hCcC : Dc * (2 : ℝ) ^ K ≤ C := by
    dsimp [C]
    linarith [mul_nonneg (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2) hDs) (pow_nonneg (by norm_num : (0 : ℝ) ≤ 2) K)]
  by_cases hPr : Pr.Nonempty
  · have hr := hSmall K F S w δ c₁ c₂ hF hS hw (le_trans (le_max_left _ _) hYbound) hL hRadius
      ρ 1 Ceta Cpsi Cmass (memoryCutoff S) j St Pr hρ.1.le hρ.2.1.le
      (le_refl 1) hCeta hCpsi hCM hB hPr hEta hPsi hV hVinv hν hνsum
    have hcoef : Ceta ^ 2 * Cpsi * (32 * Real.rpow S.L F.A₀ ^ 3 / S.Y) * 1 ^ K *
        (12 * Cs * S.Y * (Real.exp (-Real.rpow S.L (1 / 10 : ℝ)) + Real.rpow S.Y (-(1 / 10 : ℝ)))) *
          (2 * Cmass * (memoryCutoff S : ℝ)) ^ K =
        Ds * Real.rpow S.L F.A₀ ^ 3 * (memoryCutoff S : ℝ) ^ K *
          (Real.exp (-Real.rpow S.L (1 / 10 : ℝ)) + Real.rpow S.Y (-(1 / 10 : ℝ))) := by
      dsimp [Ds]
      simp only [one_pow, mul_one, mul_pow]
      field_simp [hYpos.ne']
      <;> ring
    rw [hcoef] at hr
    have hscale := pd4c_comparison_row_scale_le δ c₁ c₂ S hS hL F.A₀ Ds hDs
    have hbound := hscale.trans (mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right hCsC (Real.rpow_pos_of_pos hLpos P).le)
      (Real.exp_pos _).le)
    simpa only [if_pos hPr, MemRowSchurLE_sym] using pd4c_memRowSchurLE_mono F S
      (memoryCutoff S) (fun f => memEdgePiece F S ρ w false St Pr j (memorySym f)) 1 _ _
        (by norm_num) hr hbound
  · have hr := hCoarse K F S w δ c₁ c₂ hF hS hw (le_trans (le_max_right _ _) hYbound) hL hRadius
      ρ 1 Ceta Cpsi Cmass (memoryCutoff S) j St Pr hρ.1.le hρ.2.1.le
      (le_refl 1) hCeta hCpsi hCM hB hEta hPsi hV hVinv hν hνsum
    have hcoef : Ceta ^ 2 * Cpsi * (32 * Real.rpow S.L F.A₀ ^ 3 / S.Y) * 1 ^ K *
        (9 * Cc * S.Y) * (2 * Cmass * (memoryCutoff S : ℝ)) ^ K =
        Dc * Real.rpow S.L F.A₀ ^ 3 * (memoryCutoff S : ℝ) ^ K := by
      dsimp [Dc]
      simp only [one_pow, mul_one, mul_pow]
      field_simp [hYpos.ne']
      <;> ring
    rw [hcoef] at hr
    have hbound : Dc * Real.rpow S.L F.A₀ ^ 3 * (memoryCutoff S : ℝ) ^ K ≤ C * Real.rpow S.L P := by
      calc
        _ ≤ Dc * Real.rpow S.L F.A₀ ^ 3 * ((2 : ℝ) ^ K * Real.rpow S.L (2 * (K : ℝ))) :=
          mul_le_mul_of_nonneg_left (pd4c_memoryCutoff_pow_le S K hL)
            (mul_nonneg hDc (pow_nonneg (Real.rpow_pos_of_pos hLpos _).le _))
        _ = (Dc * (2 : ℝ) ^ K) * Real.rpow S.L P := by rw [← hpow]; ring
        _ ≤ _ := mul_le_mul_of_nonneg_right hCcC (Real.rpow_pos_of_pos hLpos P).le
    simpa only [if_neg hPr, MemRowSchurLE_sym] using pd4c_memRowSchurLE_mono F S
      (memoryCutoff S) (fun f => memEdgePiece F S ρ w false St Pr j (memorySym f)) 1 _ _
        (by norm_num) hr hbound

private theorem pd4c_rawMultiplier_bound {K : ℕ} (F : PDFix K) (S : PDScale)
    (D a b : ℕ) (t d : ℤ) (Ceta Cpsi : ℝ) (hPad : IsPadAdmissible S.d₀ D d)
    (hd : 0 < (S.d₀ : ℝ)) (hCeta : 0 ≤ Ceta) (hCpsi : 0 ≤ Cpsi)
    (hEta : ∀ u, ‖(F.eta u : ℂ)‖ ≤ Ceta) (hPsi : ∀ u, ‖(F.psi u : ℂ)‖ ≤ Cpsi) :
    ‖rawMultiplier F S D a b t‖ ≤ Ceta ^ 2 * Cpsi := by
  have hD : 0 < (D : ℝ) := lt_of_lt_of_le hd hPad.1
  have hRatio : ‖(((S.d₀ : ℝ) / D : ℝ) : ℂ)‖ ≤ 1 := by
    have h0 : 0 ≤ (S.d₀ : ℝ) / D := div_nonneg hd.le hD.le
    have h1 : (S.d₀ : ℝ) / D ≤ 1 := (div_le_iff₀ hD).mpr (by simpa using hPad.1)
    simpa only [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg h0] using h1
  have hind : ‖(if t = (b : ℤ) - a then (F.psi ((t : ℝ) / S.Y) : ℂ) else 0)‖ ≤ Cpsi := by
    by_cases h : t = (b : ℤ) - a
    · simpa only [if_pos h] using hPsi ((t : ℝ) / S.Y)
    · simpa only [if_neg h, norm_zero] using hCpsi
  unfold rawMultiplier
  simp only [norm_mul]
  calc
    _ ≤ 1 * Ceta * Ceta * Cpsi := by
      gcongr
      · exact hEta _
      · exact hEta _
    _ = _ := by ring

/-- A raw choice fixes one determinant, so its geometric support has uniformly bounded size. -/
private theorem pd4c_raw_choice_support_count {K : ℕ} (δ c₁ c₂ : ℝ) (F : PDFix K) (S : PDScale)
    (ρ : ℝ) (w : ArchRoot) (j : ℕ) (s : MemPoint S.x K)
    (c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i)
    (hS : S.Valid K δ c₁ c₂) (hw : w.InRegion S) (hs : MemValid F S s) :
    ({z' | EdgeAdmissible F S w s c z' ∧ pd4c_edgeChoiceCoeff F S ρ j true s c z' ≠ 0}.ncard : ℝ) ≤ 34 := by
  let A : Set (ℤ × ℤ) := {z' | EdgeAdmissible F S w s c z' ∧ pd4c_edgeChoiceCoeff F S ρ j true s c z' ≠ 0}
  by_cases hA : A.Nonempty
  · obtain ⟨z₀, hadm, hcoef⟩ := hA
    let d := (sharedProduct s.2.1 : ℤ) * ((lastProduct s.2.1 : ℤ) - lastProduct (edgeTargetLists F S s c))
    have hsub : A ⊆ {z' | envBox S w z' ∧ det2 s.1 z' = d} := by
      intro z' hz'
      have hgeom : edgeMultiplier F S (decide (j % 2 = 0)) true s.2.1 (edgeTargetLists F S s c) s.1 z' ≠ 0 := by
        intro h0
        exact hz'.2 (by simp [pd4c_edgeChoiceCoeff, h0])
      exact ⟨hz'.1.2.2.2.2.2.2.2.1, pd4c_raw_edge_det F S _ _ _ _ _ hz'.1.2.2.2.2.1.2.2 hgeom⟩
    have hfin : {z' | envBox S w z' ∧ det2 s.1 z' = d}.Finite :=
      (envBox_finite δ c₁ c₂ S w hS hw).subset (fun z' hz' => hz'.1)
    have hcard := Set.ncard_le_ncard hsub hfin
    obtain ⟨hU, _⟩ := pd4c_scale_pos δ c₁ c₂ S hS
    exact (show (A.ncard : ℝ) ≤ _ by exact_mod_cast hcard).trans
      (pd4c_env_fixed_det_count S w s.1 d hU hw hs.1 hadm.2.2.2.2.2.2.1)
  · have hempty : A = ∅ := Set.not_nonempty_iff_eq_empty.mp hA
    change (A.ncard : ℝ) ≤ 34
    rw [hempty]
    norm_num

/-- With no promotions, the choice mass has no memory-cutoff factor. -/
private theorem pd4c_fresh_choice_mass_le {K : ℕ} (F : PDFix K) (S : PDScale)
    (s : MemPoint S.x K)
    (hν : ∀ i, ∀ p : primeBand S.x (F.a i), 0 ≤ memoryNu S.x K F.a F.q_d i p)
    (hνsum : ∀ i, (∑ p : primeBand S.x (F.a i), memoryNu S.x K F.a F.q_d i p) ≤ 2) :
    (∑ c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i,
      if edgePromotedSet c = ∅ then ∏ i, pd4c_choicePrimeWeight F S s i (c i) else 0) ≤ (4 : ℝ) ^ K := by
  have hprod : (∏ i : Fin K, 2 * ∑ p : primeBand S.x (F.a i), memoryNu S.x K F.a F.q_d i p) ≤
      ∏ i : Fin K, (4 : ℝ) := by
    apply Finset.prod_le_prod₀
    · intro i hi
      exact mul_nonneg (by norm_num) (Finset.sum_nonneg (fun p hp => hν i p))
    · intro i hi
      have h := hνsum i
      linarith
  calc
    _ = ∏ i : Fin K, 2 * (if i ∈ (∅ : Finset (Fin K)) then
          ((s.2.2 i).length : ℝ) * (bandMass S.x (F.a i))⁻¹
        else ∑ p : primeBand S.x (F.a i), memoryNu S.x K F.a F.q_d i p) :=
          pd4c_promoted_choice_mass F S s (∅ : Finset (Fin K))
    _ = ∏ i : Fin K, 2 * ∑ p : primeBand S.x (F.a i), memoryNu S.x K F.a F.q_d i p := by
          simp
    _ ≤ ∏ i : Fin K, (4 : ℝ) := hprod
    _ = (4 : ℝ) ^ K := by simp

private theorem pd4c_raw_no_promotion_row {K : ℕ} (δ c₁ c₂ : ℝ)
    (F : PDFix K) (S : PDScale) (ρ : ℝ) (w : ArchRoot) (St : Finset (Fin K))
    (B j : ℕ) (v Ceta Cpsi : ℝ) (hS : S.Valid K δ c₁ c₂) (hw : w.InRegion S)
    (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1) (hv : 1 ≤ v) (hCeta : 0 ≤ Ceta) (hCpsi : 0 ≤ Cpsi)
    (hEta : ∀ u, ‖(F.eta u : ℂ)‖ ≤ Ceta) (hPsi : ∀ u, ‖(F.psi u : ℂ)‖ ≤ Cpsi)
    (hV : ∀ i, 0 < bandMass S.x (F.a i))
    (hν : ∀ i, ∀ p : primeBand S.x (F.a i), 0 ≤ memoryNu S.x K F.a F.q_d i p)
    (hνsum : ∀ i, (∑ p : primeBand S.x (F.a i), memoryNu S.x K F.a F.q_d i p) ≤ 2) :
    MemRowSchurLE_sym F S B (memEdgePiece F S ρ w true St ∅ j) v
      (Ceta ^ 2 * Cpsi * v ^ K * 34 * (4 : ℝ) ^ K) := by
  have hv0 : 0 ≤ v := by linarith
  let C := Ceta ^ 2 * Cpsi
  have hC : 0 ≤ C := mul_nonneg (sq_nonneg _) hCpsi
  obtain ⟨hY, hd⟩ := pd4c_scale_Y_pad_pos δ c₁ c₂ S hS
  intro s hs hsize T hT
  have hmass (σ : Fin K → Equiv.Perm (Fin (slotCount S.x))) :
      pd4c_edgeRowMass F S ρ w j true St ∅ v (s.1, permuteLists σ s.2.1, s.2.2) ≤
        C * v ^ K * v ^ memSize s * 34 * (4 : ℝ) ^ K := by
    let t : MemPoint S.x K := (s.1, permuteLists σ s.2.1, s.2.2)
    have ht := memPoint_permute_valid F S σ s hs
    have hweight (c : (i : Fin K) → EdgeChoice S.x F.a (t.2.2 i) i) (i : Fin K) :
        0 ≤ pd4c_choicePrimeWeight F S t i (c i) := by
      cases he : (c i).2 with
      | inl k => simpa only [pd4c_choicePrimeWeight, he] using inv_nonneg.mpr (hV i).le
      | inr p => simpa only [pd4c_choicePrimeWeight, he] using hν i p
    have hgeom (c : (i : Fin K) → EdgeChoice S.x F.a (t.2.2 i) i) (z' : ℤ × ℤ)
        (ha : EdgeAdmissible F S w t c z') :
        ‖edgeMultiplier F S (decide (j % 2 = 0)) true t.2.1 (edgeTargetLists F S t c) t.1 z'‖ ≤ C := by
      cases hb : decide (j % 2 = 0)
      · change ‖star (rawMultiplier F S _ _ _ _)‖ ≤ _
        rw [norm_star]
        exact pd4c_rawMultiplier_bound F S _ _ _ _ _ Ceta Cpsi ha.2.2.2.2.1 hd hCeta hCpsi hEta hPsi
      · exact pd4c_rawMultiplier_bound F S _ _ _ _ _ Ceta Cpsi ha.2.2.2.2.1 hd hCeta hCpsi hEta hPsi
    have hcount (c : (i : Fin K) → EdgeChoice S.x F.a (t.2.2 i) i) (hc : edgePromotedSet c = ∅) :
        ({z' | EdgeAdmissible F S w t c z' ∧ pd4c_edgeChoiceCoeff F S ρ j true t c z' ≠ 0}.ncard : ℝ) ≤ 34 :=
      pd4c_raw_choice_support_count δ c₁ c₂ F S ρ w j t c hS hw ht
    have hr := pd4c_edgeRowMass_le_of_count δ c₁ c₂ F S ρ w true St ∅ j v C 34 t
      hS hw hρ0 hρ1 hv hC (by norm_num) hweight hgeom hcount
    exact hr.trans (mul_le_mul_of_nonneg_left (pd4c_fresh_choice_mass_le F S t hν hνsum)
      (mul_nonneg (mul_nonneg (mul_nonneg hC (pow_nonneg hv0 _)) (pow_nonneg hv0 _)) (by norm_num)))
  have hr := pd4c_memEdgePiece_projected_row_mass δ c₁ c₂ F S ρ w true St ∅ j hS hw s T v hv0
  have hdcard : (permCount S.x K : ℝ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  calc
    _ ≤ (permCount S.x K : ℝ)⁻¹ * ∑ σ : Fin K → Equiv.Perm (Fin (slotCount S.x)),
        pd4c_edgeRowMass F S ρ w j true St ∅ v (s.1, permuteLists σ s.2.1, s.2.2) := hr
    _ ≤ (permCount S.x K : ℝ)⁻¹ * ∑ _ : Fin K → Equiv.Perm (Fin (slotCount S.x)),
        C * v ^ K * v ^ memSize s * 34 * (4 : ℝ) ^ K := by
      exact mul_le_mul_of_nonneg_left (Finset.sum_le_sum (fun σ hσ => hmass σ)) (by positivity)
    _ = _ := by
      simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
      change (permCount S.x K : ℝ)⁻¹ * ((permCount S.x K : ℝ) * _) = _
      field_simp [hdcard]
      <;> dsimp [C]
      <;> ring

/-- `t2:pd.lattice-clean` (b) — PD 04:499-603.  REPLACES the frozen `lattice_clean`.  For every
`G` there is `A₀` with `‖ℰ_j^{clean}‖_{ℋ_B} ≤ L^{-G}` (mem:clean-bound): condition on shared list
and memory, drop the extra ban (cost `C_K M sup ν`), reduce by `lattice_shape` to the
determinant-exponential matrix on the box (mem:clean-kernel), Fourier-diagonalize the product
variable, Dirichlet approximation on `𝕋 ∖ 𝔐` (mem:dirichlet-minor) and the Gram bound
(mem:bilinear-gram) give `L^{0.2-A₀} + Y^{-0.1} log Y`; `A₀` independent of `K`. Correction from
refutation lane `sol-gate-b` uses the symmetric-memory projection. -/
theorem lattice_clean (δ c₁ c₂ : ℝ) (hδ : 0 < δ) (hc₁ : 0 < c₁) (q_d : ℝ) (eta psi : ℝ → ℝ) :
    ∀ G : ℝ, 0 < G → ∃ A₀ : ℝ, 0 < A₀ ∧
      ∀ (K : ℕ) (F : PDFix K), F.Valid → F.Has q_d A₀ eta psi →
        ∀ ρ : ℝ, IsMemoryRho F.q_d ρ →
          ∃ x₀ : ℝ, 2 ≤ x₀ ∧ ∀ S : PDScale, S.Valid K δ c₁ c₂ → x₀ ≤ S.x →
            ∀ w : ArchRoot, w.InRegion S → ∀ j : ℕ, j < S.N →
              MemOpNormLE_sym F S (memoryCutoff S) (memEdge F S ρ w EdgeKind.clean j)
                (Real.rpow S.L (-G)) := by
  intro G hG
  let A₀ := G + 4
  have hA₀ : 0 < A₀ := by dsimp [A₀]; linarith
  refine ⟨A₀, hA₀, ?_⟩
  intro K F hF hHas ρ hρ
  have hquant : ∃ C P c x₁ : ℝ, 0 < C ∧ 0 < c ∧ 2 ≤ x₁ ∧
      ∀ S : PDScale, S.Valid K δ c₁ c₂ → x₁ ≤ S.x →
        ∀ w : ArchRoot, w.InRegion S → ∀ j : ℕ, j < S.N →
          MemOpNormLE_sym F S (memoryCutoff S) (memEdge F S ρ w EdgeKind.clean j)
            (C * (Real.rpow S.L ((1 / 5 : ℝ) - A₀) +
              Real.rpow S.L P * Real.exp (-c * Real.rpow S.L (1 / 10 : ℝ)))) := by
    sorry
  obtain ⟨C, P, c, x₁, hC, hc, hx₁, hquant⟩ := hquant
  obtain ⟨L₁, hL₁, hdecay⟩ := pd4c_logPower_expDecay_const (G + 1) P c C hc
  obtain ⟨xμ, hxμ, hμ⟩ := pd4c_memMeasure_nonneg_eventually F hF
  let L₀ := max 2 (max C L₁)
  let x₀ := max 2 (max x₁ (max xμ (Real.exp L₀)))
  refine ⟨x₀, le_max_left _ _, ?_⟩
  intro S hS hx w hw j hj
  have hxbound : x₁ ≤ S.x := le_trans
    (le_trans (le_max_left _ _) (le_max_right _ _)) hx
  have hxmeasure : xμ ≤ S.x := le_trans
    (le_trans (le_max_left _ _) (le_trans (le_max_right _ _) (le_max_right _ _))) hx
  have hxexp : Real.exp L₀ ≤ S.x := le_trans
    (le_trans (le_max_right _ _) (le_trans (le_max_right _ _) (le_max_right _ _))) hx
  have hL₀ : L₀ ≤ S.L := by
    have h := Real.log_le_log (Real.exp_pos L₀) hxexp
    rw [Real.log_exp] at h
    exact h
  have hL2 : 2 ≤ S.L := le_trans (le_max_left _ _) hL₀
  have hLpos : 0 < S.L := by linarith
  have hCL : C ≤ S.L := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hL₀
  have hL₁' : L₁ ≤ S.L := le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hL₀
  have hfirst : C * Real.rpow S.L ((1 / 5 : ℝ) - A₀) ≤ Real.rpow S.L (-(G + 1)) := by
    calc
      _ ≤ S.L * Real.rpow S.L ((1 / 5 : ℝ) - A₀) :=
        mul_le_mul_of_nonneg_right hCL (Real.rpow_pos_of_pos hLpos _).le
      _ = Real.rpow S.L (1 + ((1 / 5 : ℝ) - A₀)) := by
        have hOne : Real.rpow S.L 1 = S.L := Real.rpow_one S.L
        calc
          S.L * Real.rpow S.L ((1 / 5 : ℝ) - A₀) =
              Real.rpow S.L 1 * Real.rpow S.L ((1 / 5 : ℝ) - A₀) :=
            congrArg (fun z : ℝ => z * Real.rpow S.L ((1 / 5 : ℝ) - A₀)) hOne.symm
          _ = _ := (Real.rpow_add hLpos _ _).symm
      _ ≤ _ := Real.rpow_le_rpow_of_exponent_le (by linarith) (by dsimp [A₀]; linarith)
  have hsecond := hdecay S.L hL₁'
  have hsum : C * (Real.rpow S.L ((1 / 5 : ℝ) - A₀) +
      Real.rpow S.L P * Real.exp (-c * Real.rpow S.L (1 / 10 : ℝ))) ≤ Real.rpow S.L (-G) := by
    have hsplit : C * (Real.rpow S.L ((1 / 5 : ℝ) - A₀) +
      Real.rpow S.L P * Real.exp (-c * Real.rpow S.L (1 / 10 : ℝ))) =
      C * Real.rpow S.L ((1 / 5 : ℝ) - A₀) +
        C * Real.rpow S.L P * Real.exp (-c * Real.rpow S.L (1 / 10 : ℝ)) := by ring
    rw [hsplit]
    calc
      _ ≤ 2 * Real.rpow S.L (-(G + 1)) := by linarith
      _ ≤ Real.rpow S.L (-G) := by
        have hp : Real.rpow S.L (-(G + 1)) = Real.rpow S.L (-G) / S.L := by
          have h : Real.rpow S.L (-G - 1) = Real.rpow S.L (-G) / Real.rpow S.L 1 :=
            Real.rpow_sub hLpos (-G) 1
          have hOne : Real.rpow S.L 1 = S.L := Real.rpow_one S.L
          rw [hOne] at h
          simpa only [show -G - 1 = -(G + 1) by ring] using h
        rw [hp]
        rw [← mul_div_assoc, div_le_iff₀ hLpos]
        have hprod : 0 ≤ (S.L - 2) * Real.rpow S.L (-G) :=
          mul_nonneg (sub_nonneg.mpr hL2) (Real.rpow_pos_of_pos hLpos _).le
        nlinarith
  have hbound := hquant S hS hxbound w hw j hj
  exact pd4c_memOpNormLE_mono F S (memoryCutoff S)
    (fun f => memEdge F S ρ w EdgeKind.clean j (memorySym f)) _ _ (hμ S hxmeasure) hbound
    (mul_nonneg hC.le (add_nonneg (Real.rpow_pos_of_pos hLpos _).le
      (mul_nonneg (Real.rpow_pos_of_pos hLpos _).le (Real.exp_pos _).le))) hsum


/-- Retain outgoing indexed-promotion damping while bounding the remaining coefficient. -/
private theorem pd4d_edgeChoiceCoeff_damped_norm_le {K : ℕ}
    (F : PDFix K) (S : PDScale) (ρ : ℝ) (j : ℕ) (raw : Bool)
    (s : MemPoint S.x K)
    (c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i) (z' : ℤ × ℤ)
    (I : Finset (Fin K)) (iStar : Fin K) (C : ℝ)
    (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1) (hC : 0 ≤ C)
    (hI : edgePromotedSet (s := s) c = I)
    (hHits : ∀ i k, (c i).2 = Sum.inl k → particleHits ((s.2.2 i).get k) z')
    (hweight : ∀ i, 0 ≤ pd4c_choicePrimeWeight F S s i (c i))
    (hgeom : ‖edgeMultiplier F S (decide (j % 2 = 0)) raw s.2.1
      (edgeTargetLists F S s c) s.1 z'‖ ≤ C) :
    ‖pd4c_edgeChoiceCoeff F S ρ j raw s c z'‖ ≤
      C * (∏ i : Fin K, pd4c_choicePrimeWeight F S s i (c i)) *
        ∏ i : I.erase iStar, ρ ^ (hitCount (s.2.2 i.1) z' - 1) := by
  let P := ∏ i : Fin K, pd4c_choicePrimeWeight F S s i (c i)
  let hs := ∑ i : Fin K, hitCount (s.2.2 i) s.1
  let ht := ∑ i : Fin K, hitCount (edgeNewMemory F S s c i) z'
  let Q := ∏ i : I.erase iStar, ρ ^ (hitCount (s.2.2 i.1) z' - 1)
  have hP : 0 ≤ P := Finset.prod_nonneg (fun i hi => hweight i)
  have hQ : 0 ≤ Q := Finset.prod_nonneg (fun i hi => pow_nonneg hρ0 _)
  have hρs : 0 ≤ ρ ^ hs := pow_nonneg hρ0 _
  have hρt : 0 ≤ ρ ^ ht := pow_nonneg hρ0 _
  have hρs1 : ρ ^ hs ≤ 1 := pow_le_one₀ hρ0 hρ1
  have hpoint (i : Fin K) :
      ρ ^ hitCount (edgeNewMemory F S s c i) z' ≤
        if i ∈ I.erase iStar then ρ ^ (hitCount (s.2.2 i) z' - 1) else 1 := by
    by_cases hi : i ∈ I.erase iStar
    · rw [if_pos hi]
      have hiI : i ∈ I := (Finset.mem_erase.mp hi).2
      have hprom : (c i).2.isLeft = true := by
        have hmem : i ∈ edgePromotedSet (s := s) c := hI.symm ▸ hiI
        simpa only [edgePromotedSet, Finset.mem_filter, Finset.mem_univ, true_and] using hmem
      cases hc : (c i).2 with
      | inl k =>
        have h := pd4c_promotion_target_damping ρ hρ0 hρ1 (s.2.2 i)
          (if (c i).1 then [anchorAt (s.2.1 i (lastSlot S.x)) s.1] else [])
          z' k (hHits i k hc)
        simpa only [edgeNewMemory, hc] using h
      | inr p => simp only [hc, Sum.isLeft_inr, Bool.false_eq_true] at hprom
    · rw [if_neg hi]
      exact pow_le_one₀ hρ0 hρ1
  have hρtQ : ρ ^ ht ≤ Q := by
    calc
      _ = ∏ i : Fin K, ρ ^ hitCount (edgeNewMemory F S s c i) z' :=
        (Finset.prod_pow_eq_pow_sum Finset.univ
          (fun i : Fin K => hitCount (edgeNewMemory F S s c i) z') ρ).symm
      _ ≤ ∏ i : Fin K,
          if i ∈ I.erase iStar then ρ ^ (hitCount (s.2.2 i) z' - 1) else 1 := by
        apply Finset.prod_le_prod₀
        · intro i hi
          exact pow_nonneg hρ0 _
        · intro i hi
          exact hpoint i
      _ = Q := by
        dsimp only [Q]
        rw [Finset.prod_ite_mem_eq]
        exact (Finset.prod_coe_sort (I.erase iStar)
          (fun i : Fin K => ρ ^ (hitCount (s.2.2 i) z' - 1))).symm
  have hnorm : ‖(((ρ ^ hs * P * ρ ^ ht : ℝ) : ℂ))‖ = ρ ^ hs * P * ρ ^ ht := by
    rw [Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (mul_nonneg (mul_nonneg hρs hP) hρt)]
  change ‖(((ρ ^ hs * P * ρ ^ ht : ℝ) : ℂ)) *
    edgeMultiplier F S (decide (j % 2 = 0)) raw s.2.1
      (edgeTargetLists F S s c) s.1 z'‖ ≤ C * P * Q
  rw [norm_mul, hnorm]
  have hfactor : ρ ^ hs * P * ρ ^ ht ≤ P * Q := by
    calc
      _ ≤ 1 * P * Q := mul_le_mul (mul_le_mul_of_nonneg_right hρs1 hP)
        hρtQ hρt (by simpa only [one_mul] using hP)
      _ = _ := by ring
  calc
    _ ≤ (P * Q) * C := mul_le_mul hfactor hgeom (norm_nonneg _) (mul_nonneg hP hQ)
    _ = _ := by ring

open ArtinPrimitiveRoots.Proofs.pd4d_sol in
/-- Apply grouped omission/damping to the actual coefficient row for a fixed
separated fresh draw and distinguished promoted particle. -/
private theorem pd4d_raw_good_fixed_anchor {K : ℕ}
    (F : PDFix K) (S : PDScale) (s : MemPoint S.x K)
    (hp : ValidPrimeLists S.x K F.a s.2.1) (hs : MemValid F S s)
    (St I : Finset (Fin K)) (iStar : Fin K) (hstar : iStar ∈ I)
    (kStar : Fin (s.2.2 iStar).length) (fresh : RawFreshLabels S.x F.a I)
    (w : ArchRoot) (T : Finset (ℤ × ℤ)) (j : ℕ)
    (ρ v C Cmass : ℝ) (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1) (hv : 1 ≤ v)
    (hC : 0 ≤ C) (hCM : 1 ≤ Cmass)
    (hV : ∀ i, 0 < bandMass S.x (F.a i))
    (hVinv : ∀ i, (bandMass S.x (F.a i))⁻¹ ≤ Cmass)
    (hν : ∀ i, ∀ p : primeBand S.x (F.a i),
      0 ≤ memoryNu S.x K F.a F.q_d i p)
    (hbands : ∀ i i' : Fin K, i ≠ i' →
      Disjoint (primeBand S.x (F.a i)) (primeBand S.x (F.a i')))
    (hU : 0 < S.U) (hw : w.InRegion S) (hbox : envBox S w s.1)
    (hfin : {z' : ℤ × ℤ | envBox S w z'}.Finite)
    (hban : ∀ i jj, ((s.2.2 iStar).get kStar).1 ≠ s.2.1 i jj)
    (hsep : ∀ n₁ n₂,
      IsGoodnessTrialValue F.a s.2.1 (S.d₀ : ℝ) I iStar
        (rawFreshFunction S.x F.a I fresh) n₁ →
      IsGoodnessTrialValue F.a s.2.1 (S.d₀ : ℝ) I iStar
        (rawFreshFunction S.x F.a I fresh) n₂ → n₁ ≠ n₂ →
      100 * Real.exp (-Real.rpow S.L (F.a iStar)) <
        circleDistance (((n₁ : ℝ) - n₂) * transportedRatio w s.1))
    (hgeom : ∀ (σ : Fin K → Equiv.Perm (Fin (slotCount S.x)))
      (c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i) (z' : ℤ × ℤ),
      EdgeAdmissible F S w (s.1, permuteLists σ s.2.1, s.2.2) c z' →
      ‖edgeMultiplier F S (decide (j % 2 = 0)) true (permuteLists σ s.2.1)
        (edgeTargetLists F S (s.1, permuteLists σ s.2.1, s.2.2) c) s.1 z'‖ ≤ C) :
    let χ := fun κ : RawPromotionIndices I iStar s.2.2 =>
      rawPatternChoice S.x F.a s.2.2 St I iStar kStar κ fresh
    let source := fun σ : Fin K → Equiv.Perm (Fin (slotCount S.x)) =>
      (s.1, permuteLists σ s.2.1, s.2.2)
    (permCount S.x K : ℝ)⁻¹ *
      (∑ σ : Fin K → Equiv.Perm (Fin (slotCount S.x)),
        ∑ z' ∈ T, ∑ κ : RawPromotionIndices I iStar s.2.2,
          if EdgeAdmissible F S w (source σ) (χ κ) z' then
            ‖pd4c_edgeChoiceCoeff F S ρ j true (source σ) (χ κ) z'‖ *
              v ^ memSize (z', edgeTargetLists F S (source σ) (χ κ),
                edgeNewMemory F S (source σ) (χ κ))
          else 0) ≤
      (34 * (C * Cmass ^ K *
        (∏ i : Fin K, if i ∉ I then
          memoryNu S.x K F.a F.q_d i (rawFreshFunction S.x F.a I fresh i) else 1) *
        v ^ K * v ^ memSize s) * (1 / (1 - ρ) ^ 2) ^ K) /
          (slotCount S.x : ℝ) ^ K := by
  classical
  dsimp only
  let χ := fun κ : RawPromotionIndices I iStar s.2.2 =>
    rawPatternChoice S.x F.a s.2.2 St I iStar kStar κ fresh
  let source (σ : Fin K → Equiv.Perm (Fin (slotCount S.x))) : MemPoint S.x K :=
    (s.1, permuteLists σ s.2.1, s.2.2)
  let Q := ∏ i : Fin K, if i ∉ I then
    memoryNu S.x K F.a F.q_d i (rawFreshFunction S.x F.a I fresh i) else 1
  let CF := C * Cmass ^ K * Q * v ^ K * v ^ memSize s
  let W (σ : Fin K → Equiv.Perm (Fin (slotCount S.x)))
      (κ : RawPromotionIndices I iStar s.2.2) (z' : ℤ × ℤ) : ℝ :=
    if EdgeAdmissible F S w (source σ) (χ κ) z' then
      ‖pd4c_edgeChoiceCoeff F S ρ j true (source σ) (χ κ) z'‖ *
        v ^ memSize (z', edgeTargetLists F S (source σ) (χ κ),
          edgeNewMemory F S (source σ) (χ κ)) else 0
  have hv0 : 0 ≤ v := by linarith
  have hCM0 : 0 ≤ Cmass := by linarith
  have hfresh : IsFreshChoice S.x F.a I (rawFreshFunction S.x F.a I fresh) := by
    constructor
    · intro i hi
      simp [rawFreshFunction, hi]
    · intro i hi
      simpa only [rawFreshFunction, dif_neg hi] using
        (fresh ⟨i, Finset.mem_compl.mpr hi⟩).property
  have hnu (i : Fin K) (hi : i ∉ I) :
      0 ≤ memoryNu S.x K F.a F.q_d i (rawFreshFunction S.x F.a I fresh i) := by
    simpa only [rawFreshFunction, dif_neg hi] using
      hν i (fresh ⟨i, Finset.mem_compl.mpr hi⟩)
  have hQ : 0 ≤ Q := by
    apply Finset.prod_nonneg
    intro i hi
    by_cases hmem : i ∈ I
    · simp [hmem]
    · simpa only [if_pos hmem] using hnu i hmem
  have hCF : 0 ≤ CF := by dsimp only [CF]; positivity
  have hprime (σ : Fin K → Equiv.Perm (Fin (slotCount S.x)))
      (κ : RawPromotionIndices I iStar s.2.2) (i : Fin K) :
      pd4c_choicePrimeWeight F S (source σ) i (χ κ i) =
        if i ∈ I then (bandMass S.x (F.a i))⁻¹ else
          memoryNu S.x K F.a F.q_d i (rawFreshFunction S.x F.a I fresh i) := by
    by_cases hi : i ∈ I
    · by_cases heq : i = iStar
      · subst i
        simp [χ, rawPatternChoice, hstar, pd4c_choicePrimeWeight]
      · simp [χ, rawPatternChoice, hi, heq, pd4c_choicePrimeWeight]
    · simp [χ, rawPatternChoice, hi, pd4c_choicePrimeWeight, rawFreshFunction]
  have hweight (σ : Fin K → Equiv.Perm (Fin (slotCount S.x)))
      (κ : RawPromotionIndices I iStar s.2.2) (i : Fin K) :
      0 ≤ pd4c_choicePrimeWeight F S (source σ) i (χ κ i) := by
    rw [hprime]
    split_ifs with hi
    · exact inv_nonneg.mpr (hV i).le
    · exact hnu i hi
  have hP (σ : Fin K → Equiv.Perm (Fin (slotCount S.x)))
      (κ : RawPromotionIndices I iStar s.2.2) :
      (∏ i : Fin K, pd4c_choicePrimeWeight F S (source σ) i (χ κ i)) ≤ Cmass ^ K * Q := by
    calc
      _ ≤ ∏ i : Fin K, Cmass *
          (if i ∉ I then memoryNu S.x K F.a F.q_d i
            (rawFreshFunction S.x F.a I fresh i) else 1) := by
        apply Finset.prod_le_prod₀
        · intro i hi
          exact hweight σ κ i
        · intro i hi
          rw [hprime]
          by_cases hmem : i ∈ I
          · simpa [hmem] using hVinv i
          · simp only [if_neg hmem, if_pos hmem]
            exact le_mul_of_one_le_left (hnu i hmem) hCM
      _ = Cmass ^ K * Q := by
        rw [Finset.prod_mul_distrib]
        simp only [Finset.prod_const, Finset.card_univ, Fintype.card_fin, Q]
  have hI (σ : Fin K → Equiv.Perm (Fin (slotCount S.x)))
      (κ : RawPromotionIndices I iStar s.2.2) :
      edgePromotedSet (s := source σ) (χ κ) = I := by
    ext i
    by_cases hi : i ∈ I
    · by_cases heq : i = iStar
      · subst i
        simp [edgePromotedSet, χ, rawPatternChoice, hstar]
      · simp [edgePromotedSet, χ, rawPatternChoice, hi, heq]
    · simp [edgePromotedSet, χ, rawPatternChoice, hi]
  have hW (σ : Fin K → Equiv.Perm (Fin (slotCount S.x)))
      (κ : RawPromotionIndices I iStar s.2.2) (z' : ℤ × ℤ) :
      W σ κ z' ≤ CF * ∏ i : I.erase iStar,
        if particleHits ((s.2.2 i.1).get (κ i)) z'
        then ρ ^ (hitCount (s.2.2 i.1) z' - 1) else 0 := by
    by_cases ha : EdgeAdmissible F S w (source σ) (χ κ) z'
    · have hHits (i : I.erase iStar) : particleHits ((s.2.2 i.1).get (κ i)) z' := by
        rcases i with ⟨i, hi⟩
        obtain ⟨hne, hmem⟩ := Finset.mem_erase.mp hi
        apply ha.1 i (κ ⟨i, hi⟩)
        simp [χ, rawPatternChoice, hmem, hne]
      have hind :
          (∏ i : I.erase iStar, if particleHits ((s.2.2 i.1).get (κ i)) z'
            then ρ ^ (hitCount (s.2.2 i.1) z' - 1) else 0) =
          ∏ i : I.erase iStar, ρ ^ (hitCount (s.2.2 i.1) z' - 1) := by
        apply Finset.prod_congr rfl
        intro i hi
        rw [if_pos (hHits i)]
      let D := ∏ i : I.erase iStar, ρ ^ (hitCount (s.2.2 i.1) z' - 1)
      have hD : 0 ≤ D := Finset.prod_nonneg (fun i hi => pow_nonneg hρ0 _)
      have hc := pd4d_edgeChoiceCoeff_damped_norm_le F S ρ j true
        (source σ) (χ κ) z' I iStar C hρ0 hρ1.le hC (hI σ κ) ha.1
        (hweight σ κ) (hgeom σ (χ κ) z' ha)
      have hc' : ‖pd4c_edgeChoiceCoeff F S ρ j true (source σ) (χ κ) z'‖ ≤
          C * (Cmass ^ K * Q) * D :=
        hc.trans (mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_left (hP σ κ) hC) hD)
      have ht := pd4c_edge_target_weight_le F S (source σ) (χ κ) z' v hv
      have hsize : memSize (source σ) = memSize s := rfl
      rw [hsize] at ht
      rw [hind]
      dsimp only [W]
      rw [if_pos ha]
      calc
        _ ≤ (C * (Cmass ^ K * Q) * D) * (v ^ K * v ^ memSize s) :=
          mul_le_mul hc' ht (pow_nonneg hv0 _) (by positivity)
        _ = CF * D := by dsimp only [CF]; ring
    · dsimp only [W]
      rw [if_neg ha]
      apply mul_nonneg hCF
      apply Finset.prod_nonneg
      intro i hi
      split_ifs <;> positivity
  have hsupport (σ : Fin K → Equiv.Perm (Fin (slotCount S.x)))
      (κ : RawPromotionIndices I iStar s.2.2) (z' : ℤ × ℤ) (hne : W σ κ z' ≠ 0) :
      RawAnchorEndpoint S F.a s.2.1 I iStar (rawFreshFunction S.x F.a I fresh) w
        ((s.2.2 iStar).get kStar) s.1 (fun i => σ i (lastSlot S.x))
        (rawPromotionLabels I iStar s.2.2 κ) z' := by
    have ha : EdgeAdmissible F S w (source σ) (χ κ) z' := by
      by_contra hnot
      exact hne (by simp only [W, if_neg hnot])
    have hcoef : pd4c_edgeChoiceCoeff F S ρ j true (source σ) (χ κ) z' ≠ 0 := by
      intro hz
      exact hne (by simp only [W, if_pos ha, hz, norm_zero, zero_mul])
    have hraw : edgeMultiplier F S (decide (j % 2 = 0)) true (permuteLists σ s.2.1)
        (edgeTargetLists F S (source σ) (χ κ)) s.1 z' ≠ 0 := by
      intro hz
      exact hcoef (by simp [pd4c_edgeChoiceCoeff, source, hz])
    have hk : (χ κ iStar).2 = Sum.inl kStar := by
      simp [χ, rawPatternChoice, hstar]
    have hf (i : Fin K) (hi : i ∉ I) :
        rawFreshFunction S.x F.a I fresh i = edgeNewLabel (χ κ i) := by
      simp [rawFreshFunction, χ, rawPatternChoice, edgeNewLabel, hi]
    have hr := raw_edge_endpoint F S s σ (χ κ) I iStar hstar kStar hk
      (rawFreshFunction S.x F.a I fresh) hf w (decide (j % 2 = 0)) z' ha hraw
    have hlab (i : Fin K) (hi : i ∈ I ∧ i ≠ iStar) :
        edgeNewLabel (χ κ i) = rawPromotionLabels I iStar s.2.2 κ i := by
      have hierase : i ∈ I.erase iStar := Finset.mem_erase.mpr ⟨hi.2, hi.1⟩
      simp [χ, rawPatternChoice, hi.1, hi.2, edgeNewLabel, rawPromotionLabels, hierase]
    have hprod :
        (∏ i : Fin K, if i ∈ I ∧ i ≠ iStar then edgeNewLabel (χ κ i) else 1) =
        ∏ i : Fin K, if i ∈ I ∧ i ≠ iStar
          then rawPromotionLabels I iStar s.2.2 κ i else 1 := by
      apply Finset.prod_congr rfl
      intro i hi
      by_cases hmem : i ∈ I ∧ i ≠ iStar
      · simp only [if_pos hmem, hlab i hmem]
      · simp only [if_neg hmem]
    obtain ⟨hband, hcross, hpadlo, hpadhi, hbox', hhit, hdet⟩ := hr
    refine ⟨?_, ?_, hpadlo, hpadhi, hbox', hhit, ?_⟩
    · intro i hi
      rw [← hlab i hi]
      exact hband i hi
    · intro i hi jj kk
      rw [← hlab i hi]
      exact hcross i hi jj kk
    · rw [← hprod]
      exact hdet
  have hband := (hs.2.2 iStar ((s.2.2 iStar).get kStar) (List.get_mem _ _)).1
  have he : ((s.2.2 iStar).get kStar).1.Prime := (Finset.mem_filter.mp hband).2.1
  have h := raw_good_anchor_grouped_damping_average S F.a s.2.1 hp hbands I iStar
    (rawFreshFunction S.x F.a I fresh) hfresh w ((s.2.2 iStar).get kStar) he hband hban
    s.1 hs.1 hU hw hbox hfin hsep s.2.2 T ρ CF hρ0 hρ1 hCF W hW hsupport
  simpa only [χ, source, Q, CF, W] using h

open ArtinPrimitiveRoots.Proofs.pd4d_sol in
/-- Rewrite the actual fixed-pattern raw row into fresh labels and indexed promotions. -/
private theorem pd4d_raw_row_sum_reindex {K : ℕ}
    (F : PDFix K) (S : PDScale) (s : MemPoint S.x K)
    (St I : Finset (Fin K)) (iStar : Fin K) (hstar : iStar ∈ I)
    (ρ : ℝ) (w : ArchRoot) (j : ℕ) (v : ℝ) (Z : Finset (ℤ × ℤ))
    (hcover : ∀ z', envBox S w z' → z' ∈ Z) :
    let source := fun σ : Fin K → Equiv.Perm (Fin (slotCount S.x)) =>
      (s.1, permuteLists σ s.2.1, s.2.2)
    let χ := fun (fresh : RawFreshLabels S.x F.a I)
      (kStar : Fin (s.2.2 iStar).length) (κ : RawPromotionIndices I iStar s.2.2) =>
      rawPatternChoice S.x F.a s.2.2 St I iStar kStar κ fresh
    (permCount S.x K : ℝ)⁻¹ *
      (∑ σ : Fin K → Equiv.Perm (Fin (slotCount S.x)),
        pd4c_edgeRowMass F S ρ w j true St I v (source σ)) =
      ∑ fresh : RawFreshLabels S.x F.a I,
        ∑ kStar : Fin (s.2.2 iStar).length,
          (permCount S.x K : ℝ)⁻¹ *
            (∑ σ : Fin K → Equiv.Perm (Fin (slotCount S.x)),
              ∑ z' ∈ Z, ∑ κ : RawPromotionIndices I iStar s.2.2,
                if EdgeAdmissible F S w (source σ) (χ fresh kStar κ) z' then
                  ‖pd4c_edgeChoiceCoeff F S ρ j true (source σ) (χ fresh kStar κ) z'‖ *
                    v ^ memSize (z', edgeTargetLists F S (source σ) (χ fresh kStar κ),
                      edgeNewMemory F S (source σ) (χ fresh kStar κ))
                else 0) := by
  classical
  dsimp only
  let G := Fin K → Equiv.Perm (Fin (slotCount S.x))
  let C := (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i
  let source (σ : G) : MemPoint S.x K := (s.1, permuteLists σ s.2.1, s.2.2)
  let χ (fresh : RawFreshLabels S.x F.a I) (kStar : Fin (s.2.2 iStar).length)
      (κ : RawPromotionIndices I iStar s.2.2) : C :=
    rawPatternChoice S.x F.a s.2.2 St I iStar kStar κ fresh
  let W (σ : G) (c : C) (z' : ℤ × ℤ) : ℝ :=
    if EdgeAdmissible F S w (source σ) c z' then
      ‖pd4c_edgeChoiceCoeff F S ρ j true (source σ) c z'‖ *
        v ^ memSize (z', edgeTargetLists F S (source σ) c, edgeNewMemory F S (source σ) c)
    else 0
  have hfin (σ : G) (c : C) :
      (∑' z' : ℤ × ℤ,
        if edgeStoredSet (s := source σ) c = St ∧
            edgePromotedSet (s := source σ) c = I ∧ EdgeAdmissible F S w (source σ) c z'
        then ‖pd4c_edgeChoiceCoeff F S ρ j true (source σ) c z'‖ *
          v ^ memSize (z', edgeTargetLists F S (source σ) c, edgeNewMemory F S (source σ) c)
        else 0) =
      if edgeStoredSet (s := source σ) c = St ∧ edgePromotedSet (s := source σ) c = I
      then ∑ z' ∈ Z, W σ c z' else 0 := by
    rw [tsum_eq_sum (s := Z)]
    · by_cases hp : edgeStoredSet (s := source σ) c = St ∧
          edgePromotedSet (s := source σ) c = I
      · rw [if_pos hp]
        apply Finset.sum_congr rfl
        intro z' hz'
        simp only [hp.1, hp.2, true_and, W]
      · rw [if_neg hp]
        apply Finset.sum_eq_zero
        intro z' hz'
        have hn : ¬ (edgeStoredSet (s := source σ) c = St ∧
            edgePromotedSet (s := source σ) c = I ∧
            EdgeAdmissible F S w (source σ) c z') := fun hg => hp ⟨hg.1, hg.2.1⟩
        exact if_neg hn
    · intro z' hz'
      have hn : ¬ (edgeStoredSet (s := source σ) c = St ∧
          edgePromotedSet (s := source σ) c = I ∧
          EdgeAdmissible F S w (source σ) c z') := by
        intro hg
        have ha := hg.2.2
        exact hz' (hcover z' ha.2.2.2.2.2.2.2.1)
      exact if_neg hn
  have hrow (σ : G) :
      pd4c_edgeRowMass F S ρ w j true St I v (source σ) =
        ∑ fresh : RawFreshLabels S.x F.a I,
          ∑ kStar : Fin (s.2.2 iStar).length,
            ∑ z' ∈ Z, ∑ κ : RawPromotionIndices I iStar s.2.2,
              W σ (χ fresh kStar κ) z' := by
    change (∑ c : C, ∑' z' : ℤ × ℤ,
      if edgeStoredSet (s := source σ) c = St ∧
          edgePromotedSet (s := source σ) c = I ∧ EdgeAdmissible F S w (source σ) c z'
      then ‖pd4c_edgeChoiceCoeff F S ρ j true (source σ) c z'‖ *
        v ^ memSize (z', edgeTargetLists F S (source σ) c, edgeNewMemory F S (source σ) c)
      else 0) = _
    simp_rw [hfin σ]
    rw [raw_choice_sum_reindex S.x F.a (source σ) St I iStar hstar
      (fun c => ∑ z' ∈ Z, W σ c z')]
    apply Finset.sum_congr rfl
    intro fresh hfresh
    apply Finset.sum_congr rfl
    intro kStar hkStar
    exact Finset.sum_comm
  change (permCount S.x K : ℝ)⁻¹ *
      (∑ σ : G, pd4c_edgeRowMass F S ρ w j true St I v (source σ)) =
    ∑ fresh : RawFreshLabels S.x F.a I,
      ∑ kStar : Fin (s.2.2 iStar).length,
        (permCount S.x K : ℝ)⁻¹ *
          (∑ σ : G, ∑ z' ∈ Z, ∑ κ : RawPromotionIndices I iStar s.2.2,
            W σ (χ fresh kStar κ) z')
  simp_rw [hrow]
  have hcomm :
      (∑ σ : G, ∑ fresh : RawFreshLabels S.x F.a I,
        ∑ kStar : Fin (s.2.2 iStar).length,
          ∑ z' ∈ Z, ∑ κ : RawPromotionIndices I iStar s.2.2,
            W σ (χ fresh kStar κ) z') =
      ∑ fresh : RawFreshLabels S.x F.a I,
        ∑ kStar : Fin (s.2.2 iStar).length,
          ∑ σ : G, ∑ z' ∈ Z, ∑ κ : RawPromotionIndices I iStar s.2.2,
            W σ (χ fresh kStar κ) z' := by
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro fresh hfresh
    exact Finset.sum_comm
  rw [hcomm, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro fresh hfresh
  rw [Finset.mul_sum]


open ArtinPrimitiveRoots.Proofs.pd4d_sol in
/-- The coarse row for one fresh draw counts all promoted indices jointly. -/
private theorem pd4d_raw_coarse_fixed_fresh {K : ℕ} (δ c₁ c₂ : ℝ)
    (F : PDFix K) (S : PDScale) (s : MemPoint S.x K)
    (St I : Finset (Fin K)) (iStar : Fin K) (hstar : iStar ∈ I)
    (fresh : RawFreshLabels S.x F.a I) (w : ArchRoot)
    (T : Finset (ℤ × ℤ)) (B j : ℕ) (ρ v C Cmass : ℝ)
    (hS : S.Valid K δ c₁ c₂) (hw : w.InRegion S)
    (hs : MemValid F S s) (hsize : memSize s ≤ B) (hB : 1 ≤ B)
    (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1) (hv : 1 ≤ v)
    (hC : 0 ≤ C) (hCM : 1 ≤ Cmass)
    (hV : ∀ i, 0 < bandMass S.x (F.a i))
    (hVinv : ∀ i, (bandMass S.x (F.a i))⁻¹ ≤ Cmass)
    (hν : ∀ i, ∀ p : primeBand S.x (F.a i),
      0 ≤ memoryNu S.x K F.a F.q_d i p)
    (hgeom : ∀ (σ : Fin K → Equiv.Perm (Fin (slotCount S.x)))
      (c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i) (z' : ℤ × ℤ),
      EdgeAdmissible F S w (s.1, permuteLists σ s.2.1, s.2.2) c z' →
      ‖edgeMultiplier F S (decide (j % 2 = 0)) true (permuteLists σ s.2.1)
        (edgeTargetLists F S (s.1, permuteLists σ s.2.1, s.2.2) c) s.1 z'‖ ≤ C) :
    let source := fun σ : Fin K → Equiv.Perm (Fin (slotCount S.x)) =>
      (s.1, permuteLists σ s.2.1, s.2.2)
    let χ := fun (kStar : Fin (s.2.2 iStar).length)
      (κ : RawPromotionIndices I iStar s.2.2) =>
      rawPatternChoice S.x F.a s.2.2 St I iStar kStar κ fresh
    (∑ kStar : Fin (s.2.2 iStar).length,
      (permCount S.x K : ℝ)⁻¹ *
        (∑ σ : Fin K → Equiv.Perm (Fin (slotCount S.x)),
          ∑ z' ∈ T, ∑ κ : RawPromotionIndices I iStar s.2.2,
            if EdgeAdmissible F S w (source σ) (χ kStar κ) z' then
              ‖pd4c_edgeChoiceCoeff F S ρ j true (source σ) (χ kStar κ) z'‖ *
                v ^ memSize (z', edgeTargetLists F S (source σ) (χ kStar κ),
                  edgeNewMemory F S (source σ) (χ kStar κ))
            else 0)) ≤
      34 * (C * Cmass ^ K *
        (∏ i : Fin K, if i ∉ I then
          memoryNu S.x K F.a F.q_d i (rawFreshFunction S.x F.a I fresh i) else 1) *
        v ^ K * v ^ memSize s) * (B : ℝ) ^ K := by
  classical
  dsimp only
  let G := Fin K → Equiv.Perm (Fin (slotCount S.x))
  let R := RawPromotionIndices I iStar s.2.2
  let source (σ : G) : MemPoint S.x K := (s.1, permuteLists σ s.2.1, s.2.2)
  let χ (kStar : Fin (s.2.2 iStar).length) (κ : R) :=
    rawPatternChoice S.x F.a s.2.2 St I iStar kStar κ fresh
  let Q := ∏ i : Fin K, if i ∉ I then
    memoryNu S.x K F.a F.q_d i (rawFreshFunction S.x F.a I fresh i) else 1
  let CF := C * Cmass ^ K * Q * v ^ K * v ^ memSize s
  let W (σ : G) (kStar : Fin (s.2.2 iStar).length) (κ : R) (z' : ℤ × ℤ) : ℝ :=
    if EdgeAdmissible F S w (source σ) (χ kStar κ) z' then
      ‖pd4c_edgeChoiceCoeff F S ρ j true (source σ) (χ kStar κ) z'‖ *
        v ^ memSize (z', edgeTargetLists F S (source σ) (χ kStar κ),
          edgeNewMemory F S (source σ) (χ kStar κ)) else 0
  have hv0 : 0 ≤ v := by linarith
  have hCM0 : 0 ≤ Cmass := by linarith
  have hnu (i : Fin K) (hi : i ∉ I) :
      0 ≤ memoryNu S.x K F.a F.q_d i (rawFreshFunction S.x F.a I fresh i) := by
    simpa only [rawFreshFunction, dif_neg hi] using
      hν i (fresh ⟨i, Finset.mem_compl.mpr hi⟩)
  have hQ : 0 ≤ Q := by
    apply Finset.prod_nonneg
    intro i hi
    by_cases hmem : i ∈ I
    · simp [hmem]
    · simpa only [if_pos hmem] using hnu i hmem
  have hCF : 0 ≤ CF := by dsimp only [CF]; positivity
  have hprime (σ : G) (kStar : Fin (s.2.2 iStar).length) (κ : R) (i : Fin K) :
      pd4c_choicePrimeWeight F S (source σ) i (χ kStar κ i) =
        if i ∈ I then (bandMass S.x (F.a i))⁻¹ else
          memoryNu S.x K F.a F.q_d i (rawFreshFunction S.x F.a I fresh i) := by
    by_cases hi : i ∈ I
    · by_cases heq : i = iStar
      · subst i
        simp [χ, rawPatternChoice, hstar, pd4c_choicePrimeWeight]
      · simp [χ, rawPatternChoice, hi, heq, pd4c_choicePrimeWeight]
    · simp [χ, rawPatternChoice, hi, pd4c_choicePrimeWeight, rawFreshFunction]
  have hweight (σ : G) (kStar : Fin (s.2.2 iStar).length) (κ : R) (i : Fin K) :
      0 ≤ pd4c_choicePrimeWeight F S (source σ) i (χ kStar κ i) := by
    rw [hprime]
    split_ifs with hi
    · exact inv_nonneg.mpr (hV i).le
    · exact hnu i hi
  have hP (σ : G) (kStar : Fin (s.2.2 iStar).length) (κ : R) :
      (∏ i : Fin K, pd4c_choicePrimeWeight F S (source σ) i (χ kStar κ i)) ≤
        Cmass ^ K * Q := by
    calc
      _ ≤ ∏ i : Fin K, Cmass *
          (if i ∉ I then memoryNu S.x K F.a F.q_d i
            (rawFreshFunction S.x F.a I fresh i) else 1) := by
        apply Finset.prod_le_prod₀
        · intro i hi
          exact hweight σ kStar κ i
        · intro i hi
          rw [hprime]
          by_cases hmem : i ∈ I
          · simpa [hmem] using hVinv i
          · simp only [if_neg hmem, if_pos hmem]
            exact le_mul_of_one_le_left (hnu i hmem) hCM
      _ = Cmass ^ K * Q := by
        rw [Finset.prod_mul_distrib]
        simp only [Finset.prod_const, Finset.card_univ, Fintype.card_fin, Q]
  have hposition (σ : G) (kStar : Fin (s.2.2 iStar).length) (κ : R) :
      (∑ z' ∈ T, W σ kStar κ z') ≤ 34 * CF := by
    let U := T.filter (fun z' => EdgeAdmissible F S w (source σ) (χ kStar κ) z' ∧
      pd4c_edgeChoiceCoeff F S ρ j true (source σ) (χ kStar κ) z' ≠ 0)
    have hUcard : (U.card : ℝ) ≤ 34 := by
      have hsub : (U : Set (ℤ × ℤ)) ⊆ {z' | EdgeAdmissible F S w (source σ) (χ kStar κ) z' ∧
          pd4c_edgeChoiceCoeff F S ρ j true (source σ) (χ kStar κ) z' ≠ 0} := by
        intro z' hz'
        exact (Finset.mem_filter.mp hz').2
      have hfinite : {z' | EdgeAdmissible F S w (source σ) (χ kStar κ) z' ∧
          pd4c_edgeChoiceCoeff F S ρ j true (source σ) (χ kStar κ) z' ≠ 0}.Finite := by
        apply (envBox_finite δ c₁ c₂ S w hS hw).subset
        intro z' hz'
        exact hz'.1.2.2.2.2.2.2.2.1
      have hc := Set.ncard_le_ncard hsub hfinite
      exact (show (U.card : ℝ) ≤ _ by exact_mod_cast (by simpa using hc)).trans
        (pd4c_raw_choice_support_count δ c₁ c₂ F S ρ w j (source σ) (χ kStar κ) hS hw
          (memPoint_permute_valid F S σ s hs))
    have hsum : (∑ z' ∈ T, W σ kStar κ z') =
        ∑ z' ∈ U, ‖pd4c_edgeChoiceCoeff F S ρ j true (source σ) (χ kStar κ) z'‖ *
          v ^ memSize (z', edgeTargetLists F S (source σ) (χ kStar κ),
            edgeNewMemory F S (source σ) (χ kStar κ)) := by
      simp only [U, Finset.sum_filter]
      apply Finset.sum_congr rfl
      intro z' hz'
      by_cases ha : EdgeAdmissible F S w (source σ) (χ kStar κ) z'
      · by_cases hc : pd4c_edgeChoiceCoeff F S ρ j true (source σ) (χ kStar κ) z' = 0
        · simp only [W, if_pos ha, hc, norm_zero, zero_mul, ne_eq, not_true_eq_false,
            and_false, if_false]
        · simp [W, ha, hc]
      · simp only [W, if_neg ha, ha, false_and, if_false]
    have hterm (z' : ℤ × ℤ) (hz' : z' ∈ U) :
        ‖pd4c_edgeChoiceCoeff F S ρ j true (source σ) (χ kStar κ) z'‖ *
          v ^ memSize (z', edgeTargetLists F S (source σ) (χ kStar κ),
            edgeNewMemory F S (source σ) (χ kStar κ)) ≤ CF := by
      have ha := (Finset.mem_filter.mp hz').2.1
      have hc := pd4c_edgeChoiceCoeff_norm_le F S ρ j true (source σ) (χ kStar κ) z' C
        hρ0 hρ1 (hweight σ kStar κ) hC (hgeom σ (χ kStar κ) z' ha)
      have hc' := hc.trans (mul_le_mul_of_nonneg_left (hP σ kStar κ) hC)
      have ht := pd4c_edge_target_weight_le F S (source σ) (χ kStar κ) z' v hv
      have hsize' : memSize (source σ) = memSize s := rfl
      rw [hsize'] at ht
      calc
        _ ≤ (C * (Cmass ^ K * Q)) * (v ^ K * v ^ memSize s) :=
          mul_le_mul hc' ht (pow_nonneg hv0 _) (by positivity)
        _ = CF := by dsimp only [CF]; ring
    rw [hsum]
    calc
      _ ≤ ∑ _z' ∈ U, CF := Finset.sum_le_sum (fun z' hz' => hterm z' hz')
      _ = (U.card : ℝ) * CF := by simp
      _ ≤ 34 * CF := mul_le_mul_of_nonneg_right hUcard hCF
  have hlen (i : Fin K) : (s.2.2 i).length ≤ B := by
    have h := Finset.single_le_sum (fun i hi => Nat.zero_le (s.2.2 i).length)
      (Finset.mem_univ i)
    exact h.trans hsize
  have hRcard : Fintype.card R ≤ B ^ (I.erase iStar).card := by
    calc
      _ = ∏ i : I.erase iStar, (s.2.2 i.1).length := by
        simp only [R, RawPromotionIndices, Fintype.card_pi, Fintype.card_fin]
      _ ≤ ∏ _i : I.erase iStar, B := by
        apply Finset.prod_le_prod
        intro i hi
        exact hlen i.1
      _ = _ := by simp
  have hjoint : (s.2.2 iStar).length * Fintype.card R ≤ B ^ K := by
    have hcard : I.card ≤ K := by simpa using Finset.card_le_univ I
    calc
      _ ≤ B * B ^ (I.erase iStar).card := Nat.mul_le_mul (hlen iStar) hRcard
      _ = B ^ ((I.erase iStar).card + 1) := by rw [pow_succ, Nat.mul_comm]
      _ = B ^ I.card := by rw [Finset.card_erase_add_one hstar]
      _ ≤ B ^ K := pow_le_pow_right₀ hB hcard
  have hjointR : ((s.2.2 iStar).length : ℝ) * (Fintype.card R : ℝ) ≤ (B : ℝ) ^ K := by
    exact_mod_cast hjoint
  have hdcard : (permCount S.x K : ℝ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hrow (kStar : Fin (s.2.2 iStar).length) :
      (permCount S.x K : ℝ)⁻¹ * (∑ σ : G, ∑ z' ∈ T, ∑ κ : R, W σ kStar κ z') ≤
        (Fintype.card R : ℝ) * (34 * CF) := by
    have hσ (σ : G) : (∑ z' ∈ T, ∑ κ : R, W σ kStar κ z') ≤
        (Fintype.card R : ℝ) * (34 * CF) := by
      rw [Finset.sum_comm]
      calc
        _ ≤ ∑ _κ : R, 34 * CF := Finset.sum_le_sum (fun κ hκ => hposition σ kStar κ)
        _ = _ := by simp
    calc
      _ ≤ (permCount S.x K : ℝ)⁻¹ * ∑ _σ : G, (Fintype.card R : ℝ) * (34 * CF) :=
        mul_le_mul_of_nonneg_left (Finset.sum_le_sum (fun σ hσ' => hσ σ)) (by positivity)
      _ = _ := by
        simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
        change (permCount S.x K : ℝ)⁻¹ * ((permCount S.x K : ℝ) * _) = _
        rw [← mul_assoc, inv_mul_cancel₀ hdcard, one_mul]
  change (∑ kStar : Fin (s.2.2 iStar).length,
    (permCount S.x K : ℝ)⁻¹ * (∑ σ : G, ∑ z' ∈ T, ∑ κ : R, W σ kStar κ z')) ≤
      34 * CF * (B : ℝ) ^ K
  calc
    _ ≤ ∑ _kStar : Fin (s.2.2 iStar).length, (Fintype.card R : ℝ) * (34 * CF) :=
      Finset.sum_le_sum (fun kStar hkStar => hrow kStar)
    _ = (((s.2.2 iStar).length : ℝ) * (Fintype.card R : ℝ)) * (34 * CF) := by
      simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      ring
    _ ≤ (B : ℝ) ^ K * (34 * CF) :=
      mul_le_mul_of_nonneg_right hjointR (mul_nonneg (by norm_num) hCF)
    _ = _ := by ring


set_option maxHeartbeats 800000 in
open ArtinPrimitiveRoots.Proofs.pd4d_sol in
private theorem pd4d_raw_promoted_row {K : ℕ} (δ c₁ c₂ : ℝ)
    (F : PDFix K) (S : PDScale) (ρ : ℝ) (w : ArchRoot)
    (St Pr : Finset (Fin K)) (B j : ℕ) (v Ceta Cpsi Cmass : ℝ)
    (hF : F.Valid) (hS : S.Valid K δ c₁ c₂) (hw : w.InRegion S)
    (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1) (hv : 1 ≤ v)
    (hCeta : 0 ≤ Ceta) (hCpsi : 0 ≤ Cpsi) (hCM : 2 ≤ Cmass)
    (hB : 1 ≤ B) (hL : 1 ≤ S.L) (hPr : Pr.Nonempty)
    (hEta : ∀ u, ‖(F.eta u : ℂ)‖ ≤ Ceta)
    (hPsi : ∀ u, ‖(F.psi u : ℂ)‖ ≤ Cpsi)
    (hV : ∀ i, 0 < bandMass S.x (F.a i))
    (hVinv : ∀ i, (bandMass S.x (F.a i))⁻¹ ≤ Cmass)
    (hν : ∀ i, ∀ p : primeBand S.x (F.a i),
      0 ≤ memoryNu S.x K F.a F.q_d i p)
    (hνsum : ∀ i, (∑ p : primeBand S.x (F.a i),
      memoryNu S.x K F.a F.q_d i p) ≤ 2)
    (hb : ∀ i, ∀ p ∈ primeBand S.x (F.a i),
      (1 / 2 : ℝ) ≤ memoryBPrime S.x F.q_d p)
    (hbands : ∀ i i' : Fin K, i ≠ i' →
      Disjoint (primeBand S.x (F.a i)) (primeBand S.x (F.a i'))) :
    MemRowSchurLE_sym F S B (memEdgePiece F S ρ w true St Pr j) v
      (34 * Ceta ^ 2 * Cpsi * v ^ K * Cmass ^ K * (2 : ℝ) ^ K *
        (((1 / (1 - ρ) ^ 2) ^ K) * (B : ℝ) / (S.M : ℝ) ^ K +
          (B : ℝ) ^ K * Real.exp (-(1 / 4 : ℝ) * Real.rpow S.L (1 / 10 : ℝ)))) := by
  classical
  have hv0 : 0 ≤ v := by linarith
  have hCM : 1 ≤ Cmass := by linarith
  let C := Ceta ^ 2 * Cpsi
  have hC : 0 ≤ C := mul_nonneg (sq_nonneg _) hCpsi
  obtain ⟨hY, hd⟩ := pd4c_scale_Y_pad_pos δ c₁ c₂ S hS
  obtain ⟨hU, _⟩ := pd4c_scale_pos δ c₁ c₂ S hS
  intro s hs hsize T hT
  let iStar := Pr.max' hPr
  have hstar : iStar ∈ Pr := Pr.max'_mem hPr
  let G := Fin K → Equiv.Perm (Fin (slotCount S.x))
  let Z := (envBox_finite δ c₁ c₂ S w hS hw).toFinset
  let source (σ : G) : MemPoint S.x K := (s.1, permuteLists σ s.2.1, s.2.2)
  let χ (fresh : RawFreshLabels S.x F.a Pr) (kStar : Fin (s.2.2 iStar).length)
      (κ : RawPromotionIndices Pr iStar s.2.2) :=
    rawPatternChoice S.x F.a s.2.2 St Pr iStar kStar κ fresh
  let W (fresh : RawFreshLabels S.x F.a Pr) (kStar : Fin (s.2.2 iStar).length)
      (σ : G) (κ : RawPromotionIndices Pr iStar s.2.2) (z' : ℤ × ℤ) : ℝ :=
    if EdgeAdmissible F S w (source σ) (χ fresh kStar κ) z' then
      ‖pd4c_edgeChoiceCoeff F S ρ j true (source σ) (χ fresh kStar κ) z'‖ *
        v ^ memSize (z', edgeTargetLists F S (source σ) (χ fresh kStar κ),
          edgeNewMemory F S (source σ) (χ fresh kStar κ)) else 0
  let Rstar (fresh : RawFreshLabels S.x F.a Pr) (kStar : Fin (s.2.2 iStar).length) :=
    (permCount S.x K : ℝ)⁻¹ * ∑ σ : G, ∑ z' ∈ Z,
      ∑ κ : RawPromotionIndices Pr iStar s.2.2, W fresh kStar σ κ z'
  let R (fresh : RawFreshLabels S.x F.a Pr) := ∑ kStar : Fin (s.2.2 iStar).length,
    Rstar fresh kStar
  let Q (fresh : RawFreshLabels S.x F.a Pr) := ∏ i : Fin K, if i ∉ Pr then
    memoryNu S.x K F.a F.q_d i (rawFreshFunction S.x F.a Pr fresh i) else 1
  let bad (fresh : RawFreshLabels S.x F.a Pr) : Prop := ∃ n₁ n₂,
    IsGoodnessTrialValue F.a s.2.1 (S.d₀ : ℝ) Pr iStar
      (rawFreshFunction S.x F.a Pr fresh) n₁ ∧
    IsGoodnessTrialValue F.a s.2.1 (S.d₀ : ℝ) Pr iStar
      (rawFreshFunction S.x F.a Pr fresh) n₂ ∧ n₁ ≠ n₂ ∧
    circleDistance (((n₁ : ℝ) - n₂) * transportedRatio w s.1) ≤
      100 * Real.exp (-Real.rpow S.L (F.a iStar))
  let A := 1 / (1 - ρ) ^ 2
  let C0 := 34 * (C * Cmass ^ K * v ^ K * v ^ memSize s)
  let Agood := C0 * A ^ K * (B : ℝ) / (slotCount S.x : ℝ) ^ K
  let Abad := C0 * (B : ℝ) ^ K
  have hC0 : 0 ≤ C0 := by dsimp only [C0]; positivity
  have hAgood : 0 ≤ Agood := by dsimp only [Agood, A]; positivity
  have hAbad : 0 ≤ Abad := by dsimp only [Abad]; positivity
  have hQ (fresh : RawFreshLabels S.x F.a Pr) : 0 ≤ Q fresh := by
    apply Finset.prod_nonneg
    intro i hi
    by_cases hmem : i ∈ Pr
    · simp [hmem]
    · simp only [if_pos hmem, rawFreshFunction, dif_neg hmem]
      exact hν i (fresh ⟨i, Finset.mem_compl.mpr hmem⟩)
  have hcover : ∀ z', envBox S w z' → z' ∈ Z := by
    intro z' hz'
    simpa only [Z, Set.Finite.mem_toFinset, Set.mem_setOf_eq] using hz'
  have hreindex : (permCount S.x K : ℝ)⁻¹ *
      (∑ σ : G, pd4c_edgeRowMass F S ρ w j true St Pr v (source σ)) =
      ∑ fresh : RawFreshLabels S.x F.a Pr, R fresh :=
    pd4d_raw_row_sum_reindex F S s St Pr iStar hstar ρ w j v Z hcover
  have hgeom (σ : G) (c : (i : Fin K) → EdgeChoice S.x F.a (s.2.2 i) i) (z' : ℤ × ℤ)
      (ha : EdgeAdmissible F S w (source σ) c z') :
      ‖edgeMultiplier F S (decide (j % 2 = 0)) true (permuteLists σ s.2.1)
        (edgeTargetLists F S (source σ) c) s.1 z'‖ ≤ C := by
    cases hb' : decide (j % 2 = 0)
    · change ‖star (rawMultiplier F S _ _ _ _)‖ ≤ _
      rw [norm_star]
      exact pd4c_rawMultiplier_bound F S _ _ _ _ _ Ceta Cpsi
        ha.2.2.2.2.1 hd hCeta hCpsi hEta hPsi
    · exact pd4c_rawMultiplier_bound F S _ _ _ _ _ Ceta Cpsi
        ha.2.2.2.2.1 hd hCeta hCpsi hEta hPsi
  have hdata_of_adm (σ : G) (fresh : RawFreshLabels S.x F.a Pr)
      (kStar : Fin (s.2.2 iStar).length) (κ : RawPromotionIndices Pr iStar s.2.2)
      (z' : ℤ × ℤ) (ha : EdgeAdmissible F S w (source σ) (χ fresh kStar κ) z') :
      ValidPrimeLists S.x K F.a s.2.1 ∧ envBox S w s.1 ∧
        goodTestTwo S.x (S.d₀ : ℝ) K F.a s.2.1 (transportedRatio w s.1) := by
    refine ⟨⟨?_, ?_⟩, ha.2.2.2.2.2.2.1, ?_⟩
    · intro i jj
      simpa only [source, permuteLists, Equiv.apply_symm_apply] using
        ha.2.1.1 i ((σ i).symm jj)
    · intro i jj kk hne
      simpa only [source, permuteLists, Equiv.apply_symm_apply] using
        ha.2.1.2 i ((σ i).symm jj) ((σ i).symm kk) ((σ i).symm.injective.ne hne)
    · have hg : IsGoodRatio S.x S.Y (S.d₀ : ℝ) K F.a (permuteLists σ s.2.1)
          (transportedRatio w s.1) := ha.2.2.2.2.2.2.2.2.1
      exact ((pd4c_goodRatio_permuteLists_iff S.Y (S.d₀ : ℝ) F.a s.2.1 σ
        (transportedRatio w s.1)).mp hg).2
  have hmass : (∑ fresh : RawFreshLabels S.x F.a Pr, R fresh) ≤
      (Agood + Abad * Real.exp (-(1 / 4 : ℝ) * Real.rpow S.L (1 / 10 : ℝ))) *
        (2 : ℝ) ^ K := by
    by_cases hdata : ValidPrimeLists S.x K F.a s.2.1 ∧ envBox S w s.1 ∧
        goodTestTwo S.x (S.d₀ : ℝ) K F.a s.2.1 (transportedRatio w s.1)
    · obtain ⟨hp, hbox, hgood⟩ := hdata
      have hlen : (s.2.2 iStar).length ≤ B := by
        exact (Finset.single_le_sum (fun i hi => Nat.zero_le (s.2.2 i).length)
          (Finset.mem_univ iStar)).trans hsize
      have hban_of_adm (σ : G) (fresh : RawFreshLabels S.x F.a Pr)
          (kStar : Fin (s.2.2 iStar).length) (κ : RawPromotionIndices Pr iStar s.2.2)
          (z' : ℤ × ℤ) (ha : EdgeAdmissible F S w (source σ) (χ fresh kStar κ) z') :
          ∀ i jj, ((s.2.2 iStar).get kStar).1 ≠ s.2.1 i jj := by
        intro i jj
        have hc := ha.2.2.2.1.2 iStar i ((σ i).symm jj)
        have htarget : edgeTargetLists F S (source σ) (χ fresh kStar κ)
            iStar (lastSlot S.x) = ((s.2.2 iStar).get kStar).1 := by
          simp [source, edgeTargetLists, lastSlot, χ, rawPatternChoice, hstar, edgeNewLabel]
        rw [htarget] at hc
        simpa only [source, permuteLists, Equiv.apply_symm_apply] using hc
      have hgoodrow (fresh : RawFreshLabels S.x F.a Pr) (hb' : ¬ bad fresh) :
          R fresh ≤ Agood * Q fresh := by
        have hsep : ∀ n₁ n₂,
            IsGoodnessTrialValue F.a s.2.1 (S.d₀ : ℝ) Pr iStar
              (rawFreshFunction S.x F.a Pr fresh) n₁ →
            IsGoodnessTrialValue F.a s.2.1 (S.d₀ : ℝ) Pr iStar
              (rawFreshFunction S.x F.a Pr fresh) n₂ → n₁ ≠ n₂ →
            100 * Real.exp (-Real.rpow S.L (F.a iStar)) <
              circleDistance (((n₁ : ℝ) - n₂) * transportedRatio w s.1) := by
          intro n₁ n₂ hn₁ hn₂ hne
          exact lt_of_not_ge (fun hle => hb' ⟨n₁, n₂, hn₁, hn₂, hne, hle⟩)
        let D := C0 * Q fresh * A ^ K / (slotCount S.x : ℝ) ^ K
        have hD : 0 ≤ D := by
          have hQfresh := hQ fresh
          dsimp only [D]
          positivity
        have hfixed (kStar : Fin (s.2.2 iStar).length) : Rstar fresh kStar ≤ D := by
          by_cases hban : ∀ i jj, ((s.2.2 iStar).get kStar).1 ≠ s.2.1 i jj
          · have h := pd4d_raw_good_fixed_anchor F S s hp hs St Pr iStar hstar kStar
              fresh w Z j ρ v C Cmass hρ0 hρ1 hv hC hCM hV hVinv hν hbands hU hw hbox
              (envBox_finite δ c₁ c₂ S w hS hw) hban hsep hgeom
            convert h using 1 <;> dsimp only [Rstar, W, χ, source, D, C0, Q, A] <;> ring
          · have hz : Rstar fresh kStar = 0 := by
              have hW (σ : G) (κ : RawPromotionIndices Pr iStar s.2.2) (z' : ℤ × ℤ) :
                  W fresh kStar σ κ z' = 0 := by
                have ha : ¬ EdgeAdmissible F S w (source σ) (χ fresh kStar κ) z' :=
                  fun ha => hban (hban_of_adm σ fresh kStar κ z' ha)
                simp only [W, if_neg ha]
              simp only [Rstar, hW, Finset.sum_const_zero, mul_zero]
            simpa only [hz] using hD
        calc
          _ ≤ ∑ _kStar : Fin (s.2.2 iStar).length, D :=
            Finset.sum_le_sum (fun kStar hkStar => hfixed kStar)
          _ = ((s.2.2 iStar).length : ℝ) * D := by simp
          _ ≤ (B : ℝ) * D := mul_le_mul_of_nonneg_right (by exact_mod_cast hlen) hD
          _ = _ := by dsimp only [D, Agood]; ring
      have hbadrow (fresh : RawFreshLabels S.x F.a Pr) : R fresh ≤ Abad * Q fresh := by
        have h := pd4d_raw_coarse_fixed_fresh δ c₁ c₂ F S s St Pr iStar hstar fresh w Z B j
          ρ v C Cmass hS hw hs hsize hB hρ0 hρ1.le hv hC hCM hV hVinv hν hgeom
        convert h using 1 <;> dsimp only [R, Rstar, W, source, χ, Abad, C0, Q] <;> ring
      have hpoint (fresh : RawFreshLabels S.x F.a Pr) : R fresh ≤
          Agood * Q fresh + (if bad fresh then Abad * Q fresh else 0) := by
        by_cases hb' : bad fresh
        · rw [if_pos hb']
          exact (hbadrow fresh).trans (le_add_of_nonneg_left (mul_nonneg hAgood (hQ fresh)))
        · rw [if_neg hb', add_zero]
          exact hgoodrow fresh hb'
      have hsumQ := raw_fresh_nu_mass_le F S Pr hν hνsum
      have hsumBad := raw_bad_fresh_nu_mass_le F S s.2.1 (transportedRatio w s.1)
        Pr hPr hV hb hgood
      have hexp : Real.exp (-(1 / 4 : ℝ) * Real.rpow S.L (F.a iStar)) ≤
          Real.exp (-(1 / 4 : ℝ) * Real.rpow S.L (1 / 10 : ℝ)) := by
        apply Real.exp_le_exp.mpr
        have ha := (hF.1.2.1 iStar).1.le
        exact mul_le_mul_of_nonpos_left
          (show Real.rpow S.L (1 / 10 : ℝ) ≤ Real.rpow S.L (F.a iStar) from
            Real.rpow_le_rpow_of_exponent_le hL ha) (by norm_num)
      have hbadMass : (∑ fresh : RawFreshLabels S.x F.a Pr,
          if bad fresh then Q fresh else 0) ≤
          (2 : ℝ) ^ K * Real.exp (-(1 / 4 : ℝ) * Real.rpow S.L (1 / 10 : ℝ)) :=
        hsumBad.trans (mul_le_mul_of_nonneg_left hexp (by positivity))
      calc
        _ ≤ ∑ fresh : RawFreshLabels S.x F.a Pr,
            (Agood * Q fresh + (if bad fresh then Abad * Q fresh else 0)) :=
          Finset.sum_le_sum (fun fresh hfresh => hpoint fresh)
        _ = Agood * (∑ fresh : RawFreshLabels S.x F.a Pr, Q fresh) +
            Abad * (∑ fresh : RawFreshLabels S.x F.a Pr, if bad fresh then Q fresh else 0) := by
          rw [Finset.sum_add_distrib, Finset.mul_sum, Finset.mul_sum]
          congr 1
          apply Finset.sum_congr rfl
          intro fresh hfresh
          split_ifs <;> simp
        _ ≤ Agood * (2 : ℝ) ^ K + Abad *
            ((2 : ℝ) ^ K * Real.exp (-(1 / 4 : ℝ) * Real.rpow S.L (1 / 10 : ℝ))) :=
          add_le_add (mul_le_mul_of_nonneg_left hsumQ hAgood)
            (mul_le_mul_of_nonneg_left hbadMass hAbad)
        _ = _ := by ring
    · have hzero (fresh : RawFreshLabels S.x F.a Pr) (kStar : Fin (s.2.2 iStar).length)
          (σ : G) (κ : RawPromotionIndices Pr iStar s.2.2) (z' : ℤ × ℤ) :
          W fresh kStar σ κ z' = 0 := by
        have ha : ¬ EdgeAdmissible F S w (source σ) (χ fresh kStar κ) z' :=
          fun ha => hdata (hdata_of_adm σ fresh kStar κ z' ha)
        simp only [W, if_neg ha]
      have hz : (∑ fresh : RawFreshLabels S.x F.a Pr, R fresh) = 0 := by
        simp only [R, Rstar, hzero, Finset.sum_const_zero, mul_zero]
      rw [hz]
      exact mul_nonneg (add_nonneg hAgood (mul_nonneg hAbad (Real.exp_pos _).le))
        (pow_nonneg (by norm_num) _)
  have hrow := pd4c_memEdgePiece_projected_row_mass δ c₁ c₂ F S ρ w true St Pr j
    hS hw s T v hv0
  calc
    _ ≤ (permCount S.x K : ℝ)⁻¹ *
        (∑ σ : G, pd4c_edgeRowMass F S ρ w j true St Pr v (source σ)) := hrow
    _ = ∑ fresh : RawFreshLabels S.x F.a Pr, R fresh := hreindex
    _ ≤ (Agood + Abad * Real.exp (-(1 / 4 : ℝ) * Real.rpow S.L (1 / 10 : ℝ))) *
        (2 : ℝ) ^ K := hmass
    _ = _ := by dsimp only [Agood, Abad, C0, A, C, PDScale.M]; ring


/-- `t2:pd.dirty-raw` — PD 04:605-714.  REPLACES the frozen `dirty_raw`.  With
`ε_K = C_K(B/M_J^K + B^K e^{-cL^{0.1}})`: every raw piece with `(St,Pr) ≠ (∅,∅)` has weighted row
sum `≤ ε_K` if `Pr ≠ ∅` (one compatible omission tuple by test (ii), mass `M_J^{-K}`,
(mem:anchor-congruence)) and `≤ C_K` otherwise, column sum `≤ ε_K` if `St ≠ ∅` and `≤ C_K`
otherwise (reversal); weighted Schur gives `‖dirty raw‖ ≤ C_K √ε_K ≤ C_K L^{1-K/200}` for large
`x` (mem:raw-dirty-norm).  Stated for `K ≥ 201`, where `ε_K ≤ 1` eventually. Correction from
refutation lane `sol-gate-b` projects each operator bound to symmetric memory. -/
theorem dirty_raw (δ c₁ c₂ : ℝ) (hδ : 0 < δ) (hc₁ : 0 < c₁) :
    ∀ (K : ℕ), 201 ≤ K → ∀ (F : PDFix K), F.Valid → ∀ ρ : ℝ, IsMemoryRho F.q_d ρ →
      ∃ v₀ C_K c x₀ : ℝ, 1 < v₀ ∧ 0 < C_K ∧ 0 < c ∧ 2 ≤ x₀ ∧
        ∀ S : PDScale, S.Valid K δ c₁ c₂ → x₀ ≤ S.x →
          ∀ w : ArchRoot, w.InRegion S → ∀ j : ℕ, j < S.N →
            let B := memoryCutoff S
            let εK := C_K * ((B : ℝ) / (S.M : ℝ) ^ K +
              (B : ℝ) ^ K * Real.exp (-c * Real.rpow S.L (1 / 10 : ℝ)))
            (∀ St Pr : Finset (Fin K), ¬ (St = ∅ ∧ Pr = ∅) →
              MemRowSchurLE_sym F S B (memEdgePiece F S ρ w true St Pr j) v₀
                  (if Pr.Nonempty then εK else C_K) ∧
                MemColSchurLE_sym F S B (memEdgePiece F S ρ w true St Pr j) v₀
                  (if St.Nonempty then εK else C_K)) ∧
            MemOpNormLE_sym F S B (memEdge F S ρ w EdgeKind.dirtyRaw j)
              (C_K * Real.rpow S.L (1 - (K : ℝ) / 200)) := by
  classical
  intro K hK F hF ρ hρ
  obtain ⟨xμ, hxμ, hMeasure⟩ := pd4c_memMeasure_nonneg_eventually F hF
  have hrows : ∃ v C c xr : ℝ, 1 < v ∧ 0 < C ∧ 0 < c ∧ 2 ≤ xr ∧
      ∀ S : PDScale, S.Valid K δ c₁ c₂ → xr ≤ S.x →
        let D := (memoryCutoff S : ℝ) / (S.M : ℝ) ^ K +
          (memoryCutoff S : ℝ) ^ K * Real.exp (-c * Real.rpow S.L (1 / 10 : ℝ))
        ∀ w : ArchRoot, w.InRegion S → ∀ j : ℕ, ∀ St Pr : Finset (Fin K),
          MemRowSchurLE_sym F S (memoryCutoff S) (memEdgePiece F S ρ w true St Pr j) v
            (if Pr.Nonempty then C * D else C) := by
    obtain ⟨Ceta, hCeta, hEta⟩ := exists_eta_norm_bound F hF
    obtain ⟨Cpsi, hCpsi, hPsi⟩ := exists_psi_norm_bound F hF
    obtain ⟨xV, hxV, hVbounds⟩ := pd4c_bandMass_large_bounds F hF
    obtain ⟨xB, hxB, hBbounds⟩ := memoryBPrime_half_of_large_x F hF
    obtain ⟨xBands, hxBands, hBands⟩ := pd4c_validBands_disjoint_eventually K F.a hF.1
    let Cmass := max 2 (2 / Real.log 2)
    let A := (1 / (1 - ρ) ^ 2) ^ K
    let Cbase := 34 * Ceta ^ 2 * Cpsi * (2 : ℝ) ^ K
    let Cempty := Cbase * (4 : ℝ) ^ K
    let Csmall := Cbase * Cmass ^ K * (2 : ℝ) ^ K
    let C := 1 + Cempty + Csmall * (1 + A)
    let xr := max 2 (max xV (max xB (max xBands (Real.exp 1))))
    have hCM : 2 ≤ Cmass := le_max_left _ _
    have hA : 0 ≤ A := by dsimp only [A]; positivity
    have hCempty : 0 ≤ Cempty := by dsimp only [Cempty, Cbase]; positivity
    have hCsmall : 0 ≤ Csmall := by dsimp only [Csmall, Cbase]; positivity
    have hC : 0 < C := by dsimp only [C]; positivity
    have hEmptyC : Cempty ≤ C := by dsimp only [C]; nlinarith
    have hSmallC : Csmall ≤ C := by dsimp only [C]; nlinarith
    have hGoodC : Csmall * A ≤ C := by dsimp only [C]; nlinarith
    refine ⟨2, C, 1 / 4, xr, by norm_num, hC, by norm_num, le_max_left _ _, ?_⟩
    intro S hS hx
    dsimp only
    intro w hw j St Pr
    have hxV' : xV ≤ S.x := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hx
    have hxB' : xB ≤ S.x := le_trans
      (le_trans (le_max_left _ _) (le_trans (le_max_right _ _) (le_max_right _ _))) hx
    have hxBands' : xBands ≤ S.x := le_trans
      (le_trans (le_max_left _ _)
        (le_trans (le_max_right _ _) (le_trans (le_max_right _ _) (le_max_right _ _)))) hx
    have hxL : Real.exp 1 ≤ S.x := le_trans
      (le_trans (le_max_right _ _)
        (le_trans (le_max_right _ _) (le_trans (le_max_right _ _) (le_max_right _ _)))) hx
    have hL : 1 ≤ S.L := by
      have h := Real.log_le_log (Real.exp_pos 1) hxL
      simpa only [Real.log_exp, PDScale.L] using h
    have hV (i : Fin K) : 0 < bandMass S.x (F.a i) :=
      lt_of_lt_of_le (div_pos (Real.log_pos (by norm_num)) (by norm_num))
        (hVbounds S.x hxV' i).1
    have hVinv (i : Fin K) : (bandMass S.x (F.a i))⁻¹ ≤ Cmass := by
      calc
